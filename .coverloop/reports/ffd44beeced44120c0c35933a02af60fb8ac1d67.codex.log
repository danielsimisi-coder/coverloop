  1766	# git's %G? signature-status codes. Only "G" (good AND from a key of sufficient
  1767	# validity — gpg owner-trust, or an ssh signer in allowed_signers) proves an
  1768	# AUTHORIZED author. "U" is a good signature whose key validity is UNKNOWN (e.g.
  1769	# a key merely imported into the keyring, or an ssh signer NOT in
  1770	# allowed_signers) — accepting it would let anyone with any importable key pass,
  1771	# so we reject it (Sol R3 P1: `git verify-commit` exit 0 accepts both G and U).
  1772	_SIG_STATUS = {
  1773	    "U": "good signature but UNKNOWN key validity — grant owner-trust / add the signer to allowed_signers",
  1774	    "B": "BAD signature", "E": "signature could not be checked (missing public key)",
  1775	    "N": "no signature", "X": "expired signature", "Y": "expired signing key",
  1775	    "N": "no signature", "X": "expired signature", "Y": "expired signing key",
  1776	    "R": "revoked signing key",
  1777	}
