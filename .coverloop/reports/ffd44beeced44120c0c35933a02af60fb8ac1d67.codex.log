+# The words real reviewers actually end on. Sampled from the fleet's captured
+# transcripts: Codex ends "VERDICT: PASS", GLM's red-team scale is
+# "Verdict: PASS / PASS WITH RISKS / REQUEST CHANGES / BLOCK", and some runs
+# emit lowercase "verdict: fail" or a GitHub-style "APPROVE". A parser that
+# only knew uppercase "VERDICT: PASS" scored every one of those a fail —
+# fail-closed, but useless: it would have made `check` unusable with the very
+# reviewers this repo ships. Unknown wording still fails.
+# The reviewer's verdict is a MACHINE PROTOCOL, not prose to be interpreted.
+# Exactly one canonical marker line counts:
+#
+#     VERDICT: PASS        (or)        VERDICT: FAIL
+#
+# The reviewer PROMPT tells the reviewer to end with it; the gate does not try
+# to infer approval from natural language. "PASS WITH RISKS", "APPROVE",
+# "LGTM", "SHIP" and every other human phrasing are NOT a pass — inferring one
+# would let a hedged review land as `pass` with zero open findings. Missing,
+# malformed, truncated, ambiguous or non-canonical: FAIL CLOSED.
+_VERDICT_MARKER = re.compile(r"^[ \t]*VERDICT:.*$", re.M)
+_VERDICT_CANONICAL_PASS = "VERDICT: PASS"
+_VERDICT_CANONICAL_FAIL = "VERDICT: FAIL"
+
+
+def transcript_verdict(text, tail_lines=10):
+    """Return "pass" only for an unambiguous canonical PASS marker at the end.
+
+    Three conditions, all fail-closed:
+      * at least one `VERDICT:` line exists;
+      * EVERY such line is byte-for-byte "VERDICT: PASS" after trimming — no
+        "PASS WITH RISKS", no lowercase, no "APPROVE";
+      * the last one is among the final `tail_lines` non-empty lines, so it is
+        the reviewer's closing word rather than something near the top.
+
+    The whole transcript is read, not a tail window: a review that says FAIL and
+    then emits 5 KB of appendix would otherwise have its failure scroll out of
+    view. The closing-position rule is the other half of the same idea — a
+    prompt echo containing the marker, followed by a review that never reaches a
+    verdict, must not count as approval. The small allowance exists because real
+    reviewers append a footer (Codex prints "tokens used" and a count after its
+    reply); it is not room for review content.
+    """
+    lines = (text or "").splitlines()
+    live = [(i, ln.strip()) for i, ln in enumerate(lines) if ln.strip()]
+    markers = [(n, body) for n, (i, body) in enumerate(live) if _VERDICT_MARKER.match(lines[i])]
+    if not markers:
+        return "fail"
+    if any(body != _VERDICT_CANONICAL_PASS for _n, body in markers):
+        return "fail"
+    if len(live) - markers[-1][0] > tail_lines:
+        return "fail"          # a marker buried above the review is not a verdict
+    return "pass"
+
+
+def _reviewer_policy_path():
+    """Where the operator's trusted reviewer policy lives. Deliberately OUTSIDE
+    any repository: see reviewer_policy()."""
+    return os.environ.get("COVERLOOP_REVIEWERS") or os.path.join(
+        os.path.expanduser("~"), ".config", "coverloop", "reviewers.json")
+
+
+def reviewer_policy(root):
+    """Load WHO reviews and WHAT COMMAND runs them, from a trusted source.
+
+    The independence of the review is the whole product. If the commands lived
+    in the repository, a diff could replace its own reviewer with a stub that
+    prints the canonical pass marker, and `check` would dutifully run it — the
+    change under review would be signing its own evidence. So the policy is
+    read from the operator's own machine, never from the worktree, and it is
+    refused if it is reachable from inside the repo (a symlink or a path under
+    the root) or if anyone but the owner can write it.
+
+    Returns (policy, None) or (None, reason).
+    """
+    path = _reviewer_policy_path()
+    real = os.path.realpath(path)
+    root_real = os.path.realpath(root)
+    if real == root_real or real.startswith(root_real + os.sep):
+        return None, (f"reviewer policy {path} resolves inside the repository under review "
+                      f"({real}) — the reviewer must not be nominated by the change")
+    try:
+        st = os.lstat(real)
+    except OSError:
+        return None, (f"no reviewer policy at {path}. Create it (outside any repo) as:\n"
+                      '  {"reviewers": {"primary": "codex", "secondary": "glm"},\n'
+                      '   "reviewer_commands": {"codex": "<cold review cmd>", '
+                      '"glm": "<red-team cmd>"}}\n'
+                      "  Each command must make its reviewer end with the line "
+                      "'VERDICT: PASS' or 'VERDICT: FAIL'.")
+    if not stat.S_ISREG(st.st_mode):
+        return None, f"reviewer policy {path} is not a regular file"
+    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
+        return None, (f"reviewer policy {path} is group/world-writable "
+                      f"({oct(st.st_mode & 0o777)}) — anyone could swap the reviewer; "
+                      f"run: chmod 600 {path}")
+    data, err = load_json(real)
+    if err:
+        return None, f"reviewer policy {path}: {err}"
+    data = data or {}
+    roles = data.get("reviewers") or {}
+    primary = roles.get("primary", "codex")
+    secondary = roles.get("secondary", "glm")
+    if (primary not in ("codex", "glm") or secondary not in ("codex", "glm")
+            or primary == secondary):
+        return None, (f"reviewer policy {path}: reviewers must name two distinct roles from "
+                      "{codex, glm} (report keys are fixed for compatibility)")
+    cmds = data.get("reviewer_commands") or {}
+    if not isinstance(cmds, dict) or any(not isinstance(v, str) for v in cmds.values()):
+        return None, f"reviewer policy {path}: reviewer_commands must map a role to a command string"
+    # Naming the reviewer outside the repo is not enough if the command it
+    # names lives INSIDE it: the change could then edit its own reviewer to
+    # print the pass marker. Refuse any token of the command that resolves to
+    # a path under the repo root. Heuristic on purpose — it is a word-split,
+    # not a shell parser — but it fails CLOSED and catches the whole class
+    # ("./bin/review.sh", "scripts/review.sh", an absolute path into the tree).
+    for role, cmd in cmds.items():
+        for tok in cmd.replace("|", " ").replace(";", " ").split():
+            tok = tok.strip("\"'")
+            if not tok or tok.startswith("-") or tok in (".", ".."):
+                continue
+            cand = os.path.realpath(os.path.join(root_real, tok)) if not os.path.isabs(tok) \
+                else os.path.realpath(tok)
+            if not (cand.startswith(root_real + os.sep) and os.path.isfile(cand)):
+                continue
+            # A file inside the repo is only a hazard if it can RUN: an
+            # executable, or a script some interpreter will be handed. A
+            # pathspec ("git diff -- .") or a data file argument is not, and
+            # refusing those made the tool refuse its own reviewer command.
+            runnable = os.access(cand, os.X_OK) or os.path.splitext(cand)[1] in (
+                ".sh", ".bash", ".py", ".rb", ".pl", ".js", ".mjs", ".ts")
+            if runnable:
+                return None, (f"reviewer policy {path}: the {role} command runs {tok!r}, which "
+                              f"lives inside the repository under review — the change could "
+                              f"rewrite its own reviewer. Point it at a command outside the repo.")
+    return {"path": path, "primary": primary, "secondary": secondary, "commands": cmds}, None
+
+
+def _stop(reason):
+    """The single STOP line. stdout is flushed first so the reason is the last
+    thing on the terminal even though it goes to stderr."""
+    sys.stdout.flush()
+    print(f"STOP: {reason}", file=sys.stderr)
+    sys.exit(1)
+
+
