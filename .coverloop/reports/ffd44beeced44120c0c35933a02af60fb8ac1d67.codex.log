    84	TIERS = ("L0", "L1", "L2", "L3")
    85	
    86	# ---------------------------------------------------------------------------
    87	# Deterministic risk classification (the tier FLOOR, derived from the change
    88	# itself).
    89	#
    90	# Why this exists: every gate below keys off `risk_tier`, but that tier was
    91	# self-declared at `init`. A change mislabelled L1 silently skips the L3 gates —
    92	# no alarm, no evidence that anything was skipped. This is the one place the
    93	# whole chain could be defeated by a typo or by optimism. So the tier a human
    94	# (or an AI) declares is now only a FLOOR CANDIDATE: `classify` reads the paths
    95	# that actually changed and emits its own floor, and `gate --min-tier` takes the
    96	# MAX. Classification can therefore only ever RAISE the requirement.
    97	#
    98	# Rules are PATH-based on purpose: paths are cheap, stable, and reviewable, and
    99	# an attacker who renames a migration out of `migrations/` to dodge L3 has to do
   100	# something visible in the diff. Content sniffing was deliberately NOT used —
   101	# it is easy to defeat with formatting and produces false negatives that read as
   102	# safety. Deliberately blunt beats subtly wrong here.
   103	#
   104	# Ordering: first match wins per file, HIGHEST tier over all files wins overall.
   105	# Anything unrecognised is L1, never L0 — an unknown file is not evidence of
   106	# safety.
   107	# Two ways a keyword can end, and the difference is the whole false-positive story.
   108	#
   109	# _kw  — any casing, then a separator, a camelCase hump, or end of name. Used for
   110	#        the DANGEROUS words (auth, credentials, billing, worker...). AuthGuard.tsx
   111	#        and authGuard.tsx both reach L3, and a component that merely sounds like
   112	#        auth being reviewed as auth costs a review nobody regrets.
   113	# _kws — the same, EXCEPT that a PascalCase name does not count as a hump. Used for
   114	#        words that collide with ordinary React component names: ModelViewer.tsx is
   115	#        not a data model, ContextMenu.tsx is not React context, RoutePlanner.tsx is
   116	#        not a router. Those read as L3/L2 under _kw, and a floor that cries danger
   117	#        at a UI component is a floor people learn to route around — which costs far
   118	#        more than the handful of real files it would have caught.
   119	#        `models/`, `model.ts` and `Schema.ts` still match: only the HUMP form is
   120	#        restricted, because that is the only form the collision takes.
   121	def _kw(words):
   122	    return rf"(?:{words})(?=(?-i:[A-Z])|[/._\-\s]|$)"
   123	
   124	
   125	def _kws(words):
   126	    return rf"(?:(?-i:{words})(?=(?-i:[A-Z]))|(?:{words})(?=[/._\-\s]|$))"
   127	
   128	
   129	RISK_RULES = (
   130	    # (tier, compiled path pattern, human-readable reason)
   131	    ("L3", r"(^|/)migrations?/|(^|/)(alembic|db)/(versions?|migrate)/"
   132	           r"|(^|/)migrate/[^/]*\.(rb|py|go|ts|js|sql)$", "database migration"),
   133	    ("L3", r"\.sql$", "raw SQL"),
   134	    ("L3", r"(^|/)(auth|authn|authz|authentication|authorization|authorisation"
   135	           r"|rls|rbac|permissions?|policies|policy|acls?|admin)(?=(?-i:[A-Z])|[/._\-\s]|$)",
   136	     "authentication / authorisation / RLS"),
   137	    ("L3", r"(^|/)(billing|payments?|invoices?|invoicing|checkout|charges?|chargebacks?"
   138	           r"|stripe|cardcom|subscriptions?|wallets?|payouts?|refunds?|transfers?|ledgers?)(?=(?-i:[A-Z])|[/._\-\s]|$)",
   139	     "money path"),
   140	    ("L3", r"(^|/)(secrets?|credentials?|keys?)(?=(?-i:[A-Z])|[/._\-\s]|$)|(^|/)\.env",
   141	     "secrets / credentials"),
   142	    ("L3", r"(^|/)\.github/workflows/|(^|/)(Dockerfile|docker-compose|fly\.toml|vercel\.json)"
   143	           r"|(^|/)(\.gitlab-ci\.yml|Jenkinsfile|\.circleci/|azure-pipelines\.yml|buildspec\.yml)"
   144	           r"|(^|/)\.github/actions/|\.(tf|tfvars)$|(^|/)(terraform|pulumi|helm|k8s|kubernetes)/",
   145	     "CI / deploy configuration"),
   146	    ("L3", r"(^|/)(workers?|cron|jobs?|queues?|scheduler)(?=(?-i:[A-Z])|[/._\-\s]|$)",
   147	     "worker / cron / queue"),
   148	    ("L3", r"(^|/)" + _kws("schemas?|models?")
   149	           + r".*\.(ts|tsx|js|jsx|mjs|cjs|py|go|rb|java|kt|swift|rs|php|sql|prisma|graphql|ya?ml|json|cs|ex|exs|scala|clj|hs|dart)$",
   150	     "schema / data model"),
   151	    # L2 — product surface and shared contracts: wide blast radius, no direct
   152	    # money/auth authority.
   153	    # NOTE: these two are scoped to APPLICATION SOURCE extensions on purpose.
   154	    # Unscoped, `hooks/` matched this protocol's own shell hooks and `api/`
   155	    # would match any stray text file — over-classification is not free: a
   156	    # floor that cries L2 at documentation trains people to bypass the gate,
   157	    # and a bypassed gate protects nothing.
   158	    ("L2", r"(^|/)(?:" + _kw("api|handlers?|controllers?|middleware")
   159	           + "|" + _kws("routes?") + r")" + r".*\.(ts|tsx|js|jsx|mjs|cjs|py|go|rb|java|kt|swift|rs|php)$",
   160	     "API surface"),
   161	    ("L2", r"(^|/)(?:" + _kw("hooks?|providers?")
   162	           + "|" + _kws("contexts?|stores?|states?") + r")" + r".*\.(ts|tsx|js|jsx|mjs|cjs|py|go|rb|java|kt|swift|rs|php)$",
   163	     "shared application state"),
   164	    ("L2", r"(^|/)(package\.json|package-lock\.json|pnpm-lock\.yaml|yarn\.lock|requirements.*\.txt|pyproject\.toml)$",
   165	     "dependency manifest"),
   166	    # L0 — provably inert: prose and styling only. Anything else falls through
   167	    # to the L1 default.
   168	    # `.txt` is deliberately absent: config/roles.txt and the like are plain
   169	    # text that configures real behaviour, so an unmatched .txt falls to L1
   170	    # ("silence is not safety") rather than being presumed prose.
   171	    ("L0", r"\.(md|mdx|rst|adoc)$", "documentation"),
   172	    ("L0", r"\.(css|scss|sass|less)$", "stylesheet"),
   173	    ("L0", r"(^|/)(LICENSE|CODEOWNERS|\.gitignore|\.editorconfig)$", "repo metadata"),
   174	)
   175	_RISK_RULES_C = tuple((t, re.compile(p, re.I), why) for t, p, why in RISK_RULES)
   176	
   177	# Above this many changed files a change is too broad to be L1 regardless of
   178	# what the individual paths look like — breadth is itself a risk signal.
   179	# Extensions that are inert WHATEVER the file is named. `.txt` is deliberately
   180	# absent: config/permissions.txt and requirements.txt are plain text that
   181	# configures real behaviour, and the blanket shortcut was declaring them L0
   182	# ahead of the rules that call them dangerous. `.txt` falls through to the
   183	# ordinary rules, where the documentation rule still catches notes.txt — but
   184	# only after the L3 rules have had their say.
   185	# .coverloop/reports/ holds the tool's OWN generated evidence artifacts —
   186	# report JSON and reviewer transcripts. They cannot carry application risk;
   187	# their integrity is defended separately (hash binding, forgery checks in
   188	# find_report/verify_capture), not by this classifier. Without this, an
   189	# evidence-only commit classified its own report file as "L1: unrecognized
   190	# source", so a repo's evidence chain kept re-flagging ITSELF as unreviewed.
   191	# Anchored to the REPO ROOT. Unanchored, every occurrence of the substring
   192	# matched, so nested/.coverloop/reports/evil.sql — and even
   193	# x.coverloop/reports/migration.sql, via the unescaped-dot lookalike — were
   194	# exempted from classification entirely: an attacker could park a migration
   195	# under any directory NAMED like the evidence tree and classify it L0.
   196	# ...and only the exact artifact SHAPES the tool itself writes. Anchoring
   197	# alone still exempted .coverloop/reports/evil.sql — anything parked in the
   198	# canonical directory. A file there that is not a report or transcript is
   199	# ordinary (suspicious) code and classifies like any other path.
   200	_INERT_RE = re.compile(r"\.(md|mdx|rst|adoc|css|scss|sass|less)$", re.I)
   201	
   202	BREADTH_L2_FILES = 10
   203	
   204	
   205	# The narrow set: changes a human must personally stop on, because no amount of
   206	# automated review buys back a mistake here.
   207	#
   208	#   1. schema migrations / raw SQL  — can destroy data; there is no undo
   209	#   2. money paths                  — a wrong number moves real funds
   210	#   3. authz / RLS / permissions    — a wrong rule shows one customer another's data
   211	#
   212	# Everything else at L3 (workers, cron, CI config, deploy wiring, concurrency,
   213	# env plumbing) is dangerous enough to earn the FULL automated loop — tests,
   214	# an independent diff gate, a red-team pass, hashed evidence — but it is
   215	# revertible, so stopping a solo founder on every one of them buys less than it
   216	# costs. This list is deliberately short: the moment it grows to cover
   217	# "anything that feels important", the stop stops meaning anything.
   218	# Which L3 REASONS are hard to take back. This is derived from the rule that
   219	# matched, not from a second regex kept in step by hand — the parallel regex
   220	# drifted from RISK_RULES three separate times (camelCase authz, then `acl`,
   221	# then alembic/db-migrate directories), each time silently waiving the human
   222	# stop for exactly the changes `--human-gate-scope irreversible` promises to
   223	# stop. A rule added above is now covered here automatically, or not at all,
   224	# and never half-covered.
   225	IRREVERSIBLE_REASONS = frozenset({
   226	    "database migration",
   227	    "raw SQL",
   228	    "authentication / authorisation / RLS",
   229	    "money path",
   230	    "schema / data model",
   231	})
   232	
   233	
   234	def is_irreversible(path):
   235	    """True when PATH matches ANY L3 rule whose consequences are hard to undo.
   236	
   237	    Checking only the FIRST matching rule made the answer depend on rule ORDER:
   238	    `workers/models/user.py` hit the worker rule (L3, reversible) before the
   239	    schema rule (L3, irreversible), so the human stop was waived for a schema
   240	    change because of where the file happened to live. Tier selection may take
   241	    the first match; irreversibility must ask every rule."""
   242	    return any(rule_tier == "L3" and why in IRREVERSIBLE_REASONS and rx.search(path)
   243	               for rule_tier, rx, why in _RISK_RULES_C)
   244	
   245	
   246	class _IrreversibleShim:
   247	    """Kept so `IRREVERSIBLE_RE.search(path)` still reads naturally at the two
   248	    call sites and in the tests; the logic lives in is_irreversible()."""
   249	
   250	    @staticmethod
   251	    def search(path):
   252	        return is_irreversible(path)
   253	
   254	
   255	IRREVERSIBLE_RE = _IrreversibleShim()
   256	
   257	
   258	def _resolve_commit(ref, cwd):
   259	    """Resolve a user-supplied ref to a commit id, or None.
   260	
   261	    `--base` reaches `git diff` as a positional, so an option-shaped value was
   262	    read as a FLAG: `--base=--cached` diffed the index, found nothing to classify,
   263	    and the gate passed. `--end-of-options` stops git parsing further flags, and
   264	    demanding a 40-hex answer means nothing but a real commit gets through.
   265	    """
   266	    out = git(["rev-parse", "--verify", "--quiet", "--end-of-options",
   267	               f"{ref}^{{commit}}"], cwd=cwd)
   268	    if not out:
   269	        return None
   270	    out = out.strip()
   271	    return out if re.fullmatch(r"[0-9a-f]{40}", out) else None
   272	
   273	
   274	def _git_paths(args, cwd):
   275	    """Git path output, parsed losslessly. Returns None if git failed.
   276	
   277	    Two ways the old `--name-only` + splitlines() collection lost paths, and both
   278	    are classifier EVASION, not cosmetics:
   279	
   280	      * rename detection reported only the DESTINATION, so moving
   281	        src/authGuard.ts to src/guard.ts made an auth change look like an
   282	        unrecognised source file. `--no-renames` reports both sides.
   283	      * git C-quotes any name containing a newline or tab, and splitlines() then
   284	        tore that single path into two meaningless fragments. `-z` emits raw
   285	        names separated by NUL, so there is nothing to quote and nothing to tear.
   286	    """
   287	    # `--no-renames` is a diff option; ls-files rejects it, and appending it
   288	    # blindly made every collection return None — which the caller then, quite
   289	    # correctly, read as "cannot determine the paths" and held at L1. Correct
   290	    # fail-closed behaviour, wrong cause, and it would have masked the evasion
   291	    # fix it was meant to deliver.
   292	    # `show` takes diff options too, and it defaults to rename detection just
   293	    # like `diff` — scoping the flag to `diff` alone let the root-commit fallback
   294	    # lose a rename origin again, one commit after that hole was closed.
   295	    # `ls-files` is the only caller here that rejects it.
   296	    extra = (["--no-renames", "-z"] if args and args[0] in ("diff", "show")
   297	             else ["-z"])
   298	    out = git(args + extra, cwd=cwd)
   299	    if out is None:
   300	        return None
   301	    # Only EMPTY segments are dropped — a filename that is entirely whitespace
   302	    # is a real (and suspicious) file, and discarding it produced an empty,
   303	    # L0 change set.
   304	    return [p for p in out.split("\0") if p]
   305	
   306	
   307	def _changed_paths_for_gate(root, args):
   308	    """Paths this gate run is judging: the PR range if --base was given (CI),
   309	    else the working tree plus untracked files (local)."""
   310	    base = getattr(args, "base", None)
   311	    if base:
   312	        base = _resolve_commit(base, root)
   313	        if base is None:
   314	            return []
   315	        out = _git_paths(["diff", "--name-only", f"{base}...HEAD"], root)
   316	        if out is None:
   317	            out = _git_paths(["diff", "--name-only", base, "HEAD"], root)
   318	        return out or []
   319	    tracked = _git_paths(["diff", "--name-only", "HEAD"], root) or []
   320	    untracked = _git_paths(["ls-files", "--others", "--exclude-standard"], root) or []
   321	    return list(tracked) + list(untracked)
   322	
   323	
   324	def _validated_baseline(root, sha, limit=2000):
   325	    """The newest ancestor of SHA whose evidence chain actually VALIDATES.
   326	
   327	    Returns (baseline, validated): `validated` is False when the baseline is the
   328	    bare root commit with no accepted evidence — the caller must then classify
   329	    the root's OWN files too, because a two-dot diff from the root excludes the
   330	    files the root itself introduced (a migration in a repo's FIRST commit was
   331	    never classified at all; probed end-to-end). None baseline means git could
   332	    not answer, or the history is SHALLOW — a shallow boundary looks exactly
   333	    like a root commit to rev-list --max-parents=0, and treating it as one
   334	    silently drops everything at or before the boundary; fail closed and let
   335	    the operator fetch full history (CI: fetch-depth: 0, or pass --base).
   336	
   337	    A report advances the baseline only if BOTH hold:
   338	      * its tier covers the deterministic floor of the segment it governs, AND
   339	      * it would pass its own VERIFICATION (tests bound to the config command,
   340	        hash-bound reviewer transcripts) — NOT authorization: whether a human
   341	        signed for it is the gate's question about the commit being shipped,
   342	        not a property that makes an ancestor a worse baseline — existence is
   343	        not validity, and a bare tier claim is not evidence: a planted
   344	        no-evidence L3 report on a migration commit advanced the baseline and
   345	        let a later docs commit gate at L0 (probed end-to-end).
   346	
   347	    Cost is bounded: at most _BASELINE_WALK_CAP evidence commits are validated
   348	    (newest-first); anything older folds into the pre-baseline segment, which
   349	    only ever ENLARGES what the gate classifies.
   350	    """
   351	    shallow = git(["rev-parse", "--is-shallow-repository"], cwd=root)
   352	    if shallow is None or shallow.strip() == "true":
   353	        return None, False, None
   354	    out = git(["rev-list", f"--max-count={limit}", sha], cwd=root)
   355	    if not out:
   356	        return None, False, None
   357	    commits = out.split()
   358	    attested = []
   359	    for c in commits[1:]:
   360	        if os.path.exists(report_path(root, c)):
   361	            rep, _why = load_report(root, c)
   362	            if rep is not None and rep.get("risk_tier") in TIERS:
   363	                attested.append((c, rep))
   364	        if len(attested) >= _BASELINE_WALK_CAP:
   365	            break
   366	    root_out = git(["rev-list", "--max-parents=0", sha], cwd=root)
   367	    if not root_out:
   368	        return None, False, None
   369	    baseline = root_out.split()[-1]
   370	    validated = False
   371	    pending_human = None
   372	    cfg, _cfg_err = load_json(os.path.join(root, CONFIG_FILE))
   373	    cfg_cmd = (cfg or {}).get("test_command")
   374	    for c, rep in reversed(attested):
   375	        if c == baseline and validated:
   376	            continue
   377	        seg = _git_paths(["diff", "--name-only", f"{baseline}..{c}"], root)
   378	        if seg is None:
   379	            return None, False, None
   380	        if not validated:
   381	            # The segment reaching back to the bare root must include the
   382	            # root's own files — a two-dot diff excludes what the root itself
   383	            # introduced, and nothing else ever accounts for those.
   384	            own = _git_paths(["show", "--name-only", "--pretty=format:", baseline], root)
   385	            if own is None:
   386	                return None, False, None
   387	            seg = list(seg) + own
   388	        tier = rep["risk_tier"]
   389	        floor, _reasons = classify_paths(seg, BREADTH_L2_FILES)
   390	        if tier_max(tier, floor) != tier:
   391	            continue  # under-declares its segment — not a valid baseline
   392	        # VERIFICATION scope, deliberately: this asks "was commit c actually
   393	        # checked?" (tests + reviewers), not "did a human sign for it?". A
   394	        # reviewed-but-unsigned commit is a legitimate risk baseline. Human
   395	        # authorization is enforced by the GATE on the commit being shipped —
   396	        # it is never inherited from an ancestor, and never inferred here.
   397	        ok, _checks = evaluate(rep, tier, None, root=root, test_command=cfg_cmd,
   398	                               require_captured=True, scope=EVIDENCE_VERIFICATION)
   399	        if not ok:
   400	            continue  # a tier claim with no evidence behind it is not a baseline
   401	        # Advancing past this commit removes its files from every later floor.
   402	        # If its tier required a human signature and never got one, that
   403	        # OBLIGATION does not vanish with the files: it is carried to HEAD, so
   404	        # a branch containing an unapproved migration cannot be merged by
   405	        # putting a docs commit on top of it. Sticky — a later approval signs
   406	        # for its own segment, never retroactively for this one.
   407	        authorized, _ac = evaluate(rep, tier, None, root=root, test_command=cfg_cmd,
   408	                                   require_captured=True, scope=EVIDENCE_AUTHORIZATION)
   409	        if not authorized:
   410	            pending_human = pending_human or c
   411	        baseline = c
   412	        validated = True
   413	    return baseline, validated, pending_human
   414	
   415	
   416	_BASELINE_WALK_CAP = 100
   417	
   418	
   419	def _gate_floor_paths(root, args, report, sha):
   420	    """Every path this gate run is judging, and whether that set is TRUSTWORTHY.
   421	
   422	    Returns (paths, unknown). `unknown` means git could not answer, and the caller
   423	    must fail closed rather than read the resulting empty list as "nothing risky".
   424	
   425	    The first cut of the auto-floor asked only for uncommitted changes, which is
   426	    empty in the ordinary case — you commit, THEN run the gate — so `gate
   427	    --min-tier L0` still passed over a committed migration. The set therefore
   428	    also spans the commits the recorded evidence does not cover: from the report's
   429	    commit to HEAD, or the commit being gated when there is no report at all.
   430	    """
   431	    base = getattr(args, "base", None)
   432	    if base:
   433	        # Resolve to a commit id FIRST. `--base=--cached` was passed through to
   434	        # `git diff` as an OPTION, which diffed the index, found nothing, and
   435	        # gated clean. Anything that does not resolve to a commit is refused
   436	        # before it can reach git as a flag.
   437	        base = _resolve_commit(base, root)
   438	        if base is None:
   439	            return [], True, None
   440	        out = _git_paths(["diff", "--name-only", f"{base}...HEAD"], root)
   441	        if out is None:
   442	            out = _git_paths(["diff", "--name-only", base, "HEAD"], root)
   443	        if out is None:
   444	            # An unresolvable --base is a caller error, not an all-clear. Reading
   445	            # it as "no files changed" turned a typo into a passing gate.
   446	            return [], True, None
   447	        # With an explicit base the whole span is classified, so an unapproved
   448	        # commit inside it raises the tier directly — nothing to inherit.
   449	        return out, False, None
   450	
   451	    tracked = _git_paths(["diff", "--name-only", "HEAD"], root)
   452	    untracked = _git_paths(["ls-files", "--others", "--exclude-standard"], root)
   453	    if tracked is None or untracked is None:
   454	        return [], True, None
   455	    paths = list(tracked) + list(untracked)
   456	
   457	    # ...plus whatever the evidence does not already cover.
   458	    # The commit being gated is ALWAYS classified, including when the evidence
   459	    # sits on it. The old expression returned None in exactly that case — the
   460	    # normal attest path — so a migration could be committed, attested L0 with
   461	    # tests, and sail through: the floor never looked at it. `prior^..sha` also
   462	    # re-covers the evidence commit itself, which is the point: the recorded
   463	    # tier has to match what that commit actually contains.
   464	    # The EARLIEST commit this evidence claims to cover — not the one it was last
   465	    # rebound to (see origin_commit above).
   466	    # The oldest commit some EARLIER evidence already claims to cover.
   467	    # `origin_commit` is the honest source when it exists (set on rebind). A
   468	    # report's plain `commit` field is NOT a substitute: on a first-ever attest
   469	    # it equals sha itself, and treating sha as "prior" collapsed the range to
   470	    # sha^..sha — a single commit — so a migration one commit back (never
   471	    # attested, never rebound) stayed invisible. Absent a real origin, the
   472	    # honest baseline is the newest ANCESTOR that independently carries
   473	    # evidence, walking past sha itself; with none, the root. A migration that
   474	    # nothing has ever reviewed cannot be waved through by attesting the commit
   475	    # after it.
   476	    # origin_commit is kept in reports for provenance, but the baseline is
   477	    # ALWAYS the validated walk: the origin shortcut trusted a rebound report's
   478	    # word for where its coverage began, which is exactly the trust the
   479	    # planted-report attack abused. The walk finds the same origin commit when
   480	    # its report is honest, and walks past it when it is not.
   481	    prior, prior_validated, pending_human = _validated_baseline(root, sha)
   482	    if prior is None:
   483	        return sorted(set(paths)), True, None
   484	    if prior == sha:
   485	        # Only reachable for a single-commit repo (sha IS its own root): there
   486	        # is nothing to diff against, so list its own files.
   487	        out = _git_paths(["show", "--name-only", "--pretty=format:", sha], root)
   488	    else:
   489	        # A PLAIN two-dot diff, no caret. `prior` is a commit whose own state
   490	        # was already reviewed — either it carries a real evidence report (and
   491	        # attest now enforces the floor at record time, so that report already
   492	        # reflects tier >= floor(baseline..prior)), or it's the root, which
   493	        # needs no separate review since nothing precedes it. Because of that,
   494	        # `prior..sha` correctly EXCLUDES `prior`'s own introduction: adding
   495	        # `prior`'s files back in (the previous version of this code did, via
   496	        # a `^`) double-counted content that had already been accounted for,
