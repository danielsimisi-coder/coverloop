  1607	    transcript_valid = verify_capture(root, entry, commit, name) if claims_transcript else False
  1608	    if claims_transcript and not transcript_valid:
  1609	        return check(name, False,
  1610	                     f"{name}: claims {entry.get('source')!r} but the transcript is invalid "
  1611	                     f"(missing / tampered / wrong commit / failed or inconsistent run) — "
  1612	                     f"evidence rejected (re-run attest --{name}-run or --{name}-log)")
  1613	    ok = entry.get("status") == "pass" and entry.get("findings_open") == 0
