   987	    os.makedirs(os.path.dirname(log_path), exist_ok=True)
   988	    print(f"capturing {name} reviewer: {cmd}")
   989	    try:
   990	        # shell=True: same trust model as the test command — an operator-typed
   991	        # reviewer invocation (e.g. 'codex exec ...'), printed before it runs.
   992	        # text=False: capture raw bytes so non-UTF-8 reviewer output (colored
   993	        # diffs, binary error dumps) can't crash us; decode defensively below.
