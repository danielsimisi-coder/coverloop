  1780	def _project_signers_file(root, ref, tmpdir):
  1781	    """Materialize .coverloop/allowed_signers AS COMMITTED at <ref> into a temp
  1782	    file, IGNORING the working tree — a dirty/untracked policy file must never
  1783	    self-authorize (Sol+M3+GLM R4 P1), and reading the committed blob also closes
  1784	    the check-then-read TOCTOU/symlink window (no working-tree path is handed to
  1785	    git). Returns the temp path, or None if that tree has no such file.
  1786	
  1787	    <ref> is HEAD by default (the bootstrapping caveat: a commit can introduce
  1788	    its OWN signer file, so a change to the policy is itself gated evidence —
  1789	    review it like any code change). Pass a PROTECTED ref (`--signers-ref
  1790	    origin/main`) that a PR can't rewrite to remove even the bootstrap gap (R5)."""
  1791	    # Resolve FIRST: `git show` takes options positionally, so an option-shaped
  1792	    # --signers-ref (e.g. --format=...) was interpreted as formatting and could
  1793	    # materialise attacker-chosen commit text AS THE ALLOWED-SIGNERS POLICY.
  1794	    # Same class as the --base injection; the same fix applies.
  1795	    resolved = _resolve_commit(ref, root)
  1796	    if resolved is None:
  1797	        return None
  1798	    content = git(["show", "--end-of-options", f"{resolved}:.coverloop/allowed_signers"],
  1799	                  cwd=root)
  1800	    if content is None:
  1801	        return None
  1802	    p = os.path.join(tmpdir, "allowed_signers")
  1803	    with open(p, "w", encoding="utf-8") as fh:
  1804	        fh.write(content + "\n")
  1805	    return p
