  1808	def _is_ssh_signed(root, sha):
  1809	    """True iff <sha>'s signature is an SSH signature (vs GPG). The project
  1810	    signer policy is an ssh allowed_signers file, which git only consults for SSH
  1811	    signatures — a GPG-signed commit would be validated against the ambient GPG
  1812	    keyring and bypass the policy entirely (GLM R4 P2-2).
  1813	
  1814	    We inspect ONLY the `gpgsig` header, NOT the whole object: a commit's MESSAGE
  1815	    is attacker-controlled, so a GPG-signed commit whose message merely contains
  1816	    the text 'BEGIN SSH SIGNATURE' must not be mistaken for ssh-signed (Sol R4 —
  1817	    a spoof of the substring check). Commit headers end at the first blank line;
  1818	    the signature is the `gpgsig` header (its base64 continues on space-indented
  1819	    lines), so we read only up to that blank line and only the gpgsig header."""
  1820	    obj = git(["cat-file", "commit", sha], cwd=root)
  1821	    if not obj:
  1822	        return False
  1823	    header = obj.partition("\n\n")[0]  # headers only — drop the message
  1824	    for line in header.split("\n"):
  1825	        if line.startswith("gpgsig "):
  1826	            return "SSH SIGNATURE" in line  # 'gpgsig -----BEGIN SSH SIGNATURE-----'
  1827	    return False
