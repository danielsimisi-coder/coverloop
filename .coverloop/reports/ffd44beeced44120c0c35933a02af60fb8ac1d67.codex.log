  2629	def main(argv=None):
  2630	    # Windows defaults stdout/stderr to cp1252, which can't encode the gate's
  2631	    # ✔/✘/…/— glyphs — the gate would crash with UnicodeEncodeError on every
  2632	    # verdict print. Force UTF-8 (best-effort; a no-op on POSIX where it already
  2633	    # is) so output is portable across platforms.
  2634	    for _s in (sys.stdout, sys.stderr):
  2635	        try:
  2635	        try:
  2636	            _s.reconfigure(encoding="utf-8", errors="replace")
  2637	        except (AttributeError, ValueError):
  2638	            pass
  2639	    p = argparse.ArgumentParser(prog="coverloop", description=__doc__.splitlines()[0])
  2640	    sub = p.add_subparsers(dest="cmd", required=True)
  2641	
  2642	    pi = sub.add_parser("init", help="scaffold .coverloop/ in this repo")
  2643	    pi.add_argument("--test-command", help="command that must pass (default: npx tsc --noEmit)")
  2644	    pi.set_defaults(fn=cmd_init)
  2645	
  2646	    pd = sub.add_parser("doctor",
  2647	                        help="check the install and say exactly what to fix")
  2648	    pd.set_defaults(fn=cmd_doctor)
  2649	
  2650	    pc = sub.add_parser("classify",
  2651	                        help="derive the deterministic tier FLOOR from the changed paths")
  2652	    pc.add_argument("--base", metavar="REF",
  2653	                    help="classify REF...HEAD instead of the working tree (e.g. origin/main)")
  2654	    pc.add_argument("--human-gate", action="store_true",
  2655	                    help="print required|not-required instead of the tier — whether a NAMED "
  2656	                         "human approval is needed under --human-gate-scope irreversible")
  2657	    pc.add_argument("--quiet", "-q", action="store_true",
  2658	                    help="print only the tier, for piping into gate --min-tier")
  2659	    pc.add_argument("paths", nargs="*",
  2660	                    help="classify these paths instead of reading git")
  2661	    pc.set_defaults(fn=cmd_classify)
  2662	
  2663	    pa = sub.add_parser("attest", help="record evidence for the HEAD commit")
  2664	    pa.add_argument("--tier", choices=TIERS,
  2665	                    help="LEGACY floor pin. The tier is now DERIVED from the changed paths with the "
  2666	                         "gate's own floor semantics; omit this. Kept for compatibility: below the "
