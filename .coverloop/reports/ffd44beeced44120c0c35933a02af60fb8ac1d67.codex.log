   613	def git(args, cwd=None):
   614	    """Run a git command; return stdout or None on failure."""
   615	    try:
   616	        out = subprocess.run(
   617	            ["git"] + args, cwd=cwd, capture_output=True, text=True, timeout=30,
   618	            # Strict UTF-8 made a non-decodable FILENAME raise, which the gate
   619	            # caught and softened to an L1 floor — an L3 change passing on tests
   620	            # alone because someone's file was latin-1. surrogateescape keeps the
   621	            # bytes intact and round-trippable, so the path is classified rather
   622	            # than lost.
   623	            errors="surrogateescape",
   624	        )
   625	    except (OSError, subprocess.TimeoutExpired):
   626	        return None
   627	    if out.returncode != 0:
   628	        return None
   629	    # NUL-delimited output is a list of RAW pathnames: a leading or trailing
   630	    # space is part of a filename, not formatting. Stripping it re-created the
   631	    # exemption bypass one layer below classify_paths(), where the tests could
   632	    # not see it — " .coverloop/reports/<sha>.json" became the exact exempt
   633	    # shape again. Only line-oriented output gets the convenience strip.
   634	    if "-z" in args:
   635	        return out.stdout
   636	    return out.stdout.strip()
