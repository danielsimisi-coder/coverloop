  1583	    # laundered rejection artifact, not a review — reject it for BOTH sources
  1584	    # even when the hash matches. capture_run writes this line only on a nonzero
  1585	    # exit, so a genuine passing capture is never the placeholder; this closes
  1586	    # the forge where a FAILED capture's exit_code is hand-edited 1->0 (exit_code
  1587	    # is not covered by output_sha256, so no re-hash is needed) plus an attached
  1588	    # copy of the placeholder. Matching the WHOLE line (not a substring) means a
  1589	    # real review that merely quotes the marker still passes. (full audit +
  1590	    # Sol verify 2026-07-11 P1)
  1591	    if WITHHELD_RE.match(data.decode("utf-8", errors="replace").strip()):
  1592	        return False
  1593	    return hashlib.sha256(data).hexdigest() == digest
