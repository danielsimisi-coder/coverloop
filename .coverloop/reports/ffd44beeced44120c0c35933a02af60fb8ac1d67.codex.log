  2301	def reviewer_policy(root):
  2302	    """Load WHO reviews and WHAT COMMAND runs them, from a trusted source.
  2303	
  2304	    The independence of the review is the whole product. If the commands lived
  2305	    in the repository, a diff could replace its own reviewer with a stub that
  2306	    prints the canonical pass marker, and `check` would dutifully run it — the
  2307	    change under review would be signing its own evidence. So the policy is
  2308	    read from the operator's own machine, never from the worktree, and it is
  2309	    refused if it is reachable from inside the repo (a symlink or a path under
  2310	    the root) or if anyone but the owner can write it.
  2311	
  2312	    Returns (policy, None) or (None, reason).
  2313	    """
  2314	    path = _reviewer_policy_path()
  2315	    real = os.path.realpath(path)
  2316	    root_real = os.path.realpath(root)
  2317	    if real == root_real or real.startswith(root_real + os.sep):
  2318	        return None, (f"reviewer policy {path} resolves inside the repository under review "
  2319	                      f"({real}) — the reviewer must not be nominated by the change")
  2320	    try:
  2321	        st = os.lstat(real)
  2322	    except OSError:
  2323	        return None, (f"no reviewer policy at {path}. Create it (outside any repo) as:\n"
  2324	                      '  {"reviewers": {"primary": "codex", "secondary": "glm"},\n'
  2325	                      '   "reviewer_commands": {"codex": "<cold review cmd>", '
  2326	                      '"glm": "<red-team cmd>"}}\n'
  2327	                      "  Each command must make its reviewer end with the line "
  2328	                      "'VERDICT: PASS' or 'VERDICT: FAIL'.")
  2329	    if not stat.S_ISREG(st.st_mode):
  2330	        return None, f"reviewer policy {path} is not a regular file"
  2331	    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
  2332	        return None, (f"reviewer policy {path} is group/world-writable "
  2333	                      f"({oct(st.st_mode & 0o777)}) — anyone could swap the reviewer; "
  2334	                      f"run: chmod 600 {path}")
  2335	    data, err = load_json(real)
  2336	    if err:
  2337	        return None, f"reviewer policy {path}: {err}"
  2338	    data = data or {}
  2339	    roles = data.get("reviewers") or {}
  2340	    primary = roles.get("primary", "codex")
  2341	    secondary = roles.get("secondary", "glm")
  2342	    if (primary not in ("codex", "glm") or secondary not in ("codex", "glm")
  2343	            or primary == secondary):
  2344	        return None, (f"reviewer policy {path}: reviewers must name two distinct roles from "
  2345	                      "{codex, glm} (report keys are fixed for compatibility)")
  2346	    cmds = data.get("reviewer_commands") or {}
  2347	    if not isinstance(cmds, dict) or any(not isinstance(v, str) for v in cmds.values()):
  2348	        return None, f"reviewer policy {path}: reviewer_commands must map a role to a command string"
  2349	    # Naming the reviewer outside the repo is not enough if the command it
  2350	    # names lives INSIDE it: the change could then edit its own reviewer to
  2351	    # print the pass marker. Refuse any token of the command that resolves to
  2352	    # a path under the repo root. Heuristic on purpose — it is a word-split,
  2353	    # not a shell parser — but it fails CLOSED and catches the whole class
  2354	    # ("./bin/review.sh", "scripts/review.sh", an absolute path into the tree).
  2355	    for role, cmd in cmds.items():
  2356	        for tok in cmd.replace("|", " ").replace(";", " ").split():
  2357	            tok = tok.strip("\"'")
  2358	            if not tok or tok.startswith("-") or tok in (".", ".."):
  2359	                continue
  2360	            cand = os.path.realpath(os.path.join(root_real, tok)) if not os.path.isabs(tok) \
  2361	                else os.path.realpath(tok)
  2362	            if not (cand.startswith(root_real + os.sep) and os.path.isfile(cand)):
  2363	                continue
  2364	            # A file inside the repo is only a hazard if it can RUN: an
  2365	            # executable, or a script some interpreter will be handed. A
  2366	            # pathspec ("git diff -- .") or a data file argument is not, and
  2367	            # refusing those made the tool refuse its own reviewer command.
  2368	            runnable = os.access(cand, os.X_OK) or os.path.splitext(cand)[1] in (
  2369	                ".sh", ".bash", ".py", ".rb", ".pl", ".js", ".mjs", ".ts")
  2370	            if runnable:
  2371	                return None, (f"reviewer policy {path}: the {role} command runs {tok!r}, which "
  2372	                              f"lives inside the repository under review — the change could "
  2373	                              f"rewrite its own reviewer. Point it at a command outside the repo.")
  2374	    return {"path": path, "primary": primary, "secondary": secondary, "commands": cmds}, None
  2375	
