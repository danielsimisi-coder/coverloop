  2605	def _emit(args, sha, tier, verdict, checks):
  2606	    # CI annotations go to STDERR so they also work alongside --json
  2607	    # (stdout stays pure JSON for tooling; GitHub reads both streams).
  2608	    if args.ci:
  2609	        for c in checks:
  2610	            if c["status"] != "pass":
  2611	                print(f"::error title=coverloop gate::{c['check']}: {c['detail']}",
  2612	                      file=sys.stderr)
  2613	    if args.json:
  2614	        print(json.dumps(
  2615	            {"schema": "coverloop-gate/v1", "commit": sha, "tier": tier,
  2616	             "verdict": "pass" if verdict else "fail", "checks": checks},
  2617	            indent=2,
  2618	        ))
  2619	        return
  2620	    print(f"coverloop gate — commit {sha[:12]} — tier {tier}")
  2621	    for c in checks:
  2622	        mark = "✔" if c["status"] == "pass" else "✘"
  2623	        print(f"  {mark} {c['check']:<11} {c['detail']}")
  2624	    print(f"VERDICT: {'PASS' if verdict else 'FAIL — required evidence missing or failing'}")
