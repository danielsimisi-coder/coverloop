  2377	def _stop(reason):
  2378	    """The single STOP line. stdout is flushed first so the reason is the last
  2379	    thing on the terminal even though it goes to stderr."""
  2380	    sys.stdout.flush()
  2381	    print(f"STOP: {reason}", file=sys.stderr)
  2382	    sys.exit(1)
