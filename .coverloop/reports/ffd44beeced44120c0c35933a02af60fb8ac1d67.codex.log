  1563	    digest = entry.get("output_sha256") or ""
  1564	    expected = os.path.join(REPORTS_DIR, f"{commit}.{name}.log")
  1565	    if not digest or rel != expected:
  1566	        return False
  1567	    path = os.path.join(root, rel)
  1568	    # The ENTIRE reports path must be real: no symlinked `.coverloop` or
  1569	    # `reports/` ancestor (which would relocate the trusted root off-tree) and
  1570	    # the log itself must not be a symlink. Only then can the transcript be
  1571	    # trusted to live in the repo's committed evidence tree.
  1572	    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
  1573	    if os.path.realpath(reports_real) != reports_real:
  1574	        return False  # `.coverloop` or `.coverloop/reports` is a symlink
  1575	    if os.path.islink(path) or os.path.dirname(os.path.realpath(path)) != reports_real:
  1576	        return False
  1577	    try:
  1578	        with open(path, "rb") as f:
  1579	            data = f.read()
  1580	    except OSError:
  1581	        return False
