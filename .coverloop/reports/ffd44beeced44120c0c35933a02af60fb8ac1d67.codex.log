  2294	def _reviewer_policy_path():
  2295	    """Where the operator's trusted reviewer policy lives. Deliberately OUTSIDE
  2296	    any repository: see reviewer_policy()."""
  2297	    return os.environ.get("COVERLOOP_REVIEWERS") or os.path.join(
  2298	        os.path.expanduser("~"), ".config", "coverloop", "reviewers.json")
