  1534	    if src not in ("captured", "attached"):
  1535	        return False
  1536	    # A CAPTURED reviewer command must have SUCCEEDED. A nonzero exit means it
  1537	    # failed (expired auth, missing binary, a hang) and the transcript is an
  1538	    # error log, not a review — accepting it would let a failed run pass
  1539	    # --require-captured. Attached transcripts carry no exit code (the tool
  1540	    # executed nothing); their trust rests on the committed, hash-bound,
  1541	    # human-readable log alone.
  1542	    if src == "captured":
  1543	        # A genuine captured entry carries capture_run's execution fields;
  1544	        # requiring them rejects the NAIVE relabel (an attached entry flipped to
  1545	        # source:"captured" that forgets to add them). HONEST LIMIT (full audit
  1546	        # 2026-07-11): command/exit_code/ran_at are unauthenticated attester
  1547	        # JSON and the log bytes+hash are attester-authored, so a committer who
  1548	        # adds all three defeats this — no on-disk field can PROVE coverloop
  1549	        # executed the reviewer. --require-executed is therefore a best-effort
  1550	        # policy filter (rejects honestly-attached evidence), NOT proof of
  1551	        # execution; the honest ceiling is documented in docs/GATE.md.
  1552	        if not all(k in entry for k in ("command", "exit_code", "ran_at")):
  1553	            return False
  1554	        if entry.get("exit_code") != 0:
  1555	            return False
  1556	    # An ATTACHED entry never records execution fields; any leftover
  1557	    # exit_code/command/ran_at means a captured (possibly FAILED) entry was
  1558	    # hand-reclassified as "attached" to dodge the exit-code check — reject
  1559	    # the inconsistency.
  1560	    if src == "attached" and any(k in entry for k in ("exit_code", "command", "ran_at")):
  1561	        return False
