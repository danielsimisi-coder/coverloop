  1014	        "command": redact_secrets(cmd),  # the invocation string is committed too
  1015	        "exit_code": proc.returncode,
  1016	        "output_file": log_rel,
  1017	        "output_sha256": hashlib.sha256(output.encode("utf-8")).hexdigest(),
  1018	        "output_lines": output.count("\n"),
  1019	        "ran_at": now_utc(),
  1020	    }
