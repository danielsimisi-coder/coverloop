  2334	    def test_reviewers_run_outside_the_worktree(self):
  2335	        # `python3 -m reviewer` or `sh <scripts/reviewer` would resolve a
  2336	        # planted file if the reviewer ran with the repo as its cwd. It does
  2337	        # not: the repo and the diff arrive as COVERLOOP_REPO / COVERLOOP_DIFF.
  2338	        probe = os.path.join(self.policy_dir, "probe.sh")
  2339	        open(probe, "w").write(
  2340	            '#!/bin/sh\n'
  2341	            'test "$(pwd -P)" = "$(cd "$COVERLOOP_REPO" && pwd -P)" && exit 3\n'
  2342	            'test -s "$COVERLOOP_DIFF" || exit 4\n'
  2343	            'echo reviewed\necho "VERDICT: PASS"\n')
  2344	        os.chmod(probe, 0o755)
  2345	        with tempfile.TemporaryDirectory() as d:
  2346	            run = self._repo(d)
  2347	            self._policy(cmds={"codex": probe, "glm": probe})
  2348	            self._write(d, "supabase/migrations/1.sql", "alter table u;\n")
