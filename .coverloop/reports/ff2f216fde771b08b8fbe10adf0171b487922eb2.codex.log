  1764	def _project_signers_file(root, ref, tmpdir):
  1765	    """Materialize .coverloop/allowed_signers AS COMMITTED at <ref> into a temp
  1766	    file, IGNORING the working tree — a dirty/untracked policy file must never
  1767	    self-authorize (Sol+M3+GLM R4 P1), and reading the committed blob also closes
  1768	    the check-then-read TOCTOU/symlink window (no working-tree path is handed to
  1769	    git). Returns the temp path, or None if that tree has no such file.
  1770	
  1771	    <ref> is HEAD by default (the bootstrapping caveat: a commit can introduce
  1772	    its OWN signer file, so a change to the policy is itself gated evidence —
  1773	    review it like any code change). Pass a PROTECTED ref (`--signers-ref
  1774	    origin/main`) that a PR can't rewrite to remove even the bootstrap gap (R5)."""
  1775	    # Resolve FIRST: `git show` takes options positionally, so an option-shaped
  1776	    # --signers-ref (e.g. --format=...) was interpreted as formatting and could
  1777	    # materialise attacker-chosen commit text AS THE ALLOWED-SIGNERS POLICY.
  1778	    # Same class as the --base injection; the same fix applies.
  1779	    resolved = _resolve_commit(ref, root)
  1780	    if resolved is None:
  1781	        return None
  1782	    content = git(["show", "--end-of-options", f"{resolved}:.coverloop/allowed_signers"],
  1783	                  cwd=root)
  1784	    if content is None:
  1785	        return None
  1786	    p = os.path.join(tmpdir, "allowed_signers")
  1787	    with open(p, "w", encoding="utf-8") as fh:
  1788	        fh.write(content + "\n")
  1789	    return p
