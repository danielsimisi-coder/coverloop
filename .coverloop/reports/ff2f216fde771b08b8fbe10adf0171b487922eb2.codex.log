   968	def capture_run(root, sha, name, cmd, cwd=None, env=None):
   969	    """Run a reviewer command, save its combined output to
   970	    .coverloop/reports/<sha>.<name>.log, and return provenance (command, exit
   971	    code, output path, sha256, line count, timestamp).
   972	
   973	    This turns a bare `--codex pass` claim into evidence backed by the actual
   974	    reviewer transcript, committed alongside the report and hashed so tampering
   975	    with the log invalidates the recorded digest. It does NOT auto-derive the
   976	    verdict — reviewer output is prose, and inferring pass/fail from it
   977	    reliably is not possible — so the caller still states pass/fail, but now
   978	    against a captured, inspectable artifact rather than thin air.
   979	    """
   980	    log_rel = os.path.join(REPORTS_DIR, f"{sha}.{name}.log")
   981	    log_path = os.path.join(root, log_rel)
   982	    os.makedirs(os.path.dirname(log_path), exist_ok=True)
   983	    print(f"capturing {name} reviewer: {cmd}")
   984	    try:
   985	        # shell=True: same trust model as the test command — an operator-typed
   986	        # reviewer invocation (e.g. 'codex exec ...'), printed before it runs.
   987	        # text=False: capture raw bytes so non-UTF-8 reviewer output (colored
   988	        # diffs, binary error dumps) can't crash us; decode defensively below.
   989	        # `cwd` defaults to the repo (attest --codex-run keeps that contract),
   990	        # but `check` passes a directory OUTSIDE the worktree: with shell=True
   991	        # a repo-relative resolution — `python3 -m reviewer` picking up a
   992	        # planted reviewer.py, `sh <scripts/reviewer` — would otherwise let the
   993	        # change under review supply its own reviewer. The repo and a
   994	        # pre-computed diff reach the command through COVERLOOP_REPO /
   995	        # COVERLOOP_DIFF instead.
   996	        proc = subprocess.run(cmd, shell=True, cwd=cwd or root, env=env,
   997	                              capture_output=True, timeout=1800)
   998	    except (OSError, subprocess.TimeoutExpired) as e:
   999	        fail_usage(f"could not run {name} reviewer command: {e}")
  1000	    output = ((proc.stdout or b"") + (proc.stderr or b"")).decode("utf-8", errors="replace")
  1001	    if proc.returncode != 0:
  1002	        # A failed run's output is untrusted error text (env dumps, stack state
  1003	        # that routinely carries tokens). It is also NOT valid evidence (the gate
  1004	        # rejects exit!=0), so we WITHHOLD the dump rather than commit a secret-
  1005	        # bearing error log to git.
  1006	        output = f"[{name} reviewer command exited {proc.returncode}; {WITHHELD_MARKER}\n"
