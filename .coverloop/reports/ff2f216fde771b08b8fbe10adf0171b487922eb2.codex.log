  2230	# The words real reviewers actually end on. Sampled from the fleet's captured
  2231	# transcripts: Codex ends "VERDICT: PASS", GLM's red-team scale is
  2232	# "Verdict: PASS / PASS WITH RISKS / REQUEST CHANGES / BLOCK", and some runs
  2233	# emit lowercase "verdict: fail" or a GitHub-style "APPROVE". A parser that
  2234	# only knew uppercase "VERDICT: PASS" scored every one of those a fail —
  2235	# fail-closed, but useless: it would have made `check` unusable with the very
  2236	# reviewers this repo ships. Unknown wording still fails.
  2237	# The reviewer's verdict is a MACHINE PROTOCOL, not prose to be interpreted.
  2238	# Exactly one canonical marker line counts:
  2239	#
  2240	#     VERDICT: PASS        (or)        VERDICT: FAIL
  2241	#
  2242	# The reviewer PROMPT tells the reviewer to end with it; the gate does not try
  2243	# to infer approval from natural language. "PASS WITH RISKS", "APPROVE",
  2244	# "LGTM", "SHIP" and every other human phrasing are NOT a pass — inferring one
  2245	# would let a hedged review land as `pass` with zero open findings. Missing,
  2246	# malformed, truncated, ambiguous or non-canonical: FAIL CLOSED.
  2247	# Case-INSENSITIVE on purpose: a lowercase "verdict: fail" is still a verdict,
  2248	# and it must be seen so it can be rejected as non-canonical rather than skipped.
  2249	_VERDICT_MARKER = re.compile(r"^[ \t]*VERDICT:.*$", re.M | re.I)
  2250	# The only thing allowed to follow the closing marker: a CLI's own footer.
  2251	# Codex prints "tokens used" and a number. Anything sentence-like after the
  2252	# verdict means the reviewer kept talking, and the marker was not its last word.
  2253	_VERDICT_FOOTER = re.compile(
  2254	    r"^(tokens?[ _]used\s*:?\s*[\d,.]*\s*[kmb]?|[\d,.]+|[-=_*]{3,})$", re.I)
  2255	_VERDICT_CANONICAL_PASS = "VERDICT: PASS"
  2256	_VERDICT_CANONICAL_FAIL = "VERDICT: FAIL"
