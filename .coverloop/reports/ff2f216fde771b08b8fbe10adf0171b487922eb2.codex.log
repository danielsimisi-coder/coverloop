    19	# VALUE patterns — actual secret SHAPES. Used by BOTH scan() (detect) and
    20	# redact() (replace). Each is (label, compiled-regex, guard): GUARD is an
    21	# optional cheap substring that MUST be present for the regex to have any chance
    22	# of matching; when set, scan()/redact() skip the regex entirely if the guard is
    23	# absent (an O(1)-per-call `in` check instead of running the engine). This is a
    24	# ReDoS floor: for the private-key pattern, thousands of `-----BEGIN` markers
    25	# with NO `-----END` made the engine do a bounded forward scan PER marker
    26	# (~O(markers x bound)); the guard makes a no-END input skip the pattern
    27	# outright (R3 fuzz test caught 2.9s on 0.6 MB of bare BEGIN markers).
    28	# Boundaries keep ordinary kebab tokens (risk-based, task-start) off the sk- rule.
    29	VALUE_PATTERNS = [
    30	    ("sk-key",       re.compile(r"(?<![A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}"), "sk-"),
    31	    ("github-token", re.compile(r"(?<![A-Za-z0-9])(?:ghp|gho|ghs|ghu|ghr|github_pat)_[A-Za-z0-9_]{20,}"), "gh"),
    32	    ("aws-key",      re.compile(r"(?<![A-Za-z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}(?![0-9A-Z])"), None),
    33	    ("slack-token",  re.compile(r"(?<![A-Za-z0-9])xox[baprs]-[A-Za-z0-9-]{10,}"), "xox"),
    34	    ("google-key",   re.compile(r"(?<![A-Za-z0-9])AIza[0-9A-Za-z_-]{35}(?![0-9A-Za-z_-])"), "AIza"),
    35	    ("jwt",          re.compile(r"(?<![A-Za-z0-9])eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{6,}"), "eyJ"),
    36	    ("bearer",       re.compile(r"(?i)\bbearer\s+[A-Za-z0-9._~+/=-]{16,}"), None),
    37	    ("db-url-cred",  re.compile(r"(?i)\b(?:postgres|postgresql|mysql|mongodb)(?:\+[a-z]+)?://[^\s:/@]+:[^\s@]+@"), "://"),
