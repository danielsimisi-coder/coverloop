   162	# (Sol r13: `access_token: [REDACTED:secret-value] `refreshToken: [REDACTED:secret-value] so scan()
   163	# accepts a broader FALSE-NEGATIVE here in exchange for the operator's PRIMARY requirement (no FP on
   164	# real auth code). Still caught by scan(): MULTIWORD values (passphrases), NON-identifier tokens
   165	# (+/@#!%^&*-/), QUOTED opaque literals >=8, `=` assignments, YAML block/fold scalars, and every
   166	# KNOWN secret SHAPE (VALUE_PATTERNS). Critically, redact() is UNCHANGED and STILL STRIPS this value
   167	# (ASSIGN_RE redaction is shape-independent) — the DATA PROTECTION holds even where the egress
   168	# TRIPWIRE is permissive. There is NO env/flag escape hatch.
   169	_REDACTED_MARKER_RE = re.compile(r"^\[REDACTED:[a-z-]+\]$")
   170	_BOOL_NULL_RE = re.compile(r"(?i)^(?:true|false|null|none|nil|undefined)$")
   171	_YAML_BLOCK_RE = re.compile(r"^[|>][0-9+-]*$")  # YAML block scalar indicator |, >, |2, >+ ...
   172	_BAREWORD_RE = re.compile(r"[A-Za-z0-9_+/@#$%^&*!-]{16,}")
   173	_IDENT_RE = re.compile(r"[A-Za-z_$][A-Za-z0-9_$]*$")           # pure code identifier (key/call name)
   174	_CALL_OR_KEY_RE = re.compile(r"[ \t]*(?:\?\.)?\(|[ \t]*:")     # bareword followed by a call or a key ':'
   175	_MIN_OPAQUE_LEN = 8
   176	_MAX_FOLD_LINES = 64
   177	_MAPPING_KEY_RE = re.compile(r"([^:]+):(?:\s|$)")
