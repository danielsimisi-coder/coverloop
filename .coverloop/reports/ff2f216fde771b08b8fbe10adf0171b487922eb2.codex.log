    10	# Literal substrings that flag "this text likely references a secret" — used by
    11	# scan() as a heuristic egress tripwire. NOT redacted (they are variable names,
    12	# not values; redacting them would corrupt legitimate review prose).
    13	LITERAL_PATTERNS = [
    14	    "OPENROUTER_API_KEY", "ANTHROPIC_API_KEY", "OPENAI_API_KEY",
    15	    "SUPABASE_SERVICE_ROLE", "service_role", "DATABASE_URL", "VERCEL_TOKEN",
    16	    "PRIVATE KEY",
    17	]
