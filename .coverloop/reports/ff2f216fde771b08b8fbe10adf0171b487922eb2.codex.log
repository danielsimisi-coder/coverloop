  2411	    if history is None:
  2412	        return None, False
  2413	    versions = history.split()
  2414	    if len(versions) < 2:
  2415	        return None, True                      # created, never changed
  2416	
  2417	    def _at(commit):
  2418	        blob = git(["show", f"{commit}:{CONFIG_FILE}"], cwd=root)
  2419	        if blob is None:
  2420	            return None, False
  2421	        try:
