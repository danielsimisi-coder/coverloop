  2433	def _reviewer_binary_fingerprints(cmds, env):
  2434	    """sha256 of each reviewer command's resolved executable, before anything
  2435	    else runs.
  2436	
  2437	    The configured test command is arbitrary code running with the operator's
  2438	    privileges, and it runs BEFORE the reviewers. Nothing stops it overwriting
  2439	    a user-owned reviewer wrapper with one that prints the pass marker — no
  2440	    repository file changes, so the dirty-tree check sees nothing. This does not
  2441	    make the test command safe (it cannot: `coverloop` is a gate, not a
  2442	    sandbox), but it does catch the specific swap.
  2443	    """
  2444	    prints = {}
  2445	    for role, cmd in (cmds or {}).items():
  2446	        for tok in cmd.replace("|", " ").replace(";", " ").split():
  2447	            tok = tok.strip("\"'")
  2448	            if not tok or tok.startswith("-") or "=" in tok:
  2449	                continue
  2450	            exe = shutil.which(tok, path=env.get("PATH")) if not os.path.sep in tok else (
  2451	                tok if os.path.exists(tok) else None)
  2452	            if exe:
  2453	                try:
  2454	                    with open(exe, "rb") as fh:
  2455	                        prints[role] = (exe, hashlib.sha256(fh.read()).hexdigest())
  2456	                except OSError:
  2457	                    prints[role] = (exe, None)
  2458	            break                       # the command word only
  2459	    return prints
