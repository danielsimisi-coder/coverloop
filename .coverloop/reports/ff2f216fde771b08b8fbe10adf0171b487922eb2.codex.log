  2258	
  2259	def transcript_verdict(text, tail_lines=10):
  2260	    """Return "pass" only for an unambiguous canonical PASS marker at the end.
  2261	
  2262	    Three conditions, all fail-closed:
  2263	      * at least one `VERDICT:` line exists;
  2264	      * EVERY such line is byte-for-byte "VERDICT: PASS" after trimming — no
  2265	        "PASS WITH RISKS", no lowercase, no "APPROVE";
  2266	      * the last one is among the final `tail_lines` non-empty lines, so it is
  2267	        the reviewer's closing word rather than something near the top.
  2268	
  2269	    The whole transcript is read, not a tail window: a review that says FAIL and
  2270	    then emits 5 KB of appendix would otherwise have its failure scroll out of
  2271	    view. The closing-position rule is the other half of the same idea — a
  2272	    prompt echo containing the marker, followed by a review that never reaches a
  2273	    verdict, must not count as approval. The small allowance exists because real
  2274	    reviewers append a footer (Codex prints "tokens used" and a count after its
  2275	    reply); it is not room for review content.
  2276	    """
  2277	    lines = (text or "").splitlines()
  2278	    live = [(i, ln.strip()) for i, ln in enumerate(lines) if ln.strip()]
  2279	    markers = [(n, body) for n, (i, body) in enumerate(live) if _VERDICT_MARKER.match(lines[i])]
  2280	    if not markers:
  2281	        return "fail"
  2282	    if len(markers) != 1 or markers[0][1] != _VERDICT_CANONICAL_PASS:
  2283	        # Exactly one, as documented. Several markers mean either a reviewer
  2284	        # that restated itself or prompt text that survived into the log, and
  2285	        # neither is a verdict this should resolve in the change's favour.
  2286	        return "fail"
  2287	    trailing = [body for _i, body in live[markers[-1][0] + 1:]]
  2288	    if len(trailing) > tail_lines or any(not _VERDICT_FOOTER.match(t) for t in trailing):
  2289	        return "fail"          # the reviewer kept talking; the marker was not its last word
  2290	    return "pass"
