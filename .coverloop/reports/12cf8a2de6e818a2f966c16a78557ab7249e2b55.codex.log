# How many first-parent ancestors to search for an evidence-only report.
EVIDENCE_WALK_LIMIT = 20


def only_evidence_changed(root, frm, to):
    """True iff the diff frm..to touches ONLY committed report ARTIFACTS
    (<sha>.json / <sha>.<reviewer>.log). A non-artifact file under reports/
    (e.g. reports/backdoor.py) counts as a real code change and returns False."""
    # _git_paths, not a line split: a lone " .coverloop/reports/<sha>.json"
    # was stripped into the exact artifact shape, so stale ancestor evidence
    # was accepted as "nothing but evidence changed".
    files = _git_paths(["diff", "--name-only", f"{frm}..{to}"], root)
    if files is None:
        return False  # unresolvable range -> fail closed
    return bool(files) and all(is_report_artifact(f) for f in files)


def find_report(root, head):
    """Locate the report that governs HEAD.

    Returns (report, reason, malformed):
      * exact HEAD report when present;
      * else a report bound to a first-parent ancestor, accepted ONLY if the
        diff ancestor..HEAD touches nothing but evidence files (this is what
        makes "attest, commit the report, gate in CI" possible);
      * (None, why, True) when a report file exists but is corrupt, forged,
        or SHA-mismatched — malformed evidence fails EVERY tier;
      * (None, why, False) when no usable report exists.
    """
    path = report_path(root, head)
    if os.path.exists(path):
        report, why = load_report(root, head)
        if report is None:
            return None, why, True
        return report, None, False
    for i in range(1, EVIDENCE_WALK_LIMIT + 1):
        anc = git(["rev-parse", f"{head}~{i}"], cwd=root)
        if not anc:
            break
        if not os.path.exists(report_path(root, anc)):
            continue
        report, why = load_report(root, anc)
        if report is None:
            return None, why, True
        if only_evidence_changed(root, anc, head):
            return report, None, False
        return None, (f"evidence at {anc[:12]} is STALE: non-evidence files "
                      f"changed between it and HEAD — re-run the loop"), False
    return None, "no report found for HEAD or any evidence-only ancestor", False


