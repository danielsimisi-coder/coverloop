# A committed EVIDENCE ARTIFACT under .coverloop/reports/ — EXACT name shapes
# only: <40-hex commit sha>.json, or <sha>.<reviewer>.log. Anything else under
# reports/ (e.g. .coverloop/reports/backdoor.py) is a NORMAL code file: not
# "evidence-only", not test-waivable. This is what stops code being smuggled in
# under the reports/ prefix.
# `\Z`, not `$`: Python's `$` also matches BEFORE a final newline, so
# "<sha>.json\n" satisfied the artifact shape and took the exemption.
REPORT_ARTIFACT_RE = re.compile(
    r"^" + re.escape(REPORTS_DIR + "/")
    + r"[0-9a-f]{40}(?:\.json|\.(?:codex|glm)\.log)\Z")

# Documentation for the L1 test-gate waiver. Deliberately strict so a code file
# cannot masquerade as docs: an EXACT root-level doc file, or a doc-suffixed
# file UNDER docs/. Never a basename match elsewhere; never a bare .txt/.rst
# outside docs/ (a runtime-loaded config.txt or docs/deploy.sh is NOT a doc).
DOC_SUFFIXES = (".md", ".txt", ".rst")
DOC_ROOT = "docs/"
ROOT_DOC_FILES = ("LICENSE", "CHANGELOG", "CHANGELOG.md", "README.md")


def tier_max(*tiers):
    """Highest tier among the args (None/unknown-safe). TIERS is low->high.
    Used so a pinned --min-tier can only ever RAISE the requirement."""
    best = None
    for t in tiers:
        if t in TIERS and (best is None or TIERS.index(t) > TIERS.index(best)):
            best = t
    return best


def is_report_artifact(f):
    """True iff f is exactly a committed report JSON or reviewer transcript."""
    return bool(REPORT_ARTIFACT_RE.fullmatch(f))


def is_doc_file(f):
    """True iff f is documentation for the L1 waiver (never executable code)."""
    if f in ROOT_DOC_FILES:
        return True
    if f.startswith(DOC_ROOT) and f.endswith(DOC_SUFFIXES):
        return True
    return False


def fail_usage(msg):
    print(f"coverloop: error: {msg}", file=sys.stderr)
    sys.exit(2)


def git(args, cwd=None):
    """Run a git command; return stdout or None on failure."""
    try:
        out = subprocess.run(
            ["git"] + args, cwd=cwd, capture_output=True, text=True, timeout=30,
            # Strict UTF-8 made a non-decodable FILENAME raise, which the gate
            # caught and softened to an L1 floor — an L3 change passing on tests
            # alone because someone's file was latin-1. surrogateescape keeps the
            # bytes intact and round-trippable, so the path is classified rather
            # than lost.
            errors="surrogateescape",
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    # NUL-delimited output is a list of RAW pathnames: a leading or trailing
    # space is part of a filename, not formatting. Stripping it re-created the
    # exemption bypass one layer below classify_paths(), where the tests could
    # not see it — " .coverloop/reports/<sha>.json" became the exact exempt
    # shape again. Only line-oriented output gets the convenience strip.
    if "-z" in args:
        return out.stdout
    return out.stdout.strip()


def repo_root():
    root = git(["rev-parse", "--show-toplevel"])
    if not root:
        fail_usage("not inside a git repository")
    return root


def head_sha(root):
    sha = git(["rev-parse", "HEAD"], cwd=root)
    if not sha:
        fail_usage("cannot resolve HEAD (empty repository?)")
    return sha


def now_utc():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_json(path):
    """Return (data, error). Fail closed on unreadable/invalid JSON."""
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f), None
    except FileNotFoundError:
        return None, f"{path}: not found"
    except (json.JSONDecodeError, OSError) as e:
        return None, f"{path}: unreadable ({e})"


# ---------------------------------------------------------------- init

def cmd_init(args):
    root = repo_root()
    cfg_path = os.path.join(root, CONFIG_FILE)
    os.makedirs(os.path.join(root, REPORTS_DIR), exist_ok=True)
    if os.path.exists(cfg_path):
        print(f"skip {CONFIG_FILE} (exists)")
    else:
        # No base is stored here on purpose: the diff base for the L1 waiver
        # must come from the trusted caller (CI's --base), never from a file
        # that ships inside the PR under review.
        cfg = {
            "schema": "coverloop-config/v1",
            "test_command": args.test_command or "npx tsc --noEmit",
        }
        with open(cfg_path, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2)
            f.write("\n")
        print(f"+ {CONFIG_FILE}  (test_command: {cfg['test_command']!r} — edit for your stack)")
    gi_path = os.path.join(root, CONFIG_DIR, ".gitignore")
    gi_body = (
        "# Coverloop reports are evidence — commit them with the change.\n"
        "# The negations defeat repo-root ignore rules (e.g. `*.log`) that would\n"
        "# silently swallow the PR-visible transcripts (field report 2026-07-10).\n"
        "!reports/\n"
        "!reports/*.json\n"
        "!reports/*.codex.log\n"
        "!reports/*.glm.log\n"
    )
    if not os.path.exists(gi_path) or "!reports/" not in open(gi_path, encoding="utf-8").read():
        with open(gi_path, "w", encoding="utf-8") as f:
            f.write(gi_body)
        print(f"+ {CONFIG_DIR}/.gitignore  (negations keep evidence commit-able)")
    print(f"+ {REPORTS_DIR}/")
    print("Done. Record evidence with `coverloop attest`, verify with `coverloop gate`.")
    return 0


# ---------------------------------------------------------------- reports

def report_path(root, sha):
    return os.path.join(root, REPORTS_DIR, f"{sha}.json")


 succeeded in 233ms:
#     VERDICT: PASS        (or)        VERDICT: FAIL
#
# The reviewer PROMPT tells the reviewer to end with it; the gate does not try
# to infer approval from natural language. "PASS WITH RISKS", "APPROVE",
# "LGTM", "SHIP" and every other human phrasing are NOT a pass — inferring one
# would let a hedged review land as `pass` with zero open findings. Missing,
# malformed, truncated, ambiguous or non-canonical: FAIL CLOSED.
# Case-INSENSITIVE on purpose: a lowercase "verdict: fail" is still a verdict,
# and it must be seen so it can be rejected as non-canonical rather than skipped.
_VERDICT_MARKER = re.compile(r"^[ \t]*VERDICT:.*$", re.M | re.I)
# The only thing allowed to follow the closing marker: a CLI's own footer.
# Codex prints "tokens used" and a number. Anything sentence-like after the
# verdict means the reviewer kept talking, and the marker was not its last word.
_VERDICT_FOOTER = re.compile(
    r"^(tokens?[ _]used\s*:?\s*[\d,.]*\s*[kmb]?|[\d,.]+|[-=_*]{3,})$", re.I)
_VERDICT_CANONICAL_PASS = "VERDICT: PASS"
_VERDICT_CANONICAL_FAIL = "VERDICT: FAIL"


def transcript_verdict(text, tail_lines=10):
    """Return "pass" only for an unambiguous canonical PASS marker at the end.

    Three conditions, all fail-closed:
      * at least one `VERDICT:` line exists;
      * EVERY such line is byte-for-byte "VERDICT: PASS" after trimming — no
        "PASS WITH RISKS", no lowercase, no "APPROVE";
      * the last one is among the final `tail_lines` non-empty lines, so it is
        the reviewer's closing word rather than something near the top.

    The whole transcript is read, not a tail window: a review that says FAIL and
    then emits 5 KB of appendix would otherwise have its failure scroll out of
    view. The closing-position rule is the other half of the same idea — a
    prompt echo containing the marker, followed by a review that never reaches a
    verdict, must not count as approval. The small allowance exists because real
    reviewers append a footer (Codex prints "tokens used" and a count after its
    reply); it is not room for review content.
    """
    lines = (text or "").splitlines()
    live = [(i, ln.strip()) for i, ln in enumerate(lines) if ln.strip()]
    markers = [(n, body) for n, (i, body) in enumerate(live) if _VERDICT_MARKER.match(lines[i])]
    if not markers:
        return "fail"
    if any(body != _VERDICT_CANONICAL_PASS for _n, body in markers):
        return "fail"
    trailing = [body for _i, body in live[markers[-1][0] + 1:]]
    if len(trailing) > tail_lines or any(not _VERDICT_FOOTER.match(t) for t in trailing):
        return "fail"          # the reviewer kept talking; the marker was not its last word
    return "pass"


def _reviewer_policy_path():
    """Where the operator's trusted reviewer policy lives. Deliberately OUTSIDE
    any repository: see reviewer_policy()."""
    return os.environ.get("COVERLOOP_REVIEWERS") or os.path.join(
        os.path.expanduser("~"), ".config", "coverloop", "reviewers.json")


def reviewer_policy(root):
    """Load WHO reviews and WHAT COMMAND runs them, from a trusted source.

    The independence of the review is the whole product. If the commands lived
    in the repository, a diff could replace its own reviewer with a stub that
    prints the canonical pass marker, and `check` would dutifully run it — the
    change under review would be signing its own evidence. So the policy is
    read from the operator's own machine, never from the worktree, and it is
    refused if it is reachable from inside the repo (a symlink or a path under
    the root) or if anyone but the owner can write it.

    Returns (policy, None) or (None, reason).
    """
    path = _reviewer_policy_path()
    real = os.path.realpath(path)
    root_real = os.path.realpath(root)
    if real == root_real or real.startswith(root_real + os.sep):
        return None, (f"reviewer policy {path} resolves inside the repository under review "
                      f"({real}) — the reviewer must not be nominated by the change")
    try:
        st = os.lstat(real)
    except OSError:
        return None, (f"no reviewer policy at {path}. Create it (outside any repo) as:\n"
                      '  {"reviewers": {"primary": "codex", "secondary": "glm"},\n'
                      '   "reviewer_commands": {"codex": "<cold review cmd>", '
                      '"glm": "<red-team cmd>"}}\n'
                      "  Each command must make its reviewer end with the line "
                      "'VERDICT: PASS' or 'VERDICT: FAIL'.")
    if not stat.S_ISREG(st.st_mode):
        return None, f"reviewer policy {path} is not a regular file"
    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        return None, (f"reviewer policy {path} is group/world-writable "
                      f"({oct(st.st_mode & 0o777)}) — anyone could swap the reviewer; "
                      f"run: chmod 600 {path}")
    data, err = load_json(real)
    if err:
        return None, f"reviewer policy {path}: {err}"
    data = data or {}
    roles = data.get("reviewers") or {}
    primary = roles.get("primary", "codex")
    secondary = roles.get("secondary", "glm")
    if (primary not in ("codex", "glm") or secondary not in ("codex", "glm")
            or primary == secondary):
        return None, (f"reviewer policy {path}: reviewers must name two distinct roles from "
                      "{codex, glm} (report keys are fixed for compatibility)")
    cmds = data.get("reviewer_commands") or {}
    if not isinstance(cmds, dict) or any(not isinstance(v, str) for v in cmds.values()):
        return None, f"reviewer policy {path}: reviewer_commands must map a role to a command string"
    # Naming the reviewer outside the repo is not enough if the command it
    # names lives INSIDE it: the change could then edit its own reviewer to
    # print the pass marker. Refuse any token of the command that resolves to
    # a path under the repo root. Heuristic on purpose — it is a word-split,
    # not a shell parser — but it fails CLOSED and catches the whole class
    # ("./bin/review.sh", "scripts/review.sh", an absolute path into the tree).
    for role, cmd in cmds.items():
        for tok in cmd.replace("|", " ").replace(";", " ").split():
            tok = tok.strip("\"'")
            if not tok or tok.startswith("-") or tok in (".", ".."):
                continue
            cand = os.path.realpath(os.path.join(root_real, tok)) if not os.path.isabs(tok) \
                else os.path.realpath(tok)
            if not (cand.startswith(root_real + os.sep) and os.path.isfile(cand)):
                continue
            # ANY regular file in the tree, not just an executable one:
            # `sh scripts/reviewer` runs an extensionless, non-executable file
            # just as well, and the repository controls its contents either way.
            # Directories still pass, which is what keeps a pathspec
            # ("git diff -- .") from tripping this.
            return None, (f"reviewer policy {path}: the {role} command names {tok!r}, a file "
                          f"inside the repository under review — the change could rewrite its "
                          f"own reviewer. Point it at a command outside the repo.")
    return {"path": path, "primary": primary, "secondary": secondary, "commands": cmds}, None


def _stop(reason):
    """The single STOP line. stdout is flushed first so the reason is the last
    thing on the terminal even though it goes to stderr."""
    sys.stdout.flush()
    print(f"STOP: {reason}", file=sys.stderr)
    sys.exit(1)


def cmd_check(args):
    """The one-command boundary: derive the floor, run the tests, run the
    reviewers the tier requires, record it all bound to HEAD, then gate.

    Prints ONE line on success ("SAFE TO MERGE") and ONE concrete reason on
    failure ("STOP: ..."). Everything underneath is the existing primitives —
    classify, attest, gate — unchanged and still available for debugging; this
    only removes the eight-step ceremony the builder used to orchestrate by hand.

    Fail-closed at every step: the first thing that cannot be verified stops the
    run and is named. WHO reviews and WHAT COMMAND runs them comes from the
    operator's trusted policy OUTSIDE the repository (see reviewer_policy) — a
    change cannot nominate its own reviewer. The report keys stay "codex"/"glm"
    for compatibility with every existing report.
    """
    root = repo_root()
    sha = head_sha(root)
    cfg, cfg_err = load_json(os.path.join(root, CONFIG_FILE))
    if cfg_err:
        print(f"STOP: {cfg_err} — run `coverloop init` and commit {CONFIG_FILE}", file=sys.stderr)
        sys.exit(1)
    cfg = cfg or {}
    if cfg.get("reviewer_commands") or cfg.get("reviewers"):
        print(f"STOP: {CONFIG_FILE} defines reviewers/reviewer_commands, but a change under "
              f"review may not nominate its own reviewer. Move them to {_reviewer_policy_path()} "
              f"(outside the repo) and delete them from {CONFIG_FILE}.", file=sys.stderr)
        sys.exit(1)
    policy, perr = reviewer_policy(root)
    if perr:
        print(f"STOP: {perr}", file=sys.stderr)
        sys.exit(1)
    primary, secondary = policy["primary"], policy["secondary"]

    # A dirty tree means evidence bound to HEAD would not describe the code that
    # ships. Refuse up front — the single most common process failure in the
    # fleet's gate logs was exactly this, discovered only after the reviewers ran.
    tracked = _git_paths(["diff", "--name-only", "HEAD"], root)
    untracked = _git_paths(["ls-files", "--others", "--exclude-standard"], root)
    if tracked is None or untracked is None:
        print("STOP: git could not report the working tree state", file=sys.stderr)
        sys.exit(1)
    dirty = [p for p in list(tracked) + list(untracked) if not is_report_artifact(p)]
    if dirty:
        print(f"STOP: uncommitted changes not covered by evidence "
              f"({', '.join(dirty[:4])}{'…' if len(dirty) > 4 else ''}) — commit first",
              file=sys.stderr)
        sys.exit(1)

    # 1. derive the tier with the gate's own semantics (attest does this too; we
    #    compute it here so the STOP reasons can name it before anything runs).
    report, why, malformed = find_report(root, sha)
    if malformed:
        print(f"STOP: existing evidence is malformed — {why}", file=sys.stderr)
        sys.exit(1)
    try:
        paths, unknown, pending_human = _gate_floor_paths(root, args, report, sha)
    except Exception as exc:
        print(f"STOP: could not classify the change ({exc})", file=sys.stderr)
        sys.exit(1)
    if unknown:
        print("STOP: could not determine the changed paths (shallow clone or git failure) — "
              "fetch full history or pass --base", file=sys.stderr)
        sys.exit(1)
    floor, reasons = classify_paths(paths, BREADTH_L2_FILES) if paths else ("L0", [])
    tier = tier_max(floor, (report or {}).get("risk_tier"))
    raise_to = getattr(args, "raise_tier", None)
    reason = (getattr(args, "reason", None) or "").strip()
    if raise_to:
        if tier_max(raise_to, tier) != raise_to:
            print(f"STOP: --raise-tier {raise_to} is below the derived floor {tier}; the floor "
                  f"cannot be lowered", file=sys.stderr)
            sys.exit(1)
        if raise_to != tier and not reason:
            print(f"STOP: elevating {tier} -> {raise_to} requires --reason", file=sys.stderr)
            sys.exit(1)
        tier = raise_to

    # 2. attest: tests + whichever reviewers this tier needs. Reviewer commands
    #    come from config ("reviewer_commands": {"codex": "...", "glm": "..."});
    #    with none configured, check STOPs and names the missing role rather
    #    than silently downgrading to a self-attested verdict.
    a = argparse.Namespace(
        tier=None, raise_tier=raise_to if raise_to and raise_to != floor else None,
        reason=reason or None, force=False, tests=True,
        codex=None, codex_findings=None, codex_run=None, codex_log=None,
        glm=None, glm_findings=None, glm_run=None, glm_log=None,
        approve=False, approver=None, base=getattr(args, "base", None), quiet=True)
    cmds = policy["commands"]
    need = []
    if tier in ("L2", "L3"):
        if tier == "L2" and primary != "codex":
            # evaluate() reads the fixed "codex" field at L2 (report keys are
            # frozen for compatibility with every existing report), so running
            # a different primary here would produce evidence the gate does not
            # read. Fail closed and say so rather than review into a void.
            print(f"STOP: reviewer policy names {primary!r} as primary, but at L2 the gate "
                  f"reads the fixed 'codex' evidence field — swapping the L2 primary needs "
                  f"the report-key change this release did not make. Use codex as primary, "
                  f"or elevate to L3 where both reviewers run.", file=sys.stderr)
            sys.exit(1)
        need.append(primary)
    if tier == "L3":
        need.append(secondary)
    for role in need:
        cmd = cmds.get(role)
        if not cmd:
            print(f"STOP: tier {tier} requires an independent {role} review but "
                  f"{policy['path']} has no reviewer_commands.{role}", file=sys.stderr)
            sys.exit(1)
        setattr(a, f"{role}_run", cmd)
        # The verdict is read back from the transcript AFTER the run (below);
        # attest requires a stated verdict, so we provisionally state "fail" and
        # only upgrade it when the transcript ends in a pass marker. Fail-closed.
        setattr(a, role, "fail")
    # In --json mode stdout must be nothing but the JSON document.
    say = (lambda *a: print(*a, file=sys.stderr)) if getattr(args, "json", False) else print
    say(f"coverloop check — {sha[:12]} — derived tier {tier}"
        + (f" (elevated from {floor}: {reason})" if raise_to and raise_to != floor else ""))
    for r in reasons[:4]:
        say(f"  - {r}")
    try:
        with _attest_lock(root):
            if getattr(args, "json", False):
                with contextlib.redirect_stdout(sys.stderr):
                    rc = _cmd_attest_locked(a, root)
            else:
                rc = _cmd_attest_locked(a, root)
    except SystemExit as exc:
        # attest reports usage errors (no test_command configured, a reviewer
        # command that timed out) with fail_usage -> exit 2 and no STOP line.
        # `check` promises exit 1 and exactly one STOP, so translate rather than
        # letting a second exit convention leak out of the boundary command.
        if exc.code:
            _stop("attest could not run (see the error above)")
        raise
    report, why, malformed = find_report(root, sha)
    if report is None:
        print(f"STOP: attest did not produce a report — {why}", file=sys.stderr)
        sys.exit(1)
    if (report.get("tests") or {}).get("status") != "pass" and tier != "L0":
        _stop(f"tests failed ({(report.get('tests') or {}).get('command')})")
    # 3. read each reviewer's verdict from its captured transcript. Only an
    #    unambiguous pass marker counts; anything else stays "fail".
    for role in need:
        e = report.get(role) or {}
        log_rel = e.get("output_file")
        verdict = "fail"
        if log_rel and e.get("exit_code") == 0:
            try:
                txt = open(os.path.join(root, log_rel), encoding="utf-8", errors="replace").read()
                verdict = transcript_verdict(txt)
            except OSError:
                verdict = "fail"
        if verdict != "pass":
            report[role]["status"] = "fail"
            save_report(root, report)
            _stop(f"{role} review did not pass — see {log_rel or 'no transcript'}")
        report[role]["status"] = "pass"
        report[role]["findings_open"] = 0
    save_report(root, report)

    if rc:
        # Everything attest fails on that has its own message above has already
        # stopped this run. What is left is the case with no other symptom: the
        # evidence was written but git IGNORES it, so it never reaches the PR
        # while every local check keeps passing.
        _stop("attest could not record usable evidence (see the error above) — "
              "the report or transcript would not reach the PR")

    # The tests and the reviewers just ran arbitrary commands in this tree. If
    # one of them changed a tracked file, the evidence now describes something
    # other than HEAD — a test that repairs the code it is testing would earn a
    # SAFE TO MERGE for the broken commit. Re-check, excluding the evidence the
    # run is supposed to produce.
    if head_sha(root) != sha:
        # A test or reviewer command that commits, amends, resets or switches
        # branches leaves a CLEAN tree while the evidence now describes a commit
        # that is no longer HEAD.
        _stop(f"HEAD moved during the run ({sha[:12]} -> {(head_sha(root) or '?')[:12]}) — "
              f"the evidence describes a commit that is no longer checked out")
    after = _git_paths(["diff", "--name-only", "HEAD"], root)
    after_new = _git_paths(["ls-files", "--others", "--exclude-standard"], root)
    if after is None or after_new is None:
        _stop("git could not report the working tree state after the run")
    touched = [pth for pth in list(after) + list(after_new) if not is_report_artifact(pth)]
    if touched:
        _stop(f"the tests or reviewers modified the working tree "
              f"({', '.join(touched[:4])}{'…' if len(touched) > 4 else ''}) — the evidence "
              f"would not describe HEAD")

    # 4. gate — the real one, unchanged. Its checks are the final word.
    g = argparse.Namespace(
        min_tier=[tier], tier=[], base=getattr(args, "base", None),
        require_transcript=True, require_captured=False, require_executed=False,
        require_clean_tree=True, require_signed_commit=False, signers=None,
        signers_ref=None, ci=getattr(args, "ci", False), json=False,
        human_gate_scope=getattr(args, "human_gate_scope", "all"))
    files = changed_files(root, g.base, sha) if g.base else None
    human_required = True
    if tier == "L3" and g.human_gate_scope == "irreversible":
        # The exemption reads the CLASSIFIED paths. An elevation exists exactly
        # because the classifier cannot see this risk, so it must not then be
        # excused by that same classifier finding nothing irreversible.
        elevated = bool(raise_to) or (report or {}).get("tier_source") == "elevated"
        human_required = elevated or (not paths) or any(IRREVERSIBLE_RE.search(p) for p in paths)
    verdict, checks = evaluate(report, tier, files, human_gate_required=human_required,
                               inherited_human_gate=pending_human,
                               require_captured=True, root=root,
                               test_command=cfg.get("test_command"))
    failing = [c for c in checks if c["status"] != "pass"]
    if getattr(args, "json", False):
        # Automation reads the EXIT CODE. Printing {"verdict": "fail"} and then
        # exiting 0 made a missing human approval look like success to every
        # caller that checks the status the way CI does.
        print(json.dumps({"schema": "coverloop-check/v1", "commit": sha, "tier": tier,
                          "verdict": "pass" if verdict else "fail", "checks": checks}, indent=2))
        sys.exit(0 if verdict else 1)
    if verdict:
        for c in checks:
            print(f"  ✓ {c['check']:<11} {c['detail']}")
        print(f"  ✓ evidence bound to {sha[:12]}")
        print("SAFE TO MERGE")
    else:
        for c in checks:
            print(f"  {'✓' if c['status'] == 'pass' else '✘'} {c['check']:<11} {c['detail']}")
        first = failing[0]
        if first["check"] == "human_gate":
            _stop(f"{tier} requires a named human approval — "
                  f"`coverloop attest --approve --approver <name>` then re-run check")
        _stop(first["detail"])
    say("commit the evidence in .coverloop/reports/ with this change.")
    sys.exit(0)


def _emit(args, sha, tier, verdict, checks):
    # CI annotations go to STDERR so they also work alongside --json
    # (stdout stays pure JSON for tooling; GitHub reads both streams).
    if args.ci:
        for c in checks:
            if c["status"] != "pass":
                print(f"::error title=coverloop gate::{c['check']}: {c['detail']}",
                      file=sys.stderr)
    if args.json:
        print(json.dumps(
            {"schema": "coverloop-gate/v1", "commit": sha, "tier": tier,
             "verdict": "pass" if verdict else "fail", "checks": checks},
            indent=2,
        ))
        return
    print(f"coverloop gate — commit {sha[:12]} — tier {tier}")
    for c in checks:
        mark = "✔" if c["status"] == "pass" else "✘"
        print(f"  {mark} {c['check']:<11} {c['detail']}")
    print(f"VERDICT: {'PASS' if verdict else 'FAIL — required evidence missing or failing'}")


# ---------------------------------------------------------------- main

def main(argv=None):
    # Windows defaults stdout/stderr to cp1252, which can't encode the gate's
    # ✔/✘/…/— glyphs — the gate would crash with UnicodeEncodeError on every
    # verdict print. Force UTF-8 (best-effort; a no-op on POSIX where it already
    # is) so output is portable across platforms.
    for _s in (sys.stdout, sys.stderr):
        try:
            _s.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError):

