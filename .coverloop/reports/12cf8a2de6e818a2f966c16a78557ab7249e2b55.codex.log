IRREVERSIBLE_RE = _IrreversibleShim()


def _resolve_commit(ref, cwd):
    """Resolve a user-supplied ref to a commit id, or None.

    `--base` reaches `git diff` as a positional, so an option-shaped value was
    read as a FLAG: `--base=--cached` diffed the index, found nothing to classify,
    and the gate passed. `--end-of-options` stops git parsing further flags, and
    demanding a 40-hex answer means nothing but a real commit gets through.
    """
    out = git(["rev-parse", "--verify", "--quiet", "--end-of-options",
               f"{ref}^{{commit}}"], cwd=cwd)
    if not out:
        return None
    out = out.strip()
    return out if re.fullmatch(r"[0-9a-f]{40}", out) else None


def _git_paths(args, cwd):
    """Git path output, parsed losslessly. Returns None if git failed.

    Two ways the old `--name-only` + splitlines() collection lost paths, and both
    are classifier EVASION, not cosmetics:

      * rename detection reported only the DESTINATION, so moving
        src/authGuard.ts to src/guard.ts made an auth change look like an
        unrecognised source file. `--no-renames` reports both sides.
      * git C-quotes any name containing a newline or tab, and splitlines() then
        tore that single path into two meaningless fragments. `-z` emits raw
        names separated by NUL, so there is nothing to quote and nothing to tear.
    """
    # `--no-renames` is a diff option; ls-files rejects it, and appending it
    # blindly made every collection return None — which the caller then, quite
    # correctly, read as "cannot determine the paths" and held at L1. Correct
    # fail-closed behaviour, wrong cause, and it would have masked the evasion
    # fix it was meant to deliver.
    # `show` takes diff options too, and it defaults to rename detection just
    # like `diff` — scoping the flag to `diff` alone let the root-commit fallback
    # lose a rename origin again, one commit after that hole was closed.
    # `ls-files` is the only caller here that rejects it.
    extra = (["--no-renames", "-z"] if args and args[0] in ("diff", "show")
             else ["-z"])
    out = git(args + extra, cwd=cwd)
    if out is None:
        return None
    # Only EMPTY segments are dropped — a filename that is entirely whitespace
    # is a real (and suspicious) file, and discarding it produced an empty,
    # L0 change set.
    return [p for p in out.split("\0") if p]


def _changed_paths_for_gate(root, args):
    """Paths this gate run is judging: the PR range if --base was given (CI),
    else the working tree plus untracked files (local)."""
    base = getattr(args, "base", None)
    if base:
        base = _resolve_commit(base, root)
        if base is None:
            return []
        out = _git_paths(["diff", "--name-only", f"{base}...HEAD"], root)
        if out is None:
            out = _git_paths(["diff", "--name-only", base, "HEAD"], root)
        return out or []
    tracked = _git_paths(["diff", "--name-only", "HEAD"], root) or []
    untracked = _git_paths(["ls-files", "--others", "--exclude-standard"], root) or []
    return list(tracked) + list(untracked)


def _validated_baseline(root, sha, limit=2000, human_gate_scope="all"):
    """The newest ancestor of SHA whose evidence chain actually VALIDATES.

    Returns (baseline, validated): `validated` is False when the baseline is the
    bare root commit with no accepted evidence — the caller must then classify
    the root's OWN files too, because a two-dot diff from the root excludes the
    files the root itself introduced (a migration in a repo's FIRST commit was
    never classified at all; probed end-to-end). None baseline means git could
    not answer, or the history is SHALLOW — a shallow boundary looks exactly
    like a root commit to rev-list --max-parents=0, and treating it as one
    silently drops everything at or before the boundary; fail closed and let
    the operator fetch full history (CI: fetch-depth: 0, or pass --base).

    A report advances the baseline only if BOTH hold:
      * its tier covers the deterministic floor of the segment it governs, AND
      * it would pass its own VERIFICATION (tests bound to the config command,
        hash-bound reviewer transcripts) — NOT authorization: whether a human
        signed for it is the gate's question about the commit being shipped,
        not a property that makes an ancestor a worse baseline — existence is
        not validity, and a bare tier claim is not evidence: a planted
        no-evidence L3 report on a migration commit advanced the baseline and
        let a later docs commit gate at L0 (probed end-to-end).

    Cost is bounded: at most _BASELINE_WALK_CAP evidence commits are validated
    (newest-first); anything older folds into the pre-baseline segment, which
    only ever ENLARGES what the gate classifies.
    """
    shallow = git(["rev-parse", "--is-shallow-repository"], cwd=root)
    if shallow is None or shallow.strip() == "true":
        return None, False, None
    out = git(["rev-list", f"--max-count={limit}", sha], cwd=root)
    if not out:
        return None, False, None
    commits = out.split()
    attested = []
    for c in commits[1:]:
        if os.path.exists(report_path(root, c)):
            rep, _why = load_report(root, c)
            if rep is not None and rep.get("risk_tier") in TIERS:
                attested.append((c, rep))
        if len(attested) >= _BASELINE_WALK_CAP:
            break
    root_out = git(["rev-list", "--max-parents=0", sha], cwd=root)
    if not root_out:
        return None, False, None
    baseline = root_out.split()[-1]
    validated = False
    pending_human = None
    cfg, _cfg_err = load_json(os.path.join(root, CONFIG_FILE))
    cfg_cmd = (cfg or {}).get("test_command")
    for c, rep in reversed(attested):
        if c == baseline and validated:
            continue
        seg = _git_paths(["diff", "--name-only", f"{baseline}..{c}"], root)
        if seg is None:
            return None, False, None
        if not validated:
            # The segment reaching back to the bare root must include the
            # root's own files — a two-dot diff excludes what the root itself
            # introduced, and nothing else ever accounts for those.
            own = _git_paths(["show", "--name-only", "--pretty=format:", baseline], root)
            if own is None:
                return None, False, None
            seg = list(seg) + own
        tier = rep["risk_tier"]
        floor, _reasons = classify_paths(seg, BREADTH_L2_FILES)
        if tier_max(tier, floor) != tier:
            continue  # under-declares its segment — not a valid baseline
        # VERIFICATION scope, deliberately: this asks "was commit c actually
        # checked?" (tests + reviewers), not "did a human sign for it?". A
        # reviewed-but-unsigned commit is a legitimate risk baseline. Human
        # authorization is enforced by the GATE on the commit being shipped —
        # it is never inherited from an ancestor, and never inferred here.
        ok, _checks = evaluate(rep, tier, None, root=root, test_command=cfg_cmd,
                               require_captured=True, scope=EVIDENCE_VERIFICATION)
        if not ok:
            continue  # a tier claim with no evidence behind it is not a baseline
        # Advancing past this commit removes its files from every later floor.
        # If its tier required a human signature and never got one, that
        # OBLIGATION does not vanish with the files: it is carried to HEAD, so
        # a branch containing an unapproved migration cannot be merged by
        # putting a docs commit on top of it. Sticky — a later approval signs
        # for its own segment, never retroactively for this one.
        # Judge the ancestor by the SAME policy this run uses. Re-evaluating a
        # historical L3 with the default "all" made an L3 that was legitimately
        # exempt under --human-gate-scope irreversible into a permanent pending
        # obligation on every later commit.
        anc_human = True
        if human_gate_scope == "irreversible" and tier == "L3":
            anc_human = (not seg) or any(IRREVERSIBLE_RE.search(pth) for pth in seg)
        authorized, _ac = evaluate(rep, tier, None, root=root, test_command=cfg_cmd,
                                   require_captured=True, human_gate_required=anc_human,
                                   scope=EVIDENCE_AUTHORIZATION)
        if not authorized:
            pending_human = pending_human or c
        baseline = c
        validated = True
    return baseline, validated, pending_human


_BASELINE_WALK_CAP = 100


def _gate_floor_paths(root, args, report, sha):
    """Every path this gate run is judging, and whether that set is TRUSTWORTHY.

    Returns (paths, unknown). `unknown` means git could not answer, and the caller
    must fail closed rather than read the resulting empty list as "nothing risky".

    The first cut of the auto-floor asked only for uncommitted changes, which is
    empty in the ordinary case — you commit, THEN run the gate — so `gate
    --min-tier L0` still passed over a committed migration. The set therefore
    also spans the commits the recorded evidence does not cover: from the report's
    commit to HEAD, or the commit being gated when there is no report at all.
    """
    base = getattr(args, "base", None)
    if base:
        # Resolve to a commit id FIRST. `--base=--cached` was passed through to
        # `git diff` as an OPTION, which diffed the index, found nothing, and
        # gated clean. Anything that does not resolve to a commit is refused
        # before it can reach git as a flag.
        base = _resolve_commit(base, root)
        if base is None:
            return [], True, None
        out = _git_paths(["diff", "--name-only", f"{base}...HEAD"], root)
        if out is None:
            out = _git_paths(["diff", "--name-only", base, "HEAD"], root)
        if out is None:
            # An unresolvable --base is a caller error, not an all-clear. Reading
