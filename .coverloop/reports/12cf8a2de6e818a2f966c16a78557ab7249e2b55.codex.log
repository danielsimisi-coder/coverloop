  2291	# Codex prints "tokens used" and a number. Anything sentence-like after the
  2292	# verdict means the reviewer kept talking, and the marker was not its last word.
  2293	_VERDICT_FOOTER = re.compile(
  2294	    r"^(tokens?[ _]used\s*:?\s*[\d,.]*\s*[kmb]?|[\d,.]+|[-=_*]{3,})$", re.I)
