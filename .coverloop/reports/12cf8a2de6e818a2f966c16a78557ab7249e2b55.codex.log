   808	        report, why = load_report(root, head)
   809	        if report is None:
   810	            return None, why, True
   811	        return report, None, False
   812	    for i in range(1, EVIDENCE_WALK_LIMIT + 1):
   813	        anc = git(["rev-parse", f"{head}~{i}"], cwd=root)
   814	        if not anc:
   815	            break
   816	        if not os.path.exists(report_path(root, anc)):
   817	            continue
   818	        report, why = load_report(root, anc)
   819	        if report is None:
