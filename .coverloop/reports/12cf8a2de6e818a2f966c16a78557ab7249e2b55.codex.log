    # worktrees of the same repo take the SAME lock (M3 R4 — a per-worktree
    # --git-dir let two worktrees lost-update each other). realpath canonicalizes
    # a relative/`..` submodule path (M3 R4 P3).
    common = git(["rev-parse", "--git-common-dir"], cwd=root)
    candidates = []
    if common:
        candidates.append(os.path.realpath(os.path.join(root, common)))
    candidates.append(os.path.realpath(os.path.join(root, REPORTS_DIR)))  # writable iff attest can write
    fd = None
    for lock_dir in candidates:
        try:
            os.makedirs(lock_dir, exist_ok=True)
            fd = os.open(os.path.join(lock_dir, "coverloop-attest.lock"),
                         os.O_CREAT | os.O_RDWR, 0o644)
            break
        except OSError:
            continue
