  2299	def transcript_verdict(text, tail_lines=10):
  2300	    """Return "pass" only for an unambiguous canonical PASS marker at the end.
  2301	
  2302	    Three conditions, all fail-closed:
  2303	      * at least one `VERDICT:` line exists;
  2304	      * EVERY such line is byte-for-byte "VERDICT: PASS" after trimming — no
  2305	        "PASS WITH RISKS", no lowercase, no "APPROVE";
  2306	      * the last one is among the final `tail_lines` non-empty lines, so it is
  2307	        the reviewer's closing word rather than something near the top.
  2308	
  2309	    The whole transcript is read, not a tail window: a review that says FAIL and
  2310	    then emits 5 KB of appendix would otherwise have its failure scroll out of
  2311	    view. The closing-position rule is the other half of the same idea — a
  2312	    prompt echo containing the marker, followed by a review that never reaches a
  2313	    verdict, must not count as approval. The small allowance exists because real
  2314	    reviewers append a footer (Codex prints "tokens used" and a count after its
  2315	    reply); it is not room for review content.
  2316	    """
  2317	    lines = (text or "").splitlines()
  2318	    live = [(i, ln.strip()) for i, ln in enumerate(lines) if ln.strip()]
  2319	    markers = [(n, body) for n, (i, body) in enumerate(live) if _VERDICT_MARKER.match(lines[i])]
  2320	    if not markers:
  2321	        return "fail"
  2322	    if any(body != _VERDICT_CANONICAL_PASS for _n, body in markers):
  2323	        return "fail"
  2324	    trailing = [body for _i, body in live[markers[-1][0] + 1:]]
  2325	    if len(trailing) > tail_lines or any(not _VERDICT_FOOTER.match(t) for t in trailing):
  2326	        return "fail"          # the reviewer kept talking; the marker was not its last word
  2327	    return "pass"
