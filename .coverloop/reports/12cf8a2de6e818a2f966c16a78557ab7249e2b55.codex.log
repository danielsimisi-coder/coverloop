+            run("git", "add", "-A"); run("git", "commit", "-qm", "evidence")
+            g = self._cl(d, "gate", "--human-gate-scope", "irreversible")
+            self.assertIn("human gate", g.stdout)
+            self.assertIn("NOT APPROVED", g.stdout)
+            self.assertEqual(g.returncode, 1)
