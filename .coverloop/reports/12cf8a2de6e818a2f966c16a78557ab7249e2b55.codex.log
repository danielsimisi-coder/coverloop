  1585	    # The ENTIRE reports path must be real: no symlinked `.coverloop` or
  1586	    # `reports/` ancestor (which would relocate the trusted root off-tree) and
  1587	    # the log itself must not be a symlink. Only then can the transcript be
  1588	    # trusted to live in the repo's committed evidence tree.
  1589	    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
  1590	    if os.path.realpath(reports_real) != reports_real:
  1591	        return False  # `.coverloop` or `.coverloop/reports` is a symlink
