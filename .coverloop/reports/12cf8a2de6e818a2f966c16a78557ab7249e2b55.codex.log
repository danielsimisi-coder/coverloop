  1645	# Two DIFFERENT questions the gate answers, kept apart on purpose:
  1646	#
  1647	#   VERIFICATION  — "was this change actually checked?" tests bound to the config
  1648	#                   command, an independent diff review, a red-team at L3, every
  1649	#                   transcript hash-bound to the SHA. Machine-checkable evidence.
  1650	#   AUTHORIZATION — "did a human take responsibility for it?" the named approval
  1651	#                   the gate policy demands at L3.
  1652	#
  1653	# They are not interchangeable. The baseline walk asks only the FIRST question:
  1654	# a commit whose evidence VERIFIES is a sound place to start counting risk from,
  1655	# whether or not anyone signed for it — 238 fully-reviewed L3 commits across the
  1656	# fleet were never signed, and treating them as unreviewed collapsed every
  1657	# baseline to the root and inflated every floor to L3. The gate asks BOTH, and
  1658	# authorization is never inferred from verification: reviewers passing does not
  1659	# mean a human said yes.
  1660	EVIDENCE_VERIFICATION = "verification"      # tests + reviewers only
  1661	EVIDENCE_AUTHORIZATION = "authorization"    # + the human gate, where policy requires it
