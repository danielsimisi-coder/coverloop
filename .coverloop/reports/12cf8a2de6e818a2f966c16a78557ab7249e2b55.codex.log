  2280	#     VERDICT: PASS        (or)        VERDICT: FAIL
  2281	#
  2282	# The reviewer PROMPT tells the reviewer to end with it; the gate does not try
  2283	# to infer approval from natural language. "PASS WITH RISKS", "APPROVE",
  2284	# "LGTM", "SHIP" and every other human phrasing are NOT a pass — inferring one
  2285	# would let a hedged review land as `pass` with zero open findings. Missing,
  2286	# malformed, truncated, ambiguous or non-canonical: FAIL CLOSED.
  2287	# Case-INSENSITIVE on purpose: a lowercase "verdict: fail" is still a verdict,
  2288	# and it must be seen so it can be rejected as non-canonical rather than skipped.
  2289	_VERDICT_MARKER = re.compile(r"^[ \t]*VERDICT:.*$", re.M | re.I)
  2290	# The only thing allowed to follow the closing marker: a CLI's own footer.
  2291	# Codex prints "tokens used" and a number. Anything sentence-like after the
  2292	# verdict means the reviewer kept talking, and the marker was not its last word.
  2293	_VERDICT_FOOTER = re.compile(
  2294	    r"^(tokens?[ _]used\s*:?\s*[\d,.]*\s*[kmb]?|[\d,.]+|[-=_*]{3,})$", re.I)
  2295	_VERDICT_CANONICAL_PASS = "VERDICT: PASS"
  2296	_VERDICT_CANONICAL_FAIL = "VERDICT: FAIL"
