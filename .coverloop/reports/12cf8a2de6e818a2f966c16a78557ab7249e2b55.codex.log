        # that routinely carries tokens). It is also NOT valid evidence (the gate
        # rejects exit!=0), so we WITHHOLD the dump rather than commit a secret-
        # bearing error log to git.
        output = f"[{name} reviewer command exited {proc.returncode}; {WITHHELD_MARKER}\n"
