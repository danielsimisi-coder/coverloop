    if swallowed:
        print(f"ERROR: git IGNORES the evidence just written ({', '.join(swallowed)}) — "
              f"a .gitignore rule (e.g. `*.log`) would keep it out of the PR and the gate "
              f"would fail on missing evidence. Re-run `coverloop init` (writes negation "
              f"rules to .coverloop/.gitignore) and re-attest.", file=sys.stderr)
        return 1
