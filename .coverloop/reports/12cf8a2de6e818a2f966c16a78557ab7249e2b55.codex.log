    if args.approve:
        if not args.approver or not args.approver.strip():
            fail_usage("--approve requires --approver <name> (approval must be attributable)")
        report["human_gate"] = {
            "required": True,
            "approved": True,
            "approver": args.approver.strip(),
            "approved_at": now_utc(),
        }
        did.append(f"human_gate=approved({args.approver.strip()})")

    if not did and not args.tier and not getattr(args, "raise_tier", None):
        did.append(f"tier={report['risk_tier']}[{report.get('tier_source', 'derived')}]")

    path = save_report(root, report)
    rel = os.path.relpath(path, root)
    # `check` drives attest with a provisional "fail" verdict per reviewer and
    # resolves the real one from the transcript afterwards; printing the
    # provisional line there would read as a failure that then "became" a pass.
    if not getattr(args, "quiet", False):
        print(f"recorded [{', '.join(did) or 'tier=' + report['risk_tier']}] -> {rel}")
        print("commit this report with your change — it is the PR-visible evidence.")
    # Evidence git IGNORES can never reach the PR — in the field a repo-root
    # `*.log` rule silently swallowed a captured transcript and CI failed on
    # missing evidence (2026-07-10). check-ignore exits 0 (-> non-None) when
    # a path is ignored.
    evidence_paths = [rel] + [report[r]["output_file"] for r in ("codex", "glm")
                              if report.get(r) and report[r].get("output_file")]
