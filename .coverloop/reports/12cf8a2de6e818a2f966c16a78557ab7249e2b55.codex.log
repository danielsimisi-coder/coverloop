  1507	def docs_only(files):
  1508	    """True iff EVERY changed file is documentation (is_doc_file) or a committed
  1509	    report artifact. Anything else — including executable code under docs/, a
  1510	    basename-collision like src/CHANGELOG, or a non-artifact file under reports/
  1511	    — makes it not docs-only, so the L1 test gate is NOT waived."""
  1512	    if not files:  # empty diff or unknown -> not provably docs-only
  1513	        return False
  1514	    for f in files:
  1515	        if is_doc_file(f) or is_report_artifact(f):
  1516	            continue
  1517	        return False
  1518	    return True
