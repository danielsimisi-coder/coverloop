+            # ("git diff -- .") from tripping this.
+            return None, (f"reviewer policy {path}: the {role} command names {tok!r}, a file "
+                          f"inside the repository under review — the change could rewrite its "
+                          f"own reviewer. Point it at a command outside the repo.")
