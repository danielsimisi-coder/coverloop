  2337	def reviewer_policy(root):
  2338	    """Load WHO reviews and WHAT COMMAND runs them, from a trusted source.
  2339	
  2340	    The independence of the review is the whole product. If the commands lived
  2341	    in the repository, a diff could replace its own reviewer with a stub that
  2342	    prints the canonical pass marker, and `check` would dutifully run it — the
  2343	    change under review would be signing its own evidence. So the policy is
  2344	    read from the operator's own machine, never from the worktree, and it is
  2345	    refused if it is reachable from inside the repo (a symlink or a path under
  2346	    the root) or if anyone but the owner can write it.
  2347	
  2348	    Returns (policy, None) or (None, reason).
  2349	    """
  2350	    path = _reviewer_policy_path()
  2351	    real = os.path.realpath(path)
  2352	    root_real = os.path.realpath(root)
  2353	    if real == root_real or real.startswith(root_real + os.sep):
  2354	        return None, (f"reviewer policy {path} resolves inside the repository under review "
  2355	                      f"({real}) — the reviewer must not be nominated by the change")
  2356	    try:
  2357	        st = os.lstat(real)
  2358	    except OSError:
  2359	        return None, (f"no reviewer policy at {path}. Create it (outside any repo) as:\n"
  2360	                      '  {"reviewers": {"primary": "codex", "secondary": "glm"},\n'
  2361	                      '   "reviewer_commands": {"codex": "<cold review cmd>", '
  2362	                      '"glm": "<red-team cmd>"}}\n'
  2363	                      "  Each command must make its reviewer end with the line "
  2364	                      "'VERDICT: PASS' or 'VERDICT: FAIL'.")
  2365	    if not stat.S_ISREG(st.st_mode):
  2366	        return None, f"reviewer policy {path} is not a regular file"
  2367	    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
  2368	        return None, (f"reviewer policy {path} is group/world-writable "
  2369	                      f"({oct(st.st_mode & 0o777)}) — anyone could swap the reviewer; "
  2370	                      f"run: chmod 600 {path}")
  2371	    data, err = load_json(real)
  2372	    if err:
  2373	        return None, f"reviewer policy {path}: {err}"
  2374	    data = data or {}
  2375	    roles = data.get("reviewers") or {}
  2376	    primary = roles.get("primary", "codex")
  2377	    secondary = roles.get("secondary", "glm")
  2378	    if (primary not in ("codex", "glm") or secondary not in ("codex", "glm")
  2379	            or primary == secondary):
  2380	        return None, (f"reviewer policy {path}: reviewers must name two distinct roles from "
  2381	                      "{codex, glm} (report keys are fixed for compatibility)")
  2382	    cmds = data.get("reviewer_commands") or {}
  2383	    if not isinstance(cmds, dict) or any(not isinstance(v, str) for v in cmds.values()):
  2384	        return None, f"reviewer policy {path}: reviewer_commands must map a role to a command string"
  2385	    # Naming the reviewer outside the repo is not enough if the command it
  2386	    # names lives INSIDE it: the change could then edit its own reviewer to
  2387	    # print the pass marker. Refuse any token of the command that resolves to
  2388	    # a path under the repo root. Heuristic on purpose — it is a word-split,
  2389	    # not a shell parser — but it fails CLOSED and catches the whole class
  2390	    # ("./bin/review.sh", "scripts/review.sh", an absolute path into the tree).
  2391	    for role, cmd in cmds.items():
  2392	        for tok in cmd.replace("|", " ").replace(";", " ").split():
  2393	            tok = tok.strip("\"'")
  2394	            if not tok or tok.startswith("-") or tok in (".", ".."):
  2395	                continue
  2396	            cand = os.path.realpath(os.path.join(root_real, tok)) if not os.path.isabs(tok) \
  2397	                else os.path.realpath(tok)
  2398	            if not (cand.startswith(root_real + os.sep) and os.path.isfile(cand)):
  2399	                continue
  2400	            # ANY regular file in the tree, not just an executable one:
  2401	            # `sh scripts/reviewer` runs an extensionless, non-executable file
  2402	            # just as well, and the repository controls its contents either way.
  2403	            # Directories still pass, which is what keeps a pathspec
  2404	            # ("git diff -- .") from tripping this.
  2405	            return None, (f"reviewer policy {path}: the {role} command names {tok!r}, a file "
  2406	                          f"inside the repository under review — the change could rewrite its "
  2407	                          f"own reviewer. Point it at a command outside the repo.")
