   324	def _pending_elevation(root, base, head):
   325	    """The oldest commit in base..head whose report was ELEVATED above the
   326	    deterministic floor and never approved.
   327	
   328	    A plain L3 inside the range raises the floor by its own paths, so the gate
   329	    demands the human anyway. An elevation is invisible to the classifier by
   330	    definition — that is what it is for — so without this an unapproved
   331	    `--raise-tier L3` commit followed by a one-line fix passed CI at L1.
   332	    """
   333	    out = git(["rev-list", "--reverse", f"{base}..{head}"], cwd=root)
   334	    if not out:
   335	        return None
   336	    for c in out.split():
   337	        rep, _why = load_report(root, c)
   338	        if not rep or rep.get("tier_source") != "elevated":
   339	            continue
   340	        hg = rep.get("human_gate") or {}
   341	        if not (hg.get("approved") is True and str(hg.get("approver", "")).strip()):
   342	            return c
   343	    return None
