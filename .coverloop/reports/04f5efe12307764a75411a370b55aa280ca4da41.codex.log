  1022	    log_path = os.path.join(root, log_rel)
  1023	    os.makedirs(os.path.dirname(log_path), exist_ok=True)
  1024	    print(f"capturing {name} reviewer: {cmd}")
  1025	    try:
  1026	        # shell=True: same trust model as the test command — an operator-typed
  1027	        # reviewer invocation (e.g. 'codex exec ...'), printed before it runs.
  1028	        # text=False: capture raw bytes so non-UTF-8 reviewer output (colored
  1029	        # diffs, binary error dumps) can't crash us; decode defensively below.
  1030	        # `cwd` defaults to the repo (attest --codex-run keeps that contract),
  1031	        # but `check` passes a directory OUTSIDE the worktree: with shell=True
  1032	        # a repo-relative resolution — `python3 -m reviewer` picking up a
  1033	        # planted reviewer.py, `sh <scripts/reviewer` — would otherwise let the
  1034	        # change under review supply its own reviewer. The repo and a
  1035	        # pre-computed diff reach the command through COVERLOOP_REPO /
  1036	        # COVERLOOP_DIFF instead.
  1037	        proc = subprocess.run(cmd, shell=True, cwd=cwd or root, env=env,
  1038	                              capture_output=True, timeout=1800)
  1039	    except (OSError, subprocess.TimeoutExpired) as e:
  1040	        fail_usage(f"could not run {name} reviewer command: {e}")
  1041	    output = ((proc.stdout or b"") + (proc.stderr or b"")).decode("utf-8", errors="replace")
