   620	def tier_max(*tiers):
   621	    """Highest tier among the args (None/unknown-safe). TIERS is low->high.
   622	    Used so a pinned --min-tier can only ever RAISE the requirement."""
   623	    best = None
   624	    for t in tiers:
   625	        if t in TIERS and (best is None or TIERS.index(t) > TIERS.index(best)):
   626	            best = t
   627	    return best
