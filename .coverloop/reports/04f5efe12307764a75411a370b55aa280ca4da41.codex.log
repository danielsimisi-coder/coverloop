   561	    # exemption and skip the L1 floor. git reports the real name; a name with
   562	    # surrounding whitespace is a DIFFERENT, and more suspicious, file.
   563	    paths = [p for p in paths if p]
   564	    if not paths:
   565	        return "L0", []

