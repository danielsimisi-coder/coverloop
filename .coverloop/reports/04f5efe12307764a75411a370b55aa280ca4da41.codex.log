  1681	# Two DIFFERENT questions the gate answers, kept apart on purpose:
  1682	#
  1683	#   VERIFICATION  — "was this change actually checked?" tests bound to the config
  1684	#                   command, an independent diff review, a red-team at L3, every
  1685	#                   transcript hash-bound to the SHA. Machine-checkable evidence.
  1686	#   AUTHORIZATION — "did a human take responsibility for it?" the named approval
  1687	#                   the gate policy demands at L3.
  1688	#
  1689	# They are not interchangeable. The baseline walk asks only the FIRST question:
  1690	# a commit whose evidence VERIFIES is a sound place to start counting risk from,
  1691	# whether or not anyone signed for it — 238 fully-reviewed L3 commits across the
  1692	# fleet were never signed, and treating them as unreviewed collapsed every
  1693	# baseline to the root and inflated every floor to L3. The gate asks BOTH, and
  1694	# authorization is never inferred from verification: reviewers passing does not
  1695	# mean a human said yes.
  1696	EVIDENCE_VERIFICATION = "verification"      # tests + reviewers only
  1697	EVIDENCE_AUTHORIZATION = "authorization"    # + the human gate, where policy requires it
