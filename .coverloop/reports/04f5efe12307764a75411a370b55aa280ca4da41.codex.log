   346	def _validated_baseline(root, sha, limit=2000, human_gate_scope="all"):
   347	    """The newest ancestor of SHA whose evidence chain actually VALIDATES.
   348	
   349	    Returns (baseline, validated): `validated` is False when the baseline is the
   350	    bare root commit with no accepted evidence — the caller must then classify
   351	    the root's OWN files too, because a two-dot diff from the root excludes the
   352	    files the root itself introduced (a migration in a repo's FIRST commit was
   353	    never classified at all; probed end-to-end). None baseline means git could
   354	    not answer, or the history is SHALLOW — a shallow boundary looks exactly
   355	    like a root commit to rev-list --max-parents=0, and treating it as one
   356	    silently drops everything at or before the boundary; fail closed and let
   357	    the operator fetch full history (CI: fetch-depth: 0, or pass --base).
   358	
   359	    A report advances the baseline only if BOTH hold:
   360	      * its tier covers the deterministic floor of the segment it governs, AND
   361	      * it would pass its own VERIFICATION (tests bound to the config command,
   362	        hash-bound reviewer transcripts) — NOT authorization: whether a human
   363	        signed for it is the gate's question about the commit being shipped,
   364	        not a property that makes an ancestor a worse baseline — existence is
   365	        not validity, and a bare tier claim is not evidence: a planted
   366	        no-evidence L3 report on a migration commit advanced the baseline and
   367	        let a later docs commit gate at L0 (probed end-to-end).
   368	
   369	    Cost is bounded: at most _BASELINE_WALK_CAP evidence commits are validated
   370	    (newest-first); anything older folds into the pre-baseline segment, which
   371	    only ever ENLARGES what the gate classifies.
   372	    """
   373	    shallow = git(["rev-parse", "--is-shallow-repository"], cwd=root)
   374	    if shallow is None or shallow.strip() == "true":
   375	        return None, False, None
   376	    out = git(["rev-list", f"--max-count={limit}", sha], cwd=root)
   377	    if not out:
   378	        return None, False, None
   379	    commits = out.split()
   380	    attested = []
   381	    for c in commits[1:]:
   382	        if os.path.exists(report_path(root, c)):
   383	            rep, _why = load_report(root, c)
   384	            if rep is not None and rep.get("risk_tier") in TIERS:
   385	                attested.append((c, rep))
   386	        if len(attested) >= _BASELINE_WALK_CAP:
   387	            break
   388	    root_out = git(["rev-list", "--max-parents=0", sha], cwd=root)
   389	    if not root_out:
   390	        return None, False, None
   391	    baseline = root_out.split()[-1]
   392	    validated = False
   393	    pending_human = None
   394	    cfg, _cfg_err = load_json(os.path.join(root, CONFIG_FILE))
   395	    cfg_cmd = (cfg or {}).get("test_command")
   396	    for c, rep in reversed(attested):
   397	        if c == baseline and validated:
   398	            continue
   399	        seg = _git_paths(["diff", "--name-only", f"{baseline}..{c}"], root)
   400	        if seg is None:
   401	            return None, False, None
   402	        if not validated:
   403	            # The segment reaching back to the bare root must include the
   404	            # root's own files — a two-dot diff excludes what the root itself
   405	            # introduced, and nothing else ever accounts for those.
   406	            own = _git_paths(["show", "--name-only", "--pretty=format:", baseline], root)
   407	            if own is None:
   408	                return None, False, None
   409	            seg = list(seg) + own
   410	        tier = rep["risk_tier"]
   411	        floor, _reasons = classify_paths(seg, BREADTH_L2_FILES)
   412	        if tier_max(tier, floor) != tier:
   413	            continue  # under-declares its segment — not a valid baseline
   414	        # VERIFICATION scope, deliberately: this asks "was commit c actually
   415	        # checked?" (tests + reviewers), not "did a human sign for it?". A
   416	        # reviewed-but-unsigned commit is a legitimate risk baseline. Human
   417	        # authorization is enforced by the GATE on the commit being shipped —
   418	        # it is never inherited from an ancestor, and never inferred here.
   419	        ok, _checks = evaluate(rep, tier, None, root=root, test_command=cfg_cmd,
   420	                               require_captured=True, scope=EVIDENCE_VERIFICATION)
   421	        if not ok:
   422	            continue  # a tier claim with no evidence behind it is not a baseline
   423	        # Advancing past this commit removes its files from every later floor.
   424	        # If its tier required a human signature and never got one, that
   425	        # OBLIGATION does not vanish with the files: it is carried to HEAD, so
   426	        # a branch containing an unapproved migration cannot be merged by
   427	        # putting a docs commit on top of it. Sticky — a later approval signs
   428	        # for its own segment, never retroactively for this one.
   429	        # Judge the ancestor by the SAME policy this run uses. Re-evaluating a
   430	        # historical L3 with the default "all" made an L3 that was legitimately
   431	        # exempt under --human-gate-scope irreversible into a permanent pending
   432	        # obligation on every later commit.
   433	        anc_human = True
   434	        if (human_gate_scope == "irreversible" and tier == "L3"
   435	                and rep.get("tier_source") != "elevated"):
   436	            # An ELEVATED ancestor is never exempt: the exemption reads paths,
   437	            # and an elevation says the paths do not show the risk.
   438	            anc_human = (not seg) or any(IRREVERSIBLE_RE.search(pth) for pth in seg)
   439	        authorized, _ac = evaluate(rep, tier, None, root=root, test_command=cfg_cmd,
   440	                                   require_captured=True, human_gate_required=anc_human,
   441	                                   scope=EVIDENCE_AUTHORIZATION)
   442	        if not authorized:
   443	            pending_human = pending_human or c
