   258	def _resolve_commit(ref, cwd):
   259	    """Resolve a user-supplied ref to a commit id, or None.
   260	
   261	    `--base` reaches `git diff` as a positional, so an option-shaped value was
   262	    read as a FLAG: `--base=--cached` diffed the index, found nothing to classify,
   263	    and the gate passed. `--end-of-options` stops git parsing further flags, and
   264	    demanding a 40-hex answer means nothing but a real commit gets through.
   265	    """
   266	    out = git(["rev-parse", "--verify", "--quiet", "--end-of-options",
   267	               f"{ref}^{{commit}}"], cwd=cwd)
   268	    if not out:
   269	        return None
   270	    out = out.strip()
   271	    return out if re.fullmatch(r"[0-9a-f]{40}", out) else None
   272	
   273	
   274	def _git_paths(args, cwd):
   275	    """Git path output, parsed losslessly. Returns None if git failed.
   276	
   277	    Two ways the old `--name-only` + splitlines() collection lost paths, and both
   278	    are classifier EVASION, not cosmetics:
   279	
   280	      * rename detection reported only the DESTINATION, so moving
   281	        src/authGuard.ts to src/guard.ts made an auth change look like an
   282	        unrecognised source file. `--no-renames` reports both sides.
   283	      * git C-quotes any name containing a newline or tab, and splitlines() then
   284	        tore that single path into two meaningless fragments. `-z` emits raw
   285	        names separated by NUL, so there is nothing to quote and nothing to tear.
   286	    """
   287	    # `--no-renames` is a diff option; ls-files rejects it, and appending it
   288	    # blindly made every collection return None — which the caller then, quite
   289	    # correctly, read as "cannot determine the paths" and held at L1. Correct
   290	    # fail-closed behaviour, wrong cause, and it would have masked the evasion
   291	    # fix it was meant to deliver.
   292	    # `show` takes diff options too, and it defaults to rename detection just
   293	    # like `diff` — scoping the flag to `diff` alone let the root-commit fallback
   294	    # lose a rename origin again, one commit after that hole was closed.
   295	    # `ls-files` is the only caller here that rejects it.
   296	    extra = (["--no-renames", "-z"] if args and args[0] in ("diff", "show")
   297	             else ["-z"])
   298	    out = git(args + extra, cwd=cwd)
   299	    if out is None:
   300	        return None
   301	    # Only EMPTY segments are dropped — a filename that is entirely whitespace
   302	    # is a real (and suspicious) file, and discarding it produced an empty,
   303	    # L0 change set.
   304	    return [p for p in out.split("\0") if p]
   305	
