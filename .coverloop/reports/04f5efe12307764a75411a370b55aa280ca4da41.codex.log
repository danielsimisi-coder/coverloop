  1009	def capture_run(root, sha, name, cmd, cwd=None, env=None):
  1010	    """Run a reviewer command, save its combined output to
  1011	    .coverloop/reports/<sha>.<name>.log, and return provenance (command, exit
  1012	    code, output path, sha256, line count, timestamp).
