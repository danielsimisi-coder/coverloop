   207	# The narrow set: changes a human must personally stop on, because no amount of
   208	# automated review buys back a mistake here.
   209	#
   210	#   1. schema migrations / raw SQL  — can destroy data; there is no undo
   211	#   2. money paths                  — a wrong number moves real funds
   212	#   3. authz / RLS / permissions    — a wrong rule shows one customer another's data
   213	#
   214	# Everything else at L3 (workers, cron, CI config, deploy wiring, concurrency,
   215	# env plumbing) is dangerous enough to earn the FULL automated loop — tests,
   216	# an independent diff gate, a red-team pass, hashed evidence — but it is
   217	# revertible, so stopping a solo founder on every one of them buys less than it
   218	# costs. This list is deliberately short: the moment it grows to cover
   219	# "anything that feels important", the stop stops meaning anything.
   220	# Which L3 REASONS are hard to take back. This is derived from the rule that
   221	# matched, not from a second regex kept in step by hand — the parallel regex
   222	# drifted from RISK_RULES three separate times (camelCase authz, then `acl`,
   223	# then alembic/db-migrate directories), each time silently waiving the human
   224	# stop for exactly the changes `--human-gate-scope irreversible` promises to
   225	# stop. A rule added above is now covered here automatically, or not at all,
   226	# and never half-covered.
   227	IRREVERSIBLE_REASONS = frozenset({
   228	    "database migration",
   229	    "raw SQL",
   230	    "authentication / authorisation / RLS",
   231	    "money path",
   232	    "schema / data model",
   233	})
   234	
   235	
   236	def is_irreversible(path):
   237	    """True when PATH matches ANY L3 rule whose consequences are hard to undo.
   238	
   239	    Checking only the FIRST matching rule made the answer depend on rule ORDER:
   240	    `workers/models/user.py` hit the worker rule (L3, reversible) before the
   241	    schema rule (L3, irreversible), so the human stop was waived for a schema
   242	    change because of where the file happened to live. Tier selection may take
   243	    the first match; irreversibility must ask every rule."""
   244	    return any(rule_tier == "L3" and why in IRREVERSIBLE_REASONS and rx.search(path)
   245	               for rule_tier, rx, why in _RISK_RULES_C)
   246	
   247	
   248	class _IrreversibleShim:
   249	    """Kept so `IRREVERSIBLE_RE.search(path)` still reads naturally at the two
   250	    call sites and in the tests; the logic lives in is_irreversible()."""

