    86	def gen_secret(rng):
    87	    """Return (secret_value, label) for a randomly chosen real secret shape."""
    88	    b64 = string.ascii_letters + string.digits + "_-"
    89	    kind = rng.choice([
    90	        "sk", "ghp", "aws", "slack", "google", "jwt", "bearer", "dburl", "assign", "pem",
    91	    ])
    92	    if kind == "sk":
    93	        return "sk-" + _rand(rng, b64, rng.randint(20, 48)), "sk-key"
    94	    if kind == "ghp":
    95	        return "ghp_" + _rand(rng, string.ascii_letters + string.digits + "_", rng.randint(20, 40)), "github-token"
    96	    if kind == "aws":
    97	        return "AKIA" + _rand(rng, string.digits + string.ascii_uppercase, 16), "aws-key"
    98	    if kind == "slack":
    99	        return "xoxb-" + _rand(rng, string.ascii_letters + string.digits + "-", rng.randint(10, 30)), "slack-token"
