  2081	    def test_only_the_canonical_verdict_marker_is_a_pass(self):
  2082	        # The verdict is a machine protocol, not prose. Inferring approval from
  2083	        # "PASS WITH RISKS" or "APPROVE" would land a hedged review as a pass
  2084	        # with zero open findings; every non-canonical form fails closed.
  2085	        tv = self.mod.transcript_verdict
  2086	        for text, want in (
  2087	                ("VERDICT: PASS", "pass"),
  2088	                ("  VERDICT: PASS  ", "pass"),
  2089	                ("VERDICT: PASS\ntokens used: 91k", "pass"),   # a trailing footer is fine
  2090	                ("VERDICT: FAIL", "fail"),
  2091	                ("verdict: pass", "fail"),                     # not canonical
  2092	                ("VERDICT:PASS", "fail"),
  2093	                ("VERDICT: PASS.", "fail"),
  2094	                ("1. VERDICT: PASS", "fail"),
  2095	                ("VERDICT: PASS WITH RISKS", "fail"),
  2096	                ("VERDICT: APPROVE", "fail"),
  2097	                ("VERDICT: SHIP", "fail"),
  2098	                ("VERDICT: LGTM", "fail"),
  2099	                ("VERDICT: FAIL\nVERDICT: PASS", "fail"),      # ambiguous loses
  2100	                ("looks good to me", "fail"),
  2101	                ("", "fail"),
  2102	        ):
  2103	            with self.subTest(text=text[:40]):
  2104	                self.assertEqual(tv(text), want)
