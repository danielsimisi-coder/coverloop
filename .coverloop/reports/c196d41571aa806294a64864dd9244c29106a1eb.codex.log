     2	# PreToolUse(Bash) hook — when a risky git/migration command is about to run, inject the
     3	# gate checklist so the protocol is reinforced at the exact moment forgetting is costly.
     4	# Advisory only: it injects context (additionalContext), it does NOT block — the human
     5	# gate + the model's own judgment still apply. Scoped to protocol projects.
     6	set -u
     7	
     8	# Read the tool-call JSON from stdin.
     9	INPUT="$(cat 2>/dev/null)"
    10	
    11	# Only reinforce inside a protocol project.
    12	{ [ -f CLAUDE.md ] && grep -q "PROTOCOL_VERSION\|Operating Contract" CLAUDE.md 2>/dev/null; } \
    13	  || [ -f docs/OPERATING_CONTRACT.md ] || [ -f docs/MULTI_MODEL_PROTOCOL.md ] || exit 0
    14	
    15	# Extract the command (prefer jq). Without jq, DON'T try to precisely parse the
    16	# JSON — the old grep/sed truncated at the first escaped quote, so a risky
    17	# command preceded by any quoted string silently missed the reminder. This is
    18	# an advisory hook, so fail LOUD: match risky keywords against the raw input
    19	# (an extra reminder is harmless; a silently-missing one defeats the hook).
    20	if command -v jq >/dev/null 2>&1; then
    21	  CMD="$(printf '%s' "$INPUT" | jq -r '.tool_input.command // ""' 2>/dev/null)"
    22	else
    23	  CMD="$INPUT"
