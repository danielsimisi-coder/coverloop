+# The words real reviewers actually end on. Sampled from the fleet's captured
+# transcripts: Codex ends "VERDICT: PASS", GLM's red-team scale is
+# "Verdict: PASS / PASS WITH RISKS / REQUEST CHANGES / BLOCK", and some runs
+# emit lowercase "verdict: fail" or a GitHub-style "APPROVE". A parser that
+# only knew uppercase "VERDICT: PASS" scored every one of those a fail —
+# fail-closed, but useless: it would have made `check` unusable with the very
+# reviewers this repo ships. Unknown wording still fails.
+# The reviewer's verdict is a MACHINE PROTOCOL, not prose to be interpreted.
+# Exactly one canonical marker line counts:
+#
+#     VERDICT: PASS        (or)        VERDICT: FAIL
+#
+# The reviewer PROMPT tells the reviewer to end with it; the gate does not try
+# to infer approval from natural language. "PASS WITH RISKS", "APPROVE",
+# "LGTM", "SHIP" and every other human phrasing are NOT a pass — inferring one
+# would let a hedged review land as `pass` with zero open findings. Missing,
+# malformed, truncated, ambiguous or non-canonical: FAIL CLOSED.
+# Case-INSENSITIVE on purpose: a lowercase "verdict: fail" is still a verdict,
+# and it must be seen so it can be rejected as non-canonical rather than skipped.
+_VERDICT_MARKER = re.compile(r"^[ \t]*VERDICT:.*$", re.M | re.I)
+# The only thing allowed to follow the closing marker: a CLI's own footer.
+# Codex prints "tokens used" and a number. Anything sentence-like after the
+# verdict means the reviewer kept talking, and the marker was not its last word.
+_VERDICT_FOOTER = re.compile(
+    r"^(tokens?[ _]used\s*:?\s*[\d,.]*\s*[kmb]?|[\d,.]+|[-=_*]{3,})$", re.I)
+_VERDICT_FOOTER_MAX = 3   # a CLI footer, not room for a paragraph
+_VERDICT_CANONICAL_PASS = "VERDICT: PASS"
+_VERDICT_CANONICAL_FAIL = "VERDICT: FAIL"
+
+
+def transcript_verdict(text):
+    """Return "pass" only for an unambiguous canonical PASS marker at the end.
+
+    Three conditions, all fail-closed:
+      * at least one `VERDICT:` line exists;
+      * EVERY such line is byte-for-byte "VERDICT: PASS" after trimming — no
+        "PASS WITH RISKS", no lowercase, no "APPROVE";
+      * nothing but a short CLI footer follows it, so it is the reviewer's
+        closing word rather than something near the top.
+
+    The whole transcript is read, not a tail window: a review that says FAIL and
+    then emits 5 KB of appendix would otherwise have its failure scroll out of
+    view. The closing-position rule is the other half of the same idea — a
+    prompt echo containing the marker, followed by a review that never reaches a
+    verdict, must not count as approval. The small allowance exists because real
+    reviewers append a footer (Codex prints "tokens used" and a count after its
+    reply); it is not room for review content.
+    """
+    lines = (text or "").splitlines()
+    live = [(i, ln.strip()) for i, ln in enumerate(lines) if ln.strip()]
+    markers = [(n, body) for n, (i, body) in enumerate(live) if _VERDICT_MARKER.match(lines[i])]
+    if not markers:
+        return "fail"
+    if len(markers) != 1 or markers[0][1] != _VERDICT_CANONICAL_PASS:
+        # Exactly one, as documented. Several markers mean either a reviewer
+        # that restated itself or prompt text that survived into the log, and
+        # neither is a verdict this should resolve in the change's favour.
+        return "fail"
+    trailing = [body for _i, body in live[markers[-1][0] + 1:]]
+    if (len(trailing) > _VERDICT_FOOTER_MAX
+            or any(not _VERDICT_FOOTER.match(t) for t in trailing)):
+        return "fail"          # the reviewer kept talking; the marker was not its last word
+    return "pass"
+
+
+def _reviewer_policy_path():
+    """Where the operator's trusted reviewer policy lives. Deliberately OUTSIDE
+    any repository: see reviewer_policy()."""
+    return os.environ.get("COVERLOOP_REVIEWERS") or os.path.join(
+        os.path.expanduser("~"), ".config", "coverloop", "reviewers.json")
+
+
+def reviewer_policy(root):
+    """Load WHO reviews and WHAT COMMAND runs them, from a trusted source.
+
+    The independence of the review is the whole product. If the commands lived
+    in the repository, a diff could replace its own reviewer with a stub that
+    prints the canonical pass marker, and `check` would dutifully run it — the
+    change under review would be signing its own evidence. So the policy is
+    read from the operator's own machine, never from the worktree, and it is
+    refused if it is reachable from inside the repo (a symlink or a path under
+    the root) or if anyone but the owner can write it.
+
+    Returns (policy, None) or (None, reason).
+    """
+    path = _reviewer_policy_path()
+    real = os.path.realpath(path)
+    root_real = os.path.realpath(root)
+    if real == root_real or real.startswith(root_real + os.sep):
+        return None, (f"reviewer policy {path} resolves inside the repository under review "
+                      f"({real}) — the reviewer must not be nominated by the change")
+    try:
+        st = os.lstat(real)
+    except OSError:
+        return None, (f"no reviewer policy at {path}. Create it (outside any repo) as:\n"
+                      '  {"reviewers": {"primary": "codex", "secondary": "glm"},\n'
+                      '   "reviewer_commands": {"codex": "<cold review cmd>", '
+                      '"glm": "<red-team cmd>"}}\n'
+                      "  Each command must make its reviewer end with the line "
+                      "'VERDICT: PASS' or 'VERDICT: FAIL'.")
+    if not stat.S_ISREG(st.st_mode):
+        return None, f"reviewer policy {path} is not a regular file"
+    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
+        return None, (f"reviewer policy {path} is group/world-writable "
+                      f"({oct(st.st_mode & 0o777)}) — anyone could swap the reviewer; "
+                      f"run: chmod 600 {path}")
+    data, err = load_json(real)
+    if err:
+        return None, f"reviewer policy {path}: {err}"
+    data = data or {}
+    roles = data.get("reviewers") or {}
+    primary = roles.get("primary", "codex")
+    secondary = roles.get("secondary", "glm")
+    if (primary not in ("codex", "glm") or secondary not in ("codex", "glm")
+            or primary == secondary):
+        return None, (f"reviewer policy {path}: reviewers must name two distinct roles from "
+                      "{codex, glm} (report keys are fixed for compatibility)")
+    cmds = data.get("reviewer_commands") or {}
+    if not isinstance(cmds, dict) or any(not isinstance(v, str) for v in cmds.values()):
+        return None, f"reviewer policy {path}: reviewer_commands must map a role to a command string"
+    # Naming the reviewer outside the repo is not enough if the command it
+    # names lives INSIDE it: the change could then edit its own reviewer to
+    # print the pass marker. Refuse any token of the command that resolves to
+    # a path under the repo root. Heuristic on purpose — it is a word-split,
+    # not a shell parser — but it fails CLOSED and catches the whole class
+    # ("./bin/review.sh", "scripts/review.sh", an absolute path into the tree).
+    for role, cmd in cmds.items():
+        for tok in cmd.replace("|", " ").replace(";", " ").split():
+            tok = tok.strip("\"'")
+            if not tok or tok.startswith("-") or tok in (".", ".."):
+                continue
+            cand = os.path.realpath(os.path.join(root_real, tok)) if not os.path.isabs(tok) \
+                else os.path.realpath(tok)
+            if not (cand.startswith(root_real + os.sep) and os.path.isfile(cand)):
+                continue
+            # ANY regular file in the tree, not just an executable one:
+            # `sh scripts/reviewer` runs an extensionless, non-executable file
+            # just as well, and the repository controls its contents either way.
+            # Directories still pass, which is what keeps a pathspec
+            # ("git diff -- .") from tripping this.
+            return None, (f"reviewer policy {path}: the {role} command names {tok!r}, a file "
+                          f"inside the repository under review — the change could rewrite its "
+                          f"own reviewer. Point it at a command outside the repo.")
+    return {"path": path, "primary": primary, "secondary": secondary, "commands": cmds}, None
+
+
+_SCRATCH_DIRS = []
+_HELD_LOCKS = []
+
+
+def _cleanup_scratch():
+    """Remove the reviewer scratch dirs. They hold a full copy of the source
+    diff, so leaving one behind on every run — including every failure path —
+    scatters the reviewed code across /tmp."""
+    while _SCRATCH_DIRS:
+        shutil.rmtree(_SCRATCH_DIRS.pop(), ignore_errors=True)
+
+
+def _stop(reason):
+    """The single STOP line. stdout is flushed first so the reason is the last
+    thing on the terminal even though it goes to stderr."""
+    for release in list(_HELD_LOCKS):
+        try:
+            release.__exit__(None, None, None)
+        except Exception:
+            pass
+        _HELD_LOCKS.remove(release)
+    _cleanup_scratch()
+    sys.stdout.flush()
+    print(f"STOP: {reason}", file=sys.stderr)
+    sys.exit(1)
+
+
+def _command_paths(root, cmd):
+    """Repository files a shell command names — the harness behind the string.
+
+    Word-split, not a shell parser: it is a tripwire, and it errs toward
+    noticing. `./test.sh` keeping its name while its contents become `exit 0`
+    is the case it exists for.
+    """
+    found = set()
+    for tok in (cmd or "").replace("|", " ").replace(";", " ").replace("&", " ").split():
+        tok = tok.strip("\"'")
+        if not tok or tok.startswith("-"):
+            continue
+        rel = os.path.normpath(tok)
+        if os.path.isabs(rel):
+            try:
+                rel = os.path.relpath(rel, root)
+            except ValueError:
+                continue
+        if rel.startswith("..") or not os.path.isfile(os.path.join(root, rel)):
+            continue
+        found.add(rel)
+    return found
+
+
+def _reviewed_test_command(root, prior, base=None):
+    """(command, readable) — the test command as it stood at the last point the
+    evidence chain actually covered.
+
+    Comparing only the previous version (`rev-list -2`) could be laundered: set
+    `test_command` to `true` in one commit, touch any other config field in the
+    next, and both observed versions read `true`. So the comparison point is the
+    validated baseline `prior` — and when nothing has ever validated (the
+    baseline is the bare root, which is also what a tampered command produces,
+    since rewriting it invalidates the ancestor evidence), the config's FIRST
+    version, because the whole history is then the span being judged.
+
+    A config with only one commit touching it was created, not changed: that is
+    adoption, and a floor that fires on adoption is a floor people route around.
+    `readable` is False only when git could not answer, which fails closed.
+    """
+    history = git(["rev-list", "--reverse", "HEAD", "--", CONFIG_FILE], cwd=root)
+    if history is None:
+        return None, False
+    versions = history.split()
+    if len(versions) < 2:
+        return None, True                      # created, never changed
+
+    def _at(commit):
+        blob = git(["show", f"{commit}:{CONFIG_FILE}"], cwd=root)
+        if blob is None:
+            return None, False
+        try:
+            return (json.loads(blob) or {}).get("test_command"), True
+        except ValueError:
+            return None, False
+
+    for point in (base, prior):
+        # With --base the reviewed state is the base branch, full stop: reading
+        # the config's first-ever version there let a branch RESTORE a historical
+        # `true` over a base that runs the real suite, with no promotion at all.
+        if point:
+            cmd, ok = _at(point)
+            if not ok:
+                return None, False
+            if cmd:
+                return cmd, True
+    if base:
+        return None, False          # the base has no config to compare against
+    return _at(versions[0])
+
+
+def _reviewer_binary_fingerprints(cmds, env):
+    """sha256 of each reviewer command's resolved executable, before anything
+    else runs.
+
+    The configured test command is arbitrary code running with the operator's
+    privileges, and it runs BEFORE the reviewers. Nothing stops it overwriting
+    a user-owned reviewer wrapper with one that prints the pass marker — no
+    repository file changes, so the dirty-tree check sees nothing. This does not
+    make the test command safe (it cannot: `coverloop` is a gate, not a
+    sandbox), but it does catch the specific swap.
+    """
+    prints = {}
+    for role, cmd in (cmds or {}).items():
+        for tok in cmd.replace("|", " ").replace(";", " ").split():
+            tok = tok.strip("\"'")
+            if not tok or tok.startswith("-") or "=" in tok:
+                continue
+            exe = shutil.which(tok, path=env.get("PATH")) if not os.path.sep in tok else (
+                tok if os.path.exists(tok) else None)
+            if exe:
+                try:
+                    with open(exe, "rb") as fh:
+                        prints[role] = (exe, hashlib.sha256(fh.read()).hexdigest())
+                except OSError:
+                    prints[role] = (exe, None)
+            break                       # the command word only
+    return prints
+
+
+def cmd_check(args):
+    """The one-command boundary: derive the floor, run the tests, run the
+    reviewers the tier requires, record it all bound to HEAD, then gate.
+
+    Prints ONE line on success ("SAFE TO MERGE") and ONE concrete reason on
+    failure ("STOP: ..."). Everything underneath is the existing primitives —
+    classify, attest, gate — unchanged and still available for debugging; this
+    only removes the eight-step ceremony the builder used to orchestrate by hand.
+
+    Fail-closed at every step: the first thing that cannot be verified stops the
+    run and is named. WHO reviews and WHAT COMMAND runs them comes from the
+    operator's trusted policy OUTSIDE the repository (see reviewer_policy) — a
+    change cannot nominate its own reviewer. The report keys stay "codex"/"glm"
+    for compatibility with every existing report.
+    """
+    root = repo_root()
+    sha = head_sha(root)
+    cfg, cfg_err = load_json(os.path.join(root, CONFIG_FILE))
+    if cfg_err:
+        print(f"STOP: {cfg_err} — run `coverloop init` and commit {CONFIG_FILE}", file=sys.stderr)
+        sys.exit(1)
+    cfg = cfg or {}
+    if cfg.get("reviewer_commands") or cfg.get("reviewers"):
+        print(f"STOP: {CONFIG_FILE} defines reviewers/reviewer_commands, but a change under "
+              f"review may not nominate its own reviewer. Move them to {_reviewer_policy_path()} "
+              f"(outside the repo) and delete them from {CONFIG_FILE}.", file=sys.stderr)
+        sys.exit(1)
+    # The policy is REQUIRED only once the derived tier schedules a reviewer.
+    # Demanding it up front made `coverloop check` unusable on the L0/L1 changes
+    # the quick start begins with — a first command that refuses to run until
+    # you have configured a reviewer you do not yet need.
+    policy, perr = reviewer_policy(root)
+    primary = (policy or {}).get("primary", "codex")
+    secondary = (policy or {}).get("secondary", "glm")
+
+    # A dirty tree means evidence bound to HEAD would not describe the code that
+    # ships. Refuse up front — the single most common process failure in the
+    # fleet's gate logs was exactly this, discovered only after the reviewers ran.
+    tracked = _git_paths(["diff", "--name-only", "HEAD"], root)
+    untracked = _git_paths(["ls-files", "--others", "--exclude-standard"], root)
+    if tracked is None or untracked is None:
+        print("STOP: git could not report the working tree state", file=sys.stderr)
+        sys.exit(1)
+    dirty = [p for p in list(tracked) + list(untracked) if not is_report_artifact(p)]
+    if dirty:
+        print(f"STOP: uncommitted changes not covered by evidence "
+              f"({', '.join(dirty[:4])}{'…' if len(dirty) > 4 else ''}) — commit first",
+              file=sys.stderr)
+        sys.exit(1)
+
+    # 1. derive the tier with the gate's own semantics (attest does this too; we
+    #    compute it here so the STOP reasons can name it before anything runs).
+    report, why, malformed = find_report(root, sha)
+    if malformed:
+        print(f"STOP: existing evidence is malformed — {why}", file=sys.stderr)
+        sys.exit(1)
+    try:
+        paths, unknown = _gate_floor_paths(root, args, report, sha)
+    except Exception as exc:
+        print(f"STOP: could not classify the change ({exc})", file=sys.stderr)
+        sys.exit(1)
+    if unknown:
+        print("STOP: could not determine the changed paths (shallow clone or git failure) — "
+              "fetch full history or pass --base", file=sys.stderr)
+        sys.exit(1)
+    floor, reasons = classify_paths(paths, BREADTH_L2_FILES) if paths else ("L0", [])
+    tier = tier_max(floor, (report or {}).get("risk_tier"))
+    raise_to = getattr(args, "raise_tier", None)
+    reason = (getattr(args, "reason", None) or "").strip()
+    if raise_to:
+        if tier_max(raise_to, tier) != raise_to:
+            print(f"STOP: --raise-tier {raise_to} is below the derived floor {tier}; the floor "
+                  f"cannot be lowered", file=sys.stderr)
+            sys.exit(1)
+        if raise_to != tier and not reason:
+            print(f"STOP: elevating {tier} -> {raise_to} requires --reason", file=sys.stderr)
+            sys.exit(1)
+        tier = raise_to
+
+    # 2. attest: tests + whichever reviewers this tier needs. Reviewer commands
+    #    come from config ("reviewer_commands": {"codex": "...", "glm": "..."});
+    #    with none configured, check STOPs and names the missing role rather
+    #    than silently downgrading to a self-attested verdict.
+    # `test_command` is what "tests: pass" MEANS, and reviewers only run at
+    # L2/L3, so a commit rewriting it to `true` was ordinary L1 source by path:
+    # no meaningful tests, no review, SAFE TO MERGE. Compared against the last
+    # command a REPORT recorded, not against the baseline's config, because
+    # rewriting the command invalidates that evidence by construction and drops
+    # the baseline to the root — where the check would never fire.
+    #
+    # This runs BEFORE the attest namespace is built: raising only the local
+    # `tier` let check evaluate L2 while RECORDING L1, and CI's gate then read
+    # L1 and never asked for the transcript.
+    prior, prior_validated = (None, False)
+    if not getattr(args, "base", None):
+        prior, prior_validated = _validated_baseline(root, sha)
+        if prior is None:
+            _stop("cannot determine the span to review (shallow clone or git failure) — "
+                  "fetch full history or pass --base")
+    prev_cmd, history_readable = _reviewed_test_command(
+        root, prior, base=getattr(args, "base", None))
+    cur_cmd = cfg.get("test_command")
+    # The STRING is only half of it: `./test.sh` can keep its name while its
+    # contents become `exit 0`. Any file the command names, that this span also
+    # changed, is part of what "tests: pass" now means.
+    harness = sorted({t for t in _command_paths(root, cur_cmd) if t in set(paths)})
+    if (prev_cmd and prev_cmd != cur_cmd) or not history_readable or harness:
+        why = (f"the test command changed ({prev_cmd!r} -> {cur_cmd!r})"
+               if prev_cmd and prev_cmd != cur_cmd else
+               f"the test harness it runs changed ({', '.join(harness[:3])})" if harness else
+               "the previous test command could not be read from git")
+        if tier_max(tier, "L2") != tier:
+            tier = "L2"
+            raise_to, reason = "L2", f"{why} — what 'tests: pass' means is part of what needs reviewing"
+        reasons = list(reasons) + [f"L2: {why}"]
+
+    # Reviewer commands run from a scratch directory OUTSIDE the worktree, and
+    # with the search paths that could lead back into it removed. Changing the
+    # cwd alone was not enough: PYTHONPATH or a repo directory on PATH still let
+    # `python3 -m reviewer` or a bare command resolve code the change controls.
+    # What the reviewer needs arrives explicitly:
+    #   $COVERLOOP_REPO  absolute path to the repository under review
+    #   $COVERLOOP_DIFF  the diff this run is judging — the SAME span the floor
+    #                    was computed over, not just HEAD
+    #   $COVERLOOP_BASE  the base ref, when one was given
+    review_dir = tempfile.mkdtemp(prefix="coverloop-review-")
+    _SCRATCH_DIRS.append(review_dir)
+    atexit.register(_cleanup_scratch)
+    diff_file = os.path.join(review_dir, "change.diff")
+    if getattr(args, "base", None):
+        span = [f"{args.base}...HEAD"]
+    else:
+        span = [sha] if prior == sha else [f"{prior}..{sha}"]
+    # The floor classifies the bare root's OWN files when no evidence ever
+    # covered them (a two-dot diff excludes what the root introduced). The
+    # reviewers have to see exactly what the floor judged, or a root-commit
+    # migration derives L3 while both reviewers read a packet without it.
+    # Only the exact SHA-shaped artifacts are evidence. `:(exclude)reports/*`
+    # also hid anything else parked there — and `.coverloop/reports/evil.sql`
+    # classifies L3 like any other path, so it derived an L3 floor while both
+    # reviewers got a packet without it.
+    span_files = _git_paths(["diff", "--name-only"] + span, root) or []
+    if len(span) == 1 and span[0] == sha:
+        span_files = _git_paths(["show", "--name-only", "--pretty=format:", sha], root) or []
+    exclude = ["--", "."] + [":(exclude)" + f for f in span_files if is_report_artifact(f)]
+    parts = []
+    if len(span) == 1 and span[0] == sha:
+        parts.append(git(["show", "--patch", sha] + exclude, cwd=root))
+    else:
+        parts.append(git(["diff"] + span + exclude, cwd=root))
+        if not getattr(args, "base", None) and not prior_validated:
+            parts.append(git(["show", "--patch", prior] + exclude, cwd=root))
+    if any(part is None for part in parts):
+        # An empty packet is not "nothing to review" — it is a reviewer looking
+        # at nothing and saying PASS. git failing here must stop the run.
+        _stop("could not produce the diff for the reviewers to read (git failed) — "
+              "refusing to review an empty packet")
+    # The git wrapper strips the trailing newline, which makes the file an
+    # invalid patch: `git apply` reports "corrupt patch at line N", so a
+    # patch-based reviewer cannot reconstruct the change at all.
+    diff_text = "\n".join(part for part in parts if part)
+    # A reviewer command may ship this packet to an external model. Redaction
+    # used to happen only on the way BACK, when capturing output — by which
+    # point a committed credential had already left the machine. Scan and
+    # redact before any reviewer process starts, and refuse outright if the
+    # scan still finds a secret in the redacted text: a privacy gate that
+    # forwards the packet anyway is not a privacy gate.
+    if _secret is None:
+        # The fallback regex covers a handful of key shapes; it does not know
+        # database URLs, service-role keys or Google keys. Handing a packet to
+        # something that may forward it to a model, with the canonical filter
+        # missing, is the one case where continuing is worse than stopping.
+        _stop("the secret filter (glm_secret_filter) could not be imported, so the diff "
+              "cannot be scanned before reviewers see it — install it beside bin/coverloop "
+              "or run the reviewers yourself and attach the transcript with --codex-log")
+    diff_text = redact_secrets(diff_text)
+    if True:
+        try:
+            found = _secret.scan(diff_text)
+        except Exception:
+            found = ["scan failed"]
+        if found:
+            _stop(f"the change contains what looks like a secret ({', '.join(sorted(set(found))[:3])}) "
+                  f"and reviewers may send it to a model — remove it from the diff, rotate the "
+                  f"credential, and re-run")
+    with open(diff_file, "w", encoding="utf-8", errors="replace") as fh:
+        fh.write(diff_text + ("" if diff_text.endswith("\n") else "\n"))
+    review_env = {k: v for k, v in os.environ.items()
+                  if k not in ("PYTHONPATH", "PYTHONHOME", "PYTHONSTARTUP")}
+    # Drop every PATH entry that is empty (= cwd), relative, or inside the repo.
+    review_env["PATH"] = os.pathsep.join(
+        d for d in review_env.get("PATH", "").split(os.pathsep)
+        if d and os.path.isabs(d)
+        and not os.path.realpath(d).startswith(os.path.realpath(root) + os.sep)
+        and os.path.realpath(d) != os.path.realpath(root))
+    review_env.update({"COVERLOOP_REPO": root, "COVERLOOP_DIFF": diff_file,
+                       "COVERLOOP_BASE": str(getattr(args, "base", "") or "")})
+    a = argparse.Namespace(
+        tier=None, raise_tier=raise_to if raise_to and raise_to != floor else None,
+        reason=reason or None, force=False, tests=True,
+        codex=None, codex_findings=None, codex_run=None, codex_log=None,
+        glm=None, glm_findings=None, glm_run=None, glm_log=None,
+        approve=False, approver=None, base=getattr(args, "base", None), quiet=True,
+        reviewer_cwd=review_dir, reviewer_env=review_env)
+    # `test_command` is what "tests: pass" MEANS, and reviewers only run at
+    # L2/L3. A commit that rewrites it to `true` is ordinary L1 source by path,
+    # so it earned SAFE TO MERGE with no meaningful tests and no independent
+    # review. Classifying the config FILE was too blunt — it sits in the first
+    # span of every repo after `init`, and a floor that fires on adoption is a
+    # floor people route around. What needs the review is the CHANGE to it.
+    need = []
+    if tier in ("L2", "L3"):
+        if tier == "L2" and primary != "codex":
+            # evaluate() reads the fixed "codex" field at L2 (report keys are
+            # frozen for compatibility with every existing report), so running
+            # a different primary here would produce evidence the gate does not
+            # read. Fail closed and say so rather than review into a void.
+            print(f"STOP: reviewer policy names {primary!r} as primary, but at L2 the gate "
+                  f"reads the fixed 'codex' evidence field — swapping the L2 primary needs "
+                  f"the report-key change this release did not make. Use codex as primary, "
+                  f"or elevate to L3 where both reviewers run.", file=sys.stderr)
+            sys.exit(1)
+        need.append(primary)
+    if tier == "L3":
+        need.append(secondary)
+    if need and perr:
+        # ...but the moment one IS needed, an unreadable policy is a STOP.
+        _stop(perr)
+    cmds = (policy or {}).get("commands", {})
+    for role in need:
+        cmd = cmds.get(role)
+        if not cmd:
+            print(f"STOP: tier {tier} requires an independent {role} review but "
+                  f"{policy['path']} has no reviewer_commands.{role}", file=sys.stderr)
+            sys.exit(1)
+        setattr(a, f"{role}_run", cmd)
+        # The verdict is read back from the transcript AFTER the run (below);
+        # attest requires a stated verdict, so we provisionally state "fail" and
+        # only upgrade it when the transcript ends in a pass marker. Fail-closed.
+        setattr(a, role, "fail")
+    # In --json mode stdout must be nothing but the JSON document. Redirecting
+    # sys.stdout is not enough: the test command and the reviewers are
+    # SUBPROCESSES that inherit file descriptor 1, and nearly every real test
+    # command prints. Move fd 1 itself to stderr for the whole run and keep the
+    # original to write the document at the end.
+    json_mode = getattr(args, "json", False)
+    json_out = None
+    if json_mode:
+        json_out = os.dup(1)
+        os.dup2(2, 1)
+    say = (lambda *a: print(*a, file=sys.stderr)) if json_mode else print
+
+    say(f"coverloop check — {sha[:12]} — derived tier {tier}"
+        + (f" (elevated from {floor}: {reason})" if raise_to and raise_to != floor else ""))
+    for r in reasons[:4]:
+        say(f"  - {r}")
+    # ORDER MATTERS. The configured test command is arbitrary code running with
+    # the operator's privileges; the reviewers are the thing it would most like
+    # to replace. Hashing the reviewer executable around the test run does not
+    # settle it — a fake wrapper can restore the original before it exits, and
+    # only the first command word is ever resolved. So the reviewers run FIRST,
+    # in their own attest pass, before any repository-controlled code executes
+    # in this invocation. The fingerprints stay as a tripwire for a swap that
+    # happened earlier. The residual limit is real and documented: an arbitrary
+    # test command can do anything to local state, and a gate is not a sandbox.
+    def _attest(ns, what):
+        # NOTE: called with the check-wide lock already held (see below), so it
+        # goes straight to the locked worker. Taking the lock per phase let a
+        # concurrent run's transcript be read back between phases: two checks on
+        # the same commit write the same <sha>.<role>.log, and a run whose
+        # reviewer said FAIL could consume the other's PASS and print SAFE TO
+        # MERGE. The whole capture -> verdict -> evaluate cycle is one critical
