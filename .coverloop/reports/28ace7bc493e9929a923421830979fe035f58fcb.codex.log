   380	            # The segment reaching back to the bare root must include the
   381	            # root's own files — a two-dot diff excludes what the root itself
   382	            # introduced, and nothing else ever accounts for those.
   383	            own = _git_paths(["show", "--name-only", "--pretty=format:", baseline], root)
   384	            if own is None:
