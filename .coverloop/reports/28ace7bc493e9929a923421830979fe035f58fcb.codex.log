  2246	def _reviewer_policy_path():
  2247	    """Where the operator's trusted reviewer policy lives. Deliberately OUTSIDE
  2248	    any repository: see reviewer_policy()."""
  2249	    return os.environ.get("COVERLOOP_REVIEWERS") or os.path.join(
  2250	        os.path.expanduser("~"), ".config", "coverloop", "reviewers.json")
