  1745	def _project_signers_file(root, ref, tmpdir):
  1746	    """Materialize .coverloop/allowed_signers AS COMMITTED at <ref> into a temp
  1747	    file, IGNORING the working tree — a dirty/untracked policy file must never
  1748	    self-authorize (Sol+M3+GLM R4 P1), and reading the committed blob also closes
  1749	    the check-then-read TOCTOU/symlink window (no working-tree path is handed to
  1750	    git). Returns the temp path, or None if that tree has no such file.
  1751	
  1752	    <ref> is HEAD by default (the bootstrapping caveat: a commit can introduce
  1753	    its OWN signer file, so a change to the policy is itself gated evidence —
  1754	    review it like any code change). Pass a PROTECTED ref (`--signers-ref
  1755	    origin/main`) that a PR can't rewrite to remove even the bootstrap gap (R5)."""
  1756	    # Resolve FIRST: `git show` takes options positionally, so an option-shaped
  1757	    # --signers-ref (e.g. --format=...) was interpreted as formatting and could
  1758	    # materialise attacker-chosen commit text AS THE ALLOWED-SIGNERS POLICY.
  1759	    # Same class as the --base injection; the same fix applies.
  1760	    resolved = _resolve_commit(ref, root)
  1761	    if resolved is None:
  1762	        return None
  1763	    content = git(["show", "--end-of-options", f"{resolved}:.coverloop/allowed_signers"],
  1764	                  cwd=root)
  1765	    if content is None:
  1766	        return None
  1767	    p = os.path.join(tmpdir, "allowed_signers")
  1768	    with open(p, "w", encoding="utf-8") as fh:
  1769	        fh.write(content + "\n")
  1770	    return p
