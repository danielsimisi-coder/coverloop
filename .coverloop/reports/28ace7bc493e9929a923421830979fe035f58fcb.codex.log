   960	def capture_run(root, sha, name, cmd):
   961	    """Run a reviewer command, save its combined output to
   962	    .coverloop/reports/<sha>.<name>.log, and return provenance (command, exit
   963	    code, output path, sha256, line count, timestamp).
   964	
   965	    This turns a bare `--codex pass` claim into evidence backed by the actual
   966	    reviewer transcript, committed alongside the report and hashed so tampering
   967	    with the log invalidates the recorded digest. It does NOT auto-derive the
   968	    verdict — reviewer output is prose, and inferring pass/fail from it
   969	    reliably is not possible — so the caller still states pass/fail, but now
   970	    against a captured, inspectable artifact rather than thin air.
   971	    """
   972	    log_rel = os.path.join(REPORTS_DIR, f"{sha}.{name}.log")
   973	    log_path = os.path.join(root, log_rel)
   974	    os.makedirs(os.path.dirname(log_path), exist_ok=True)
   975	    print(f"capturing {name} reviewer: {cmd}")
   976	    try:
   977	        # shell=True: same trust model as the test command — an operator-typed
   978	        # reviewer invocation (e.g. 'codex exec ...'), printed before it runs.
   979	        # text=False: capture raw bytes so non-UTF-8 reviewer output (colored
   980	        # diffs, binary error dumps) can't crash us; decode defensively below.
   981	        proc = subprocess.run(cmd, shell=True, cwd=root,
   982	                              capture_output=True, timeout=1800)
   983	    except (OSError, subprocess.TimeoutExpired) as e:
   984	        fail_usage(f"could not run {name} reviewer command: {e}")
   985	    output = ((proc.stdout or b"") + (proc.stderr or b"")).decode("utf-8", errors="replace")
   986	    if proc.returncode != 0:
   987	        # A failed run's output is untrusted error text (env dumps, stack state
   988	        # that routinely carries tokens). It is also NOT valid evidence (the gate
   989	        # rejects exit!=0), so we WITHHOLD the dump rather than commit a secret-
   990	        # bearing error log to git.
   991	        output = f"[{name} reviewer command exited {proc.returncode}; {WITHHELD_MARKER}\n"
   992	    # Redact secret VALUES before this text is written to a committed file — a
   993	    # privacy tool must never leak keys/tokens/DB creds into git history.
   994	    output = redact_secrets(output)
   995	    with open_write(root, log_path) as f:
   996	        f.write(output)
   997	    return {
   998	        "source": "captured",
   999	        "command": redact_secrets(cmd),  # the invocation string is committed too
  1000	        "exit_code": proc.returncode,
  1001	        "output_file": log_rel,
  1002	        "output_sha256": hashlib.sha256(output.encode("utf-8")).hexdigest(),
  1003	        "output_lines": output.count("\n"),
  1004	        "ran_at": now_utc(),
  1005	    }
