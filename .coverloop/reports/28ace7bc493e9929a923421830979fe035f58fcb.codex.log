   772	def find_report(root, head):
   773	    """Locate the report that governs HEAD.
   774	
   775	    Returns (report, reason, malformed):
   776	      * exact HEAD report when present;
   777	      * else a report bound to a first-parent ancestor, accepted ONLY if the
   778	        diff ancestor..HEAD touches nothing but evidence files (this is what
   779	        makes "attest, commit the report, gate in CI" possible);
   780	      * (None, why, True) when a report file exists but is corrupt, forged,
   781	        or SHA-mismatched — malformed evidence fails EVERY tier;
   782	      * (None, why, False) when no usable report exists.
   783	    """
   784	    path = report_path(root, head)
   785	    if os.path.exists(path):
   786	        report, why = load_report(root, head)
   787	        if report is None:
   788	            return None, why, True
   789	        return report, None, False
   790	    for i in range(1, EVIDENCE_WALK_LIMIT + 1):
   791	        anc = git(["rev-parse", f"{head}~{i}"], cwd=root)
   792	        if not anc:
   793	            break
   794	        if not os.path.exists(report_path(root, anc)):
   795	            continue
   796	        report, why = load_report(root, anc)
   797	        if report is None:
   798	            return None, why, True
   799	        if only_evidence_changed(root, anc, head):
   800	            return report, None, False
   801	        return None, (f"evidence at {anc[:12]} is STALE: non-evidence files "
   802	                      f"changed between it and HEAD — re-run the loop"), False
   803	    return None, "no report found for HEAD or any evidence-only ancestor", False
