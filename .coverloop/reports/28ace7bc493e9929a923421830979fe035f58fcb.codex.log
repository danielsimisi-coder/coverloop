+
+def reviewer_policy(root):
+    """Load WHO reviews and WHAT COMMAND runs them, from a trusted source.
+
+    The independence of the review is the whole product. If the commands lived
+    in the repository, a diff could replace its own reviewer with a stub that
+    prints the canonical pass marker, and `check` would dutifully run it — the
+    change under review would be signing its own evidence. So the policy is
+    read from the operator's own machine, never from the worktree, and it is
+    refused if it is reachable from inside the repo (a symlink or a path under
+    the root) or if anyone but the owner can write it.
+
+    Returns (policy, None) or (None, reason).
+    """
+    path = _reviewer_policy_path()
+    real = os.path.realpath(path)
+    root_real = os.path.realpath(root)
+    if real == root_real or real.startswith(root_real + os.sep):
+        return None, (f"reviewer policy {path} resolves inside the repository under review "
+                      f"({real}) — the reviewer must not be nominated by the change")
+    try:
+        st = os.lstat(real)
+    except OSError:
+        return None, (f"no reviewer policy at {path}. Create it (outside any repo) as:\n"
+                      '  {"reviewers": {"primary": "codex", "secondary": "glm"},\n'
+                      '   "reviewer_commands": {"codex": "<cold review cmd>", '
+                      '"glm": "<red-team cmd>"}}\n'
+                      "  Each command must make its reviewer end with the line "
+                      "'VERDICT: PASS' or 'VERDICT: FAIL'.")
+    if not stat.S_ISREG(st.st_mode):
+        return None, f"reviewer policy {path} is not a regular file"
+    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
+        return None, (f"reviewer policy {path} is group/world-writable "
+                      f"({oct(st.st_mode & 0o777)}) — anyone could swap the reviewer; "
+                      f"run: chmod 600 {path}")
+    data, err = load_json(real)
+    if err:
+        return None, f"reviewer policy {path}: {err}"
+    data = data or {}
+    roles = data.get("reviewers") or {}
+    primary = roles.get("primary", "codex")
+    secondary = roles.get("secondary", "glm")
+    if (primary not in ("codex", "glm") or secondary not in ("codex", "glm")
+            or primary == secondary):
+        return None, (f"reviewer policy {path}: reviewers must name two distinct roles from "
+                      "{codex, glm} (report keys are fixed for compatibility)")
+    cmds = data.get("reviewer_commands") or {}
+    if not isinstance(cmds, dict) or any(not isinstance(v, str) for v in cmds.values()):
+        return None, f"reviewer policy {path}: reviewer_commands must map a role to a command string"
+    return {"path": path, "primary": primary, "secondary": secondary, "commands": cmds}, None
