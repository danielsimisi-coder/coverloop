  2092	    def test_only_the_canonical_verdict_marker_is_a_pass(self):
  2093	        # The verdict is a machine protocol, not prose. Inferring approval from
  2094	        # "PASS WITH RISKS" or "APPROVE" would land a hedged review as a pass
  2095	        # with zero open findings; every non-canonical form fails closed.
  2096	        tv = self.mod.transcript_verdict
  2097	        for text, want in (
  2098	                ("VERDICT: PASS", "pass"),
  2099	                ("  VERDICT: PASS  ", "pass"),
  2100	                ("VERDICT: PASS\ntokens used: 91k", "pass"),   # a trailing footer is fine
  2101	                ("VERDICT: FAIL", "fail"),
  2102	                ("verdict: pass", "fail"),                     # not canonical
  2103	                ("VERDICT:PASS", "fail"),
  2104	                ("VERDICT: PASS.", "fail"),
  2105	                ("1. VERDICT: PASS", "fail"),
  2106	                ("VERDICT: PASS WITH RISKS", "fail"),
  2107	                ("VERDICT: APPROVE", "fail"),
  2108	                ("VERDICT: SHIP", "fail"),
  2109	                ("VERDICT: LGTM", "fail"),
  2110	                ("VERDICT: FAIL\nVERDICT: PASS", "fail"),      # ambiguous loses
  2111	                ("looks good to me", "fail"),
  2112	                ("", "fail"),
  2113	        ):
  2114	            with self.subTest(text=text[:40]):
  2115	                self.assertEqual(tv(text), want)
