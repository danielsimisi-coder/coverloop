   822	def _fsync_fd(fd):
   823	    """Best-effort fsync of an already-open fd (used to durably persist a
   824	    directory's rename entry). Never fatal — durability is a bonus, not a
   825	    correctness precondition, and some platforms/filesystems reject dir fsync."""
   826	    try:
   827	        os.fsync(fd)
   828	    except OSError:
   829	        pass
