   389	        if tier_max(tier, floor) != tier:
   390	            continue  # under-declares its segment — not a valid baseline
   391	        # VERIFICATION scope, deliberately: this asks "was commit c actually
   392	        # checked?" (tests + reviewers), not "did a human sign for it?". A
   393	        # reviewed-but-unsigned commit is a legitimate risk baseline. Human
   394	        # authorization is enforced by the GATE on the commit being shipped —
   395	        # it is never inherited from an ancestor, and never inferred here.
