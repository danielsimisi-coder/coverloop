   948	# The exact marker written when a failed run's output is withheld. Checked in
   949	# attach_log AND verify_capture so the placeholder can never be re-attested as
   950	# a review transcript (laundering), wherever a copy of it lives.
   951	WITHHELD_MARKER = "transcript withheld — a failed run is not valid evidence]"
   952	# The FULL placeholder line capture_run writes on a failed run (see below). Match
   953	# the whole line — NOT the substring — so verify_capture rejects a laundered
   954	# failed capture without false-rejecting a genuine review that merely QUOTES the
   955	# marker (e.g. a review of coverloop's own source). (Sol v2.7.3 verify #1)
   956	WITHHELD_RE = re.compile(r"^\[[a-z]+ reviewer command exited -?\d+; "
   957	                         + re.escape(WITHHELD_MARKER) + r"\s*$")
