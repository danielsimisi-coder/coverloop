  1011	def attach_log(root, sha, name, src_path):
  1012	    """Attach an EXISTING reviewer transcript as evidence: redact secret
  1013	    values, copy it to .coverloop/reports/<sha>.<name>.log, and return
  1014	    provenance with the redacted copy's sha256.
  1015	
  1016	    Field reality (the reason this exists): reviews usually run interactively
  1017	    first (codex exec / glm-review in the terminal), so `--codex-run` would
  1018	    mean paying for the SAME review twice — and in practice evidence stays
  1019	    self-attested. An attached transcript is one honesty notch below captured
  1020	    (the tool didn't execute the command, so there's no exit-code/execution
  1021	    binding) but far above a bare claim: the transcript is committed, readable
  1022	    in the PR, and hash-bound to this commit like any captured log.
  1023	    """
  1024	    if os.path.islink(src_path):
  1025	        fail_usage(f"--{name}-log: {src_path} is a symlink — pass the real transcript file")
  1026	    if not os.path.isfile(src_path):
  1027	        fail_usage(f"--{name}-log: no such file: {src_path}")
  1028	    # Refuse sources inside the reports dir: attaching the gate's own artifacts
  1029	    # would launder a withheld failed-run log, or replay an OLD commit's log,
  1030	    # into fresh "attached" evidence with one command. (Replaying a copy made
  1031	    # elsewhere is the documented attester's-word ceiling — but the tool must
  1032	    # not accept its own rejection/stale artifacts as new evidence.)
  1033	    src_real = os.path.realpath(src_path)
  1034	    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
  1035	    inside_reports = src_real == reports_real or src_real.startswith(reports_real + os.sep)
  1036	    # String compare alone is bypassable on case-insensitive filesystems
  1037	    # (".COVERLOOP/REPORTS/x.log" resolves but keeps its casing) — also walk
  1038	    # the source's ancestor DIRECTORY IDENTITIES (inode compare) against the
  1039	    # reports dir.
  1040	    if not inside_reports:
  1041	        try:
  1042	            rep_stat = os.stat(reports_real)
  1043	        except OSError:
  1044	            rep_stat = None
  1045	        if rep_stat is not None:
  1046	            d = os.path.dirname(src_real)
  1047	            while True:
  1048	                try:
  1049	                    if os.path.samestat(os.stat(d), rep_stat):
  1050	                        inside_reports = True
  1051	                        break
