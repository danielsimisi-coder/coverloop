   844	@contextlib.contextmanager
   845	def open_write(root, path):
   846	    """ATOMICALLY write PATH (which MUST live directly inside
   847	    <root>/.coverloop/reports/): the caller writes to a private temp file in the
   848	    same dir; on clean exit the temp is fsync'd and os.replace'd over PATH, so a
   849	    reader (gate) sees either the OLD file or the fully-written NEW one, never a
   850	    torn/partial report (Sol R3: a plain open()+dump is not atomic, so a
   851	    concurrent reader or a killed writer could observe a truncated file). On
   852	    POSIX the containing directory is also fsync'd so the rename survives a crash;
   853	    on platforms without dir-fd support this degrades to a path-based replace
   854	    (atomic on the OS, best-effort directory durability). Still refuses any
   855	    symlink in the reports path and disables newline translation.
   856	
   857	    Audit fixes (2026-07-11): (1) evidence WRITES used a plain open() that would
   858	    follow a pre-planted destination symlink and overwrite an arbitrary off-tree
   859	    file; the read paths guarded symlinks but the writers did not. (2) text-mode
   860	    writes translated '\\n'->'\\r\\n' on Windows while output_sha256 is hashed over
   861	    the untranslated string, so verify_capture rejected its own untampered
   862	    evidence there; newline='' keeps on-disk bytes == hashed bytes everywhere.
   863	
   864	    Symlink defense mirrors the read-side guard and covers the whole PARENT
   865	    CHAIN, not just the final component (Sol v2.7.3 grade): the file's resolved
   866	    parent must BE the real reports dir (so a symlinked `.coverloop/` or
   867	    `reports/` ancestor can't relocate the write off-tree), and the final
   868	    component must not be a symlink (portable, holds where O_NOFOLLOW is absent).
   869	
   870	    Where the platform supports it (POSIX), the actual write additionally goes
   871	    through a PINNED directory fd (open the reports dir O_DIRECTORY|O_NOFOLLOW,
   872	    fstat-verify it IS the real reports dir, then openat the basename relative to
   873	    that fd): once the dir fd is pinned, swapping `reports/` for a symlink AFTER
   874	    the path check can no longer redirect the write — closing the parent-swap
   875	    TOCTOU race (Sol Round-1 review). Windows (no dir_fd/O_DIRECTORY) keeps the
   876	    path-based check + O_NOFOLLOW best-effort."""
   877	    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
   878	    if (os.path.realpath(reports_real) != reports_real          # .coverloop or reports/ is a symlink
   879	            or os.path.islink(path)                             # final component pre-planted as a symlink
   880	            or os.path.dirname(os.path.realpath(path)) != reports_real):  # resolves outside the real reports dir
   881	        fail_usage(f"refusing to write evidence outside the real reports dir (symlinked path): {path}")
   882	    o_nofollow = getattr(os, "O_NOFOLLOW", 0)
   883	    o_dir = getattr(os, "O_DIRECTORY", 0)
   884	    # O_EXCL: the temp name is private (pid + process-monotonic counter), so a
   885	    # collision is anomalous — never clobber. We create it, so it is never a
   886	    # symlink and the write can't be redirected through it.
   887	    wflags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | o_nofollow
   888	    base = os.path.basename(path)
   889	    tmp_base = f".{base}.tmp.{os.getpid()}.{next(_TMP_SEQ)}"
   890	    tmp_full = os.path.join(os.path.dirname(path), tmp_base)
   891	    use_dirfd = bool(o_dir and o_nofollow
   892	                     and os.open in getattr(os, "supports_dir_fd", set())
   893	                     and os.replace in getattr(os, "supports_dir_fd", set()))
   894	    dfd = None
   895	    try:
   896	        if use_dirfd:
   897	            # POSIX: pin the reports dir by fd (no-follow), verify identity, then
   898	            # create + replace WITHIN that pinned fd (immune to a post-check swap).
   899	            dfd = os.open(os.path.join(root, REPORTS_DIR), os.O_RDONLY | o_dir | o_nofollow)
   900	            if not os.path.samestat(os.fstat(dfd), os.stat(reports_real)):
   901	                fail_usage(f"refusing to write evidence: reports dir identity changed: {path}")
   902	            fd = os.open(tmp_base, wflags, 0o644, dir_fd=dfd)
   903	        else:
   904	            fd = os.open(tmp_full, wflags, 0o644)
   905	        f = None
   906	        try:
   907	            f = os.fdopen(fd, "w", encoding="utf-8", newline="")
   908	            yield f                       # caller writes the evidence to the temp
   909	            f.flush()
   910	            os.fsync(f.fileno())          # file data durable before the rename
   911	            f.close(); f = None
   912	            if use_dirfd:                 # atomic publish: reader sees old or new, never partial
   913	                os.replace(tmp_base, base, src_dir_fd=dfd, dst_dir_fd=dfd)
   914	                _fsync_fd(dfd)            # make the rename itself crash-durable (POSIX dir fsync)
   915	            else:
   916	                os.replace(tmp_full, path)
   917	                _fsync_dir(os.path.dirname(path))
   918	        except BaseException:
   919	            # Close the handle BEFORE unlinking — Windows can't unlink an open
   920	            # file (Sol R3 grade), so a leaked-open temp would otherwise survive.
   921	            # The prior report (if any) is untouched: we only ever wrote the temp.
   922	            if f is not None:
   923	                try:
   924	                    f.close()
   925	                except OSError:
   926	                    pass
   927	            try:
   928	                os.unlink(tmp_base, dir_fd=dfd) if use_dirfd else os.unlink(tmp_full)
   929	            except OSError:
   930	                pass
   931	            raise
   932	    finally:
   933	        if dfd is not None:
   934	            os.close(dfd)
   935	
