  2304	def _stop(reason):
  2305	    """The single STOP line. stdout is flushed first so the reason is the last
  2306	    thing on the terminal even though it goes to stderr."""
  2307	    sys.stdout.flush()
  2308	    print(f"STOP: {reason}", file=sys.stderr)
  2309	    sys.exit(1)
