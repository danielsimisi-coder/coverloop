  2253	def reviewer_policy(root):
  2254	    """Load WHO reviews and WHAT COMMAND runs them, from a trusted source.
  2255	
  2256	    The independence of the review is the whole product. If the commands lived
  2257	    in the repository, a diff could replace its own reviewer with a stub that
  2258	    prints the canonical pass marker, and `check` would dutifully run it — the
  2259	    change under review would be signing its own evidence. So the policy is
  2260	    read from the operator's own machine, never from the worktree, and it is
  2261	    refused if it is reachable from inside the repo (a symlink or a path under
  2262	    the root) or if anyone but the owner can write it.
  2263	
  2264	    Returns (policy, None) or (None, reason).
  2265	    """
  2266	    path = _reviewer_policy_path()
  2267	    real = os.path.realpath(path)
  2268	    root_real = os.path.realpath(root)
  2269	    if real == root_real or real.startswith(root_real + os.sep):
  2270	        return None, (f"reviewer policy {path} resolves inside the repository under review "
  2271	                      f"({real}) — the reviewer must not be nominated by the change")
  2272	    try:
  2273	        st = os.lstat(real)
  2274	    except OSError:
  2275	        return None, (f"no reviewer policy at {path}. Create it (outside any repo) as:\n"
  2276	                      '  {"reviewers": {"primary": "codex", "secondary": "glm"},\n'
  2277	                      '   "reviewer_commands": {"codex": "<cold review cmd>", '
  2278	                      '"glm": "<red-team cmd>"}}\n'
  2279	                      "  Each command must make its reviewer end with the line "
  2280	                      "'VERDICT: PASS' or 'VERDICT: FAIL'.")
  2281	    if not stat.S_ISREG(st.st_mode):
  2282	        return None, f"reviewer policy {path} is not a regular file"
  2283	    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
  2284	        return None, (f"reviewer policy {path} is group/world-writable "
  2285	                      f"({oct(st.st_mode & 0o777)}) — anyone could swap the reviewer; "
  2286	                      f"run: chmod 600 {path}")
  2287	    data, err = load_json(real)
  2288	    if err:
  2289	        return None, f"reviewer policy {path}: {err}"
  2290	    data = data or {}
  2291	    roles = data.get("reviewers") or {}
  2292	    primary = roles.get("primary", "codex")
  2293	    secondary = roles.get("secondary", "glm")
  2294	    if (primary not in ("codex", "glm") or secondary not in ("codex", "glm")
  2295	            or primary == secondary):
  2296	        return None, (f"reviewer policy {path}: reviewers must name two distinct roles from "
  2297	                      "{codex, glm} (report keys are fixed for compatibility)")
  2298	    cmds = data.get("reviewer_commands") or {}
  2299	    if not isinstance(cmds, dict) or any(not isinstance(v, str) for v in cmds.values()):
  2300	        return None, f"reviewer policy {path}: reviewer_commands must map a role to a command string"
  2301	    return {"path": path, "primary": primary, "secondary": secondary, "commands": cmds}, None
