   832	def _fsync_dir(path):
   833	    """Best-effort fsync of a directory by path (fallback publication path)."""
   834	    try:
   835	        d = os.open(path or ".", os.O_RDONLY)
   836	    except OSError:
   837	        return
   838	    try:
   839	        _fsync_fd(d)
   840	    finally:
   841	        os.close(d)
