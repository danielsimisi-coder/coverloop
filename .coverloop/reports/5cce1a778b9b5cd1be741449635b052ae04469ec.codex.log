  2268	def _reviewer_policy_path():
  2269	    """Where the operator's trusted reviewer policy lives. Deliberately OUTSIDE
  2270	    any repository: see reviewer_policy()."""
  2271	    return os.environ.get("COVERLOOP_REVIEWERS") or os.path.join(
  2272	        os.path.expanduser("~"), ".config", "coverloop", "reviewers.json")
