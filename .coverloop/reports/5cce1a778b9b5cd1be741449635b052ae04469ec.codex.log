  2208	# The words real reviewers actually end on. Sampled from the fleet's captured
  2209	# transcripts: Codex ends "VERDICT: PASS", GLM's red-team scale is
  2210	# "Verdict: PASS / PASS WITH RISKS / REQUEST CHANGES / BLOCK", and some runs
  2211	# emit lowercase "verdict: fail" or a GitHub-style "APPROVE". A parser that
  2212	# only knew uppercase "VERDICT: PASS" scored every one of those a fail —
  2213	# fail-closed, but useless: it would have made `check` unusable with the very
  2214	# reviewers this repo ships. Unknown wording still fails.
  2215	# The reviewer's verdict is a MACHINE PROTOCOL, not prose to be interpreted.
  2216	# Exactly one canonical marker line counts:
  2217	#
  2218	#     VERDICT: PASS        (or)        VERDICT: FAIL
  2219	#
  2220	# The reviewer PROMPT tells the reviewer to end with it; the gate does not try
  2221	# to infer approval from natural language. "PASS WITH RISKS", "APPROVE",
  2222	# "LGTM", "SHIP" and every other human phrasing are NOT a pass — inferring one
  2223	# would let a hedged review land as `pass` with zero open findings. Missing,
  2224	# malformed, truncated, ambiguous or non-canonical: FAIL CLOSED.
  2225	# Case-INSENSITIVE on purpose: a lowercase "verdict: fail" is still a verdict,
  2226	# and it must be seen so it can be rejected as non-canonical rather than skipped.
  2227	_VERDICT_MARKER = re.compile(r"^[ \t]*VERDICT:.*$", re.M | re.I)
  2228	# The only thing allowed to follow the closing marker: a CLI's own footer.
  2229	# Codex prints "tokens used" and a number. Anything sentence-like after the
  2230	# verdict means the reviewer kept talking, and the marker was not its last word.
  2231	_VERDICT_FOOTER = re.compile(
  2232	    r"^(tokens?[ _]used\s*:?\s*[\d,.]*\s*[kmb]?|[\d,.]+|[-=_*]{3,})$", re.I)
  2233	_VERDICT_CANONICAL_PASS = "VERDICT: PASS"
  2234	_VERDICT_CANONICAL_FAIL = "VERDICT: FAIL"
  2235	
  2236	
  2237	def transcript_verdict(text, tail_lines=10):
  2238	    """Return "pass" only for an unambiguous canonical PASS marker at the end.
  2239	
  2240	    Three conditions, all fail-closed:
  2241	      * at least one `VERDICT:` line exists;
  2242	      * EVERY such line is byte-for-byte "VERDICT: PASS" after trimming — no
  2243	        "PASS WITH RISKS", no lowercase, no "APPROVE";
  2244	      * the last one is among the final `tail_lines` non-empty lines, so it is
  2245	        the reviewer's closing word rather than something near the top.
  2246	
  2247	    The whole transcript is read, not a tail window: a review that says FAIL and
  2248	    then emits 5 KB of appendix would otherwise have its failure scroll out of
  2249	    view. The closing-position rule is the other half of the same idea — a
  2250	    prompt echo containing the marker, followed by a review that never reaches a
  2251	    verdict, must not count as approval. The small allowance exists because real
  2252	    reviewers append a footer (Codex prints "tokens used" and a count after its
  2253	    reply); it is not room for review content.
  2254	    """
  2255	    lines = (text or "").splitlines()
  2256	    live = [(i, ln.strip()) for i, ln in enumerate(lines) if ln.strip()]
  2257	    markers = [(n, body) for n, (i, body) in enumerate(live) if _VERDICT_MARKER.match(lines[i])]
  2258	    if not markers:
  2259	        return "fail"
  2260	    if any(body != _VERDICT_CANONICAL_PASS for _n, body in markers):
  2261	        return "fail"
  2262	    trailing = [body for _i, body in live[markers[-1][0] + 1:]]
  2263	    if len(trailing) > tail_lines or any(not _VERDICT_FOOTER.match(t) for t in trailing):
  2264	        return "fail"          # the reviewer kept talking; the marker was not its last word
  2265	    return "pass"
