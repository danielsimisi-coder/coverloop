  1529	                     f"{name}: claims {entry.get('source')!r} but the transcript is invalid "
  1530	                     f"(missing / tampered / wrong commit / failed or inconsistent run) — "
  1531	                     f"evidence rejected (re-run attest --{name}-run or --{name}-log)")
  1532	    ok = entry.get("status") == "pass" and entry.get("findings_open") == 0
  1533	    if ok and require_captured and not transcript_valid:
  1534	        return check(name, False,
  1535	                     f"{name}: pass but SELF-ATTESTED — --require-transcript needs a "
