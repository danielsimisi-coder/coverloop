+    lines = (text or "").splitlines()
+    live = [(i, ln.strip()) for i, ln in enumerate(lines) if ln.strip()]
+    markers = [(n, body) for n, (i, body) in enumerate(live) if _VERDICT_MARKER.match(lines[i])]
+    if not markers:
