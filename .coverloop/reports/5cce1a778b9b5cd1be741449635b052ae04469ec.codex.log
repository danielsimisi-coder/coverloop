     1	# Coverloop's OWN CI — continuously proves the gate on every push and PR.
     2	# stdlib-only, so no install step. Runs the full suite on Linux and macOS across
     3	# Python 3.9/3.11/3.13 — all required-green.
     4	#
     5	# Windows is intentionally NOT in the matrix yet. `continue-on-error` was tried,
     6	# but it still posts a red ✗ per Windows job to the commit's check list ("some
     7	# checks were not successful"), which misreads as "broken" on a green project.
     8	# Native Windows is honestly documented as WIP in the README (a few tests assume
     9	# POSIX file semantics — path separators, handle locking); it'll be re-added to
    10	# the matrix once it actually passes, not before.
    11	name: tests
    12	on:
    13	  push:
    14	    branches: [main]
    15	  pull_request:
    16	permissions:
    17	  contents: read
    18	jobs:
    19	  test:
    20	    runs-on: ${{ matrix.os }}
    21	    strategy:
    22	      fail-fast: false
    23	      matrix:
    24	        os: [ubuntu-latest, macos-latest]
    25	        python-version: ['3.9', '3.11', '3.13']
    26	    steps:
    27	      # Pinned to full commit SHAs (not mutable tags) — supply-chain hygiene.
    28	      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4
    29	      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
    30	        with:
    31	          python-version: ${{ matrix.python-version }}
    32	      # `python` (not `python3`): setup-python guarantees `python` on PATH for
    33	      # the selected version on all three OSes; `python3` is not aliased on the
    34	      # Windows runner, which would fail the whole Windows leg (Sol + GLM R3).
    35	      - name: Gate test suite
    36	        run: python tests/test_gate.py
    37	      - name: Report v2 external-authority tests
    38	        run: python tests/test_report_v2.py
    39	      - name: Property / fuzz / concurrency tests
    40	        run: python tests/test_properties.py
    41	      # The shell hooks are POSIX (bash + pwd -P + git). They ship for Unix; on
    42	      # Windows they run under Git Bash / WSL, which the hosted windows runner's
    43	      # default shell is not — so this leg is Unix-only rather than claiming an
