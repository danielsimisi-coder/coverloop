  2275	def reviewer_policy(root):
  2276	    """Load WHO reviews and WHAT COMMAND runs them, from a trusted source.
  2277	
  2278	    The independence of the review is the whole product. If the commands lived
  2279	    in the repository, a diff could replace its own reviewer with a stub that
  2280	    prints the canonical pass marker, and `check` would dutifully run it — the
  2281	    change under review would be signing its own evidence. So the policy is
  2282	    read from the operator's own machine, never from the worktree, and it is
  2283	    refused if it is reachable from inside the repo (a symlink or a path under
  2284	    the root) or if anyone but the owner can write it.
  2285	
  2286	    Returns (policy, None) or (None, reason).
  2287	    """
  2288	    path = _reviewer_policy_path()
  2289	    real = os.path.realpath(path)
  2290	    root_real = os.path.realpath(root)
  2291	    if real == root_real or real.startswith(root_real + os.sep):
  2292	        return None, (f"reviewer policy {path} resolves inside the repository under review "
  2293	                      f"({real}) — the reviewer must not be nominated by the change")
  2294	    try:
  2295	        st = os.lstat(real)
  2296	    except OSError:
  2297	        return None, (f"no reviewer policy at {path}. Create it (outside any repo) as:\n"
  2298	                      '  {"reviewers": {"primary": "codex", "secondary": "glm"},\n'
  2299	                      '   "reviewer_commands": {"codex": "<cold review cmd>", '
  2300	                      '"glm": "<red-team cmd>"}}\n'
  2301	                      "  Each command must make its reviewer end with the line "
  2302	                      "'VERDICT: PASS' or 'VERDICT: FAIL'.")
  2303	    if not stat.S_ISREG(st.st_mode):
  2304	        return None, f"reviewer policy {path} is not a regular file"
  2305	    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
  2306	        return None, (f"reviewer policy {path} is group/world-writable "
  2307	                      f"({oct(st.st_mode & 0o777)}) — anyone could swap the reviewer; "
  2308	                      f"run: chmod 600 {path}")
  2309	    data, err = load_json(real)
  2310	    if err:
  2311	        return None, f"reviewer policy {path}: {err}"
  2312	    data = data or {}
  2313	    roles = data.get("reviewers") or {}
  2314	    primary = roles.get("primary", "codex")
  2315	    secondary = roles.get("secondary", "glm")
  2316	    if (primary not in ("codex", "glm") or secondary not in ("codex", "glm")
  2317	            or primary == secondary):
  2318	        return None, (f"reviewer policy {path}: reviewers must name two distinct roles from "
  2319	                      "{codex, glm} (report keys are fixed for compatibility)")
  2320	    cmds = data.get("reviewer_commands") or {}
  2321	    if not isinstance(cmds, dict) or any(not isinstance(v, str) for v in cmds.values()):
  2322	        return None, f"reviewer policy {path}: reviewer_commands must map a role to a command string"
  2323	    # Naming the reviewer outside the repo is not enough if the command it
  2324	    # names lives INSIDE it: the change could then edit its own reviewer to
  2325	    # print the pass marker. Refuse any token of the command that resolves to
  2326	    # a path under the repo root. Heuristic on purpose — it is a word-split,
  2327	    # not a shell parser — but it fails CLOSED and catches the whole class
  2328	    # ("./bin/review.sh", "scripts/review.sh", an absolute path into the tree).
  2329	    for role, cmd in cmds.items():
  2330	        for tok in cmd.replace("|", " ").replace(";", " ").split():
  2331	            tok = tok.strip("\"'")
  2332	            if not tok or tok.startswith("-") or tok in (".", ".."):
  2333	                continue
  2334	            cand = os.path.realpath(os.path.join(root_real, tok)) if not os.path.isabs(tok) \
  2335	                else os.path.realpath(tok)
  2336	            if not (cand.startswith(root_real + os.sep) and os.path.isfile(cand)):
  2337	                continue
  2338	            # ANY regular file in the tree, not just an executable one:
  2339	            # `sh scripts/reviewer` runs an extensionless, non-executable file
  2340	            # just as well, and the repository controls its contents either way.
  2341	            # Directories still pass, which is what keeps a pathspec
  2342	            # ("git diff -- .") from tripping this.
  2343	            return None, (f"reviewer policy {path}: the {role} command names {tok!r}, a file "
  2344	                          f"inside the repository under review — the change could rewrite its "
  2345	                          f"own reviewer. Point it at a command outside the repo.")
