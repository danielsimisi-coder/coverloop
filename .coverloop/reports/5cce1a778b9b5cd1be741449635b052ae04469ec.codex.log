  1628	# git's %G? signature-status codes. Only "G" (good AND from a key of sufficient
  1629	# validity — gpg owner-trust, or an ssh signer in allowed_signers) proves an
  1630	# AUTHORIZED author. "U" is a good signature whose key validity is UNKNOWN (e.g.
  1631	# a key merely imported into the keyring, or an ssh signer NOT in
  1632	# allowed_signers) — accepting it would let anyone with any importable key pass,
  1633	# so we reject it (Sol R3 P1: `git verify-commit` exit 0 accepts both G and U).
  1634	_SIG_STATUS = {
