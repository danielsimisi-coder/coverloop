   764	# How many first-parent ancestors to search for an evidence-only report.
   765	EVIDENCE_WALK_LIMIT = 20
   766	
   767	
   768	def only_evidence_changed(root, frm, to):
   769	    """True iff the diff frm..to touches ONLY committed report ARTIFACTS
   770	    (<sha>.json / <sha>.<reviewer>.log). A non-artifact file under reports/
   771	    (e.g. reports/backdoor.py) counts as a real code change and returns False."""
   772	    # _git_paths, not a line split: a lone " .coverloop/reports/<sha>.json"
   773	    # was stripped into the exact artifact shape, so stale ancestor evidence
   774	    # was accepted as "nothing but evidence changed".
   775	    files = _git_paths(["diff", "--name-only", f"{frm}..{to}"], root)
   776	    if files is None:
   777	        return False  # unresolvable range -> fail closed
   778	    return bool(files) and all(is_report_artifact(f) for f in files)
