  2473	    def test_the_review_packet_is_a_valid_patch_over_the_whole_span(self):
  2474	        # Two defects in one: the git wrapper strips the trailing newline (so
  2475	        # `git apply` reports "corrupt patch"), and a two-dot diff from the bare
  2476	        # root excludes everything the root commit introduced — which the FLOOR
  2477	        # does classify. Both meant the reviewers judged something other than
  2478	        # what the gate did.
  2479	        captured = os.path.join(self.policy_dir, "capture.sh")
  2480	        out_file = os.path.join(self.policy_dir, "packet.diff")
  2481	        open(captured, "w").write(
  2482	            f'#!/bin/sh\ncat "$COVERLOOP_DIFF" > {out_file}\necho "VERDICT: PASS"\n')
  2483	        os.chmod(captured, 0o755)
  2484	        with tempfile.TemporaryDirectory() as d:
  2485	            run = self._repo(d, cmds={"codex": "capture.sh", "glm": "capture.sh"})
  2486	            # a migration in the repo's own root-adjacent history, then a commit
  2487	            self._write(d, "supabase/migrations/1.sql", "alter table u;\n")
  2488	            run("git", "add", "-A"); run("git", "commit", "-qm", "migrate")
  2489	            self._write(d, "src/a.ts", "export const a = 1;\n")
