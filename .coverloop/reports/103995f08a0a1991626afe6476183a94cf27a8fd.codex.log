  2473	def cmd_check(args):
  2474	    """The one-command boundary: derive the floor, run the tests, run the
  2475	    reviewers the tier requires, record it all bound to HEAD, then gate.
  2476	
  2477	    Prints ONE line on success ("SAFE TO MERGE") and ONE concrete reason on
  2478	    failure ("STOP: ..."). Everything underneath is the existing primitives —
  2479	    classify, attest, gate — unchanged and still available for debugging; this
  2480	    only removes the eight-step ceremony the builder used to orchestrate by hand.
  2481	
  2482	    Fail-closed at every step: the first thing that cannot be verified stops the
  2483	    run and is named. WHO reviews and WHAT COMMAND runs them comes from the
  2484	    operator's trusted policy OUTSIDE the repository (see reviewer_policy) — a
  2485	    change cannot nominate its own reviewer. The report keys stay "codex"/"glm"
  2486	    for compatibility with every existing report.
  2487	    """
  2488	    root = repo_root()
  2489	    sha = head_sha(root)
  2490	    cfg, cfg_err = load_json(os.path.join(root, CONFIG_FILE))
  2491	    if cfg_err:
  2492	        print(f"STOP: {cfg_err} — run `coverloop init` and commit {CONFIG_FILE}", file=sys.stderr)
  2493	        sys.exit(1)
  2494	    cfg = cfg or {}
  2495	    if cfg.get("reviewer_commands") or cfg.get("reviewers"):
  2496	        print(f"STOP: {CONFIG_FILE} defines reviewers/reviewer_commands, but a change under "
  2497	              f"review may not nominate its own reviewer. Move them to {_reviewer_policy_path()} "
  2498	              f"(outside the repo) and delete them from {CONFIG_FILE}.", file=sys.stderr)
  2499	        sys.exit(1)
  2500	    policy, perr = reviewer_policy(root)
  2501	    if perr:
  2502	        print(f"STOP: {perr}", file=sys.stderr)
  2503	        sys.exit(1)
  2504	    primary, secondary = policy["primary"], policy["secondary"]
  2505	
  2506	    # A dirty tree means evidence bound to HEAD would not describe the code that
  2507	    # ships. Refuse up front — the single most common process failure in the
  2508	    # fleet's gate logs was exactly this, discovered only after the reviewers ran.
  2509	    tracked = _git_paths(["diff", "--name-only", "HEAD"], root)
  2510	    untracked = _git_paths(["ls-files", "--others", "--exclude-standard"], root)
  2511	    if tracked is None or untracked is None:
  2512	        print("STOP: git could not report the working tree state", file=sys.stderr)
  2513	        sys.exit(1)
  2514	    dirty = [p for p in list(tracked) + list(untracked) if not is_report_artifact(p)]
  2515	    if dirty:
  2516	        print(f"STOP: uncommitted changes not covered by evidence "
  2517	              f"({', '.join(dirty[:4])}{'…' if len(dirty) > 4 else ''}) — commit first",
  2518	              file=sys.stderr)
  2519	        sys.exit(1)
  2520	
  2521	    # 1. derive the tier with the gate's own semantics (attest does this too; we
  2522	    #    compute it here so the STOP reasons can name it before anything runs).
  2523	    report, why, malformed = find_report(root, sha)
  2524	    if malformed:
  2525	        print(f"STOP: existing evidence is malformed — {why}", file=sys.stderr)
  2525	        print(f"STOP: existing evidence is malformed — {why}", file=sys.stderr)
  2526	        sys.exit(1)
  2527	    try:
  2528	        paths, unknown = _gate_floor_paths(root, args, report, sha)
  2529	    except Exception as exc:
  2530	        print(f"STOP: could not classify the change ({exc})", file=sys.stderr)
  2531	        sys.exit(1)
  2532	    if unknown:
  2533	        print("STOP: could not determine the changed paths (shallow clone or git failure) — "
  2534	              "fetch full history or pass --base", file=sys.stderr)
  2535	        sys.exit(1)
  2536	    floor, reasons = classify_paths(paths, BREADTH_L2_FILES) if paths else ("L0", [])
  2537	    tier = tier_max(floor, (report or {}).get("risk_tier"))
  2538	    raise_to = getattr(args, "raise_tier", None)
  2539	    reason = (getattr(args, "reason", None) or "").strip()
  2540	    if raise_to:
  2541	        if tier_max(raise_to, tier) != raise_to:
  2542	            print(f"STOP: --raise-tier {raise_to} is below the derived floor {tier}; the floor "
  2543	                  f"cannot be lowered", file=sys.stderr)
  2544	            sys.exit(1)
  2545	        if raise_to != tier and not reason:
  2546	            print(f"STOP: elevating {tier} -> {raise_to} requires --reason", file=sys.stderr)
  2547	            sys.exit(1)
  2548	        tier = raise_to
  2549	
  2550	    # 2. attest: tests + whichever reviewers this tier needs. Reviewer commands
  2551	    #    come from config ("reviewer_commands": {"codex": "...", "glm": "..."});
  2552	    #    with none configured, check STOPs and names the missing role rather
  2553	    #    than silently downgrading to a self-attested verdict.
  2554	    # `test_command` is what "tests: pass" MEANS, and reviewers only run at
  2555	    # L2/L3, so a commit rewriting it to `true` was ordinary L1 source by path:
  2556	    # no meaningful tests, no review, SAFE TO MERGE. Compared against the last
  2557	    # command a REPORT recorded, not against the baseline's config, because
  2558	    # rewriting the command invalidates that evidence by construction and drops
  2559	    # the baseline to the root — where the check would never fire.
  2560	    #
  2561	    # This runs BEFORE the attest namespace is built: raising only the local
  2562	    # `tier` let check evaluate L2 while RECORDING L1, and CI's gate then read
  2563	    # L1 and never asked for the transcript.
  2564	    prior, prior_validated = (None, False)
  2565	    if not getattr(args, "base", None):
  2566	        prior, prior_validated = _validated_baseline(root, sha)
  2567	        if prior is None:
  2568	            _stop("cannot determine the span to review (shallow clone or git failure) — "
  2569	                  "fetch full history or pass --base")
  2570	    prev_cmd, history_readable = _reviewed_test_command(
  2571	        root, prior, base=getattr(args, "base", None))
  2572	    cur_cmd = cfg.get("test_command")
  2573	    if (prev_cmd and prev_cmd != cur_cmd) or not history_readable:
  2574	        why = (f"the test command changed ({prev_cmd!r} -> {cur_cmd!r})"
  2575	               if prev_cmd and prev_cmd != cur_cmd else
  2576	               "the previous test command could not be read from git")
  2577	        if tier_max(tier, "L2") != tier:
  2578	            tier = "L2"
  2579	            raise_to, reason = "L2", f"{why} — what 'tests: pass' means is part of what needs reviewing"
  2580	        reasons = list(reasons) + [f"L2: {why}"]
  2581	
  2582	    # Reviewer commands run from a scratch directory OUTSIDE the worktree, and
  2583	    # with the search paths that could lead back into it removed. Changing the
  2584	    # cwd alone was not enough: PYTHONPATH or a repo directory on PATH still let
  2585	    # `python3 -m reviewer` or a bare command resolve code the change controls.
  2586	    # What the reviewer needs arrives explicitly:
  2587	    #   $COVERLOOP_REPO  absolute path to the repository under review
  2588	    #   $COVERLOOP_DIFF  the diff this run is judging — the SAME span the floor
  2589	    #                    was computed over, not just HEAD
  2590	    #   $COVERLOOP_BASE  the base ref, when one was given
  2591	    review_dir = tempfile.mkdtemp(prefix="coverloop-review-")
  2592	    _SCRATCH_DIRS.append(review_dir)
  2593	    atexit.register(_cleanup_scratch)
  2594	    diff_file = os.path.join(review_dir, "change.diff")
  2595	    if getattr(args, "base", None):
  2596	        span = [f"{args.base}...HEAD"]
  2597	    else:
  2598	        span = [sha] if prior == sha else [f"{prior}..{sha}"]
  2599	    # The floor classifies the bare root's OWN files when no evidence ever
  2600	    # covered them (a two-dot diff excludes what the root introduced). The
  2601	    # reviewers have to see exactly what the floor judged, or a root-commit
  2602	    # migration derives L3 while both reviewers read a packet without it.
  2603	    # Only the exact SHA-shaped artifacts are evidence. `:(exclude)reports/*`
  2604	    # also hid anything else parked there — and `.coverloop/reports/evil.sql`
  2605	    # classifies L3 like any other path, so it derived an L3 floor while both
  2606	    # reviewers got a packet without it.
  2607	    span_files = _git_paths(["diff", "--name-only"] + span, root) or []
  2608	    if len(span) == 1 and span[0] == sha:
  2609	        span_files = _git_paths(["show", "--name-only", "--pretty=format:", sha], root) or []
  2610	    exclude = ["--", "."] + [":(exclude)" + f for f in span_files if is_report_artifact(f)]
  2611	    parts = []
  2612	    if len(span) == 1 and span[0] == sha:
  2613	        parts.append(git(["show", "--patch", sha] + exclude, cwd=root))
  2614	    else:
  2615	        parts.append(git(["diff"] + span + exclude, cwd=root))
  2616	        if not getattr(args, "base", None) and not prior_validated:
  2617	            parts.append(git(["show", "--patch", prior] + exclude, cwd=root))
  2618	    if any(part is None for part in parts):
  2619	        # An empty packet is not "nothing to review" — it is a reviewer looking
  2620	        # at nothing and saying PASS. git failing here must stop the run.
  2621	        _stop("could not produce the diff for the reviewers to read (git failed) — "
  2622	              "refusing to review an empty packet")
  2623	    # The git wrapper strips the trailing newline, which makes the file an
  2624	    # invalid patch: `git apply` reports "corrupt patch at line N", so a
  2625	    # patch-based reviewer cannot reconstruct the change at all.
  2626	    diff_text = "\n".join(part for part in parts if part)
  2627	    # A reviewer command may ship this packet to an external model. Redaction
  2628	    # used to happen only on the way BACK, when capturing output — by which
  2629	    # point a committed credential had already left the machine. Scan and
  2630	    # redact before any reviewer process starts, and refuse outright if the
  2631	    # scan still finds a secret in the redacted text: a privacy gate that
  2632	    # forwards the packet anyway is not a privacy gate.
  2633	    if _secret is None:
  2634	        # The fallback regex covers a handful of key shapes; it does not know
  2635	        # database URLs, service-role keys or Google keys. Handing a packet to
  2636	        # something that may forward it to a model, with the canonical filter
  2637	        # missing, is the one case where continuing is worse than stopping.
  2638	        _stop("the secret filter (glm_secret_filter) could not be imported, so the diff "
  2639	              "cannot be scanned before reviewers see it — install it beside bin/coverloop "
  2640	              "or run the reviewers yourself and attach the transcript with --codex-log")
  2641	    diff_text = redact_secrets(diff_text)
  2642	    if True:
  2643	        try:
  2644	            found = _secret.scan(diff_text)
  2645	        except Exception:
  2646	            found = ["scan failed"]
  2647	        if found:
  2648	            _stop(f"the change contains what looks like a secret ({', '.join(sorted(set(found))[:3])}) "
  2649	                  f"and reviewers may send it to a model — remove it from the diff, rotate the "
  2650	                  f"credential, and re-run")
  2651	    with open(diff_file, "w", encoding="utf-8", errors="replace") as fh:
  2652	        fh.write(diff_text + ("" if diff_text.endswith("\n") else "\n"))
  2653	    review_env = {k: v for k, v in os.environ.items()
  2654	                  if k not in ("PYTHONPATH", "PYTHONHOME", "PYTHONSTARTUP")}
  2655	    # Drop every PATH entry that is empty (= cwd), relative, or inside the repo.
  2656	    review_env["PATH"] = os.pathsep.join(
  2657	        d for d in review_env.get("PATH", "").split(os.pathsep)
  2658	        if d and os.path.isabs(d)
  2659	        and not os.path.realpath(d).startswith(os.path.realpath(root) + os.sep)
  2660	        and os.path.realpath(d) != os.path.realpath(root))
