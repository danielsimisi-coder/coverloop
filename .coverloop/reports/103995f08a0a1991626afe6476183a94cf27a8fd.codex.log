   151	           + r".*\.(ts|tsx|js|jsx|mjs|cjs|py|go|rb|java|kt|swift|rs|php|sql|prisma|graphql|ya?ml|json|cs|ex|exs|scala|clj|hs|dart)$",
   152	     "schema / data model"),
   153	    # L2 — product surface and shared contracts: wide blast radius, no direct
   154	    # money/auth authority.
   155	    # NOTE: these two are scoped to APPLICATION SOURCE extensions on purpose.
   156	    # Unscoped, `hooks/` matched this protocol's own shell hooks and `api/`
   157	    # would match any stray text file — over-classification is not free: a
   158	    # floor that cries L2 at documentation trains people to bypass the gate,
   159	    # and a bypassed gate protects nothing.
   160	    ("L2", r"(^|/)(?:" + _kw("api|handlers?|controllers?|middleware")
   161	           + "|" + _kws("routes?") + r")" + r".*\.(ts|tsx|js|jsx|mjs|cjs|py|go|rb|java|kt|swift|rs|php)$",
   162	     "API surface"),
   163	    ("L2", r"(^|/)(?:" + _kw("hooks?|providers?")
   164	           + "|" + _kws("contexts?|stores?|states?") + r")" + r".*\.(ts|tsx|js|jsx|mjs|cjs|py|go|rb|java|kt|swift|rs|php)$",
   165	     "shared application state"),
   166	    ("L2", r"(^|/)(package\.json|package-lock\.json|pnpm-lock\.yaml|yarn\.lock|requirements.*\.txt|pyproject\.toml)$",
   167	     "dependency manifest"),
   168	    # L0 — provably inert: prose and styling only. Anything else falls through
   169	    # to the L1 default.
   170	    # `.txt` is deliberately absent: config/roles.txt and the like are plain
   171	    # text that configures real behaviour, so an unmatched .txt falls to L1
   172	    # ("silence is not safety") rather than being presumed prose.
   173	    ("L0", r"\.(md|mdx|rst|adoc)$", "documentation"),
   174	    ("L0", r"\.(css|scss|sass|less)$", "stylesheet"),
   175	    ("L0", r"(^|/)(LICENSE|CODEOWNERS|\.gitignore|\.editorconfig)$", "repo metadata"),
