  2902	def main(argv=None):
  2903	    # Windows defaults stdout/stderr to cp1252, which can't encode the gate's
  2904	    # ✔/✘/…/— glyphs — the gate would crash with UnicodeEncodeError on every
  2905	    # verdict print. Force UTF-8 (best-effort; a no-op on POSIX where it already
  2906	    # is) so output is portable across platforms.
  2907	    for _s in (sys.stdout, sys.stderr):
  2908	        try:
  2909	            _s.reconfigure(encoding="utf-8", errors="replace")
  2910	        except (AttributeError, ValueError):
  2911	            pass
  2912	    p = argparse.ArgumentParser(prog="coverloop", description=__doc__.splitlines()[0])
  2913	    sub = p.add_subparsers(dest="cmd", required=True)
  2914	
  2915	    pi = sub.add_parser("init", help="scaffold .coverloop/ in this repo")
  2916	    pi.add_argument("--test-command", help="command that must pass (default: npx tsc --noEmit)")
  2917	    pi.set_defaults(fn=cmd_init)
  2918	
  2919	    pd = sub.add_parser("doctor",
  2920	                        help="check the install and say exactly what to fix")
  2921	    pd.set_defaults(fn=cmd_doctor)
  2922	
  2923	    pc = sub.add_parser("classify",
  2924	                        help="derive the deterministic tier FLOOR from the changed paths")
  2925	    pc.add_argument("--base", metavar="REF",
  2926	                    help="classify REF...HEAD instead of the working tree (e.g. origin/main)")
  2927	    pc.add_argument("--human-gate", action="store_true",
  2928	                    help="print required|not-required instead of the tier — whether a NAMED "
  2929	                         "human approval is needed under --human-gate-scope irreversible")
  2930	    pc.add_argument("--quiet", "-q", action="store_true",
  2931	                    help="print only the tier, for piping into gate --min-tier")
  2932	    pc.add_argument("paths", nargs="*",
  2933	                    help="classify these paths instead of reading git")
  2934	    pc.set_defaults(fn=cmd_classify)
  2935	
  2936	    pa = sub.add_parser("attest", help="record evidence for the HEAD commit")
  2937	    pa.add_argument("--tier", choices=TIERS,
  2938	                    help="LEGACY floor pin. The tier is now DERIVED from the changed paths with the "
  2939	                         "gate's own floor semantics; omit this. Kept for compatibility: below the "
  2940	                         "floor it is refused, above it it needs --reason (see --raise-tier)")
  2941	    pa.add_argument("--raise-tier", choices=TIERS, dest="raise_tier",
  2942	                    help="elevate ABOVE the derived floor for a risk the path classifier cannot see "
  2943	                         "(a milestone gate covering many migrations; a config file that steers "
