  1586	    expected = os.path.join(REPORTS_DIR, f"{commit}.{name}.log")
  1587	    if not digest or rel != expected:
  1588	        return False
  1589	    path = os.path.join(root, rel)
  1590	    # The ENTIRE reports path must be real: no symlinked `.coverloop` or
  1591	    # `reports/` ancestor (which would relocate the trusted root off-tree) and
  1592	    # the log itself must not be a symlink. Only then can the transcript be
  1593	    # trusted to live in the repo's committed evidence tree.
  1594	    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
  1595	    if os.path.realpath(reports_real) != reports_real:
  1596	        return False  # `.coverloop` or `.coverloop/reports` is a symlink
