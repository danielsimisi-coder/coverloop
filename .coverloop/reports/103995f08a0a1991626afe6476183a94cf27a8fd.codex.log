   326	def _validated_baseline(root, sha, limit=2000):
   327	    """The newest ancestor of SHA whose evidence chain actually VALIDATES.
   328	
   329	    Returns (baseline, validated): `validated` is False when the baseline is the
   330	    bare root commit with no accepted evidence — the caller must then classify
   331	    the root's OWN files too, because a two-dot diff from the root excludes the
   332	    files the root itself introduced (a migration in a repo's FIRST commit was
   333	    never classified at all; probed end-to-end). None baseline means git could
   334	    not answer, or the history is SHALLOW — a shallow boundary looks exactly
   335	    like a root commit to rev-list --max-parents=0, and treating it as one
   336	    silently drops everything at or before the boundary; fail closed and let
   337	    the operator fetch full history (CI: fetch-depth: 0, or pass --base).
   338	
   339	    A report advances the baseline only if BOTH hold:
   340	      * its tier covers the deterministic floor of the segment it governs, AND
   341	      * it would pass its own VERIFICATION (tests bound to the config command,
   342	        hash-bound reviewer transcripts) — NOT authorization: whether a human
   343	        signed for it is the gate's question about the commit being shipped,
   344	        not a property that makes an ancestor a worse baseline — existence is
   345	        not validity, and a bare tier claim is not evidence: a planted
   346	        no-evidence L3 report on a migration commit advanced the baseline and
   347	        let a later docs commit gate at L0 (probed end-to-end).
   348	
   349	    Cost is bounded: at most _BASELINE_WALK_CAP evidence commits are validated
   350	    (newest-first); anything older folds into the pre-baseline segment, which
   351	    only ever ENLARGES what the gate classifies.
   352	    """
   353	    shallow = git(["rev-parse", "--is-shallow-repository"], cwd=root)
   354	    if shallow is None or shallow.strip() == "true":
   355	        return None, False
   356	    out = git(["rev-list", f"--max-count={limit}", sha], cwd=root)
   357	    if not out:
   358	        return None, False
   359	    commits = out.split()
   360	    attested = []
   361	    for c in commits[1:]:
   362	        if os.path.exists(report_path(root, c)):
   363	            rep, _why = load_report(root, c)
   364	            if rep is not None and rep.get("risk_tier") in TIERS:
   365	                attested.append((c, rep))
   366	        if len(attested) >= _BASELINE_WALK_CAP:
   367	            break
   368	    root_out = git(["rev-list", "--max-parents=0", sha], cwd=root)
   369	    if not root_out:
   370	        return None, False
   371	    baseline = root_out.split()[-1]
   372	    validated = False
   373	    cfg, _cfg_err = load_json(os.path.join(root, CONFIG_FILE))
   374	    cfg_cmd = (cfg or {}).get("test_command")
   375	    for c, rep in reversed(attested):
   376	        if c == baseline and validated:
   377	            continue
   378	        seg = _git_paths(["diff", "--name-only", f"{baseline}..{c}"], root)
   379	        if seg is None:
   380	            return None, False
   381	        if not validated:
   382	            # The segment reaching back to the bare root must include the
   383	            # root's own files — a two-dot diff excludes what the root itself
   384	            # introduced, and nothing else ever accounts for those.
   385	            own = _git_paths(["show", "--name-only", "--pretty=format:", baseline], root)
   386	            if own is None:
   387	                return None, False
   388	            seg = list(seg) + own
   389	        tier = rep["risk_tier"]
   390	        floor, _reasons = classify_paths(seg, BREADTH_L2_FILES)
   391	        if tier_max(tier, floor) != tier:
   392	            continue  # under-declares its segment — not a valid baseline
   393	        # require_captured: a bare `--codex pass --glm pass --approve` records a
   394	        # CLAIM that nothing ran. Accepting it as a baseline let a later L1
   395	        # change start after it, and `check` schedules no reviewer below L2 —
   396	        # so the mandatory independent review disappeared for the whole span.
   397	        # Strictly more conservative than not requiring it: fewer reports
   398	        # advance the baseline, so more paths stay in the floor.
   399	        # FULL evaluation, human approval included. Accepting merely-verified
   400	        # evidence here (so a reviewed-but-uncountersigned L3 stops inflating
   401	        # every later floor) is deferred: it needs the owed signature carried
   402	        # forward to HEAD, and five review rounds each found a way to shed that.
   403	        # See docs/GATE.md. require_captured: a bare `--codex pass` is a claim
   404	        # that nothing ran, and a claim is not a baseline.
   405	        ok, _checks = evaluate(rep, tier, None, root=root, test_command=cfg_cmd,
   406	                               require_captured=True)
   407	        if not ok:
   408	            continue  # a tier claim with no evidence behind it is not a baseline
   409	        baseline = c
   410	        validated = True
   411	    return baseline, validated
   412	
