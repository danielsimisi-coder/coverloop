   653	def load_json(path):
   654	    """Return (data, error). Fail closed on unreadable/invalid JSON."""
   655	    try:
   656	        with open(path, encoding="utf-8") as f:
   657	            return json.load(f), None
   658	    except FileNotFoundError:
   659	        return None, f"{path}: not found"
   660	    except (json.JSONDecodeError, OSError) as e:
   661	        return None, f"{path}: unreadable ({e})"
