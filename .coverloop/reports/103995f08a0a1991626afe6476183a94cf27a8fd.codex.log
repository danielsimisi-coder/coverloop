   708	
   709	def load_report(root, sha):
   710	    """Load the report for this exact SHA. (None, reason) if unusable."""
   711	    path = report_path(root, sha)
   712	    # Reject a report reached through a symlink (or a symlinked reports/ dir):
   713	    # the evidence must live in the repo's committed tree, not off-tree. Mirrors
   714	    # the transcript guard in verify_capture.
   715	    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
   716	    if (os.path.islink(path)
   717	            or os.path.realpath(reports_real) != reports_real
   718	            or (os.path.exists(path) and os.path.dirname(os.path.realpath(path)) != reports_real)):
   719	        return None, f"{path}: report resolves outside the reports dir (symlink) — rejected"
   720	    data, err = load_json(path)
   721	    if err:
   722	        return None, err
   723	    if data.get("schema") != SCHEMA:
   724	        return None, f"{path}: unknown schema {data.get('schema')!r} (want {SCHEMA})"
   725	    if data.get("commit") != sha:
   726	        return None, f"{path}: bound to commit {data.get('commit')!r}, HEAD is {sha}"
   727	    # An invalid risk_tier must fail closed — otherwise a garbage tier is ignored
   728	    # by tier_max() and a pinned --min-tier L0 would gate it as L0 (no evidence).
   729	    if data.get("risk_tier") not in TIERS:
   730	        return None, f"{path}: invalid risk_tier {data.get('risk_tier')!r}"
   731	    # Shape guard (full audit 2026-07-11): a schema-valid report whose
   732	    # tests/codex/glm/human_gate field is not an object would raise an uncaught
   733	    # AttributeError deep in evaluate() (e.g. (tests or {}).get(...)) instead of
   734	    # the documented clean "malformed evidence" FAIL. Reject it here so it takes
   735	    # the fail-closed path.
   736	    for field in ("tests", "codex", "glm", "human_gate"):
   737	        v = data.get(field)
   738	        if v is not None and not isinstance(v, dict):
   739	            return None, f"{path}: field {field!r} must be an object, got {type(v).__name__}"
   740	    # Strict nested-field validation (Sol grade R2): reject a schema-valid report
   741	    # whose sub-fields carry wrong-typed values, so a malformed report takes the
   742	    # clean FAIL path instead of relying on a downstream comparison happening to
   743	    # be falsy. (Note: bool is an int subclass in Python — reject it explicitly so
   744	    # `findings_open: true` can't masquerade as a count.)
   745	    for rk in ("tests", "codex", "glm"):
   746	        e = data.get(rk)
   747	        if e is not None and e.get("status") is not None and e.get("status") not in ("pass", "fail"):
   748	            return None, f"{path}: {rk}.status must be 'pass' or 'fail', got {e.get('status')!r}"
   749	    for rk in ("codex", "glm"):
   750	        e = data.get(rk)
   751	        if e is not None and "findings_open" in e:
   752	            fo = e["findings_open"]
   753	            if isinstance(fo, bool) or not isinstance(fo, int) or fo < 0:
   754	                return None, f"{path}: {rk}.findings_open must be a non-negative integer"
   755	    hg = data.get("human_gate")
   756	    if hg is not None:
   757	        if "approved" in hg and not isinstance(hg["approved"], bool):
   758	            return None, f"{path}: human_gate.approved must be a boolean"
   759	        if hg.get("approver") is not None and not isinstance(hg.get("approver"), str):
   760	            return None, f"{path}: human_gate.approver must be a string"
   761	    return data, None
