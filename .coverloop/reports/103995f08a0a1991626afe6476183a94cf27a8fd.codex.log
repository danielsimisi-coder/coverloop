  1843	    def test_one_predicate_governs_the_exemption(self):
  1844	        """The bypass existed because two regexes encoded 'is this an evidence
  1845	        artifact' and only one was strict. Any future divergence reintroduces it."""
  1846	        src = open(CLI, encoding="utf-8").read()
  1847	        self.assertNotIn("_EVIDENCE_RE", src,
  1848	                         "a second artifact predicate came back")
  1849	        self.assertIn("is_report_artifact(path)", src)
