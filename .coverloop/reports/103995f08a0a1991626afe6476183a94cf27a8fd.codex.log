+def _reviewed_test_command(root, prior, base=None):
+    """(command, readable) — the test command as it stood at the last point the
+    evidence chain actually covered.
+
+    Comparing only the previous version (`rev-list -2`) could be laundered: set
+    `test_command` to `true` in one commit, touch any other config field in the
+    next, and both observed versions read `true`. So the comparison point is the
+    validated baseline `prior` — and when nothing has ever validated (the
+    baseline is the bare root, which is also what a tampered command produces,
+    since rewriting it invalidates the ancestor evidence), the config's FIRST
+    version, because the whole history is then the span being judged.
+
+    A config with only one commit touching it was created, not changed: that is
+    adoption, and a floor that fires on adoption is a floor people route around.
+    `readable` is False only when git could not answer, which fails closed.
+    """
+    history = git(["rev-list", "--reverse", "HEAD", "--", CONFIG_FILE], cwd=root)
+    if history is None:
+        return None, False
+    versions = history.split()
+    if len(versions) < 2:
+        return None, True                      # created, never changed
+
+    def _at(commit):
+        blob = git(["show", f"{commit}:{CONFIG_FILE}"], cwd=root)
+        if blob is None:
+            return None, False
+        try:
+            return (json.loads(blob) or {}).get("test_command"), True
+        except ValueError:
+            return None, False
+
+    for point in (base, prior):
+        # With --base the reviewed state is the base branch, full stop: reading
+        # the config's first-ever version there let a branch RESTORE a historical
+        # `true` over a base that runs the real suite, with no promotion at all.
+        if point:
+            cmd, ok = _at(point)
+            if not ok:
+                return None, False
+            if cmd:
+                return cmd, True
+    if base:
+        return None, False          # the base has no config to compare against
+    return _at(versions[0])
+
+
+def _reviewer_binary_fingerprints(cmds, env):
+    """sha256 of each reviewer command's resolved executable, before anything
+    else runs.
+
+    The configured test command is arbitrary code running with the operator's
+    privileges, and it runs BEFORE the reviewers. Nothing stops it overwriting
+    a user-owned reviewer wrapper with one that prints the pass marker — no
+    repository file changes, so the dirty-tree check sees nothing. This does not
+    make the test command safe (it cannot: `coverloop` is a gate, not a
+    sandbox), but it does catch the specific swap.
+    """
+    prints = {}
+    for role, cmd in (cmds or {}).items():
+        for tok in cmd.replace("|", " ").replace(";", " ").split():
+            tok = tok.strip("\"'")
+            if not tok or tok.startswith("-") or "=" in tok:
+                continue
+            exe = shutil.which(tok, path=env.get("PATH")) if not os.path.sep in tok else (
+                tok if os.path.exists(tok) else None)
+            if exe:
+                try:
+                    with open(exe, "rb") as fh:
+                        prints[role] = (exe, hashlib.sha256(fh.read()).hexdigest())
+                except OSError:
+                    prints[role] = (exe, None)
+            break                       # the command word only
+    return prints
+
