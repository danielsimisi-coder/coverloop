  2600	    def test_no_secret_filter_means_no_reviewers(self):
  2601	        # The fallback regex knows a handful of key shapes; it does not know
  2602	        # database URLs, service-role keys or Google keys. Handing a packet to
  2603	        # something that may forward it with the canonical filter missing is
  2604	        # the one case where continuing is worse than stopping.
  2605	        with tempfile.TemporaryDirectory() as d:
  2606	            run = self._repo(d, cmds={"codex": "pass.sh", "glm": "pass.sh"})
  2607	            self._write(d, "supabase/migrations/1.sql", "alter table u;\n")
  2608	            run("git", "add", "-A"); run("git", "commit", "-qm", "migrate")
  2609	            # coverloop imports the filter from its OWN directory, so a copy
  2610	            # standing alone is exactly the "filter missing" deployment.
  2611	            import shutil as _sh
  2612	            alone = os.path.join(self.policy_dir, "alone")
  2613	            os.makedirs(alone, exist_ok=True)
  2614	            solo = os.path.join(alone, "coverloop")
  2615	            _sh.copy2(CLI, solo)
  2616	            env = dict(os.environ, COVERLOOP_REVIEWERS=self.policy, PYTHONPATH="")
  2617	            r = subprocess.run([sys.executable, solo, "check"], cwd=d,
  2618	                               capture_output=True, text=True, env=env)
  2619	            self.assertEqual(r.returncode, 1, r.stdout + r.stderr)
  2620	            self.assertIn("secret filter", r.stderr)
