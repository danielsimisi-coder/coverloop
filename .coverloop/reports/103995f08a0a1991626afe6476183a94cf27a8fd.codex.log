   259	
   260	def _resolve_commit(ref, cwd):
   261	    """Resolve a user-supplied ref to a commit id, or None.
   262	
   263	    `--base` reaches `git diff` as a positional, so an option-shaped value was
   264	    read as a FLAG: `--base=--cached` diffed the index, found nothing to classify,
   265	    and the gate passed. `--end-of-options` stops git parsing further flags, and
   266	    demanding a 40-hex answer means nothing but a real commit gets through.
   267	    """
   268	    out = git(["rev-parse", "--verify", "--quiet", "--end-of-options",
   269	               f"{ref}^{{commit}}"], cwd=cwd)
   270	    if not out:
   271	        return None
   272	    out = out.strip()
   273	    return out if re.fullmatch(r"[0-9a-f]{40}", out) else None
   274	
   275	
   276	def _git_paths(args, cwd):
   277	    """Git path output, parsed losslessly. Returns None if git failed.
   278	
   279	    Two ways the old `--name-only` + splitlines() collection lost paths, and both
   280	    are classifier EVASION, not cosmetics:
   281	
   282	      * rename detection reported only the DESTINATION, so moving
   283	        src/authGuard.ts to src/guard.ts made an auth change look like an
   284	        unrecognised source file. `--no-renames` reports both sides.
   285	      * git C-quotes any name containing a newline or tab, and splitlines() then
   286	        tore that single path into two meaningless fragments. `-z` emits raw
   287	        names separated by NUL, so there is nothing to quote and nothing to tear.
   288	    """
   289	    # `--no-renames` is a diff option; ls-files rejects it, and appending it
   290	    # blindly made every collection return None — which the caller then, quite
   291	    # correctly, read as "cannot determine the paths" and held at L1. Correct
   292	    # fail-closed behaviour, wrong cause, and it would have masked the evasion
   293	    # fix it was meant to deliver.
   294	    # `show` takes diff options too, and it defaults to rename detection just
   295	    # like `diff` — scoping the flag to `diff` alone let the root-commit fallback
   296	    # lose a rename origin again, one commit after that hole was closed.
   297	    # `ls-files` is the only caller here that rejects it.
   298	    extra = (["--no-renames", "-z"] if args and args[0] in ("diff", "show")
   299	             else ["-z"])
   300	    out = git(args + extra, cwd=cwd)
   301	    if out is None:
   302	        return None
   303	    # Only EMPTY segments are dropped — a filename that is entirely whitespace
   304	    # is a real (and suspicious) file, and discarding it produced an empty,
   305	    # L0 change set.
   306	    return [p for p in out.split("\0") if p]
   307	
   308	
   309	def _changed_paths_for_gate(root, args):
   310	    """Paths this gate run is judging: the PR range if --base was given (CI),
   311	    else the working tree plus untracked files (local)."""
   312	    base = getattr(args, "base", None)
   313	    if base:
   314	        base = _resolve_commit(base, root)
   315	        if base is None:
   316	            return []
   317	        out = _git_paths(["diff", "--name-only", f"{base}...HEAD"], root)
   318	        if out is None:
   319	            out = _git_paths(["diff", "--name-only", base, "HEAD"], root)
   320	        return out or []
   321	    tracked = _git_paths(["diff", "--name-only", "HEAD"], root) or []
   322	    untracked = _git_paths(["ls-files", "--others", "--exclude-standard"], root) or []
   323	    return list(tracked) + list(untracked)
