   609	def git(args, cwd=None):
   610	    """Run a git command; return stdout or None on failure."""
   611	    try:
   612	        out = subprocess.run(
   613	            ["git"] + args, cwd=cwd, capture_output=True, text=True, timeout=30,
   614	            # Strict UTF-8 made a non-decodable FILENAME raise, which the gate
   615	            # caught and softened to an L1 floor — an L3 change passing on tests
   616	            # alone because someone's file was latin-1. surrogateescape keeps the
   617	            # bytes intact and round-trippable, so the path is classified rather
   618	            # than lost.
   619	            errors="surrogateescape",
   620	        )
   621	    except (OSError, subprocess.TimeoutExpired):
   622	        return None
   623	    if out.returncode != 0:
   624	        return None
   625	    # NUL-delimited output is a list of RAW pathnames: a leading or trailing
   626	    # space is part of a filename, not formatting. Stripping it re-created the
   627	    # exemption bypass one layer below classify_paths(), where the tests could
   628	    # not see it — " .coverloop/reports/<sha>.json" became the exact exempt
   629	    # shape again. Only line-oriented output gets the convenience strip.
   630	    if "-z" in args:
   631	        return out.stdout
   632	    return out.stdout.strip()
   633	
