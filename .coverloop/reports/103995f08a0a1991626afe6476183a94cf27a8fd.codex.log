   510	
   511	def classify_paths(paths, breadth_threshold=BREADTH_L2_FILES):
   512	    """Derive the deterministic tier FLOOR for a set of changed paths.
   513	
   514	    Returns (tier, reasons) where reasons is an ordered, de-duplicated list of
   515	    "<tier>: <why> (<example path>)" strings — the audit trail for the verdict.
   516	    An empty change set is L0 with no reasons; it asserts nothing.
   517	    """
   518	    # RAW git paths — no .strip(). Stripping first meant `<sha>.json ` and
   519	    # ` <sha>.glm.log` (trailing space, leading space, tab) were normalised INTO
   520	    # the exempt artifact shape, so an arbitrary file could take the evidence
   521	    # exemption and skip the L1 floor. git reports the real name; a name with
   522	    # surrounding whitespace is a DIFFERENT, and more suspicious, file.
   523	    paths = [p for p in paths if p]
   524	    if not paths:
   525	        return "L0", []
   526	    tier = "L0"
   527	    reasons, seen = [], set()
   528	    for path in paths:
   529	        matched = None
   530	        # Prose and styling are inert whatever they are NAMED. The name rules run
   531	        # first and match anywhere in the path, so docs/authGuide.md,
   532	        # docs/workerPool.md and docs/credentialsGuide.md were all classified L3 —
   533	        # a floor that demands a red-team review of a markdown file is a floor
   534	        # people learn to route around, which costs more than it ever protects.
   535	        # ...unless the name itself carries meaning. requirements.txt is a
   536	        # dependency manifest that happens to end in .txt, and the blanket inert
   537	        # shortcut demoted it from L2 to L0 — a regression introduced by the fix
   538	        # for documentation false positives.
   539	        if _INERT_RE.search(path) or is_report_artifact(path):
   540	            matched = ("L0", "documentation / styling (inert regardless of name)")
   541	        for rule_tier, rx, why in (() if matched else _RISK_RULES_C):
   542	            if rx.search(path):
   543	                matched = (rule_tier, why)
   544	                break
   545	        # Unrecognised => L1. Silence is not safety.
   546	        if matched is None:
   547	            matched = ("L1", "source change (no specific rule matched)")
   548	        rule_tier, why = matched
   549	        tier = tier_max(tier, rule_tier)
   550	        key = (rule_tier, why)
   551	        if key not in seen:
   552	            seen.add(key)
   553	            reasons.append(f"{rule_tier}: {why} ({path})")
   554	    if len(paths) >= breadth_threshold:
   555	        tier = tier_max(tier, "L2")
   556	        reasons.append(f"L2: breadth — {len(paths)} files changed "
   557	                       f"(>= {breadth_threshold})")
   558	    return tier, reasons
   559	
   560	# A committed EVIDENCE ARTIFACT under .coverloop/reports/ — EXACT name shapes
   561	# only: <40-hex commit sha>.json, or <sha>.<reviewer>.log. Anything else under
   562	# reports/ (e.g. .coverloop/reports/backdoor.py) is a NORMAL code file: not
   563	# "evidence-only", not test-waivable. This is what stops code being smuggled in
   564	# under the reports/ prefix.
   565	# `\Z`, not `$`: Python's `$` also matches BEFORE a final newline, so
   566	# "<sha>.json\n" satisfied the artifact shape and took the exemption.
   567	REPORT_ARTIFACT_RE = re.compile(
   568	    r"^" + re.escape(REPORTS_DIR + "/")
   569	    + r"[0-9a-f]{40}(?:\.json|\.(?:codex|glm)\.log)\Z")
   570	
   571	# Documentation for the L1 test-gate waiver. Deliberately strict so a code file
   572	# cannot masquerade as docs: an EXACT root-level doc file, or a doc-suffixed
   573	# file UNDER docs/. Never a basename match elsewhere; never a bare .txt/.rst
   574	# outside docs/ (a runtime-loaded config.txt or docs/deploy.sh is NOT a doc).
   575	DOC_SUFFIXES = (".md", ".txt", ".rst")
   576	DOC_ROOT = "docs/"
   577	ROOT_DOC_FILES = ("LICENSE", "CHANGELOG", "CHANGELOG.md", "README.md")
   578	
   579	
   580	def tier_max(*tiers):
   581	    """Highest tier among the args (None/unknown-safe). TIERS is low->high.
   582	    Used so a pinned --min-tier can only ever RAISE the requirement."""
   583	    best = None
   584	    for t in tiers:
   585	        if t in TIERS and (best is None or TIERS.index(t) > TIERS.index(best)):
   586	            best = t
   587	    return best
   588	
   589	
   590	def is_report_artifact(f):
   591	    """True iff f is exactly a committed report JSON or reviewer transcript."""
   592	    return bool(REPORT_ARTIFACT_RE.fullmatch(f))
   593	
   594	
   595	def is_doc_file(f):
   596	    """True iff f is documentation for the L1 waiver (never executable code)."""
   597	    if f in ROOT_DOC_FILES:
   598	        return True
   599	    if f.startswith(DOC_ROOT) and f.endswith(DOC_SUFFIXES):
   600	        return True
   601	    return False
