  1853	class TenthRoundDerivedTierAndCheck(unittest.TestCase):
  1854	    """v2.11: the tier is DERIVED from the gate's own floor semantics, reviewed
  1855	    evidence advances the baseline without a human signature, and `coverloop
  1856	    check` is the one command a builder runs at the merge boundary.
  1857	
  1858	    Every case here is a falsification from the research pass — each asserts
  1859	    the thing that would silently weaken if the change were wrong.
  1860	    """
  1861	
  1862	    @classmethod
  1863	    def setUpClass(cls):
  1864	        cls.mod = _load_coverloop()
  1865	
  1866	    # ---- fixtures -------------------------------------------------------
  1867	    def setUp(self):
  1868	        # The reviewer policy is deliberately OUTSIDE the repo under review, so
  1869	        # every fixture keeps it in its own directory.
  1870	        self.policy_dir = tempfile.mkdtemp()
  1871	        self.policy = os.path.join(self.policy_dir, "reviewers.json")
  1872	
  1873	    def tearDown(self):
  1874	        import shutil as _sh
  1875	        _sh.rmtree(self.policy_dir, ignore_errors=True)
  1876	
  1877	    def _policy(self, reviewers=None, cmds=None, mode=0o600):
  1878	        body = {"reviewers": reviewers or {"primary": "codex", "secondary": "glm"},
  1879	                "reviewer_commands": cmds if cmds is not None else {}}
  1880	        with open(self.policy, "w") as fh:
  1881	            json.dump(body, fh)
  1882	        os.chmod(self.policy, mode)
  1883	        return self.policy
  1884	
  1885	    def _repo(self, d, reviewers=None, cmds=None):
  1886	        run = lambda *a, **k: subprocess.run(a, cwd=d, capture_output=True, text=True, **k)
  1887	        run("git", "init", "-q", "-b", "main", ".")
  1888	        run("git", "config", "user.email", "[REDACTED:email]")
  1889	        run("git", "config", "user.name", "t")
  1890	        for name, body in (("pass.sh", 'echo reviewed\necho "VERDICT: PASS"\n'),
  1891	                           ("fail.sh", 'echo "found it"\necho "VERDICT: FAIL"\n')):
  1892	            p = os.path.join(self.policy_dir, name)
  1893	            open(p, "w").write("#!/bin/sh\n" + body)
  1894	            os.chmod(p, 0o755)
  1895	        open(os.path.join(d, "README.md"), "w").write("x\n")
  1896	        run("git", "add", "-A"); run("git", "commit", "-qm", "init")
  1897	        self._cl(d, "init")
  1898	        cfg_path = os.path.join(d, ".coverloop", "config.json")
  1899	        cfg = json.load(open(cfg_path))
  1900	        cfg["test_command"] = "true"
  1901	        json.dump(cfg, open(cfg_path, "w"), indent=2)
  1902	        # Reviewer commands are paths inside the repo (the stubs above) but the
  1903	        # POLICY naming them lives outside it — that is the whole point.
  1904	        if cmds:
  1905	            cmds = {k: os.path.join(self.policy_dir, v.lstrip("./bin/"))
  1906	                    for k, v in cmds.items()}
  1907	        self._policy(reviewers, cmds)
  1908	        run("git", "add", "-A"); run("git", "commit", "-qm", "coverloop")
  1909	        return run
  1910	
  1911	    def _cl(self, d, *a, policy=None):
  1912	        env = dict(os.environ)
  1913	        env["COVERLOOP_REVIEWERS"] = policy or self.policy
  1914	        return subprocess.run([sys.executable, CLI] + list(a), cwd=d,
  1915	                              capture_output=True, text=True, env=env)
  1916	
  1917	    def _write(self, d, rel, body="x\n"):
  1918	        p = os.path.join(d, rel)
  1919	        os.makedirs(os.path.dirname(p), exist_ok=True)
  1920	        open(p, "w").write(body)
  1921	
  1922	    def _report(self, d):
  1923	        # HEAD's report — NOT sorted(...)[-1], which orders by SHA hex and so
  1924	        # picks an arbitrary older report once a repo has more than one.
  1925	        head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=d,
  1926	                              capture_output=True, text=True).stdout.strip()
  1927	        return json.load(open(os.path.join(d, ".coverloop", "reports", head + ".json")))
