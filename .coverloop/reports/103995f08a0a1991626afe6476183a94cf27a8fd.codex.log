   417	def _gate_floor_paths(root, args, report, sha):
   418	    """Every path this gate run is judging, and whether that set is TRUSTWORTHY.
   419	
   420	    Returns (paths, unknown). `unknown` means git could not answer, and the caller
   421	    must fail closed rather than read the resulting empty list as "nothing risky".
   422	
   423	    The first cut of the auto-floor asked only for uncommitted changes, which is
   424	    empty in the ordinary case — you commit, THEN run the gate — so `gate
   425	    --min-tier L0` still passed over a committed migration. The set therefore
   426	    also spans the commits the recorded evidence does not cover: from the report's
   427	    commit to HEAD, or the commit being gated when there is no report at all.
   428	    """
   429	    base = getattr(args, "base", None)
   430	    if base:
   431	        # Resolve to a commit id FIRST. `--base=--cached` was passed through to
   432	        # `git diff` as an OPTION, which diffed the index, found nothing, and
   433	        # gated clean. Anything that does not resolve to a commit is refused
   434	        # before it can reach git as a flag.
   435	        base = _resolve_commit(base, root)
   436	        if base is None:
   437	            return [], True
   438	        out = _git_paths(["diff", "--name-only", f"{base}...HEAD"], root)
   439	        if out is None:
   440	            out = _git_paths(["diff", "--name-only", base, "HEAD"], root)
   441	        if out is None:
   442	            # An unresolvable --base is a caller error, not an all-clear. Reading
   443	            # it as "no files changed" turned a typo into a passing gate.
   444	            return [], True
   445	        return out, False
   446	
   447	    tracked = _git_paths(["diff", "--name-only", "HEAD"], root)
   448	    untracked = _git_paths(["ls-files", "--others", "--exclude-standard"], root)
   449	    if tracked is None or untracked is None:
   450	        return [], True
   451	    paths = list(tracked) + list(untracked)
   452	
   453	    # ...plus whatever the evidence does not already cover.
   454	    # The commit being gated is ALWAYS classified, including when the evidence
   455	    # sits on it. The old expression returned None in exactly that case — the
   500	            own = _git_paths(["show", "--name-only", "--pretty=format:", prior], root)
   501	            out = None if own is None else out + own
   502	    if out is None:
   503	        # `or []` here once turned a git timeout, a shallow clone, a corrupt
   504	        # object or a bad origin_commit into an EMPTY path set with
   505	        # unknown=False — an all-clear built out of a failure.
   506	        return sorted(set(paths)), True
   507	    paths += out
   508	    return sorted(set(paths)), False
