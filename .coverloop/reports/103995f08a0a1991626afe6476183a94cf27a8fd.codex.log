   853	@contextlib.contextmanager
   854	def open_write(root, path):
   855	    """ATOMICALLY write PATH (which MUST live directly inside
   856	    <root>/.coverloop/reports/): the caller writes to a private temp file in the
   857	    same dir; on clean exit the temp is fsync'd and os.replace'd over PATH, so a
   858	    reader (gate) sees either the OLD file or the fully-written NEW one, never a
   859	    torn/partial report (Sol R3: a plain open()+dump is not atomic, so a
   860	    concurrent reader or a killed writer could observe a truncated file). On
   861	    POSIX the containing directory is also fsync'd so the rename survives a crash;
   862	    on platforms without dir-fd support this degrades to a path-based replace
   863	    (atomic on the OS, best-effort directory durability). Still refuses any
   864	    symlink in the reports path and disables newline translation.
   865	
   866	    Audit fixes (2026-07-11): (1) evidence WRITES used a plain open() that would
   867	    follow a pre-planted destination symlink and overwrite an arbitrary off-tree
   868	    file; the read paths guarded symlinks but the writers did not. (2) text-mode
   869	    writes translated '\\n'->'\\r\\n' on Windows while output_sha256 is hashed over
   870	    the untranslated string, so verify_capture rejected its own untampered
   871	    evidence there; newline='' keeps on-disk bytes == hashed bytes everywhere.
   872	
   873	    Symlink defense mirrors the read-side guard and covers the whole PARENT
   874	    CHAIN, not just the final component (Sol v2.7.3 grade): the file's resolved
   875	    parent must BE the real reports dir (so a symlinked `.coverloop/` or
   876	    `reports/` ancestor can't relocate the write off-tree), and the final
   877	    component must not be a symlink (portable, holds where O_NOFOLLOW is absent).
   878	
   879	    Where the platform supports it (POSIX), the actual write additionally goes
   880	    through a PINNED directory fd (open the reports dir O_DIRECTORY|O_NOFOLLOW,
   881	    fstat-verify it IS the real reports dir, then openat the basename relative to
   882	    that fd): once the dir fd is pinned, swapping `reports/` for a symlink AFTER
   883	    the path check can no longer redirect the write — closing the parent-swap
   884	    TOCTOU race (Sol Round-1 review). Windows (no dir_fd/O_DIRECTORY) keeps the
   885	    path-based check + O_NOFOLLOW best-effort."""
   886	    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
   887	    if (os.path.realpath(reports_real) != reports_real          # .coverloop or reports/ is a symlink
   888	            or os.path.islink(path)                             # final component pre-planted as a symlink
   889	            or os.path.dirname(os.path.realpath(path)) != reports_real):  # resolves outside the real reports dir
   890	        fail_usage(f"refusing to write evidence outside the real reports dir (symlinked path): {path}")
   891	    o_nofollow = getattr(os, "O_NOFOLLOW", 0)
