  2397	def _reviewed_test_command(root, prior, base=None):
  2398	    """(command, readable) — the test command as it stood at the last point the
  2399	    evidence chain actually covered.
  2400	
  2401	    Comparing only the previous version (`rev-list -2`) could be laundered: set
  2402	    `test_command` to `true` in one commit, touch any other config field in the
  2403	    next, and both observed versions read `true`. So the comparison point is the
  2404	    validated baseline `prior` — and when nothing has ever validated (the
  2405	    baseline is the bare root, which is also what a tampered command produces,
  2406	    since rewriting it invalidates the ancestor evidence), the config's FIRST
  2407	    version, because the whole history is then the span being judged.
  2408	
  2409	    A config with only one commit touching it was created, not changed: that is
  2410	    adoption, and a floor that fires on adoption is a floor people route around.
  2411	    `readable` is False only when git could not answer, which fails closed.
  2412	    """
  2413	    history = git(["rev-list", "--reverse", "HEAD", "--", CONFIG_FILE], cwd=root)
  2414	    if history is None:
  2415	        return None, False
  2416	    versions = history.split()
  2417	    if len(versions) < 2:
  2418	        return None, True                      # created, never changed
  2419	
  2420	    def _at(commit):
  2421	        blob = git(["show", f"{commit}:{CONFIG_FILE}"], cwd=root)
  2422	        if blob is None:
  2423	            return None, False
  2424	        try:
  2425	            return (json.loads(blob) or {}).get("test_command"), True
  2426	        except ValueError:
  2427	            return None, False
  2428	
  2429	    for point in (base, prior):
  2430	        # With --base the reviewed state is the base branch, full stop: reading
  2431	        # the config's first-ever version there let a branch RESTORE a historical
  2432	        # `true` over a base that runs the real suite, with no promotion at all.
  2433	        if point:
  2434	            cmd, ok = _at(point)
  2435	            if not ok:
  2436	                return None, False
  2437	            if cmd:
  2438	                return cmd, True
  2439	    if base:
  2440	        return None, False          # the base has no config to compare against
  2441	    return _at(versions[0])
  2442	
  2443	
  2444	def _reviewer_binary_fingerprints(cmds, env):
  2445	    """sha256 of each reviewer command's resolved executable, before anything
  2446	    else runs.
  2447	
  2448	    The configured test command is arbitrary code running with the operator's
  2449	    privileges, and it runs BEFORE the reviewers. Nothing stops it overwriting
  2450	    a user-owned reviewer wrapper with one that prints the pass marker — no
  2451	    repository file changes, so the dirty-tree check sees nothing. This does not
  2452	    make the test command safe (it cannot: `coverloop` is a gate, not a
  2453	    sandbox), but it does catch the specific swap.
  2454	    """
  2455	    prints = {}
  2456	    for role, cmd in (cmds or {}).items():
  2457	        for tok in cmd.replace("|", " ").replace(";", " ").split():
  2458	            tok = tok.strip("\"'")
  2459	            if not tok or tok.startswith("-") or "=" in tok:
  2460	                continue
  2461	            exe = shutil.which(tok, path=env.get("PATH")) if not os.path.sep in tok else (
  2462	                tok if os.path.exists(tok) else None)
  2463	            if exe:
  2464	                try:
  2465	                    with open(exe, "rb") as fh:
  2466	                        prints[role] = (exe, hashlib.sha256(fh.read()).hexdigest())
  2467	                except OSError:
  2468	                    prints[role] = (exe, None)
  2469	            break                       # the command word only
  2470	    return prints
  2471	
