  1610	    # copy of the placeholder. Matching the WHOLE line (not a substring) means a
  1611	    # real review that merely quotes the marker still passes. (full audit +
  1612	    # Sol verify 2026-07-11 P1)
  1613	    if WITHHELD_RE.match(data.decode("utf-8", errors="replace").strip()):
