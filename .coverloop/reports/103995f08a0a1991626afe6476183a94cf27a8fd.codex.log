  2303	def reviewer_policy(root):
  2304	    """Load WHO reviews and WHAT COMMAND runs them, from a trusted source.
  2305	
  2306	    The independence of the review is the whole product. If the commands lived
  2307	    in the repository, a diff could replace its own reviewer with a stub that
  2308	    prints the canonical pass marker, and `check` would dutifully run it — the
  2309	    change under review would be signing its own evidence. So the policy is
  2310	    read from the operator's own machine, never from the worktree, and it is
  2311	    refused if it is reachable from inside the repo (a symlink or a path under
  2312	    the root) or if anyone but the owner can write it.
  2313	
  2314	    Returns (policy, None) or (None, reason).
  2315	    """
  2316	    path = _reviewer_policy_path()
  2317	    real = os.path.realpath(path)
  2318	    root_real = os.path.realpath(root)
  2319	    if real == root_real or real.startswith(root_real + os.sep):
  2320	        return None, (f"reviewer policy {path} resolves inside the repository under review "
  2321	                      f"({real}) — the reviewer must not be nominated by the change")
  2322	    try:
  2323	        st = os.lstat(real)
  2324	    except OSError:
  2325	        return None, (f"no reviewer policy at {path}. Create it (outside any repo) as:\n"
  2326	                      '  {"reviewers": {"primary": "codex", "secondary": "glm"},\n'
  2327	                      '   "reviewer_commands": {"codex": "<cold review cmd>", '
  2328	                      '"glm": "<red-team cmd>"}}\n'
  2329	                      "  Each command must make its reviewer end with the line "
  2330	                      "'VERDICT: PASS' or 'VERDICT: FAIL'.")
  2331	    if not stat.S_ISREG(st.st_mode):
  2332	        return None, f"reviewer policy {path} is not a regular file"
  2333	    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
  2334	        return None, (f"reviewer policy {path} is group/world-writable "
  2335	                      f"({oct(st.st_mode & 0o777)}) — anyone could swap the reviewer; "
  2336	                      f"run: chmod 600 {path}")
  2337	    data, err = load_json(real)
  2338	    if err:
  2339	        return None, f"reviewer policy {path}: {err}"
  2340	    data = data or {}
  2341	    roles = data.get("reviewers") or {}
  2342	    primary = roles.get("primary", "codex")
  2343	    secondary = roles.get("secondary", "glm")
  2344	    if (primary not in ("codex", "glm") or secondary not in ("codex", "glm")
  2345	            or primary == secondary):
  2346	        return None, (f"reviewer policy {path}: reviewers must name two distinct roles from "
  2347	                      "{codex, glm} (report keys are fixed for compatibility)")
  2348	    cmds = data.get("reviewer_commands") or {}
  2349	    if not isinstance(cmds, dict) or any(not isinstance(v, str) for v in cmds.values()):
  2350	        return None, f"reviewer policy {path}: reviewer_commands must map a role to a command string"
  2351	    # Naming the reviewer outside the repo is not enough if the command it
  2352	    # names lives INSIDE it: the change could then edit its own reviewer to
  2353	    # print the pass marker. Refuse any token of the command that resolves to
  2354	    # a path under the repo root. Heuristic on purpose — it is a word-split,
  2355	    # not a shell parser — but it fails CLOSED and catches the whole class
  2356	    # ("./bin/review.sh", "scripts/review.sh", an absolute path into the tree).
  2357	    for role, cmd in cmds.items():
  2358	        for tok in cmd.replace("|", " ").replace(";", " ").split():
  2359	            tok = tok.strip("\"'")
  2360	            if not tok or tok.startswith("-") or tok in (".", ".."):
  2361	                continue
  2362	            cand = os.path.realpath(os.path.join(root_real, tok)) if not os.path.isabs(tok) \
  2363	                else os.path.realpath(tok)
  2364	            if not (cand.startswith(root_real + os.sep) and os.path.isfile(cand)):
  2365	                continue
  2366	            # ANY regular file in the tree, not just an executable one:
  2367	            # `sh scripts/reviewer` runs an extensionless, non-executable file
  2368	            # just as well, and the repository controls its contents either way.
  2369	            # Directories still pass, which is what keeps a pathspec
  2370	            # ("git diff -- .") from tripping this.
  2371	            return None, (f"reviewer policy {path}: the {role} command names {tok!r}, a file "
  2372	                          f"inside the repository under review — the change could rewrite its "
  2373	                          f"own reviewer. Point it at a command outside the repo.")
  2374	    return {"path": path, "primary": primary, "secondary": secondary, "commands": cmds}, None
  2375	
