  2664	        tier=None, raise_tier=raise_to if raise_to and raise_to != floor else None,
  2665	        reason=reason or None, force=False, tests=True,
  2666	        codex=None, codex_findings=None, codex_run=None, codex_log=None,
  2667	        glm=None, glm_findings=None, glm_run=None, glm_log=None,
  2668	        approve=False, approver=None, base=getattr(args, "base", None), quiet=True,
  2669	        reviewer_cwd=review_dir, reviewer_env=review_env)
  2670	    # `test_command` is what "tests: pass" MEANS, and reviewers only run at
  2671	    # L2/L3. A commit that rewrites it to `true` is ordinary L1 source by path,
  2672	    # so it earned SAFE TO MERGE with no meaningful tests and no independent
  2673	    # review. Classifying the config FILE was too blunt — it sits in the first
  2674	    # span of every repo after `init`, and a floor that fires on adoption is a
  2675	    # floor people route around. What needs the review is the CHANGE to it.
  2875	    sys.exit(0)
