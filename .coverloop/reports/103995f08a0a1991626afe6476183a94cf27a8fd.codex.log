  1826	    def test_every_path_collector_uses_the_raw_collector(self):
  1827	        """The bypass reappeared twice at a lower layer, so this asserts the
  1828	        STRUCTURE rather than another instance: no pathname-producing git call
  1829	        may bypass _git_paths(), because each one that does re-opens the
  1830	        normalisation hole in its own caller."""
  1831	        src = open(CLI, encoding="utf-8").read()
  1832	        offenders = []
  1833	        for lineno, line in enumerate(src.splitlines(), 1):
  1834	            if '"--name-only"' not in line and '"--others"' not in line:
  1835	                continue  # prose mentioning the flag is not a call site
  1836	            if "_git_paths(" in line or line.lstrip().startswith("#"):
  1837	                continue
  1838	            offenders.append(f"{lineno}: {line.strip()[:70]}")
  1839	        self.assertFalse(offenders,
  1840	                         "path-producing git calls outside _git_paths():\n"
  1841	                         + "\n".join(offenders))
