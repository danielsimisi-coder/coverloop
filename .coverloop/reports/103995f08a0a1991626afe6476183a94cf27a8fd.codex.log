   831	def _fsync_fd(fd):
   832	    """Best-effort fsync of an already-open fd (used to durably persist a
   833	    directory's rename entry). Never fatal — durability is a bonus, not a
   834	    correctness precondition, and some platforms/filesystems reject dir fsync."""
   835	    try:
   836	        os.fsync(fd)
   837	    except OSError:
   838	        pass
