  2380	def _cleanup_scratch():
  2381	    """Remove the reviewer scratch dirs. They hold a full copy of the source
  2382	    diff, so leaving one behind on every run — including every failure path —
  2383	    scatters the reviewed code across /tmp."""
  2384	    while _SCRATCH_DIRS:
  2385	        shutil.rmtree(_SCRATCH_DIRS.pop(), ignore_errors=True)
