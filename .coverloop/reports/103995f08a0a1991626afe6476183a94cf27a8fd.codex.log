  2878	def _emit(args, sha, tier, verdict, checks):
  2879	    # CI annotations go to STDERR so they also work alongside --json
  2880	    # (stdout stays pure JSON for tooling; GitHub reads both streams).
  2881	    if args.ci:
  2882	        for c in checks:
  2883	            if c["status"] != "pass":
  2884	                print(f"::error title=coverloop gate::{c['check']}: {c['detail']}",
  2885	                      file=sys.stderr)
  2886	    if args.json:
  2887	        print(json.dumps(
  2888	            {"schema": "coverloop-gate/v1", "commit": sha, "tier": tier,
  2889	             "verdict": "pass" if verdict else "fail", "checks": checks},
  2890	            indent=2,
  2891	        ))
  2892	        return
  2893	    print(f"coverloop gate — commit {sha[:12]} — tier {tier}")
  2894	    for c in checks:
  2895	        mark = "✔" if c["status"] == "pass" else "✘"
  2896	        print(f"  {mark} {c['check']:<11} {c['detail']}")
  2897	    print(f"VERDICT: {'PASS' if verdict else 'FAIL — required evidence missing or failing'}")
  2898	
