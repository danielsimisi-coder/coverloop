  2344	    if (primary not in ("codex", "glm") or secondary not in ("codex", "glm")
  2345	            or primary == secondary):
  2346	        return None, (f"reviewer policy {path}: reviewers must name two distinct roles from "
  2347	                      "{codex, glm} (report keys are fixed for compatibility)")
  2348	    cmds = data.get("reviewer_commands") or {}
  2349	    if not isinstance(cmds, dict) or any(not isinstance(v, str) for v in cmds.values()):
  2350	        return None, f"reviewer policy {path}: reviewer_commands must map a role to a command string"
  2351	    # Naming the reviewer outside the repo is not enough if the command it
  2352	    # names lives INSIDE it: the change could then edit its own reviewer to
  2353	    # print the pass marker. Refuse any token of the command that resolves to
  2354	    # a path under the repo root. Heuristic on purpose — it is a word-split,
  2355	    # not a shell parser — but it fails CLOSED and catches the whole class
  2356	    # ("./bin/review.sh", "scripts/review.sh", an absolute path into the tree).
  2357	    for role, cmd in cmds.items():
  2358	        for tok in cmd.replace("|", " ").replace(";", " ").split():
  2359	            tok = tok.strip("\"'")
  2360	            if not tok or tok.startswith("-") or tok in (".", ".."):
  2361	                continue
  2362	            cand = os.path.realpath(os.path.join(root_real, tok)) if not os.path.isabs(tok) \
  2363	                else os.path.realpath(tok)
  2364	            if not (cand.startswith(root_real + os.sep) and os.path.isfile(cand)):
  2365	                continue
