   781	def find_report(root, head):
   782	    """Locate the report that governs HEAD.
   783	
   784	    Returns (report, reason, malformed):
   785	      * exact HEAD report when present;
   786	      * else a report bound to a first-parent ancestor, accepted ONLY if the
   787	        diff ancestor..HEAD touches nothing but evidence files (this is what
   788	        makes "attest, commit the report, gate in CI" possible);
   789	      * (None, why, True) when a report file exists but is corrupt, forged,
   790	        or SHA-mismatched — malformed evidence fails EVERY tier;
   791	      * (None, why, False) when no usable report exists.
   792	    """
   793	    path = report_path(root, head)
   794	    if os.path.exists(path):
   795	        report, why = load_report(root, head)
   796	        if report is None:
   797	            return None, why, True
   798	        return report, None, False
   799	    for i in range(1, EVIDENCE_WALK_LIMIT + 1):
   800	        anc = git(["rev-parse", f"{head}~{i}"], cwd=root)
   801	        if not anc:
   802	            break
   803	        if not os.path.exists(report_path(root, anc)):
   804	            continue
   805	        report, why = load_report(root, anc)
   806	        if report is None:
   807	            return None, why, True
   808	        if only_evidence_changed(root, anc, head):
   809	            return report, None, False
   810	        return None, (f"evidence at {anc[:12]} is STALE: non-evidence files "
   811	                      f"changed between it and HEAD — re-run the loop"), False
