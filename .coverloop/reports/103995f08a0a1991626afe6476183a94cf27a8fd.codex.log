  2261	def transcript_verdict(text):
  2262	    """Return "pass" only for an unambiguous canonical PASS marker at the end.
  2263	
  2264	    Three conditions, all fail-closed:
  2265	      * at least one `VERDICT:` line exists;
  2266	      * EVERY such line is byte-for-byte "VERDICT: PASS" after trimming — no
  2267	        "PASS WITH RISKS", no lowercase, no "APPROVE";
  2268	      * nothing but a short CLI footer follows it, so it is the reviewer's
  2269	        closing word rather than something near the top.
  2270	
  2271	    The whole transcript is read, not a tail window: a review that says FAIL and
  2272	    then emits 5 KB of appendix would otherwise have its failure scroll out of
  2273	    view. The closing-position rule is the other half of the same idea — a
  2274	    prompt echo containing the marker, followed by a review that never reaches a
  2275	    verdict, must not count as approval. The small allowance exists because real
  2276	    reviewers append a footer (Codex prints "tokens used" and a count after its
  2277	    reply); it is not room for review content.
  2278	    """
  2279	    lines = (text or "").splitlines()
  2280	    live = [(i, ln.strip()) for i, ln in enumerate(lines) if ln.strip()]
  2281	    markers = [(n, body) for n, (i, body) in enumerate(live) if _VERDICT_MARKER.match(lines[i])]
