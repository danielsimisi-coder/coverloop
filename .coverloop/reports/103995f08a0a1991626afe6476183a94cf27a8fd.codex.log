    81	# ---- generators for real secret SHAPES (one valid instance per VALUE pattern) ----
    82	def _rand(rng, alphabet, n):
    83	    return "".join(rng.choice(alphabet) for _ in range(n))
    84	
    85	
    86	def gen_secret(rng):
    87	    """Return (secret_value, label) for a randomly chosen real secret shape."""
    88	    b64 = string.ascii_letters + string.digits + "_-"
    89	    kind = rng.choice([
    90	        "sk", "ghp", "aws", "slack", "google", "jwt", "bearer", "dburl", "assign", "pem",
    91	    ])
    92	    if kind == "sk":
    93	        return "sk-" + _rand(rng, b64, rng.randint(20, 48)), "sk-key"
    94	    if kind == "ghp":
    95	        return "ghp_" + _rand(rng, string.ascii_letters + string.digits + "_", rng.randint(20, 40)), "github-token"
    96	    if kind == "aws":
    97	        return "AKIA" + _rand(rng, string.digits + string.ascii_uppercase, 16), "aws-key"
    98	    if kind == "slack":
    99	        return "xoxb-" + _rand(rng, string.ascii_letters + string.digits + "-", rng.randint(10, 30)), "slack-token"
   100	    if kind == "google":
   101	        return "AIza" + _rand(rng, b64, 35), "google-key"
   102	    if kind == "jwt":
   103	        return ("eyJ" + _rand(rng, b64, rng.randint(8, 20)) + "." +
   104	                _rand(rng, b64, rng.randint(8, 20)) + "." + _rand(rng, b64, rng.randint(6, 20))), "jwt"
   105	    if kind == "bearer":
   106	        return "bearer " + _rand(rng, string.ascii_letters + string.digits + "._~+/=-", rng.randint(16, 40)), "bearer"
   107	    if kind == "dburl":
   108	        return ("postgres://" + _rand(rng, string.ascii_lowercase, 6) + ":" +
   109	                _rand(rng, b64, 10) + "@host/db"), "db-url-cred"
   110	    if kind == "assign":
   111	        # 2026-07-15a boundary: env-style (=) assignments block at ANY value; colon-style blocks
   112	        # for quoted opaque literals >= 8 chars. Generate only the still-blocking class here —
   113	        # the colon-style code idioms scan() now deliberately allows are pinned the other way in
   114	        # AssignmentScanBoundary below.
   115	        name = rng.choice(["API_KEY", "X_SECRET", "DB_PASSWORD", "AUTH_TOKEN", "MY_API_KEY", "z_passwd"])
  1820	                self.skipTest("filesystem rejects leading-space names")
  1821	            r = subprocess.run([CLI, "classify", "--quiet"], cwd=d,
  1822	                               capture_output=True, text=True)
  1823	            self.assertNotEqual(r.stdout.strip(), "L0",
  1824	                                "a leading-space name took the artifact exemption")
