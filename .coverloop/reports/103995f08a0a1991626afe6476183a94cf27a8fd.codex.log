  1515	    basename-collision like src/CHANGELOG, or a non-artifact file under reports/
  2250	_VERDICT_MARKER = re.compile(r"^[ \t]*VERDICT:.*$", re.M | re.I)
  2251	# The only thing allowed to follow the closing marker: a CLI's own footer.
  2252	# Codex prints "tokens used" and a number. Anything sentence-like after the
  2253	# verdict means the reviewer kept talking, and the marker was not its last word.
  2254	_VERDICT_FOOTER = re.compile(
  2255	    r"^(tokens?[ _]used\s*:?\s*[\d,.]*\s*[kmb]?|[\d,.]+|[-=_*]{3,})$", re.I)
  2256	_VERDICT_FOOTER_MAX = 3   # a CLI footer, not room for a paragraph
  2257	_VERDICT_CANONICAL_PASS = "VERDICT: PASS"
  2258	_VERDICT_CANONICAL_FAIL = "VERDICT: FAIL"
