  2388	def _stop(reason):
  2389	    """The single STOP line. stdout is flushed first so the reason is the last
  2390	    thing on the terminal even though it goes to stderr."""
  2391	    _cleanup_scratch()
  2392	    sys.stdout.flush()
  2393	    print(f"STOP: {reason}", file=sys.stderr)
  2394	    sys.exit(1)
