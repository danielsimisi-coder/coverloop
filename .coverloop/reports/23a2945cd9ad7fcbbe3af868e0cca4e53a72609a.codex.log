  1068	        fail_usage(f"--{name}-log: {src_path} is inside {REPORTS_DIR}/ — attaching the gate's "
  1069	                   f"own artifacts would launder or replay existing evidence; pass the "
  1070	                   f"original transcript from outside the reports dir")
  1071	    size = os.path.getsize(src_path)
  1072	    if size > ATTACH_MAX_BYTES:
  1073	        fail_usage(f"--{name}-log: {src_path} is {size} bytes (cap {ATTACH_MAX_BYTES}) — "
  1074	                   f"attach the reviewer transcript, not a build artifact")
  1075	    with open(src_path, "rb") as f:
  1076	        text = f.read().decode("utf-8", errors="replace")
  1077	    if not text.strip():
  1078	        fail_usage(f"--{name}-log: {src_path} is empty — an empty transcript is not evidence")
  1079	    if WITHHELD_RE.match(text.strip()):
