  1496	def docs_only(files):
  1497	    """True iff EVERY changed file is documentation (is_doc_file) or a committed
  1498	    report artifact. Anything else — including executable code under docs/, a
  1499	    basename-collision like src/CHANGELOG, or a non-artifact file under reports/
  1500	    — makes it not docs-only, so the L1 test gate is NOT waived."""
  1501	    if not files:  # empty diff or unknown -> not provably docs-only
  1502	        return False
  1503	    for f in files:
  1504	        if is_doc_file(f) or is_report_artifact(f):
