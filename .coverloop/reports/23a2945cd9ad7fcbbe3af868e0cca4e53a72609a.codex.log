   130	RISK_RULES = (
   131	    # (tier, compiled path pattern, human-readable reason)
   132	    ("L3", r"(^|/)migrations?/|(^|/)(alembic|db)/(versions?|migrate)/"
   133	           r"|(^|/)migrate/[^/]*\.(rb|py|go|ts|js|sql)$", "database migration"),
   134	    ("L3", r"\.sql$", "raw SQL"),
   135	    ("L3", r"(^|/)(auth|authn|authz|authentication|authorization|authorisation"
   136	           r"|rls|rbac|permissions?|policies|policy|acls?|admin)(?=(?-i:[A-Z])|[/._\-\s]|$)",
   137	     "authentication / authorisation / RLS"),
   138	    ("L3", r"(^|/)(billing|payments?|invoices?|invoicing|checkout|charges?|chargebacks?"
   139	           r"|stripe|cardcom|subscriptions?|wallets?|payouts?|refunds?|transfers?|ledgers?)(?=(?-i:[A-Z])|[/._\-\s]|$)",
   140	     "money path"),
   141	    ("L3", r"(^|/)(secrets?|credentials?|keys?)(?=(?-i:[A-Z])|[/._\-\s]|$)|(^|/)\.env",
   142	     "secrets / credentials"),
   143	    ("L3", r"(^|/)\.github/workflows/|(^|/)(Dockerfile|docker-compose|fly\.toml|vercel\.json)"
   144	           r"|(^|/)(\.gitlab-ci\.yml|Jenkinsfile|\.circleci/|azure-pipelines\.yml|buildspec\.yml)"
   145	           r"|(^|/)\.github/actions/|\.(tf|tfvars)$|(^|/)(terraform|pulumi|helm|k8s|kubernetes)/",
   146	     "CI / deploy configuration"),
   147	    ("L3", r"(^|/)(workers?|cron|jobs?|queues?|scheduler)(?=(?-i:[A-Z])|[/._\-\s]|$)",
   148	     "worker / cron / queue"),
   149	    ("L3", r"(^|/)" + _kws("schemas?|models?")
   150	           + r".*\.(ts|tsx|js|jsx|mjs|cjs|py|go|rb|java|kt|swift|rs|php|sql|prisma|graphql|ya?ml|json|cs|ex|exs|scala|clj|hs|dart)$",
   151	     "schema / data model"),
   152	    # L2 — product surface and shared contracts: wide blast radius, no direct
   153	    # money/auth authority.
   154	    # NOTE: these two are scoped to APPLICATION SOURCE extensions on purpose.
   155	    # Unscoped, `hooks/` matched this protocol's own shell hooks and `api/`
   156	    # would match any stray text file — over-classification is not free: a
   157	    # floor that cries L2 at documentation trains people to bypass the gate,
   158	    # and a bypassed gate protects nothing.
   159	    ("L2", r"(^|/)(?:" + _kw("api|handlers?|controllers?|middleware")
   160	           + "|" + _kws("routes?") + r")" + r".*\.(ts|tsx|js|jsx|mjs|cjs|py|go|rb|java|kt|swift|rs|php)$",
   161	     "API surface"),
   162	    ("L2", r"(^|/)(?:" + _kw("hooks?|providers?")
   163	           + "|" + _kws("contexts?|stores?|states?") + r")" + r".*\.(ts|tsx|js|jsx|mjs|cjs|py|go|rb|java|kt|swift|rs|php)$",
   164	     "shared application state"),
   165	    ("L2", r"(^|/)(package\.json|package-lock\.json|pnpm-lock\.yaml|yarn\.lock|requirements.*\.txt|pyproject\.toml)$",
   166	     "dependency manifest"),
   167	    # L0 — provably inert: prose and styling only. Anything else falls through
   168	    # to the L1 default.
   169	    # `.txt` is deliberately absent: config/roles.txt and the like are plain
   170	    # text that configures real behaviour, so an unmatched .txt falls to L1
   171	    # ("silence is not safety") rather than being presumed prose.
   172	    ("L0", r"\.(md|mdx|rst|adoc)$", "documentation"),
   173	    ("L0", r"\.(css|scss|sass|less)$", "stylesheet"),
   174	    ("L0", r"(^|/)(LICENSE|CODEOWNERS|\.gitignore|\.editorconfig)$", "repo metadata"),
   175	)
   176	_RISK_RULES_C = tuple((t, re.compile(p, re.I), why) for t, p, why in RISK_RULES)
   177	
   178	# Above this many changed files a change is too broad to be L1 regardless of
   179	# what the individual paths look like — breadth is itself a risk signal.
   180	# Extensions that are inert WHATEVER the file is named. `.txt` is deliberately
   181	# absent: config/permissions.txt and requirements.txt are plain text that
