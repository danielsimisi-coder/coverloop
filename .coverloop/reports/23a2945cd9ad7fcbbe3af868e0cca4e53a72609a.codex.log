  1777	def _is_ssh_signed(root, sha):
  1778	    """True iff <sha>'s signature is an SSH signature (vs GPG). The project
  1779	    signer policy is an ssh allowed_signers file, which git only consults for SSH
  1780	    signatures — a GPG-signed commit would be validated against the ambient GPG
  1781	    keyring and bypass the policy entirely (GLM R4 P2-2).
  1782	
  1783	    We inspect ONLY the `gpgsig` header, NOT the whole object: a commit's MESSAGE
  1784	    is attacker-controlled, so a GPG-signed commit whose message merely contains
  1785	    the text 'BEGIN SSH SIGNATURE' must not be mistaken for ssh-signed (Sol R4 —
  1786	    a spoof of the substring check). Commit headers end at the first blank line;
  1787	    the signature is the `gpgsig` header (its base64 continues on space-indented
  1788	    lines), so we read only up to that blank line and only the gpgsig header."""
  1789	    obj = git(["cat-file", "commit", sha], cwd=root)
  1790	    if not obj:
  1791	        return False
  1792	    header = obj.partition("\n\n")[0]  # headers only — drop the message
  1793	    for line in header.split("\n"):
  1794	        if line.startswith("gpgsig "):
  1795	            return "SSH SIGNATURE" in line  # 'gpgsig -----BEGIN SSH SIGNATURE-----'
  1796	    return False
