   659	def cmd_init(args):
   660	    root = repo_root()
   661	    cfg_path = os.path.join(root, CONFIG_FILE)
   662	    os.makedirs(os.path.join(root, REPORTS_DIR), exist_ok=True)
   663	    if os.path.exists(cfg_path):
   664	        print(f"skip {CONFIG_FILE} (exists)")
   665	    else:
   666	        # No base is stored here on purpose: the diff base for the L1 waiver
   667	        # must come from the trusted caller (CI's --base), never from a file
   668	        # that ships inside the PR under review.
   669	        cfg = {
   670	            "schema": "coverloop-config/v1",
   671	            "test_command": args.test_command or "npx tsc --noEmit",
   672	        }
   673	        with open(cfg_path, "w", encoding="utf-8") as f:
   674	            json.dump(cfg, f, indent=2)
   675	            f.write("\n")
   676	        print(f"+ {CONFIG_FILE}  (test_command: {cfg['test_command']!r} — edit for your stack)")
   677	    gi_path = os.path.join(root, CONFIG_DIR, ".gitignore")
   678	    gi_body = (
   679	        "# Coverloop reports are evidence — commit them with the change.\n"
   680	        "# The negations defeat repo-root ignore rules (e.g. `*.log`) that would\n"
   681	        "# silently swallow the PR-visible transcripts (field report 2026-07-10).\n"
   682	        "!reports/\n"
   683	        "!reports/*.json\n"
   684	        "!reports/*.codex.log\n"
   685	        "!reports/*.glm.log\n"
   686	    )
   687	    if not os.path.exists(gi_path) or "!reports/" not in open(gi_path, encoding="utf-8").read():
   688	        with open(gi_path, "w", encoding="utf-8") as f:
   689	            f.write(gi_body)
   690	        print(f"+ {CONFIG_DIR}/.gitignore  (negations keep evidence commit-able)")
   691	    print(f"+ {REPORTS_DIR}/")
   692	    print("Done. Record evidence with `coverloop attest`, verify with `coverloop gate`.")
   693	    return 0
