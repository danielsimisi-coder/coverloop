  1602	def reviewer_check(name, entry, mandatory_msg, require_captured, root, commit,
  1603	                   require_executed=False):
  1604	    """Gate check for a reviewer (codex/glm): pass requires status==pass AND
  1605	    zero open findings. A verdict claiming `captured`/`attached` whose
  1606	    transcript is missing/tampered/replayed is rejected outright (the label
  1607	    must never be a lie); with require_captured, a self-attested verdict also
  1608	    fails — captured OR attached both satisfy it (each carries a committed,
  1609	    hash-bound transcript; the honest difference is documented in GATE.md)."""
  1610	    if not entry:
  1611	        return check(name, False, f"{name}: NO RECORD — {mandatory_msg}")
  1612	    claims_transcript = entry.get("source") in ("captured", "attached")
  1613	    transcript_valid = verify_capture(root, entry, commit, name) if claims_transcript else False
  1614	    if claims_transcript and not transcript_valid:
  1615	        return check(name, False,
  1616	                     f"{name}: claims {entry.get('source')!r} but the transcript is invalid "
  1617	                     f"(missing / tampered / wrong commit / failed or inconsistent run) — "
  1618	                     f"evidence rejected (re-run attest --{name}-run or --{name}-log)")
  1619	    ok = entry.get("status") == "pass" and entry.get("findings_open") == 0
  1620	    if ok and require_captured and not transcript_valid:
  1621	        return check(name, False,
  1622	                     f"{name}: pass but SELF-ATTESTED — --require-transcript needs a "
  1623	                     f"transcript (attest --{name}-run \"<cmd>\" or --{name}-log <file>)")
  1624	    if ok and require_executed and (entry.get("source") != "captured" or not transcript_valid):
  1625	        return check(name, False,
  1626	                     f"{name}: --require-executed demands a coverloop-EXECUTED capture "
  1627	                     f"(attest --{name}-run \"<cmd>\"); source "
  1628	                     f"{entry.get('source', 'self-attested')!r} does not qualify")
  1629	    return check(name, ok,
  1630	                 f"{name}: {entry.get('status')}, open findings: "
  1631	                 f"{entry.get('findings_open')} [{source_tag(entry)}]")
