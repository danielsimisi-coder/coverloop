  1046	    # (".COVERLOOP/REPORTS/x.log" resolves but keeps its casing) — also walk
  1047	    # the source's ancestor DIRECTORY IDENTITIES (inode compare) against the
  1048	    # reports dir.
  1049	    if not inside_reports:
  1050	        try:
  1051	            rep_stat = os.stat(reports_real)
  1052	        except OSError:
  1053	            rep_stat = None
  1054	        if rep_stat is not None:
  1055	            d = os.path.dirname(src_real)
  1056	            while True:
