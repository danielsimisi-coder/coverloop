   259	def _resolve_commit(ref, cwd):
   260	    """Resolve a user-supplied ref to a commit id, or None.
   261	
   262	    `--base` reaches `git diff` as a positional, so an option-shaped value was
   263	    read as a FLAG: `--base=--cached` diffed the index, found nothing to classify,
   264	    and the gate passed. `--end-of-options` stops git parsing further flags, and
   265	    demanding a 40-hex answer means nothing but a real commit gets through.
   266	    """
   267	    out = git(["rev-parse", "--verify", "--quiet", "--end-of-options",
   268	               f"{ref}^{{commit}}"], cwd=cwd)
   269	    if not out:
   270	        return None
   271	    out = out.strip()
   272	    return out if re.fullmatch(r"[0-9a-f]{40}", out) else None
   273	
   274	
   275	def _git_paths(args, cwd):
   276	    """Git path output, parsed losslessly. Returns None if git failed.
   277	
   278	    Two ways the old `--name-only` + splitlines() collection lost paths, and both
   279	    are classifier EVASION, not cosmetics:
   280	
   281	      * rename detection reported only the DESTINATION, so moving
   282	        src/authGuard.ts to src/guard.ts made an auth change look like an
   283	        unrecognised source file. `--no-renames` reports both sides.
   284	      * git C-quotes any name containing a newline or tab, and splitlines() then
   285	        tore that single path into two meaningless fragments. `-z` emits raw
   286	        names separated by NUL, so there is nothing to quote and nothing to tear.
   287	    """
   288	    # `--no-renames` is a diff option; ls-files rejects it, and appending it
   289	    # blindly made every collection return None — which the caller then, quite
   290	    # correctly, read as "cannot determine the paths" and held at L1. Correct
   291	    # fail-closed behaviour, wrong cause, and it would have masked the evasion
   292	    # fix it was meant to deliver.
   293	    # `show` takes diff options too, and it defaults to rename detection just
   294	    # like `diff` — scoping the flag to `diff` alone let the root-commit fallback
   295	    # lose a rename origin again, one commit after that hole was closed.
   296	    # `ls-files` is the only caller here that rejects it.
   297	    extra = (["--no-renames", "-z"] if args and args[0] in ("diff", "show")
   298	             else ["-z"])
   299	    out = git(args + extra, cwd=cwd)
   300	    if out is None:
   301	        return None
   302	    # Only EMPTY segments are dropped — a filename that is entirely whitespace
   303	    # is a real (and suspicious) file, and discarding it produced an empty,
   304	    # L0 change set.
   305	    return [p for p in out.split("\0") if p]
