   504	def classify_paths(paths, breadth_threshold=BREADTH_L2_FILES):
   505	    """Derive the deterministic tier FLOOR for a set of changed paths.
   506	
   507	    Returns (tier, reasons) where reasons is an ordered, de-duplicated list of
   508	    "<tier>: <why> (<example path>)" strings — the audit trail for the verdict.
   509	    An empty change set is L0 with no reasons; it asserts nothing.
   510	    """
   511	    # RAW git paths — no .strip(). Stripping first meant `<sha>.json ` and
   512	    # ` <sha>.glm.log` (trailing space, leading space, tab) were normalised INTO
   513	    # the exempt artifact shape, so an arbitrary file could take the evidence
   514	    # exemption and skip the L1 floor. git reports the real name; a name with
   515	    # surrounding whitespace is a DIFFERENT, and more suspicious, file.
   516	    paths = [p for p in paths if p]
   517	    if not paths:
   518	        return "L0", []
   519	    tier = "L0"
   520	    reasons, seen = [], set()
   521	    for path in paths:
   522	        matched = None
   523	        # Prose and styling are inert whatever they are NAMED. The name rules run
   524	        # first and match anywhere in the path, so docs/authGuide.md,
   525	        # docs/workerPool.md and docs/credentialsGuide.md were all classified L3 —
   526	        # a floor that demands a red-team review of a markdown file is a floor
   527	        # people learn to route around, which costs more than it ever protects.
   528	        # ...unless the name itself carries meaning. requirements.txt is a
   529	        # dependency manifest that happens to end in .txt, and the blanket inert
   530	        # shortcut demoted it from L2 to L0 — a regression introduced by the fix
   531	        # for documentation false positives.
   532	        if _INERT_RE.search(path) or is_report_artifact(path):
   533	            matched = ("L0", "documentation / styling (inert regardless of name)")
   534	        for rule_tier, rx, why in (() if matched else _RISK_RULES_C):
   535	            if rx.search(path):
   536	                matched = (rule_tier, why)
   537	                break
   538	        # Unrecognised => L1. Silence is not safety.
   539	        if matched is None:
   540	            matched = ("L1", "source change (no specific rule matched)")
   541	        rule_tier, why = matched
   542	        tier = tier_max(tier, rule_tier)
   543	        key = (rule_tier, why)
   544	        if key not in seen:
   545	            seen.add(key)
   546	            reasons.append(f"{rule_tier}: {why} ({path})")
   547	    if len(paths) >= breadth_threshold:
   548	        tier = tier_max(tier, "L2")
   549	        reasons.append(f"L2: breadth — {len(paths)} files changed "
   550	                       f"(>= {breadth_threshold})")
   551	    return tier, reasons
