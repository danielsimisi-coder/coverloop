  1097	        "output_file": log_rel,
  1098	        "output_sha256": hashlib.sha256(text.encode("utf-8")).hexdigest(),
  1099	        "output_lines": text.count("\n"),
  1100	        "attached_at": now_utc(),
  1101	    }
