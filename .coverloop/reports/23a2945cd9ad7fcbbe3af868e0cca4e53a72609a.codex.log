   588	def is_doc_file(f):
   589	    """True iff f is documentation for the L1 waiver (never executable code)."""
   590	    if f in ROOT_DOC_FILES:
   591	        return True
   592	    if f.startswith(DOC_ROOT) and f.endswith(DOC_SUFFIXES):
   593	        return True
   594	    return False
