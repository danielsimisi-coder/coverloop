   919	                _fsync_dir(os.path.dirname(path))
   920	        except BaseException:
   921	            # Close the handle BEFORE unlinking — Windows can't unlink an open
   922	            # file (Sol R3 grade), so a leaked-open temp would otherwise survive.
   923	            # The prior report (if any) is untouched: we only ever wrote the temp.
   924	            if f is not None:
   925	                try:
   926	                    f.close()
   927	                except OSError:
   928	                    pass
   929	            try:
   930	                os.unlink(tmp_base, dir_fd=dfd) if use_dirfd else os.unlink(tmp_full)
   931	            except OSError:
   932	                pass
   933	            raise
   934	    finally:
   935	        if dfd is not None:
   936	            os.close(dfd)
