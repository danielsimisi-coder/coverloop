  2079	    def test_only_the_canonical_verdict_marker_is_a_pass(self):
  2080	        # The verdict is a machine protocol, not prose. Inferring approval from
  2081	        # "PASS WITH RISKS" or "APPROVE" would land a hedged review as a pass
  2082	        # with zero open findings; every non-canonical form fails closed.
  2083	        tv = self.mod.transcript_verdict
  2084	        for text, want in (
  2085	                ("VERDICT: PASS", "pass"),
  2086	                ("  VERDICT: PASS  ", "pass"),
