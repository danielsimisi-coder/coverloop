  2079	    def test_only_the_canonical_verdict_marker_is_a_pass(self):
  2080	        # The verdict is a machine protocol, not prose. Inferring approval from
  2081	        # "PASS WITH RISKS" or "APPROVE" would land a hedged review as a pass
  2082	        # with zero open findings; every non-canonical form fails closed.
  2083	        tv = self.mod.transcript_verdict
  2084	        for text, want in (
  2085	                ("VERDICT: PASS", "pass"),
  2086	                ("  VERDICT: PASS  ", "pass"),
  2087	                ("VERDICT: PASS\ntokens used: 91k", "pass"),   # a trailing footer is fine
  2088	                ("VERDICT: FAIL", "fail"),
  2089	                ("verdict: pass", "fail"),                     # not canonical
  2090	                ("VERDICT:PASS", "fail"),
  2091	                ("VERDICT: PASS.", "fail"),
  2092	                ("1. VERDICT: PASS", "fail"),
  2093	                ("VERDICT: PASS WITH RISKS", "fail"),
  2094	                ("VERDICT: APPROVE", "fail"),
  2095	                ("VERDICT: SHIP", "fail"),
  2096	                ("VERDICT: LGTM", "fail"),
  2097	                ("VERDICT: FAIL\nVERDICT: PASS", "fail"),      # ambiguous loses
  2098	                ("looks good to me", "fail"),
  2099	                ("", "fail"),
  2100	        ):
  2101	            with self.subTest(text=text[:40]):
  2102	                self.assertEqual(tv(text), want)
