   774	def find_report(root, head):
   775	    """Locate the report that governs HEAD.
   776	
   777	    Returns (report, reason, malformed):
   778	      * exact HEAD report when present;
   779	      * else a report bound to a first-parent ancestor, accepted ONLY if the
   780	        diff ancestor..HEAD touches nothing but evidence files (this is what
   781	        makes "attest, commit the report, gate in CI" possible);
   782	      * (None, why, True) when a report file exists but is corrupt, forged,
   783	        or SHA-mismatched — malformed evidence fails EVERY tier;
   784	      * (None, why, False) when no usable report exists.
   785	    """
   786	    path = report_path(root, head)
   787	    if os.path.exists(path):
   788	        report, why = load_report(root, head)
   789	        if report is None:
   790	            return None, why, True
   791	        return report, None, False
