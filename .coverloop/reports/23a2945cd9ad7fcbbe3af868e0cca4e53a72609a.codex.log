   702	def load_report(root, sha):
   703	    """Load the report for this exact SHA. (None, reason) if unusable."""
   704	    path = report_path(root, sha)
   705	    # Reject a report reached through a symlink (or a symlinked reports/ dir):
   706	    # the evidence must live in the repo's committed tree, not off-tree. Mirrors
   707	    # the transcript guard in verify_capture.
   708	    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
   709	    if (os.path.islink(path)
   710	            or os.path.realpath(reports_real) != reports_real
   711	            or (os.path.exists(path) and os.path.dirname(os.path.realpath(path)) != reports_real)):
   712	        return None, f"{path}: report resolves outside the reports dir (symlink) — rejected"
   713	    data, err = load_json(path)
   714	    if err:
   715	        return None, err
   716	    if data.get("schema") != SCHEMA:
   717	        return None, f"{path}: unknown schema {data.get('schema')!r} (want {SCHEMA})"
   718	    if data.get("commit") != sha:
   719	        return None, f"{path}: bound to commit {data.get('commit')!r}, HEAD is {sha}"
   720	    # An invalid risk_tier must fail closed — otherwise a garbage tier is ignored
   721	    # by tier_max() and a pinned --min-tier L0 would gate it as L0 (no evidence).
   722	    if data.get("risk_tier") not in TIERS:
   723	        return None, f"{path}: invalid risk_tier {data.get('risk_tier')!r}"
   724	    # Shape guard (full audit 2026-07-11): a schema-valid report whose
   725	    # tests/codex/glm/human_gate field is not an object would raise an uncaught
   726	    # AttributeError deep in evaluate() (e.g. (tests or {}).get(...)) instead of
   727	    # the documented clean "malformed evidence" FAIL. Reject it here so it takes
   728	    # the fail-closed path.
   729	    for field in ("tests", "codex", "glm", "human_gate"):
   730	        v = data.get(field)
   731	        if v is not None and not isinstance(v, dict):
   732	            return None, f"{path}: field {field!r} must be an object, got {type(v).__name__}"
   733	    # Strict nested-field validation (Sol grade R2): reject a schema-valid report
   734	    # whose sub-fields carry wrong-typed values, so a malformed report takes the
   735	    # clean FAIL path instead of relying on a downstream comparison happening to
   736	    # be falsy. (Note: bool is an int subclass in Python — reject it explicitly so
   737	    # `findings_open: true` can't masquerade as a count.)
   738	    for rk in ("tests", "codex", "glm"):
   739	        e = data.get(rk)
   740	        if e is not None and e.get("status") is not None and e.get("status") not in ("pass", "fail"):
   741	            return None, f"{path}: {rk}.status must be 'pass' or 'fail', got {e.get('status')!r}"
   742	    for rk in ("codex", "glm"):
   743	        e = data.get(rk)
   744	        if e is not None and "findings_open" in e:
   745	            fo = e["findings_open"]
   746	            if isinstance(fo, bool) or not isinstance(fo, int) or fo < 0:
   747	                return None, f"{path}: {rk}.findings_open must be a non-negative integer"
   748	    hg = data.get("human_gate")
   749	    if hg is not None:
   750	        if "approved" in hg and not isinstance(hg["approved"], bool):
   751	            return None, f"{path}: human_gate.approved must be a boolean"
   752	        if hg.get("approver") is not None and not isinstance(hg.get("approver"), str):
   753	            return None, f"{path}: human_gate.approver must be a string"
   754	    return data, None
