   410	def _gate_floor_paths(root, args, report, sha):
   411	    """Every path this gate run is judging, and whether that set is TRUSTWORTHY.
   412	
   413	    Returns (paths, unknown). `unknown` means git could not answer, and the caller
   414	    must fail closed rather than read the resulting empty list as "nothing risky".
   415	
   416	    The first cut of the auto-floor asked only for uncommitted changes, which is
   417	    empty in the ordinary case — you commit, THEN run the gate — so `gate
   418	    --min-tier L0` still passed over a committed migration. The set therefore
   419	    also spans the commits the recorded evidence does not cover: from the report's
   420	    commit to HEAD, or the commit being gated when there is no report at all.
   421	    """
   422	    base = getattr(args, "base", None)
   423	    if base:
   424	        # Resolve to a commit id FIRST. `--base=--cached` was passed through to
   425	        # `git diff` as an OPTION, which diffed the index, found nothing, and
   426	        # gated clean. Anything that does not resolve to a commit is refused
   427	        # before it can reach git as a flag.
   428	        base = _resolve_commit(base, root)
   429	        if base is None:
   430	            return [], True
   431	        out = _git_paths(["diff", "--name-only", f"{base}...HEAD"], root)
   432	        if out is None:
   433	            out = _git_paths(["diff", "--name-only", base, "HEAD"], root)
   434	        if out is None:
   435	            # An unresolvable --base is a caller error, not an all-clear. Reading
   436	            # it as "no files changed" turned a typo into a passing gate.
   437	            return [], True
   438	        return out, False
   439	
   440	    tracked = _git_paths(["diff", "--name-only", "HEAD"], root)
   441	    untracked = _git_paths(["ls-files", "--others", "--exclude-standard"], root)
   442	    if tracked is None or untracked is None:
   443	        return [], True
   444	    paths = list(tracked) + list(untracked)
   445	
   446	    # ...plus whatever the evidence does not already cover.
   447	    # The commit being gated is ALWAYS classified, including when the evidence
   448	    # sits on it. The old expression returned None in exactly that case — the
   449	    # normal attest path — so a migration could be committed, attested L0 with
   450	    # tests, and sail through: the floor never looked at it. `prior^..sha` also
   451	    # re-covers the evidence commit itself, which is the point: the recorded
   452	    # tier has to match what that commit actually contains.
   453	    # The EARLIEST commit this evidence claims to cover — not the one it was last
   454	    # rebound to (see origin_commit above).
   455	    # The oldest commit some EARLIER evidence already claims to cover.
   456	    # `origin_commit` is the honest source when it exists (set on rebind). A
   457	    # report's plain `commit` field is NOT a substitute: on a first-ever attest
   458	    # it equals sha itself, and treating sha as "prior" collapsed the range to
   459	    # sha^..sha — a single commit — so a migration one commit back (never
   460	    # attested, never rebound) stayed invisible. Absent a real origin, the
   461	    # honest baseline is the newest ANCESTOR that independently carries
   462	    # evidence, walking past sha itself; with none, the root. A migration that
   463	    # nothing has ever reviewed cannot be waved through by attesting the commit
   464	    # after it.
   465	    # origin_commit is kept in reports for provenance, but the baseline is
   466	    # ALWAYS the validated walk: the origin shortcut trusted a rebound report's
   467	    # word for where its coverage began, which is exactly the trust the
   468	    # planted-report attack abused. The walk finds the same origin commit when
   469	    # its report is honest, and walks past it when it is not.
   470	    prior, prior_validated = _validated_baseline(root, sha)
   471	    if prior is None:
   472	        return sorted(set(paths)), True
   473	    if prior == sha:
   474	        # Only reachable for a single-commit repo (sha IS its own root): there
   475	        # is nothing to diff against, so list its own files.
   476	        out = _git_paths(["show", "--name-only", "--pretty=format:", sha], root)
   477	    else:
   478	        # A PLAIN two-dot diff, no caret. `prior` is a commit whose own state
   479	        # was already reviewed — either it carries a real evidence report (and
   480	        # attest now enforces the floor at record time, so that report already
   481	        # reflects tier >= floor(baseline..prior)), or it's the root, which
   482	        # needs no separate review since nothing precedes it. Because of that,
   483	        # `prior..sha` correctly EXCLUDES `prior`'s own introduction: adding
   484	        # `prior`'s files back in (the previous version of this code did, via
   485	        # a `^`) double-counted content that had already been accounted for,
   486	        # and specifically kept re-flagging a repo's OWN coverloop scaffolding
   487	        # every time a later, unrelated commit made that evidence stale for
   488	        # governance purposes but not for floor purposes.
   489	        out = _git_paths(["diff", "--name-only", f"{prior}..{sha}"], root)
   490	        if out is not None and not prior_validated:
   491	            # The baseline is the BARE root: no evidence ever covered the files
   492	            # the root commit itself introduced, and prior..sha excludes them.
   493	            own = _git_paths(["show", "--name-only", "--pretty=format:", prior], root)
   494	            out = None if own is None else out + own
   495	    if out is None:
   496	        # `or []` here once turned a git timeout, a shallow clone, a corrupt
   497	        # object or a bad origin_commit into an EMPTY path set with
   498	        # unknown=False — an all-clear built out of a failure.
   499	        return sorted(set(paths)), True
   500	    paths += out
   501	    return sorted(set(paths)), False
