   573	def tier_max(*tiers):
   574	    """Highest tier among the args (None/unknown-safe). TIERS is low->high.
   575	    Used so a pinned --min-tier can only ever RAISE the requirement."""
   576	    best = None
   577	    for t in tiers:
   578	        if t in TIERS and (best is None or TIERS.index(t) > TIERS.index(best)):
   579	            best = t
   580	    return best
