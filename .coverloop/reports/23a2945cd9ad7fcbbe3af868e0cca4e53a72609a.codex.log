  1735	# git's %G? signature-status codes. Only "G" (good AND from a key of sufficient
  1736	# validity — gpg owner-trust, or an ssh signer in allowed_signers) proves an
  1737	# AUTHORIZED author. "U" is a good signature whose key validity is UNKNOWN (e.g.
  1738	# a key merely imported into the keyring, or an ssh signer NOT in
  1739	# allowed_signers) — accepting it would let anyone with any importable key pass,
  1740	# so we reject it (Sol R3 P1: `git verify-commit` exit 0 accepts both G and U).
  1741	_SIG_STATUS = {
  1742	    "U": "good signature but UNKNOWN key validity — grant owner-trust / add the signer to allowed_signers",
  1743	    "B": "BAD signature", "E": "signature could not be checked (missing public key)",
  1744	    "N": "no signature", "X": "expired signature", "Y": "expired signing key",
  1745	    "R": "revoked signing key",
  1746	}
