  1008	        "command": redact_secrets(cmd),  # the invocation string is committed too
  1009	        "exit_code": proc.returncode,
  1010	        "output_file": log_rel,
  1011	        "output_sha256": hashlib.sha256(output.encode("utf-8")).hexdigest(),
  1012	        "output_lines": output.count("\n"),
  1013	        "ran_at": now_utc(),
