  1522	def verify_capture(root, entry, commit, name):
  1523	    """True iff `entry` claims a captured transcript that is genuinely THIS
  1524	    commit's / THIS reviewer's committed log and whose sha256 matches.
  1525	
  1526	    Applies to BOTH transcript sources — "captured" (the tool ran the reviewer)
  1527	    and "attached" (an existing transcript was attested via --codex-log/--glm-log;
  1528	    same binding rules, minus the exit-code check the tool can't know).
  1529	
  1530	    The `source: "captured"` string alone means nothing — a hand-edited report
  1531	    could set it. Real transcript evidence must:
  1532	      * name the transcript EXACTLY `.coverloop/reports/<commit>.<name>.log`
  1533	        (no traversal, and no REPLAY of an old/unrelated log under a different
  1534	        commit or reviewer);
  1535	      * resolve — after following any symlinks — to a real file INSIDE the
  1536	        reports dir (a symlink pointing outside is rejected);
  1537	      * hash to the recorded digest (catches tampering).
  1538	    """
  1539	    src = entry.get("source")
  1540	    if src not in ("captured", "attached"):
  1541	        return False
  1542	    # A CAPTURED reviewer command must have SUCCEEDED. A nonzero exit means it
  1543	    # failed (expired auth, missing binary, a hang) and the transcript is an
  1544	    # error log, not a review — accepting it would let a failed run pass
  1545	    # --require-captured. Attached transcripts carry no exit code (the tool
  1546	    # executed nothing); their trust rests on the committed, hash-bound,
  1547	    # human-readable log alone.
  1548	    if src == "captured":
  1549	        # A genuine captured entry carries capture_run's execution fields;
  1550	        # requiring them rejects the NAIVE relabel (an attached entry flipped to
  1551	        # source:"captured" that forgets to add them). HONEST LIMIT (full audit
  1552	        # 2026-07-11): command/exit_code/ran_at are unauthenticated attester
  1553	        # JSON and the log bytes+hash are attester-authored, so a committer who
  1554	        # adds all three defeats this — no on-disk field can PROVE coverloop
  1555	        # executed the reviewer. --require-executed is therefore a best-effort
  1556	        # policy filter (rejects honestly-attached evidence), NOT proof of
  1557	        # execution; the honest ceiling is documented in docs/GATE.md.
  1558	        if not all(k in entry for k in ("command", "exit_code", "ran_at")):
  1559	            return False
  1560	        if entry.get("exit_code") != 0:
  1561	            return False
  1562	    # An ATTACHED entry never records execution fields; any leftover
  1563	    # exit_code/command/ran_at means a captured (possibly FAILED) entry was
  1564	    # hand-reclassified as "attached" to dodge the exit-code check — reject
  1565	    # the inconsistency.
  1566	    if src == "attached" and any(k in entry for k in ("exit_code", "command", "ran_at")):
  1567	        return False
  1568	    rel = entry.get("output_file") or ""
  1569	    digest = entry.get("output_sha256") or ""
  1570	    expected = os.path.join(REPORTS_DIR, f"{commit}.{name}.log")
  1571	    if not digest or rel != expected:
  1572	        return False
  1573	    path = os.path.join(root, rel)
  1574	    # The ENTIRE reports path must be real: no symlinked `.coverloop` or
  1575	    # `reports/` ancestor (which would relocate the trusted root off-tree) and
  1576	    # the log itself must not be a symlink. Only then can the transcript be
  1577	    # trusted to live in the repo's committed evidence tree.
  1578	    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
  1579	    if os.path.realpath(reports_real) != reports_real:
  1580	        return False  # `.coverloop` or `.coverloop/reports` is a symlink
  1581	    if os.path.islink(path) or os.path.dirname(os.path.realpath(path)) != reports_real:
  1582	        return False
  1583	    try:
  1584	        with open(path, "rb") as f:
  1585	            data = f.read()
