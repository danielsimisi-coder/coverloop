   761	def only_evidence_changed(root, frm, to):
   762	    """True iff the diff frm..to touches ONLY committed report ARTIFACTS
   763	    (<sha>.json / <sha>.<reviewer>.log). A non-artifact file under reports/
   764	    (e.g. reports/backdoor.py) counts as a real code change and returns False."""
   765	    # _git_paths, not a line split: a lone " .coverloop/reports/<sha>.json"
   766	    # was stripped into the exact artifact shape, so stale ancestor evidence
   767	    # was accepted as "nothing but evidence changed".
   768	    files = _git_paths(["diff", "--name-only", f"{frm}..{to}"], root)
   769	    if files is None:
   770	        return False  # unresolvable range -> fail closed
   771	    return bool(files) and all(is_report_artifact(f) for f in files)
