  1593	    # is not covered by output_sha256, so no re-hash is needed) plus an attached
  1594	    # copy of the placeholder. Matching the WHOLE line (not a substring) means a
  1595	    # real review that merely quotes the marker still passes. (full audit +
  1596	    # Sol verify 2026-07-11 P1)
  1597	    if WITHHELD_RE.match(data.decode("utf-8", errors="replace").strip()):
  1598	        return False
  1599	    return hashlib.sha256(data).hexdigest() == digest
