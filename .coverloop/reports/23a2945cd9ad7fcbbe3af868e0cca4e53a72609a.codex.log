   553	# A committed EVIDENCE ARTIFACT under .coverloop/reports/ — EXACT name shapes
   554	# only: <40-hex commit sha>.json, or <sha>.<reviewer>.log. Anything else under
   555	# reports/ (e.g. .coverloop/reports/backdoor.py) is a NORMAL code file: not
   556	# "evidence-only", not test-waivable. This is what stops code being smuggled in
   557	# under the reports/ prefix.
   558	# `\Z`, not `$`: Python's `$` also matches BEFORE a final newline, so
   559	# "<sha>.json\n" satisfied the artifact shape and took the exemption.
   560	REPORT_ARTIFACT_RE = re.compile(
   561	    r"^" + re.escape(REPORTS_DIR + "/")
   562	    + r"[0-9a-f]{40}(?:\.json|\.(?:codex|glm)\.log)\Z")
   563	
   564	# Documentation for the L1 test-gate waiver. Deliberately strict so a code file
   565	# cannot masquerade as docs: an EXACT root-level doc file, or a doc-suffixed
   566	# file UNDER docs/. Never a basename match elsewhere; never a bare .txt/.rst
   567	# outside docs/ (a runtime-loaded config.txt or docs/deploy.sh is NOT a doc).
   568	DOC_SUFFIXES = (".md", ".txt", ".rst")
   569	DOC_ROOT = "docs/"
   570	ROOT_DOC_FILES = ("LICENSE", "CHANGELOG", "CHANGELOG.md", "README.md")

