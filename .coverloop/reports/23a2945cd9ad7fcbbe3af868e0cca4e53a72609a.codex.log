   962	def capture_run(root, sha, name, cmd, cwd=None, env=None):
   963	    """Run a reviewer command, save its combined output to
   964	    .coverloop/reports/<sha>.<name>.log, and return provenance (command, exit
   965	    code, output path, sha256, line count, timestamp).
   966	
   967	    This turns a bare `--codex pass` claim into evidence backed by the actual
   968	    reviewer transcript, committed alongside the report and hashed so tampering
   969	    with the log invalidates the recorded digest. It does NOT auto-derive the
   970	    verdict — reviewer output is prose, and inferring pass/fail from it
   971	    reliably is not possible — so the caller still states pass/fail, but now
   972	    against a captured, inspectable artifact rather than thin air.
   973	    """
   974	    log_rel = os.path.join(REPORTS_DIR, f"{sha}.{name}.log")
   975	    log_path = os.path.join(root, log_rel)
   976	    os.makedirs(os.path.dirname(log_path), exist_ok=True)
   977	    print(f"capturing {name} reviewer: {cmd}")
   978	    try:
   979	        # shell=True: same trust model as the test command — an operator-typed
   980	        # reviewer invocation (e.g. 'codex exec ...'), printed before it runs.
   981	        # text=False: capture raw bytes so non-UTF-8 reviewer output (colored
   982	        # diffs, binary error dumps) can't crash us; decode defensively below.
   983	        # `cwd` defaults to the repo (attest --codex-run keeps that contract),
   984	        # but `check` passes a directory OUTSIDE the worktree: with shell=True
   985	        # a repo-relative resolution — `python3 -m reviewer` picking up a
   986	        # planted reviewer.py, `sh <scripts/reviewer` — would otherwise let the
   987	        # change under review supply its own reviewer. The repo and a
   988	        # pre-computed diff reach the command through COVERLOOP_REPO /
   989	        # COVERLOOP_DIFF instead.
   990	        proc = subprocess.run(cmd, shell=True, cwd=cwd or root, env=env,
   991	                              capture_output=True, timeout=1800)
   992	    except (OSError, subprocess.TimeoutExpired) as e:
   993	        fail_usage(f"could not run {name} reviewer command: {e}")
   994	    output = ((proc.stdout or b"") + (proc.stderr or b"")).decode("utf-8", errors="replace")
   995	    if proc.returncode != 0:
   996	        # A failed run's output is untrusted error text (env dumps, stack state
   997	        # that routinely carries tokens). It is also NOT valid evidence (the gate
   998	        # rejects exit!=0), so we WITHHOLD the dump rather than commit a secret-
   999	        # bearing error log to git.
  1000	        output = f"[{name} reviewer command exited {proc.returncode}; {WITHHELD_MARKER}\n"
