   846	@contextlib.contextmanager
   847	def open_write(root, path):
   848	    """ATOMICALLY write PATH (which MUST live directly inside
   849	    <root>/.coverloop/reports/): the caller writes to a private temp file in the
   850	    same dir; on clean exit the temp is fsync'd and os.replace'd over PATH, so a
   851	    reader (gate) sees either the OLD file or the fully-written NEW one, never a
   852	    torn/partial report (Sol R3: a plain open()+dump is not atomic, so a
   853	    concurrent reader or a killed writer could observe a truncated file). On
   854	    POSIX the containing directory is also fsync'd so the rename survives a crash;
   855	    on platforms without dir-fd support this degrades to a path-based replace
   856	    (atomic on the OS, best-effort directory durability). Still refuses any
   857	    symlink in the reports path and disables newline translation.
   858	
   859	    Audit fixes (2026-07-11): (1) evidence WRITES used a plain open() that would
   860	    follow a pre-planted destination symlink and overwrite an arbitrary off-tree
   861	    file; the read paths guarded symlinks but the writers did not. (2) text-mode
   862	    writes translated '\\n'->'\\r\\n' on Windows while output_sha256 is hashed over
   863	    the untranslated string, so verify_capture rejected its own untampered
   864	    evidence there; newline='' keeps on-disk bytes == hashed bytes everywhere.
   865	
   866	    Symlink defense mirrors the read-side guard and covers the whole PARENT
   867	    CHAIN, not just the final component (Sol v2.7.3 grade): the file's resolved
   868	    parent must BE the real reports dir (so a symlinked `.coverloop/` or
   869	    `reports/` ancestor can't relocate the write off-tree), and the final
   870	    component must not be a symlink (portable, holds where O_NOFOLLOW is absent).
   871	
   872	    Where the platform supports it (POSIX), the actual write additionally goes
   873	    through a PINNED directory fd (open the reports dir O_DIRECTORY|O_NOFOLLOW,
   874	    fstat-verify it IS the real reports dir, then openat the basename relative to
   875	    that fd): once the dir fd is pinned, swapping `reports/` for a symlink AFTER
   876	    the path check can no longer redirect the write — closing the parent-swap
   877	    TOCTOU race (Sol Round-1 review). Windows (no dir_fd/O_DIRECTORY) keeps the
   878	    path-based check + O_NOFOLLOW best-effort."""
   879	    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
   880	    if (os.path.realpath(reports_real) != reports_real          # .coverloop or reports/ is a symlink
   881	            or os.path.islink(path)                             # final component pre-planted as a symlink
   882	            or os.path.dirname(os.path.realpath(path)) != reports_real):  # resolves outside the real reports dir
   883	        fail_usage(f"refusing to write evidence outside the real reports dir (symlinked path): {path}")
   884	    o_nofollow = getattr(os, "O_NOFOLLOW", 0)
   885	    o_dir = getattr(os, "O_DIRECTORY", 0)
   886	    # O_EXCL: the temp name is private (pid + process-monotonic counter), so a
   887	    # collision is anomalous — never clobber. We create it, so it is never a
   888	    # symlink and the write can't be redirected through it.
   889	    wflags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | o_nofollow
   890	    base = os.path.basename(path)
   891	    tmp_base = f".{base}.tmp.{os.getpid()}.{next(_TMP_SEQ)}"
   892	    tmp_full = os.path.join(os.path.dirname(path), tmp_base)
   893	    use_dirfd = bool(o_dir and o_nofollow
   894	                     and os.open in getattr(os, "supports_dir_fd", set())
   895	                     and os.replace in getattr(os, "supports_dir_fd", set()))
   896	    dfd = None
   897	    try:
   898	        if use_dirfd:
   899	            # POSIX: pin the reports dir by fd (no-follow), verify identity, then
   900	            # create + replace WITHIN that pinned fd (immune to a post-check swap).
   901	            dfd = os.open(os.path.join(root, REPORTS_DIR), os.O_RDONLY | o_dir | o_nofollow)
   902	            if not os.path.samestat(os.fstat(dfd), os.stat(reports_real)):
   903	                fail_usage(f"refusing to write evidence: reports dir identity changed: {path}")
   904	            fd = os.open(tmp_base, wflags, 0o644, dir_fd=dfd)
   905	        else:
   906	            fd = os.open(tmp_full, wflags, 0o644)
   907	        f = None
   908	        try:
   909	            f = os.fdopen(fd, "w", encoding="utf-8", newline="")
   910	            yield f                       # caller writes the evidence to the temp
   911	            f.flush()
   912	            os.fsync(f.fileno())          # file data durable before the rename
   913	            f.close(); f = None
