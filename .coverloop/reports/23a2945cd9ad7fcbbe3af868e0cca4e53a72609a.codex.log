   235	def is_irreversible(path):
   236	    """True when PATH matches ANY L3 rule whose consequences are hard to undo.
   237	
   238	    Checking only the FIRST matching rule made the answer depend on rule ORDER:
   239	    `workers/models/user.py` hit the worker rule (L3, reversible) before the
   240	    schema rule (L3, irreversible), so the human stop was waived for a schema
   241	    change because of where the file happened to live. Tier selection may take
   242	    the first match; irreversibility must ask every rule."""
   243	    return any(rule_tier == "L3" and why in IRREVERSIBLE_REASONS and rx.search(path)
   244	               for rule_tier, rx, why in _RISK_RULES_C)
