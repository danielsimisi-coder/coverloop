  2392	    if out is None:
  2393	        return None, False
  2394	    commits = out.split()
  2395	    if len(commits) < 2:
  2396	        return None, True          # created, never changed
  2397	    prev = git(["show", f"{commits[1]}:{CONFIG_FILE}"], cwd=root)
  2398	    if prev is None:
  2399	        return None, False
  2400	    try:
  2401	        return ((json.loads(prev) or {}).get("test_command"), True)
  2402	    except ValueError:
  2403	        return None, False
