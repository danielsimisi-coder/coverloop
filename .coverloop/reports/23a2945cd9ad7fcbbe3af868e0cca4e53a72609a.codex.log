  1634	# Two DIFFERENT questions the gate answers, kept apart on purpose:
  1635	#
  1636	#   VERIFICATION  — "was this change actually checked?" tests bound to the config
  1637	#                   command, an independent diff review, a red-team at L3, every
  1638	#                   transcript hash-bound to the SHA. Machine-checkable evidence.
  1639	#   AUTHORIZATION — "did a human take responsibility for it?" the named approval
  1640	#                   the gate policy demands at L3.
  1641	#
  1642	# They are not interchangeable. The baseline walk asks only the FIRST question:
  1643	# a commit whose evidence VERIFIES is a sound place to start counting risk from,
  1644	# whether or not anyone signed for it — 238 fully-reviewed L3 commits across the
  1645	# fleet were never signed, and treating them as unreviewed collapsed every
  1646	# baseline to the root and inflated every floor to L3. The gate asks BOTH, and
  1647	# authorization is never inferred from verification: reviewers passing does not
  1648	# mean a human said yes.
  1649	def evaluate(report, tier, files, require_captured=False, root=None, test_command=None,
  1650	             require_executed=False, human_gate_required=True):
  1651	    """Pure gate logic -> (verdict_pass, [checks]). Fail closed throughout.
  1652	
  1653	    """
  1654	    checks = []
  1655	
  1656	    if tier == "L0":
  1657	        checks.append(check("tier", True, "L0: trivial — no evidence required"))
  1658	        return True, checks
  1659	
  1660	    tests = report.get("tests") if report else None
  1661	    recorded_cmd = str((tests or {}).get("command", "")).strip()
  1662	    # The recorded test command must match the project's CURRENT config command,
  1663	    # so a hand-forged `{"command":"echo fake","status":"pass"}` (or an old
  1664	    # command from before config changed) can't gate green. FAIL CLOSED when the
  1665	    # config has no test_command — an empty/None command can never be a match, so
  1666	    # a forged pass can't ride on a repo that never configured its tests.
  1667	    cfg_cmd = str(test_command or "").strip()
  1668	    cmd_matches = bool(cfg_cmd) and recorded_cmd == cfg_cmd
  1669	    tests_ok = bool(tests) and tests.get("status") == "pass" and bool(recorded_cmd) and cmd_matches
  1670	    if tier == "L1" and docs_only(files):
  1671	        checks.append(check("tests", True, "docs-only diff — test gate waived"))
  1672	    else:
  1673	        if not cfg_cmd:
  1674	            detail = "tests: no test_command configured — cannot verify (set one in .coverloop/config.json)"
  1675	        elif tests and not cmd_matches:
  1676	            detail = (f"tests: recorded command {recorded_cmd!r} != config test_command "
  1677	                      f"{cfg_cmd!r} — re-run `coverloop attest --tests`")
  1678	        elif tests:
  1679	            detail = f"tests: {tests.get('status')} ({tests.get('command')})"
  1680	        else:
  1681	            detail = "tests: NO RECORD — run `coverloop attest --tests`"
  1682	        checks.append(check("tests", tests_ok, detail))
  1683	
  1684	    report_commit = (report or {}).get("commit")
  1685	    if tier in ("L2", "L3"):
  1686	        checks.append(reviewer_check(
  1687	            "codex", report.get("codex") if report else None,
  1688	            "independent diff review is mandatory at L2/L3", require_captured, root, report_commit,
  1689	            require_executed))
  1690	
  1691	    if tier == "L3":
  1692	        checks.append(reviewer_check(
  1693	            "glm", report.get("glm") if report else None,
  1694	            "red-team/audit is mandatory at L3", require_captured, root, report_commit,
  1695	            require_executed))
  1696	
  1697	    if tier == "L3":
  1698	        # WHO gets stopped, and why it is a choice.
  1699	        #
  1700	        # By default every L3 change waits for a named human. Measured on a real
  1701	        # billing/auth/worker platform that is ~47% of commits — and a gate that
  1702	        # fires on half your work is a gate you learn to rubber-stamp, which is
  1703	        # the same failure this tool warns about for over-classification, one
  1704	        # notch up. `--human-gate-scope irreversible` narrows the STOP (not the
  1705	        # review: tests, diff gate and red-team still run on every L3) to the
  1706	        # changes you cannot take back — schema migrations, money paths, and
  1707	        # authz/RLS policy. On that same repo it took the human stops from 47%
  1708	        # to 25% of commits.
  1709	        #
  1710	        # It is OPT-IN. Silently relaxing an existing user's gate on upgrade
  1711	        # would be exactly the kind of unannounced weakening this project exists
  1712	        # to make impossible.
  1713	        needs_human = human_gate_required
  1714	        why_exempt = ("" if needs_human else
  1715	                      " — scope=irreversible and no migration/money/authz path in "
  1716	                      "this change; the full automated L3 evidence still applies")
  1717	
  1718	        hg = report.get("human_gate") if report else None
  1719	        hg_ok = bool(hg) and hg.get("approved") is True and bool(str(hg.get("approver", "")).strip())
  1720	        if not needs_human:
  1721	            checks.append(check("human_gate", True, "human gate: not required" + why_exempt))
  1722	        elif hg_ok:
  1723	            checks.append(check("human_gate", True,
  1724	                                f"human gate: approved by {hg.get('approver')!r}"))
  1725	        else:
  1726	            checks.append(check(
  1727	                "human_gate", False,
  1728	                "human gate: NOT APPROVED — L3 requires "
  1729	                "`coverloop attest --approve --approver <name>`"))
