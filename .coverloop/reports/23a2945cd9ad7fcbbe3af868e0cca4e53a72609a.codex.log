   646	def load_json(path):
   647	    """Return (data, error). Fail closed on unreadable/invalid JSON."""
   648	    try:
   649	        with open(path, encoding="utf-8") as f:
   650	            return json.load(f), None
   651	    except FileNotFoundError:
   652	        return None, f"{path}: not found"
   653	    except (json.JSONDecodeError, OSError) as e:
   654	        return None, f"{path}: unreadable ({e})"
