   602	def git(args, cwd=None):
   603	    """Run a git command; return stdout or None on failure."""
   604	    try:
   605	        out = subprocess.run(
   606	            ["git"] + args, cwd=cwd, capture_output=True, text=True, timeout=30,
   607	            # Strict UTF-8 made a non-decodable FILENAME raise, which the gate
   608	            # caught and softened to an L1 floor — an L3 change passing on tests
   609	            # alone because someone's file was latin-1. surrogateescape keeps the
   610	            # bytes intact and round-trippable, so the path is classified rather
   611	            # than lost.
   612	            errors="surrogateescape",
   613	        )
   614	    except (OSError, subprocess.TimeoutExpired):
   615	        return None
   616	    if out.returncode != 0:
   617	        return None
   618	    # NUL-delimited output is a list of RAW pathnames: a leading or trailing
   619	    # space is part of a filename, not formatting. Stripping it re-created the
   620	    # exemption bypass one layer below classify_paths(), where the tests could
   621	    # not see it — " .coverloop/reports/<sha>.json" became the exact exempt
   622	    # shape again. Only line-oriented output gets the convenience strip.
   623	    if "-z" in args:
   624	        return out.stdout
   625	    return out.stdout.strip()
