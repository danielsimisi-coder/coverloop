   325	def _validated_baseline(root, sha, limit=2000):
   326	    """The newest ancestor of SHA whose evidence chain actually VALIDATES.
   327	
   328	    Returns (baseline, validated): `validated` is False when the baseline is the
   329	    bare root commit with no accepted evidence — the caller must then classify
   330	    the root's OWN files too, because a two-dot diff from the root excludes the
   331	    files the root itself introduced (a migration in a repo's FIRST commit was
   332	    never classified at all; probed end-to-end). None baseline means git could
   333	    not answer, or the history is SHALLOW — a shallow boundary looks exactly
   334	    like a root commit to rev-list --max-parents=0, and treating it as one
   335	    silently drops everything at or before the boundary; fail closed and let
   336	    the operator fetch full history (CI: fetch-depth: 0, or pass --base).
   337	
   338	    A report advances the baseline only if BOTH hold:
   339	      * its tier covers the deterministic floor of the segment it governs, AND
   340	      * it would pass its own VERIFICATION (tests bound to the config command,
   341	        hash-bound reviewer transcripts) — NOT authorization: whether a human
   342	        signed for it is the gate's question about the commit being shipped,
   343	        not a property that makes an ancestor a worse baseline — existence is
   344	        not validity, and a bare tier claim is not evidence: a planted
   345	        no-evidence L3 report on a migration commit advanced the baseline and
   346	        let a later docs commit gate at L0 (probed end-to-end).
   347	
   348	    Cost is bounded: at most _BASELINE_WALK_CAP evidence commits are validated
   349	    (newest-first); anything older folds into the pre-baseline segment, which
   350	    only ever ENLARGES what the gate classifies.
   351	    """
   352	    shallow = git(["rev-parse", "--is-shallow-repository"], cwd=root)
   353	    if shallow is None or shallow.strip() == "true":
   354	        return None, False
   355	    out = git(["rev-list", f"--max-count={limit}", sha], cwd=root)
   356	    if not out:
   357	        return None, False
   358	    commits = out.split()
   359	    attested = []
   360	    for c in commits[1:]:
   361	        if os.path.exists(report_path(root, c)):
   362	            rep, _why = load_report(root, c)
   363	            if rep is not None and rep.get("risk_tier") in TIERS:
   364	                attested.append((c, rep))
   365	        if len(attested) >= _BASELINE_WALK_CAP:
   366	            break
   367	    root_out = git(["rev-list", "--max-parents=0", sha], cwd=root)
   368	    if not root_out:
   369	        return None, False
   370	    baseline = root_out.split()[-1]
   371	    validated = False
   372	    cfg, _cfg_err = load_json(os.path.join(root, CONFIG_FILE))
   373	    cfg_cmd = (cfg or {}).get("test_command")
   374	    for c, rep in reversed(attested):
   375	        if c == baseline and validated:
   376	            continue
   377	        seg = _git_paths(["diff", "--name-only", f"{baseline}..{c}"], root)
   378	        if seg is None:
   379	            return None, False
   380	        if not validated:
   381	            # The segment reaching back to the bare root must include the
   382	            # root's own files — a two-dot diff excludes what the root itself
   383	            # introduced, and nothing else ever accounts for those.
   384	            own = _git_paths(["show", "--name-only", "--pretty=format:", baseline], root)
   385	            if own is None:
   386	                return None, False
   387	            seg = list(seg) + own
   388	        tier = rep["risk_tier"]
   389	        floor, _reasons = classify_paths(seg, BREADTH_L2_FILES)
   390	        if tier_max(tier, floor) != tier:
   391	            continue  # under-declares its segment — not a valid baseline
   392	        # require_captured: a bare `--codex pass --glm pass --approve` records a
   393	        # CLAIM that nothing ran. Accepting it as a baseline let a later L1
   394	        # change start after it, and `check` schedules no reviewer below L2 —
   395	        # so the mandatory independent review disappeared for the whole span.
   396	        # Strictly more conservative than not requiring it: fewer reports
   397	        # advance the baseline, so more paths stay in the floor.
   398	        ok, _checks = evaluate(rep, tier, None, root=root, test_command=cfg_cmd,
   399	                               require_captured=True)
   400	        if not ok:
   401	            continue  # a tier claim with no evidence behind it is not a baseline
   402	        baseline = c
   403	        validated = True
   404	    return baseline, validated
   405	
   406	
   407	_BASELINE_WALK_CAP = 100
