  1058	                    if os.path.samestat(os.stat(d), rep_stat):
  1059	                        inside_reports = True
  1060	                        break
  1061	                except OSError:
  1062	                    pass
  1063	                parent = os.path.dirname(d)
  1064	                if parent == d:
  1065	                    break
  1066	                d = parent
