   841	def _fsync_dir(path):
   842	    """Best-effort fsync of a directory by path (fallback publication path)."""
   843	    try:
   844	        d = os.open(path or ".", os.O_RDONLY)
   845	    except OSError:
   846	        return
   847	    try:
   848	        _fsync_fd(d)
   849	    finally:
   850	        os.close(d)
