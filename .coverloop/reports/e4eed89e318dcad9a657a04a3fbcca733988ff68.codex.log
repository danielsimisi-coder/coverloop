  2231	# The words real reviewers actually end on. Sampled from the fleet's captured
  2232	# transcripts: Codex ends "VERDICT: PASS", GLM's red-team scale is
  2233	# "Verdict: PASS / PASS WITH RISKS / REQUEST CHANGES / BLOCK", and some runs
  2234	# emit lowercase "verdict: fail" or a GitHub-style "APPROVE". A parser that
  2235	# only knew uppercase "VERDICT: PASS" scored every one of those a fail —
  2236	# fail-closed, but useless: it would have made `check` unusable with the very
  2237	# reviewers this repo ships. Unknown wording still fails.
  2238	# The reviewer's verdict is a MACHINE PROTOCOL, not prose to be interpreted.
  2239	# Exactly one canonical marker line counts:
  2240	#
  2241	#     VERDICT: PASS        (or)        VERDICT: FAIL
  2242	#
  2243	# The reviewer PROMPT tells the reviewer to end with it; the gate does not try
  2244	# to infer approval from natural language. "PASS WITH RISKS", "APPROVE",
  2245	# "LGTM", "SHIP" and every other human phrasing are NOT a pass — inferring one
  2246	# would let a hedged review land as `pass` with zero open findings. Missing,
  2247	# malformed, truncated, ambiguous or non-canonical: FAIL CLOSED.
  2248	# Case-INSENSITIVE on purpose: a lowercase "verdict: fail" is still a verdict,
  2249	# and it must be seen so it can be rejected as non-canonical rather than skipped.
  2250	_VERDICT_MARKER = re.compile(r"^[ \t]*VERDICT:.*$", re.M | re.I)
  2251	# The only thing allowed to follow the closing marker: a CLI's own footer.
  2252	# Codex prints "tokens used" and a number. Anything sentence-like after the
  2253	# verdict means the reviewer kept talking, and the marker was not its last word.
  2254	_VERDICT_FOOTER = re.compile(
  2255	    r"^(tokens?[ _]used\s*:?\s*[\d,.]*\s*[kmb]?|[\d,.]+|[-=_*]{3,})$", re.I)
  2256	_VERDICT_FOOTER_MAX = 3   # a CLI footer, not room for a paragraph
  2257	_VERDICT_CANONICAL_PASS = "VERDICT: PASS"
  2258	_VERDICT_CANONICAL_FAIL = "VERDICT: FAIL"
