+def _reviewer_binary_fingerprints(cmds, env):
+    """sha256 of each reviewer command's resolved executable, before anything
+    else runs.
+
+    The configured test command is arbitrary code running with the operator's
+    privileges, and it runs BEFORE the reviewers. Nothing stops it overwriting
+    a user-owned reviewer wrapper with one that prints the pass marker — no
+    repository file changes, so the dirty-tree check sees nothing. This does not
+    make the test command safe (it cannot: `coverloop` is a gate, not a
+    sandbox), but it does catch the specific swap.
+    """
+    prints = {}
+    for role, cmd in (cmds or {}).items():
+        for tok in cmd.replace("|", " ").replace(";", " ").split():
+            tok = tok.strip("\"'")
+            if not tok or tok.startswith("-") or "=" in tok:
+                continue
+            exe = shutil.which(tok, path=env.get("PATH")) if not os.path.sep in tok else (
+                tok if os.path.exists(tok) else None)
+            if exe:
+                try:
+                    with open(exe, "rb") as fh:
+                        prints[role] = (exe, hashlib.sha256(fh.read()).hexdigest())
+                except OSError:
+                    prints[role] = (exe, None)
+            break                       # the command word only
+    return prints
