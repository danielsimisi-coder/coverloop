  1676	    tests = report.get("tests") if report else None
  1677	    recorded_cmd = str((tests or {}).get("command", "")).strip()
  1678	    # The recorded test command must match the project's CURRENT config command,
  1679	    # so a hand-forged `{"command":"echo fake","status":"pass"}` (or an old
  1680	    # command from before config changed) can't gate green. FAIL CLOSED when the
  1681	    # config has no test_command — an empty/None command can never be a match, so
  1682	    # a forged pass can't ride on a repo that never configured its tests.
  1683	    cfg_cmd = str(test_command or "").strip()
  1684	    cmd_matches = bool(cfg_cmd) and recorded_cmd == cfg_cmd
  1685	    tests_ok = bool(tests) and tests.get("status") == "pass" and bool(recorded_cmd) and cmd_matches
  1686	    if tier == "L1" and docs_only(files):
  1687	        checks.append(check("tests", True, "docs-only diff — test gate waived"))
  1688	    else:
  1689	        if not cfg_cmd:
  1690	            detail = "tests: no test_command configured — cannot verify (set one in .coverloop/config.json)"
  1691	        elif tests and not cmd_matches:
  1692	            detail = (f"tests: recorded command {recorded_cmd!r} != config test_command "
  1693	                      f"{cfg_cmd!r} — re-run `coverloop attest --tests`")
  1694	        elif tests:
  1695	            detail = f"tests: {tests.get('status')} ({tests.get('command')})"
