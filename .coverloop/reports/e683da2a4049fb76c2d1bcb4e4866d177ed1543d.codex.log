#!/usr/bin/env python3
import os
import sys
import json
import hashlib
import urllib.request
import urllib.error
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from glm_secret_filter import SECRET_PATTERNS, FILTER_VERSION, scan, redact
import egress_cap  # daily reviewer-call spend cap (R6)

CLI_VERSION = "2.2.0"

API_URL = "https://openrouter.ai/api/v1/chat/completions"
# Default reviewer since 2.1.0 (2026-09-23): Kimi K3 — a known-answer pilot on three historical
# design packets found more of the later-confirmed bugs, faster, than GLM 5.2/5.3 and Gemini 3.1 Pro,
# on the same ZDR route (see CHANGELOG). GLM_MODEL still overrides; the helpers keep their glm-* names.
MODEL = os.getenv("GLM_MODEL", "moonshotai/kimi-k3")
MAX_CHARS = int(os.getenv("GLM_MAX_CHARS", "120000"))
MAX_COMPLETION_TOKENS = int(os.getenv("GLM_MAX_COMPLETION_TOKENS", "4096"))
REASONING_EFFORT = os.getenv("GLM_REASONING_EFFORT", "high")
TIMEOUT = int(os.getenv("GLM_TIMEOUT", "120"))
USE_ZDR = True  # ZDR mandatory, NOT env-disableable (Codex P1; protocol Hard Boundaries)
# The role prompts below name the reviewer ("You are GLM-5.2 as …"). The engine
# itself — privacy gate, secret filter, egress log, spend cap — is model-agnostic,
# so a sibling reviewer on a DIFFERENT lineage reuses it by overriding the model
# and this name. Nothing else about the prompts changes: the ROLE is the point,
# the lineage is what makes a second opinion worth having.
REVIEWER_NAME = os.getenv("REVIEWER_NAME", "Kimi K3")
# Resolved through the SAME helper the cap reads, so the two can never point
# at different files. They used to diverge: the cap honoured
# COVERLOOP_EGRESS_LOG while the reviewers hardcoded the default, so relocating
# the log left the cap counting a file nobody wrote to — it then read zero usage
# and allowed every request. A quota that silently stops counting is worse than
# no quota, because the dashboard still says you are protected.
EGRESS_LOG = Path(os.environ.get("COVERLOOP_EGRESS_LOG")
                 or (Path.home() / ".config" / "openrouter" / "egress.log"))

SYSTEMS = {
    "ask": "You are GLM-5.2 as a read-only advisory software engineering specialist. You can only analyze the text provided. You cannot access shell, files, repo, secrets, or commands. Be concise and evidence-based.",
    "scout": "You are GLM-5.2 as a read-only pre-implementation scout. Identify risks, affected areas, unclear requirements, missing tests, and what Codex should verify. Use only provided text.",
    "tests": "You are GLM-5.2 as a read-only test strategist. Suggest the smallest useful tests that catch real regressions. Use only provided text.",
    "audit": "You are GLM-5.2 acting as a LOW-AUTHORITY System/Runtime Consistency Auditor in the AI development workflow. You are not a builder. You cannot run commands or access files unless pasted. You cannot approve merge, deploy, migrations, prod, env, secrets, billing, worker changes, or payments. Findings are advisory only. Catch cross-layer deployment/runtime mismatches: app code depending on DB columns/RPCs not deployed everywhere; app auto-deploy vs gated migrations; staging/prod drift; worker code depending on missing columns/RPCs; unsafe blanket db push or migration ordering; docs/runbook contradictions; route/page assumptions failing when fields are null/missing; rollback-order gaps. Return a markdown table with exactly: Finding | Severity P0/P1/P2 | Evidence | Why it matters | Required verification | Suggested action | Gate required? Never output only None. If evidence is missing, write needs verification. Do not invent runtime facts.",
    "redteam": """You are GLM-5.2 as an adversarial read-only reviewer.
You are NOT the builder. You are NOT the final gate. Codex/GPT-5.5 xhigh remains final reviewer.
Review only evidence provided.
Output:
1. Verdict: PASS / PASS WITH RISKS / REQUEST CHANGES / BLOCK
2. P0 blockers, if any
3. P1 serious issues, if any
4. P2 improvements, if any
5. Missing tests / verification
6. Likely false positives / what to ignore
7. Suggested next action
Severity:
- P0 = definite production blocker with direct evidence.
- P1 = likely serious issue.
- P2 = improvement, edge case, docs, naming, or ambiguous requirement.
If ambiguous, do not mark P0.""",
    # Measured on known misses (2026-11-05, CHANGELOG): the same two models found bugs every earlier
    # run missed once they had these questions AND were told to report what they could not rule out.
    # Neither change alone did. Advisory output: every finding is a claim for the builder to verify.
    "diff": """You are GLM-5.2 as an adversarial read-only reviewer of a finished change. You are NOT the gate.
Find defects in the change itself: logic errors, fail-open paths, claims the code does not support, missing or wrong tests.
A limitation the change states about itself is a claim to challenge, not a reason to stop looking.
Answer each question in a CHECKED line:
(1) Existing data: what happens when reports, records or configs written by earlier versions meet this code?
(2) Claims: for each statement this change adds to docs, comments or the changelog, does the code support it for all inputs?
(3) Tests: which new behaviour has no test that would fail if the behaviour broke?
(4) Failure paths: for each new branch, error, timeout, missing or corrupt input, does it fail closed?
Output:
- 3 to 8 lines, exactly `CHECKED <place> | <what you tried to break> | <what happened>`. Required whatever you find; a reply with only a conclusion is invalid.
- Then one line per finding, exactly `FINDING [P0|P1|P2] <short title> | <file:place> | <concrete input or sequence> | <minimal fix> | confidence: high|medium|low`
Rate severity by the impact if the finding is true. Report every suspect you could not rule out; do not withhold one because you are unsure, a human verifies every finding.
Do not report style or naming. Give no overall verdict: no findings does not mean the change is safe.""",
    "code": """You are GLM-5.2 as an optional implementation specialist.
You may propose code or a unified diff patch.
