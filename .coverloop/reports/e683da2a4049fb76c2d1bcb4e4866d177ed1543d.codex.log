# Asked of the same conversation in diff mode. Measured 2026-11-06 (CHANGELOG): it surfaced a known
# gap no first pass had; an independent benchmark found recall up across models.
SECOND_PASS = ("Go through the change once more. Report only defects you did not report above, "
               "in the same FINDING format. If there are none, write NONE.")


def provider_block():
    return {"zdr": True, "allow_fallbacks": False, "data_collection": "deny"}

def read_key():
    # Installed as a Claude Code plugin, the key comes from the user's OS
    # keychain via userConfig and is exposed here — no file to create, no
    # chmod to remember, and nothing key-shaped anywhere in the repo. Checked
    # FIRST so a plugin install needs no manual setup at all.
    plugin_key = [REDACTED:secret-value]"CLAUDE_PLUGIN_OPTION_OPENROUTER_API_KEY", "").strip()
    if plugin_key:
        [REDACTED:secret-value] plugin_key
    env_key = [REDACTED:secret-value]"OPENROUTER_API_KEY")
    if env_key:
        [REDACTED:secret-value] env_key.strip()
    key_path = Path.home() / ".config" / "openrouter" / "api_key"
    if key_path.exists():
        return key_path.read_text(encoding="utf-8").strip()
    print("ERROR: no OpenRouter API key. Either set it in the Coverloop plugin "
          "settings, or export OPENROUTER_API_KEY, or write it to "
          "~/.config/openrouter/api_key (chmod 600). Run `coverloop doctor` "
          "for the exact command.", file=sys.stderr)
    sys.exit(1)

def log_egress(model, mode, zdr_requested, http_status, secret_scan, char_count, payload_sha, extra=None):
    rec = {
        "ts": datetime.now(timezone.utc).isoformat(),
        "cli_version": CLI_VERSION,
        "filter_version": FILTER_VERSION,
        "model": model,
        "mode": mode,
        "zdr_requested": bool(zdr_requested),
        "http_status": http_status,
        "secret_scan": secret_scan,
        "char_count": char_count,
        "sha256_of_payload": payload_sha,
        "zdr_verified": bool(zdr_requested) and http_status == 200,
        "served_by": None,
    }
    if extra:
        rec.update(extra)
    try:
        os.makedirs(os.path.dirname(str(EGRESS_LOG)), exist_ok=True)
        fd = os.open(str(EGRESS_LOG), os.O_CREAT | os.O_APPEND | os.O_WRONLY, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except Exception as e:
        print(f"ERROR: egress log write failed ({e}); failing closed (no unaudited send).", file=sys.stderr)
        sys.exit(7)

def sha(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()

def _enforce_egress_redaction(payload):
    """SINGLE egress choke point (operator invariant, 2026-07-15): NO content reaches the network
    without passing redact() + a fail-closed scan(). Every do_request caller — review, ping,
    self-test, any future path — is covered here, so there is structurally no raw-packet bypass.
    redact() is idempotent, so already-redacted review content is unchanged."""
    for msg in payload.get("messages", []):
        c = msg.get("content")
        if isinstance(c, str):
            msg["content"] = redact(c)
    joined = "\n".join(m.get("content", "") for m in payload.get("messages", []) if isinstance(m.get("content"), str))
    hits = scan(joined)
    if hits:
        raise RuntimeError("egress blocked: redacted packet still scans as secret-bearing: " + ",".join(hits))
    return payload


def do_request(payload, timeout):
    payload = _enforce_egress_redaction(payload)
    req = urllib.request.Request(
        API_URL,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {read_key()}",
            "Content-Type": "application/json",
            "X-Title": "the operator GLM Least Privilege CLI v" + CLI_VERSION,
        },
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))

def zdr_selftest():
    if not USE_ZDR:
        print("ZDR SELF-TEST: GLM_ZDR is disabled by env — refusing to self-test without ZDR.", file=sys.stderr)
        log_egress(MODEL, "zdr-selftest", False, None, "n/a", 0, "", {"zdr_disabled_by_env": True})
        return 4
    payload = {
        "model": MODEL,
        "messages": [{"role": "user", "content": "ping"}],
        "max_completion_tokens": 8,
        "temperature": 0,
        "provider": provider_block(),
    }
    try:
        data = do_request(payload, 30)
        served = data.get("provider")
        print(f"ZDR SELF-TEST OK: model={MODEL} served_by={served} — a ZDR endpoint accepted the request "
              f"(zdr:true, allow_fallbacks:false). Routing-level proof; OpenRouter returns no per-response ZDR attestation.")
        log_egress(MODEL, "zdr-selftest", True, 200, "n/a", 0, "", {"served_by": served})
        return 0
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        if e.code == 404 and "zero data retention" in body.lower():
            print(f"ZDR SELF-TEST FAIL CLOSED: no ZDR endpoint for {MODEL}. "
                  f"Do NOT send proprietary content to this model. Use a ZDR-backed model.", file=sys.stderr)
            log_egress(MODEL, "zdr-selftest", True, 404, "n/a", 0, "", {"zdr_denied": True})
            return 4
        print(f"ZDR SELF-TEST HTTP ERROR {e.code}:\n{body}", file=sys.stderr)
        log_egress(MODEL, "zdr-selftest", True, e.code, "n/a", 0, "", {"error": True})
        return 1
    except Exception as e:
        print(f"ZDR SELF-TEST ERROR: {e}", file=sys.stderr)
        log_egress(MODEL, "zdr-selftest", True, None, "n/a", 0, "", {"error": str(e)})
        return 1

def second_pass(payload, first, mode, char_count, payload_sha):
    """Optional by design: the first answer is already printed, so any failure here is
    noted and leaves it standing. Same choke point, same privacy path, same spend cap."""
    follow_up = dict(payload)
    follow_up["messages"] = payload["messages"] + [
        {"role": "assistant", "content": first},
        {"role": "user", "content": SECOND_PASS},
    ]
    try:
        egress_cap.reserve_daily_slot(
            lambda: log_egress(MODEL, mode, USE_ZDR, None, "clean", char_count,
                               payload_sha, {"phase": "attempt", "pass": 2}))
        data = do_request(follow_up, TIMEOUT)
