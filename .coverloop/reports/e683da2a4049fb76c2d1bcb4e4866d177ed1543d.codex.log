#!/usr/bin/env python3
"""Property-based / fuzz / concurrency tests (R3 hardening).

The unit suite (test_gate.py) proves specific inputs; this proves INVARIANTS
over many seeded-random inputs, plus filesystem-race behavior the unit tests
can't reach. stdlib-only (random with a FIXED seed for determinism — no
hypothesis dependency, and reproducible in CI).

Run:  python3 tests/test_properties.py
"""
import json
import os
import random
import re
import string
import subprocess
import sys
import tempfile
import threading
import time
import unittest

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "bin"))
BIN_DIR = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "bin")
CLI = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "bin", "coverloop")
import glm_secret_filter as F

SEED = 20260711  # fixed -> deterministic, reproducible failures

# ---------------------------------------------------------------------------
# The suite drives the REAL reviewer CLIs (that is the point of the egress
# tests: they assert on the exact bytes that would leave the machine). Their
# do_request is stubbed, so nothing is ever sent — but log_egress still wrote
# `attempt` markers to the PRODUCTION egress log, and the daily spend cap counts
# exactly those markers — 6 per run, measured (13 log lines: 6 attempts, 6
# results, 1 refusal). Small per run, and the reason every real review was
# refused by late afternoon after a day of re-running the suite. That is how a
# test suite silently consumed production quota.
#
# The whole module runs against a temporary log, and tearDownModule FAILS if the
# caller's log changed SIZE OR MTIME while the suite ran. That is a tripwire,
# not proof: a real review running concurrently trips it, and a change that
# restored both values would not. It is here to catch the accident this comment
# describes, not to detect tampering.
# ---------------------------------------------------------------------------
PROD_EGRESS_LOG = os.path.join(os.path.expanduser("~"), ".config", "openrouter", "egress.log")
_SUITE_LOG_DIR = None
_PROD_LOG_BEFORE = None
_CALLER_EGRESS_LOG = None      # whatever the caller had set, restored on teardown


def _prod_log_fingerprint():
    try:
        st = os.stat(PROD_EGRESS_LOG)
        return (st.st_size, st.st_mtime_ns)
    except OSError:
        return None


def setUpModule():
    global _SUITE_LOG_DIR, _PROD_LOG_BEFORE, _CALLER_EGRESS_LOG, PROD_EGRESS_LOG
    # The log to PROTECT is the caller's, not a hardcoded default: someone who
    # runs the suite with COVERLOOP_EGRESS_LOG pointing at their own log would
    # otherwise have it overwritten, unset on teardown, and never fingerprinted.
    _CALLER_EGRESS_LOG = os.environ.get("COVERLOOP_EGRESS_LOG")
    if _CALLER_EGRESS_LOG:
        PROD_EGRESS_LOG = _CALLER_EGRESS_LOG
    _PROD_LOG_BEFORE = _prod_log_fingerprint()
    _SUITE_LOG_DIR = tempfile.mkdtemp(prefix="coverloop-suite-egress-")
    os.environ["COVERLOOP_EGRESS_LOG"] = os.path.join(_SUITE_LOG_DIR, "egress.log")


def tearDownModule():
    import shutil as _sh
    if _CALLER_EGRESS_LOG is None:
        os.environ.pop("COVERLOOP_EGRESS_LOG", None)
    else:
        os.environ["COVERLOOP_EGRESS_LOG"] = _CALLER_EGRESS_LOG
    if _SUITE_LOG_DIR:
        _sh.rmtree(_SUITE_LOG_DIR, ignore_errors=True)
    if _prod_log_fingerprint() != _PROD_LOG_BEFORE:
        raise AssertionError(
            f"the egress log at {PROD_EGRESS_LOG} changed size or mtime while the "
            f"suite ran (a concurrent real review would also do this). "
            f"Those entries are what the daily spend cap counts, so the suite would be "
    def _head_floor(self, d):
        r = self._cl(d, "gate", "--json", "--min-tier", "L0")
        out = json.loads(r.stdout)
        return r.returncode, out

    def test_an_L3_anchor_older_than_100_reports_still_bounds_the_floor(self):
        with tempfile.TemporaryDirectory() as d:
            self._repo(d)
            mig = self._commit(d, "migrations/1.sql", "drop table x;\n", "T6: migration")
            r = self._cl(d, "attest", "--tier", "L3", "--tests")
            self.assertEqual(r.returncode, 0, r.stderr)
            for args in (["--codex", "pass"], ["--mutation", "pass", "--mutation-guards", "1"],
                         ["--approve", "--approver", "daniel"]):
                r = self._cl(d, "attest", *args)
                self.assertEqual(r.returncode, 0, r.stderr)
            last = self._docs_reports(d, self.AFTER_ANCHOR)
            head = self._commit(d, "docs/guide.md", "docs only\n", "docs-only change")

            baseline, validated = self.mod._validated_baseline(d, head)
            self.assertTrue(validated, "no baseline validated: the walk fell back to the root")
            self.assertEqual(baseline, last)
            self.assertNotIn("migrations/1.sql",
                             self._git(d, "diff", "--name-only", f"{baseline}..{head}"))
            code, out = self._head_floor(d)
            self.assertEqual(out["tier"], "L0",
                             f"a docs-only change floored at {out['tier']}: the migration on "
                             f"{mig[:7]} was re-classified because its anchor was out of reach")
            self.assertEqual(code, 0, out)

    def test_an_unapproved_L3_anchor_out_of_reach_still_floors_at_L3(self):
        """Fail closed: walking further must not make a report count that would
        not count up close. The anchor here lacks the human approval."""
        with tempfile.TemporaryDirectory() as d:
            root = self._repo(d)
            mig = self._commit(d, "migrations/1.sql", "drop table x;\n", "migration")
            ev = dict(self.L3_EVIDENCE)
            ev["human_gate"] = {"required": True, "approved": False}
            self._report(d, mig, "L3", **ev)
            self._docs_reports(d, self.AFTER_ANCHOR)
            head = self._commit(d, "docs/guide.md", "docs only\n", "docs-only change")
            self.assertEqual(self.mod._validated_baseline(d, head), (root, False))
            code, out = self._head_floor(d)
            self.assertEqual(out["tier"], "L3")
            self.assertNotEqual(code, 0)

    def test_a_valid_report_below_L3_is_not_an_anchor(self):
        """Only an L3 report validates whatever came before it. An L1 report with
        passing tests, sitting after an unreviewed migration, under-declares its
        segment — stopping the walk at it would hide the migration."""
        with tempfile.TemporaryDirectory() as d:
            root = self._repo(d)
            self._commit(d, "migrations/1.sql", "drop table x;\n", "unreviewed migration")
            self._docs_reports(d, 3)
            head = self._commit(d, "docs/guide.md", "docs only\n", "docs-only change")
            self.assertEqual(self.mod._validated_baseline(d, head), (root, False))
            code, out = self._head_floor(d)
            self.assertEqual(out["tier"], "L3")
            self.assertNotEqual(code, 0)

    def test_a_failing_L3_newer_than_the_anchor_is_replayed_not_skipped(self):
        """The walk passes over an L3 that fails its own evaluation and anchors
        on an older valid one; the failing report must stay in the replay,
        where it does not advance the baseline, and the floor must still see
        the migration it carried."""
        with tempfile.TemporaryDirectory() as d:
            self._repo(d)
            mig1 = self._commit(d, "migrations/1.sql", "drop table x;\n", "reviewed migration")
            self._report(d, mig1, "L3", **self.L3_EVIDENCE)
            ev = dict(self.L3_EVIDENCE)
            ev["human_gate"] = {"required": True, "approved": False}
            mig2 = self._commit(d, "migrations/2.sql", "drop table y;\n", "unapproved migration")
            self._report(d, mig2, "L3", **ev)
            self._commit(d, "NOTES.md", "evidence\n", "evidence")
            head = self._commit(d, "docs/guide.md", "docs only\n", "docs-only change")
            self.assertEqual(self.mod._validated_baseline(d, head), (mig1, True))
            code, out = self._head_floor(d)
            self.assertEqual(out["tier"], "L3", "the unapproved migration fell out of the floor")
            self.assertNotEqual(code, 0)

    def test_without_an_anchor_the_whole_chain_is_replayed(self):
        # No L3 anywhere: the honest L1 chain runs from the root through more
        # than 100 reports, and must still reach the newest one.
        with tempfile.TemporaryDirectory() as d:
            self._repo(d)
            last = self._docs_reports(d, self.AFTER_ANCHOR)
            head = self._commit(d, "docs/guide.md", "docs only\n", "docs-only change")
            self.assertEqual(self.mod._validated_baseline(d, head), (last, True))
            code, out = self._head_floor(d)
            self.assertEqual((code, out["tier"]), (0, "L0"), out)

    def _reference_chain(self, d, sha):
        """The definition the walk must match: the v2.12.3 walk with its two
        caps removed and nothing else changed — replay EVERY report from the
        root, oldest first, failing closed wherever git cannot answer."""
        m = self.mod
        shallow = m.git(["rev-parse", "--is-shallow-repository"], cwd=d)
        if shallow is None or shallow.strip() == "true":
            return None, False
        out = m.git(["rev-list", sha], cwd=d)
        if not out:
            return None, False
        attested = []
        for c in out.split()[1:]:
            if os.path.exists(m.report_path(d, c)):
                rep, _ = m.load_report(d, c)
                if rep is not None and rep.get("risk_tier") in m.TIERS:
                    attested.append((c, rep))
        root_out = m.git(["rev-list", "--max-parents=0", sha], cwd=d)
        if not root_out:
            return None, False
        baseline = root_out.split()[-1]
        validated = False
        cfg, _ = m.load_json(os.path.join(d, m.CONFIG_FILE))
        cmd = (cfg or {}).get("test_command")
        for c, rep in reversed(attested):
            if c == baseline and validated:
                continue
            seg = m._git_paths(["diff", "--name-only", f"{baseline}..{c}"], d)
            if seg is None:
                return None, False
            if not validated:
                own = m._git_paths(["show", "--name-only", "--pretty=format:", baseline], d)
                if own is None:
                    return None, False
                seg = list(seg) + own
            floor, _ = m.classify_paths(seg, m.BREADTH_L2_FILES)
            if m.tier_max(rep["risk_tier"], floor) != rep["risk_tier"]:
                continue
            if not m.evaluate(rep, rep["risk_tier"], None, root=d, test_command=cmd)[0]:
                continue
            baseline, validated = c, True
        return baseline, validated

    def _random_report(self, rng, d, sha):
        roll = rng.random()
        if roll < 0.25:
            return
        tier = rng.choice(self.mod.TIERS)
        ev = {}
        if tier in ("L2", "L3"):
            ev["codex"] = self.L3_EVIDENCE["codex"]
        if tier == "L3":
            ev["mutation"] = self.L3_EVIDENCE["mutation"]
            ev["human_gate"] = (self.L3_EVIDENCE["human_gate"] if roll > 0.45
                                else {"required": True, "approved": False})
        self._report(d, sha, tier, **ev)

    def test_the_anchor_shortcut_matches_the_full_replay(self):
        """Stopping at the newest valid L3 report is an optimisation, not a new
        rule: on random histories — some with a merged side branch whose commit
        dates are skewed, so rev-list's date order is not the topology — it
        must give exactly what replaying every report from the root gives."""
        rng = random.Random(20261011)
        files = ["NOTES.md", "src/app.py", "migrations/{}.sql", "api/routes.ts"]
        side_files = ["side/{}.md", "src/side{}.py", "migrations/side{}.sql"]
        for trial in range(12):
            with self.subTest(trial=trial), tempfile.TemporaryDirectory() as d:
                self._repo(d)
                main_shas = []
                for i in range(rng.randint(6, 14)):
                    sha = self._commit(d, rng.choice(files).format(i), f"{i}\n", f"c{i}")
                    main_shas.append(sha)
                    self._random_report(rng, d, sha)
                if trial % 2:
                    fork = rng.choice(main_shas[:-1])
                    self._git(d, "add", "-A")
                    self._git(d, "commit", "-qm", "evidence", "--allow-empty")
                    self._git(d, "checkout", "-q", "-b", "side", fork)
                    skew = rng.choice(["2001-01-01T00:00:00", "2099-01-01T00:00:00"])
                    env = dict(os.environ, GIT_COMMITTER_DATE=skew, GIT_AUTHOR_DATE=skew)
                    for j in range(rng.randint(1, 3)):
                        rel = rng.choice(side_files).format(j)
                        os.makedirs(os.path.dirname(os.path.join(d, rel)), exist_ok=True)
                        with open(os.path.join(d, rel), "a") as fh:
                            fh.write(f"{j}\n")
                        subprocess.run(["git", "add", "-A"], cwd=d, check=True, env=env)
                        subprocess.run(["git", "commit", "-qm", f"side{j}"], cwd=d,
                                       check=True, env=env)
                        sha = self._git(d, "rev-parse", "HEAD")
                        self._random_report(rng, d, sha)
                    self._git(d, "add", "-A")
                    self._git(d, "commit", "-qm", "side evidence", "--allow-empty")
                    self._git(d, "checkout", "-q", "main")
                    self._git(d, "merge", "-q", "--no-ff", "-m", "merge side", "side")
                    merge = self._git(d, "rev-parse", "HEAD")
                    self._random_report(rng, d, merge)
                head = self._commit(d, "docs/guide.md", "head\n", "head")
                self.assertEqual(self.mod._validated_baseline(d, head),
                                 self._reference_chain(d, head))

    def test_history_before_the_anchor_is_not_read(self):
        """A pinned decision (Codex v2.12.4 round 1). The anchor stands for
        everything before it, so the walk does not read that history — and a
        pre-anchor tree or file git cannot read no longer makes the floor unknowable.
        The full replay does read it and refuses. v2.12.3 never read history
        beyond its 100-report window either: those reads were never an
        integrity check. What the floor depends on, anchor..HEAD, must still be
        readable — that path is unchanged."""
        with tempfile.TemporaryDirectory() as d:
            root = self._repo(d)
            mig = self._commit(d, "migrations/1.sql", "drop table x;\n", "migration")
            self._report(d, mig, "L3", **self.L3_EVIDENCE)
            self._commit(d, "NOTES.md", "evidence\n", "evidence")
            head = self._commit(d, "docs/guide.md", "docs only\n", "docs-only change")
            tree = self._git(d, "rev-parse", root + "^{tree}")
            os.remove(os.path.join(d, ".git", "objects", tree[:2], tree[2:]))
            self.assertIsNone(self.mod._git_paths(["diff", "--name-only", f"{root}..{mig}"], d))
            self.assertEqual(self._reference_chain(d, head), (None, False))
            self.assertEqual(self.mod._validated_baseline(d, head), (mig, True))
            code, out = self._head_floor(d)
            self.assertEqual((code, out["tier"]), (0, "L0"), out)

    def test_a_missing_commit_before_the_anchor_still_refuses(self):
        """The limit of the decision above: rev-list walks every commit, so a
        missing commit object is not skipped by the anchor. It refuses."""
        with tempfile.TemporaryDirectory() as d:
            root = self._repo(d)
            mig = self._commit(d, "migrations/1.sql", "drop table x;\n", "migration")
            self._report(d, mig, "L3", **self.L3_EVIDENCE)
            self._commit(d, "NOTES.md", "evidence\n", "evidence")
            head = self._commit(d, "docs/guide.md", "docs only\n", "docs-only change")
            os.remove(os.path.join(d, ".git", "objects", root[:2], root[2:]))
            self.assertEqual(self.mod._validated_baseline(d, head), (None, False))

    def test_the_walk_lists_history_without_a_commit_limit(self):
        """v2.12.4 removed `rev-list --max-count=2000` too, but every history
        here is far shorter than that, so only the call itself can pin it."""
        with tempfile.TemporaryDirectory() as d:
            self._repo(d)
            head = self._commit(d, "docs/guide.md", "docs only\n", "docs-only change")
            real, calls = self.mod.git, []
            def spy(args, **kw):
                calls.append(args)
                return real(args, **kw)
            self.mod.git = spy
            try:
                self.mod._validated_baseline(d, head)
            finally:
                self.mod.git = real
            walks = [a for a in calls if a and a[0] == "rev-list"]
            self.assertTrue(walks)
            self.assertFalse([a for a in walks if any(str(x).startswith(("--max-count", "-n")) for x in a)], walks)

class SuiteCollectsItself(unittest.TestCase):
    """The entry point is load-bearing, not decorative.

    CI runs this file directly, and `unittest.main()` collects only what is
    defined ABOVE it — so a class appended below is silently skipped. A comment
    saying so does not prevent it; this does.
    """

    def test_nothing_is_defined_after_the_entry_point(self):
        src = open(__file__, encoding="utf-8").read().splitlines()
        entry = [i for i, ln in enumerate(src) if ln.startswith('if __name__ == "__main__"')]
        self.assertEqual(len(entry), 1, "exactly one entry point expected")
        after = src[entry[0]:]
        offenders = [ln for ln in after
                     if ln.startswith("class ") or ln.startswith("def ")]
        self.assertEqual(offenders, [],
                         "defined below unittest.main(); it will be silently skipped when "
                         "CI runs this file directly — move it above the entry point")

    def test_the_production_log_fingerprint_notices_a_write(self):
        # Covers the FINGERPRINT the guard is built on — that a written-to log
        # does not look untouched, and a removed one reads as absent. It does
        # not exercise tearDownModule's comparison itself, which cannot run
        # inside the module it tears down.
        probe = os.path.join(_SUITE_LOG_DIR or tempfile.gettempdir(), "tripwire-probe.log")
        saved = globals()["PROD_EGRESS_LOG"]
        try:
            globals()["PROD_EGRESS_LOG"] = probe
            open(probe, "w").write("one\n")
            before = _prod_log_fingerprint()
            self.assertIsNotNone(before)
            open(probe, "a").write("two\n")
            self.assertNotEqual(_prod_log_fingerprint(), before,
                                "a written-to log must not look untouched")
            os.remove(probe)
            self.assertIsNone(_prod_log_fingerprint())
        finally:
            globals()["PROD_EGRESS_LOG"] = saved
