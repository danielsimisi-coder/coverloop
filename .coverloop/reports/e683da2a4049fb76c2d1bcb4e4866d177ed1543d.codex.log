   169	            "Content-Type": "application/json",
   170	            "X-Title": "the operator GLM Least Privilege CLI v" + CLI_VERSION,
   171	        },
   172	        method="POST",
   173	    )
   174	    with urllib.request.urlopen(req, timeout=timeout) as resp:
   175	        return json.loads(resp.read().decode("utf-8"))
