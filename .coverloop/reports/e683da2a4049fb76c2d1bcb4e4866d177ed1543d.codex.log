import unittest

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "bin"))
BIN_DIR = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "bin")
CLI = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "bin", "coverloop")
import glm_secret_filter as F

SEED = 20260711  # fixed -> deterministic, reproducible failures

# ---------------------------------------------------------------------------
# The suite drives the REAL reviewer CLIs (that is the point of the egress
# tests: they assert on the exact bytes that would leave the machine). Their
# do_request is stubbed, so nothing is ever sent — but log_egress still wrote
# `attempt` markers to the PRODUCTION egress log, and the daily spend cap counts
# exactly those markers — 6 per run, measured (13 log lines: 6 attempts, 6
# results, 1 refusal). Small per run, and the reason every real review was
# refused by late afternoon after a day of re-running the suite. That is how a
# test suite silently consumed production quota.
#
# The whole module runs against a temporary log, and tearDownModule FAILS if the
# caller's log changed SIZE OR MTIME while the suite ran. That is a tripwire,
# not proof: a real review running concurrently trips it, and a change that
# restored both values would not. It is here to catch the accident this comment
# describes, not to detect tampering.
# ---------------------------------------------------------------------------
PROD_EGRESS_LOG = os.path.join(os.path.expanduser("~"), ".config", "openrouter", "egress.log")
_SUITE_LOG_DIR = None
_PROD_LOG_BEFORE = None
_CALLER_EGRESS_LOG = None      # whatever the caller had set, restored on teardown


def _prod_log_fingerprint():
    try:
        st = os.stat(PROD_EGRESS_LOG)
        return (st.st_size, st.st_mtime_ns)
    except OSError:
        return None


def setUpModule():
    global _SUITE_LOG_DIR, _PROD_LOG_BEFORE, _CALLER_EGRESS_LOG, PROD_EGRESS_LOG
    # The log to PROTECT is the caller's, not a hardcoded default: someone who
    # runs the suite with COVERLOOP_EGRESS_LOG pointing at their own log would
    # otherwise have it overwritten, unset on teardown, and never fingerprinted.
    _CALLER_EGRESS_LOG = os.environ.get("COVERLOOP_EGRESS_LOG")
    if _CALLER_EGRESS_LOG:
        PROD_EGRESS_LOG = _CALLER_EGRESS_LOG
    _PROD_LOG_BEFORE = _prod_log_fingerprint()
    _SUITE_LOG_DIR = tempfile.mkdtemp(prefix="coverloop-suite-egress-")
    os.environ["COVERLOOP_EGRESS_LOG"] = os.path.join(_SUITE_LOG_DIR, "egress.log")


def tearDownModule():
    import shutil as _sh
    if _CALLER_EGRESS_LOG is None:

    def _docs_reports(self, d, n, tier="L1"):
        """n docs commits, each with an honest report committed alongside the
        next one. Returns the newest attested commit."""
        last = None
        for i in range(n):
            last = self._commit(d, "NOTES.md", f"note {i}\n", f"docs {i}")
            self._report(d, last, tier)
        return last

    def _head_floor(self, d):
        r = self._cl(d, "gate", "--json", "--min-tier", "L0")
        out = json.loads(r.stdout)
        return r.returncode, out

    def test_an_L3_anchor_older_than_100_reports_still_bounds_the_floor(self):
        with tempfile.TemporaryDirectory() as d:
            self._repo(d)
            mig = self._commit(d, "migrations/1.sql", "drop table x;\n", "T6: migration")
            r = self._cl(d, "attest", "--tier", "L3", "--tests")
            self.assertEqual(r.returncode, 0, r.stderr)
            for args in (["--codex", "pass"], ["--mutation", "pass", "--mutation-guards", "1"],
                         ["--approve", "--approver", "daniel"]):
                r = self._cl(d, "attest", *args)
                self.assertEqual(r.returncode, 0, r.stderr)
            last = self._docs_reports(d, self.AFTER_ANCHOR)
            head = self._commit(d, "docs/guide.md", "docs only\n", "docs-only change")

            baseline, validated = self.mod._validated_baseline(d, head)
            self.assertTrue(validated, "no baseline validated: the walk fell back to the root")
            self.assertEqual(baseline, last)
            self.assertNotIn("migrations/1.sql",
                             self._git(d, "diff", "--name-only", f"{baseline}..{head}"))
            code, out = self._head_floor(d)
            self.assertEqual(out["tier"], "L0",
                             f"a docs-only change floored at {out['tier']}: the migration on "
                             f"{mig[:7]} was re-classified because its anchor was out of reach")
            self.assertEqual(code, 0, out)

    def test_an_unapproved_L3_anchor_out_of_reach_still_floors_at_L3(self):
        """Fail closed: walking further must not make a report count that would
        not count up close. The anchor here lacks the human approval."""
        with tempfile.TemporaryDirectory() as d:
            root = self._repo(d)
            mig = self._commit(d, "migrations/1.sql", "drop table x;\n", "migration")
            ev = dict(self.L3_EVIDENCE)
            ev["human_gate"] = {"required": True, "approved": False}
            self._report(d, mig, "L3", **ev)
            self._docs_reports(d, self.AFTER_ANCHOR)
            head = self._commit(d, "docs/guide.md", "docs only\n", "docs-only change")
            self.assertEqual(self.mod._validated_baseline(d, head), (root, False))
            code, out = self._head_floor(d)
            self.assertEqual(out["tier"], "L3")
            self.assertNotEqual(code, 0)

    def test_a_valid_report_below_L3_is_not_an_anchor(self):
        """Only an L3 report validates whatever came before it. An L1 report with
        passing tests, sitting after an unreviewed migration, under-declares its
        segment — stopping the walk at it would hide the migration."""
        with tempfile.TemporaryDirectory() as d:
            root = self._repo(d)
            self._commit(d, "migrations/1.sql", "drop table x;\n", "unreviewed migration")
