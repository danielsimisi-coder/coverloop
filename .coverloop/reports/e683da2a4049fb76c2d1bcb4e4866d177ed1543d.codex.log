     1	"""Daily reviewer-call cap — a spend guardrail (R6).
     2	
     3	The gate itself is free (local, no model calls); the cost lives in the reviewer
     4	CLIs (glm-*/m3-*) that hit OpenRouter. This counts reviews actually SENT today
     5	(egress-log `phase:"attempt"` entries — REFUSED/too-large/self-test never get
     6	one) across ALL reviewers (they share one egress log), and refuses past a
     7	configurable daily cap, FAIL-CLOSED. So a runaway review loop or many parallel
     8	projects can't silently burn your token budget — the exact pain the field keeps
     9	reporting (and a per-day run cap Iftah Saar described as what lets him sleep).
    10	
    11	Wire: call enforce_daily_cap() right before a review is transmitted (after the
    12	secret scan passes, before the send). Configure with COVERLOOP_DAILY_REVIEW_CAP
    13	(default 40); set it to 0 to disable, or raise it for a single run.
    14	"""
    15	import json
    16	import fcntl
    17	import os
    18	import sys
    19	from datetime import datetime, timezone
    20	from pathlib import Path
    21	
    22	DEFAULT_CAP = 40
    23	
    24	
    25	def _log_path():
    26	    # Same default the reviewer CLIs write to; env-overridable (power users/tests).
    27	    return Path(os.environ.get("COVERLOOP_EGRESS_LOG")
    28	                or (Path.home() / ".config" / "openrouter" / "egress.log"))
    29	
    30	
    31	def _cap():
    32	    try:
    33	        return int(os.environ.get("COVERLOOP_DAILY_REVIEW_CAP", DEFAULT_CAP))
    34	    except ValueError:
    35	        return DEFAULT_CAP
    36	
    37	
    38	def sent_today():
    39	    """Number of reviews actually transmitted today (UTC) — counted from the
    40	    egress log's `attempt` markers, which are written only for packets that pass
    41	    the size + secret checks and are about to hit the network."""
    42	    log = _log_path()
    43	    if not log.exists():
    44	        return 0
    45	    day = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    46	    n = 0
    47	    try:
    48	        with open(log, encoding="utf-8", errors="replace") as f:
    49	            for line in f:
    50	                line = line.strip()
    51	                if not line:
    52	                    continue
    53	                try:
    54	                    rec = json.loads(line)
    55	                except ValueError:
    56	                    continue  # tolerate a partial/corrupt line rather than crash
    57	                if rec.get("phase") == "attempt" and str(rec.get("ts", "")).startswith(day):
    58	                    n += 1
    59	    except OSError:
    60	        # NOT zero. An unreadable quota log used to read as "nothing sent today",
    61	        # which allowed every request precisely when the accounting was broken.
    62	        # A quota that silently stops counting is worse than no quota, because the
    63	        # operator still believes there is a ceiling. Raise and let the caller
    64	        # fail closed.
    65	        raise
    66	    return n
    67	
    68	
    69	def enforce_daily_cap():
    70	    """Fail closed (exit 4) if today's sent reviews have reached the cap. A no-op
    71	    when the cap is <= 0 (disabled) or when the count is safely under it."""
    72	    cap = _cap()
    73	    if cap <= 0:
    74	        return
    75	    try:
    76	        used = sent_today()
    77	    except OSError as exc:
    78	        print(f"egress cap: cannot read the quota log ({exc}); refusing to send. "
    79	              f"Fix the log at {_log_path()} or set COVERLOOP_DAILY_REVIEW_CAP=0 "
    80	              f"to disable the cap deliberately.", file=sys.stderr)
    81	        sys.exit(4)
    82	    if used >= cap:
    83	        sys.stderr.write(
    84	            "coverloop: daily review cap reached (%d/%d reviews sent today). Refusing to send "
    85	            "more — this protects your token budget across parallel projects. Raise it for this "
    86	            "run with COVERLOOP_DAILY_REVIEW_CAP=%d, or set it to 0 to disable.\n"
    87	            % (used, cap, cap * 2))
    88	        sys.exit(4)
    89	
    90	
    91	def reserve_daily_slot(record_attempt):
    92	    """Count today's sends and record this one as a SINGLE atomic step.
    93	
    94	    `enforce_daily_cap()` only counts. The caller then records its attempt a few
    95	    lines later, and in that gap two reviewers running against different projects
    96	    could both read cap-1, both pass, and both send — so the documented
    97	    parallel-project protection did not hold. Holding an exclusive lock across
    98	    check-and-record closes the window: at most `cap` processes can observe a
    99	    count below the cap.
   100	
   101	    Falls back to the old check-then-record if the filesystem cannot lock, and
   102	    SAYS SO rather than pretending. This is a spend guardrail, not a safety
   103	    boundary; refusing to run at all on an exotic filesystem would be friction
   104	    with no security to show for it.
   105	    """
   106	    cap = _cap()
   107	    if cap <= 0:
   108	        record_attempt()
   109	        return
   110	    log = _log_path()
   111	    try:
   112	        log.parent.mkdir(parents=True, exist_ok=True)
   113	        lock_path = str(log) + ".lock"
   114	        with open(lock_path, "a+") as lf:
   115	            fcntl.flock(lf.fileno(), fcntl.LOCK_EX)
   116	            try:
   117	                _check_and_record(cap, record_attempt)
   118	            finally:
   119	                fcntl.flock(lf.fileno(), fcntl.LOCK_UN)
   120	        return
   121	    except OSError as exc:
   122	        # Falling back to unlocked check-then-record recreates exactly the race
   123	        # this function exists to close, and does so silently at the moment the
   124	        # guarantee is most needed. Default to refusing; the operator can opt
   125	        # back into the weaker behaviour, but they have to say so.
   126	        if os.environ.get("COVERLOOP_ALLOW_UNLOCKED_CAP") != "1":
   127	            print(f"egress cap: cannot lock the quota log ({exc}); refusing to "
   128	                  f"send rather than allow parallel reviewers past the cap. Set "
   129	                  f"COVERLOOP_ALLOW_UNLOCKED_CAP=1 to accept that risk, or "
   130	                  f"COVERLOOP_DAILY_REVIEW_CAP=0 to disable the cap.",
   131	                  file=sys.stderr)
   132	            sys.exit(4)
   133	        print(f"egress cap: proceeding without a lock ({exc}); the daily cap is "
   134	              f"still enforced but is NOT safe against reviewers running in "
   135	              f"parallel (COVERLOOP_ALLOW_UNLOCKED_CAP=1).", file=sys.stderr)
   136	    _check_and_record(cap, record_attempt)
   137	
   138	
   139	def _check_and_record(cap, record_attempt):
   140	    try:
   141	        used = sent_today()
   142	    except OSError as exc:
   143	        print(f"egress cap: cannot read the quota log ({exc}); refusing to send.",
   144	              file=sys.stderr)
   145	        sys.exit(4)
   146	    if used >= cap:
   147	        print(f"egress cap: {used}/{cap} reviews already sent today; refusing. "
   148	              f"Raise COVERLOOP_DAILY_REVIEW_CAP or wait for the UTC day to roll.",
   149	              file=sys.stderr)
   150	        sys.exit(4)
   151	    record_attempt()
