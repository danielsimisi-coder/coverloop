    def test_no_env_escape_hatch(self):
        import os as _os
        _os.environ["GLM_FILTER_ALLOW"] = "1"  # must have zero effect
        try:
            self.assertTrue(F.scan("VERCEL_TOKEN=[REDACTED:secret-value]"))
        finally:
