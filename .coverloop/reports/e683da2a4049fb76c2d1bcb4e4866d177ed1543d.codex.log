   146	def _enforce_egress_redaction(payload):
   147	    """SINGLE egress choke point (operator invariant, 2026-07-15): NO content reaches the network
   148	    without passing redact() + a fail-closed scan(). Every do_request caller — review, ping,
   149	    self-test, any future path — is covered here, so there is structurally no raw-packet bypass.
   150	    redact() is idempotent, so already-redacted review content is unchanged."""
   151	    for msg in payload.get("messages", []):
   152	        c = msg.get("content")
   153	        if isinstance(c, str):
   154	            msg["content"] = redact(c)
   155	    joined = "\n".join(m.get("content", "") for m in payload.get("messages", []) if isinstance(m.get("content"), str))
   156	    hits = scan(joined)
   157	    if hits:
   158	        raise RuntimeError("egress blocked: redacted packet still scans as secret-bearing: " + ",".join(hits))
   159	    return payload
