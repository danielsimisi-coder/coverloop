  2275	def _reviewer_policy_path():
  2276	    """Where the operator's trusted reviewer policy lives. Deliberately OUTSIDE
  2277	    any repository: see reviewer_policy()."""
  2278	    return os.environ.get("COVERLOOP_REVIEWERS") or os.path.join(
  2279	        os.path.expanduser("~"), ".config", "coverloop", "reviewers.json")
  2280	
  2281	
  2282	def reviewer_policy(root):
  2283	    """Load WHO reviews and WHAT COMMAND runs them, from a trusted source.
  2284	
  2285	    The independence of the review is the whole product. If the commands lived
  2286	    in the repository, a diff could replace its own reviewer with a stub that
  2287	    prints the canonical pass marker, and `check` would dutifully run it — the
  2288	    change under review would be signing its own evidence. So the policy is
  2289	    read from the operator's own machine, never from the worktree, and it is
  2290	    refused if it is reachable from inside the repo (a symlink or a path under
  2291	    the root) or if anyone but the owner can write it.
  2292	
  2293	    Returns (policy, None) or (None, reason).
  2294	    """
  2295	    path = _reviewer_policy_path()
  2296	    real = os.path.realpath(path)
  2297	    root_real = os.path.realpath(root)
  2298	    if real == root_real or real.startswith(root_real + os.sep):
  2299	        return None, (f"reviewer policy {path} resolves inside the repository under review "
  2300	                      f"({real}) — the reviewer must not be nominated by the change")
  2301	    try:
  2302	        st = os.lstat(real)
  2303	    except OSError:
  2304	        return None, (f"no reviewer policy at {path}. Create it (outside any repo) as:\n"
  2305	                      '  {"reviewers": {"primary": "codex", "secondary": "glm"},\n'
  2306	                      '   "reviewer_commands": {"codex": "<cold review cmd>", '
  2307	                      '"glm": "<red-team cmd>"}}\n'
  2308	                      "  Each command must make its reviewer end with the line "
  2309	                      "'VERDICT: PASS' or 'VERDICT: FAIL'.")
  2310	    if not stat.S_ISREG(st.st_mode):
  2311	        return None, f"reviewer policy {path} is not a regular file"
  2312	    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
  2313	        return None, (f"reviewer policy {path} is group/world-writable "
  2314	                      f"({oct(st.st_mode & 0o777)}) — anyone could swap the reviewer; "
  2315	                      f"run: chmod 600 {path}")
  2316	    data, err = load_json(real)
  2317	    if err:
  2318	        return None, f"reviewer policy {path}: {err}"
  2319	    data = data or {}
  2320	    roles = data.get("reviewers") or {}
  2321	    primary = roles.get("primary", "codex")
  2322	    secondary = roles.get("secondary", "glm")
  2323	    if (primary not in ("codex", "glm") or secondary not in ("codex", "glm")
  2324	            or primary == secondary):
  2325	        return None, (f"reviewer policy {path}: reviewers must name two distinct roles from "
  2326	                      "{codex, glm} (report keys are fixed for compatibility)")
  2327	    cmds = data.get("reviewer_commands") or {}
  2328	    if not isinstance(cmds, dict) or any(not isinstance(v, str) for v in cmds.values()):
  2329	        return None, f"reviewer policy {path}: reviewer_commands must map a role to a command string"
  2330	    # Naming the reviewer outside the repo is not enough if the command it
  2331	    # names lives INSIDE it: the change could then edit its own reviewer to
  2332	    # print the pass marker. Refuse any token of the command that resolves to
  2333	    # a path under the repo root. Heuristic on purpose — it is a word-split,
  2334	    # not a shell parser — but it fails CLOSED and catches the whole class
  2335	    # ("./bin/review.sh", "scripts/review.sh", an absolute path into the tree).
  2336	    for role, cmd in cmds.items():
  2337	        for tok in cmd.replace("|", " ").replace(";", " ").split():
  2338	            tok = tok.strip("\"'")
  2339	            if not tok or tok.startswith("-") or tok in (".", ".."):
  2340	                continue
  2341	            cand = os.path.realpath(os.path.join(root_real, tok)) if not os.path.isabs(tok) \
  2342	                else os.path.realpath(tok)
  2343	            if not (cand.startswith(root_real + os.sep) and os.path.isfile(cand)):
  2344	                continue
  2345	            # ANY regular file in the tree, not just an executable one:
  2346	            # `sh scripts/reviewer` runs an extensionless, non-executable file
  2347	            # just as well, and the repository controls its contents either way.
  2348	            # Directories still pass, which is what keeps a pathspec
  2349	            # ("git diff -- .") from tripping this.
  2350	            return None, (f"reviewer policy {path}: the {role} command names {tok!r}, a file "
  2351	                          f"inside the repository under review — the change could rewrite its "
  2352	                          f"own reviewer. Point it at a command outside the repo.")
  2353	    return {"path": path, "primary": primary, "secondary": secondary, "commands": cmds}, None
  2354	
