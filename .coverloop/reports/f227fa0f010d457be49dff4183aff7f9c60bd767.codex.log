  2367	def _stop(reason):
  2368	    """The single STOP line. stdout is flushed first so the reason is the last
  2369	    thing on the terminal even though it goes to stderr."""
  2370	    _cleanup_scratch()
  2371	    sys.stdout.flush()
  2372	    print(f"STOP: {reason}", file=sys.stderr)
  2373	    sys.exit(1)
