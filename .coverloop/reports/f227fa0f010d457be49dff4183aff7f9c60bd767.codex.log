  2419	        print(f"STOP: {CONFIG_FILE} defines reviewers/reviewer_commands, but a change under "
  2420	              f"review may not nominate its own reviewer. Move them to {_reviewer_policy_path()} "
  2421	              f"(outside the repo) and delete them from {CONFIG_FILE}.", file=sys.stderr)
