   308	def _changed_paths_for_gate(root, args):
   309	    """Paths this gate run is judging: the PR range if --base was given (CI),
   310	    else the working tree plus untracked files (local)."""
   311	    base = getattr(args, "base", None)
   312	    if base:
   313	        base = _resolve_commit(base, root)
   314	        if base is None:
   315	            return []
   316	        out = _git_paths(["diff", "--name-only", f"{base}...HEAD"], root)
   317	        if out is None:
   318	            out = _git_paths(["diff", "--name-only", base, "HEAD"], root)
   319	        return out or []
   320	    tracked = _git_paths(["diff", "--name-only", "HEAD"], root) or []
   321	    untracked = _git_paths(["ls-files", "--others", "--exclude-standard"], root) or []
   322	    return list(tracked) + list(untracked)
