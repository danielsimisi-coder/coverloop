  2357	
  2358	
  2359	def _cleanup_scratch():
  2360	    """Remove the reviewer scratch dirs. They hold a full copy of the source
  2361	    diff, so leaving one behind on every run — including every failure path —
  2362	    scatters the reviewed code across /tmp."""
  2363	    while _SCRATCH_DIRS:
  2364	        shutil.rmtree(_SCRATCH_DIRS.pop(), ignore_errors=True)
