  1184	                    # fail closed; the `finally` below releases + closes the fd.
  1185	                    sys.stderr.write(
  1186	                        "coverloop: another `attest` has held the lock for >5min. Refusing to "
  1187	                        "proceed UNLOCKED (it could lose evidence) — NOTHING was written. Re-run "
  1188	                        "once the other attest finishes, or investigate a stuck process.\n")
