  2346	            # `sh scripts/reviewer` runs an extensionless, non-executable file
  2347	            # just as well, and the repository controls its contents either way.
  2348	            # Directories still pass, which is what keeps a pathspec
  2349	            # ("git diff -- .") from tripping this.
  2350	            return None, (f"reviewer policy {path}: the {role} command names {tok!r}, a file "
  2351	                          f"inside the repository under review — the change could rewrite its "
  2352	                          f"own reviewer. Point it at a command outside the repo.")
