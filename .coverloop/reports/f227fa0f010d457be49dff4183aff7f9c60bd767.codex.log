  2214	
  2215	# The words real reviewers actually end on. Sampled from the fleet's captured
  2216	# transcripts: Codex ends "VERDICT: PASS", GLM's red-team scale is
  2217	# "Verdict: PASS / PASS WITH RISKS / REQUEST CHANGES / BLOCK", and some runs
  2218	# emit lowercase "verdict: fail" or a GitHub-style "APPROVE". A parser that
  2219	# only knew uppercase "VERDICT: PASS" scored every one of those a fail —
  2220	# fail-closed, but useless: it would have made `check` unusable with the very
  2221	# reviewers this repo ships. Unknown wording still fails.
  2222	# The reviewer's verdict is a MACHINE PROTOCOL, not prose to be interpreted.
  2223	# Exactly one canonical marker line counts:
  2224	#
  2225	#     VERDICT: PASS        (or)        VERDICT: FAIL
  2226	#
  2227	# The reviewer PROMPT tells the reviewer to end with it; the gate does not try
  2228	# to infer approval from natural language. "PASS WITH RISKS", "APPROVE",
  2229	# "LGTM", "SHIP" and every other human phrasing are NOT a pass — inferring one
  2230	# would let a hedged review land as `pass` with zero open findings. Missing,
  2231	# malformed, truncated, ambiguous or non-canonical: FAIL CLOSED.
  2232	# Case-INSENSITIVE on purpose: a lowercase "verdict: fail" is still a verdict,
  2233	# and it must be seen so it can be rejected as non-canonical rather than skipped.
  2234	_VERDICT_MARKER = re.compile(r"^[ \t]*VERDICT:.*$", re.M | re.I)
  2235	# The only thing allowed to follow the closing marker: a CLI's own footer.
  2236	# Codex prints "tokens used" and a number. Anything sentence-like after the
  2237	# verdict means the reviewer kept talking, and the marker was not its last word.
  2238	_VERDICT_FOOTER = re.compile(
  2239	    r"^(tokens?[ _]used\s*:?\s*[\d,.]*\s*[kmb]?|[\d,.]+|[-=_*]{3,})$", re.I)
  2240	_VERDICT_CANONICAL_PASS = "VERDICT: PASS"
  2241	_VERDICT_CANONICAL_FAIL = "VERDICT: FAIL"
  2242	
  2243	
  2244	def transcript_verdict(text, tail_lines=10):
  2245	    """Return "pass" only for an unambiguous canonical PASS marker at the end.
  2246	
  2247	    Three conditions, all fail-closed:
  2248	      * at least one `VERDICT:` line exists;
  2249	      * EVERY such line is byte-for-byte "VERDICT: PASS" after trimming — no
  2250	        "PASS WITH RISKS", no lowercase, no "APPROVE";
  2251	      * the last one is among the final `tail_lines` non-empty lines, so it is
  2252	        the reviewer's closing word rather than something near the top.
  2253	
  2254	    The whole transcript is read, not a tail window: a review that says FAIL and
  2255	    then emits 5 KB of appendix would otherwise have its failure scroll out of
  2256	    view. The closing-position rule is the other half of the same idea — a
  2257	    prompt echo containing the marker, followed by a review that never reaches a
  2258	    verdict, must not count as approval. The small allowance exists because real
  2259	    reviewers append a footer (Codex prints "tokens used" and a count after its
  2260	    reply); it is not room for review content.
  2261	    """
  2262	    lines = (text or "").splitlines()
  2263	    live = [(i, ln.strip()) for i, ln in enumerate(lines) if ln.strip()]
  2264	    markers = [(n, body) for n, (i, body) in enumerate(live) if _VERDICT_MARKER.match(lines[i])]
  2265	    if not markers:
  2266	        return "fail"
  2267	    if any(body != _VERDICT_CANONICAL_PASS for _n, body in markers):
  2268	        return "fail"
  2269	    trailing = [body for _i, body in live[markers[-1][0] + 1:]]
  2270	    if len(trailing) > tail_lines or any(not _VERDICT_FOOTER.match(t) for t in trailing):
  2271	        return "fail"          # the reviewer kept talking; the marker was not its last word
  2272	    return "pass"
  2273	
