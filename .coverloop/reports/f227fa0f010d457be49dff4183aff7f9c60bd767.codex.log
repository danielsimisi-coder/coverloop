  2376	def _last_recorded_test_command(root, sha):
  2377	    """The test command the newest ancestor report actually ran, or None.
  2378	
  2379	    Deliberately independent of whether that report VALIDATES: a rewritten
  2380	    test_command invalidates it by construction, and that is precisely the case
  2381	    this exists to catch.
  2382	    """
  2383	    out = git(["rev-list", "--max-count=200", sha], cwd=root)
  2384	    if not out:
  2385	        return None
  2386	    for c in out.split()[1:]:
  2387	        if not os.path.exists(report_path(root, c)):
  2388	            continue
  2389	        rep, _why = load_report(root, c)
  2390	        cmd = ((rep or {}).get("tests") or {}).get("command")
  2391	        if cmd:
  2392	            return str(cmd)
  2393	    return None
