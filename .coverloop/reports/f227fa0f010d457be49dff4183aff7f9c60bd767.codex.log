  2244	def transcript_verdict(text, tail_lines=10):
  2245	    """Return "pass" only for an unambiguous canonical PASS marker at the end.
  2246	
  2247	    Three conditions, all fail-closed:
  2248	      * at least one `VERDICT:` line exists;
  2249	      * EVERY such line is byte-for-byte "VERDICT: PASS" after trimming — no
  2250	        "PASS WITH RISKS", no lowercase, no "APPROVE";
  2251	      * the last one is among the final `tail_lines` non-empty lines, so it is
  2252	        the reviewer's closing word rather than something near the top.
  2253	
  2254	    The whole transcript is read, not a tail window: a review that says FAIL and
  2255	    then emits 5 KB of appendix would otherwise have its failure scroll out of
  2256	    view. The closing-position rule is the other half of the same idea — a
  2257	    prompt echo containing the marker, followed by a review that never reaches a
  2258	    verdict, must not count as approval. The small allowance exists because real
  2259	    reviewers append a footer (Codex prints "tokens used" and a count after its
  2260	    reply); it is not room for review content.
  2261	    """
  2262	    lines = (text or "").splitlines()
  2263	    live = [(i, ln.strip()) for i, ln in enumerate(lines) if ln.strip()]
  2264	    markers = [(n, body) for n, (i, body) in enumerate(live) if _VERDICT_MARKER.match(lines[i])]
  2265	    if not markers:
  2266	        return "fail"
  2267	    if any(body != _VERDICT_CANONICAL_PASS for _n, body in markers):
  2268	        return "fail"
  2269	    trailing = [body for _i, body in live[markers[-1][0] + 1:]]
  2270	    if len(trailing) > tail_lines or any(not _VERDICT_FOOTER.match(t) for t in trailing):
  2271	        return "fail"          # the reviewer kept talking; the marker was not its last word
  2272	    return "pass"
