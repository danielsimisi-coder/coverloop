   663	class DailyReviewCap(unittest.TestCase):
   664	    """R6: the daily reviewer-call cap counts today's SENT reviews (egress
   665	    'attempt' markers) and refuses past the configured cap, fail-closed — a
   666	    token-spend guardrail for runaway loops / many parallel projects."""
   667	
   668	    def setUp(self):
   669	        import egress_cap
   670	        self.cap = egress_cap
   671	        self.tmp = tempfile.mkdtemp()
   672	        self.log = os.path.join(self.tmp, "egress.log")
   673	        os.environ["COVERLOOP_EGRESS_LOG"] = self.log
   674	
   675	    def tearDown(self):
   676	        # Restore the SUITE's temporary log — popping it would let every later
   677	        # test fall back to the operator's production log.
   678	        os.environ["COVERLOOP_EGRESS_LOG"] = suite_egress_log()
   679	        os.environ.pop("COVERLOOP_DAILY_REVIEW_CAP", None)
   680	
   681	    def _write(self, n_today=0, n_old=0, n_result=0, corrupt=False):
   682	        from datetime import datetime, timezone
   683	        today = datetime.now(timezone.utc).isoformat()
   684	        with open(self.log, "w", encoding="utf-8") as f:
   685	            if corrupt:
   686	                f.write("not-json-a-partial-line\n")
   687	            for _ in range(n_today):
   688	                f.write(json.dumps({"ts": today, "phase": "attempt"}) + "\n")
   689	            for _ in range(n_result):  # result-phase is NOT a new billable call
   690	                f.write(json.dumps({"ts": today, "phase": "result"}) + "\n")
   691	            for _ in range(n_old):      # a different day
   692	                f.write(json.dumps({"ts": "2020-01-01T00:00:00+00:00", "phase": "attempt"}) + "\n")
   693	
   694	    def test_counts_only_todays_attempts(self):
   695	        self._write(n_today=5, n_old=9, n_result=4)
   696	        self.assertEqual(self.cap.sent_today(), 5)
   697	
   698	    def test_missing_log_is_zero(self):
   699	        self.assertEqual(self.cap.sent_today(), 0)
   700	
   701	    def test_corrupt_line_tolerated(self):
   702	        self._write(n_today=1, corrupt=True)
   703	        self.assertEqual(self.cap.sent_today(), 1)
   704	
   705	    def test_under_cap_passes(self):
   706	        self._write(n_today=3)
   707	        os.environ["COVERLOOP_DAILY_REVIEW_CAP"] = "10"
   708	        self.cap.enforce_daily_cap()  # must NOT exit
   709	
   710	    def test_at_cap_fails_closed(self):
   711	        self._write(n_today=3)
   712	        os.environ["COVERLOOP_DAILY_REVIEW_CAP"] = "3"
   713	        with self.assertRaises(SystemExit) as cm:
   714	            self.cap.enforce_daily_cap()
   715	        self.assertEqual(cm.exception.code, 4)
   716	
   717	    def test_zero_disables_even_far_over(self):
   718	        self._write(n_today=500)
   719	        os.environ["COVERLOOP_DAILY_REVIEW_CAP"] = "0"
   720	        self.cap.enforce_daily_cap()  # disabled -> no exit

