#!/usr/bin/env python3
"""coverloop — evidence gate for AI-written changes.

Subcommands:
  init    scaffold .coverloop/ (config + reports dir) in the current repo
  attest  record evidence (test run, reviewer verdicts, human approval)
          into a report bound to the current HEAD commit
  gate    verify the required evidence exists for the given risk tier;
          exit 0 only if every required gate has a passing, HEAD-bound record

Design rules (do not weaken):
  * FAIL CLOSED: missing config (non-L0), missing report (non-L0), stale
    evidence, unreadable JSON, unknown tier -> non-zero exit. A malformed,
    forged, or SHA-mismatched report fails EVERY tier, including L0.
  * The GATE never sends code anywhere and never calls a model — it only
    inspects local files and git metadata. `attest` runs the project's own
    test command and, when given `--codex-run` / `--glm-run`, executes those
    reviewer commands and captures their hashed transcripts; `--codex-log` /
    `--glm-log` instead ATTACH an existing transcript (redacted + hashed, no
    re-run — source "attached", one honesty notch below "captured"); otherwise
    a reviewer verdict is self-attested (a recorded claim). The verdict itself
    is always caller-stated (reviewer output is prose, not a status).
    `gate --require-transcript` makes L2/L3 reject self-attested reviewer
    verdicts and demand a committed transcript (captured or attached);
    `--require-executed` is stricter (executed capture only).
  * Evidence binds to a commit SHA. The gate accepts a report bound to an
    ancestor commit ONLY when the diff from that ancestor to HEAD touches
    nothing but files under .coverloop/reports/ — this makes the
    "attest, then commit the report" flow possible while guaranteeing any
    CODE change after attestation still invalidates the evidence.

Honest threat model: this verifies that evidence EXISTS and is bound to
the commit under review; it cannot stop someone from hand-writing a lying
report. It turns silent drift into an explicit, committed, auditable lie —
and in CI the report travels with the PR, where a reviewer can see it.

Exit codes: 0 = all required gates pass; 1 = gate failure (missing/failed
evidence); 2 = usage or environment error.
"""
import argparse
import contextlib
import datetime
import hashlib
import itertools
import json
import os
import re
import subprocess
import sys

# The canonical secret filter ships next to this script (install.sh copies all
# of bin/). Import it for transcript/command redaction; fall back to a minimal
# built-in redactor so a missing filter can never cause a total secret leak.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    import glm_secret_filter as _secret
except Exception:  # pragma: no cover - defensive
    _secret = None

_FALLBACK_SECRET_RE = re.compile(
    r"(?<![A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}"
    r"|(?<![A-Za-z0-9])(?:ghp|gho|ghs|github_pat)_[A-Za-z0-9_]{20,}"
    r"|(?<![A-Za-z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}"
    r"|\bbearer\s+[A-Za-z0-9._~+/=-]{16,}"
    r"|-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----",
    re.IGNORECASE | re.DOTALL)


def redact_secrets(text):
    """Strip secret VALUES from text before it is written to a committed file."""
    if _secret is not None:
        return _secret.redact(text)
    return _FALLBACK_SECRET_RE.sub("[REDACTED]", text or "")


SCHEMA = "coverloop-report/v1"
CONFIG_DIR = ".coverloop"
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
REPORTS_DIR = os.path.join(CONFIG_DIR, "reports")
TIERS = ("L0", "L1", "L2", "L3")

# A committed EVIDENCE ARTIFACT under .coverloop/reports/ — EXACT name shapes
# only: <40-hex commit sha>.json, or <sha>.<reviewer>.log. Anything else under
# reports/ (e.g. .coverloop/reports/backdoor.py) is a NORMAL code file: not
# "evidence-only", not test-waivable. This is what stops code being smuggled in
# under the reports/ prefix.
REPORT_ARTIFACT_RE = re.compile(
    r"^" + re.escape(REPORTS_DIR + "/")
    + r"[0-9a-f]{40}(?:\.json|\.(?:codex|glm)\.log)$")

# Documentation for the L1 test-gate waiver. Deliberately strict so a code file
# cannot masquerade as docs: an EXACT root-level doc file, or a doc-suffixed
# file UNDER docs/. Never a basename match elsewhere; never a bare .txt/.rst
# outside docs/ (a runtime-loaded config.txt or docs/deploy.sh is NOT a doc).
DOC_SUFFIXES = (".md", ".txt", ".rst")
DOC_ROOT = "docs/"
ROOT_DOC_FILES = ("LICENSE", "CHANGELOG", "CHANGELOG.md", "README.md")


def tier_max(*tiers):
    """Highest tier among the args (None/unknown-safe). TIERS is low->high.
    Used so a pinned --min-tier can only ever RAISE the requirement."""
    best = None
    for t in tiers:
        if t in TIERS and (best is None or TIERS.index(t) > TIERS.index(best)):
            best = t
    return best


def is_report_artifact(f):
    """True iff f is exactly a committed report JSON or reviewer transcript."""
    return bool(REPORT_ARTIFACT_RE.match(f))


def is_doc_file(f):
    """True iff f is documentation for the L1 waiver (never executable code)."""
    if f in ROOT_DOC_FILES:
        return True
    if f.startswith(DOC_ROOT) and f.endswith(DOC_SUFFIXES):
        return True
    return False


def fail_usage(msg):
    print(f"coverloop: error: {msg}", file=sys.stderr)
    sys.exit(2)


def git(args, cwd=None):
    """Run a git command; return stdout or None on failure."""
    try:
        out = subprocess.run(
            ["git"] + args, cwd=cwd, capture_output=True, text=True, timeout=30
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    return out.stdout.strip()


def repo_root():
    root = git(["rev-parse", "--show-toplevel"])
    if not root:
        fail_usage("not inside a git repository")
    return root


def head_sha(root):
    sha = git(["rev-parse", "HEAD"], cwd=root)
    if not sha:
        fail_usage("cannot resolve HEAD (empty repository?)")
    return sha


def now_utc():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_json(path):
    """Return (data, error). Fail closed on unreadable/invalid JSON."""
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f), None
    except FileNotFoundError:
        return None, f"{path}: not found"
    except (json.JSONDecodeError, OSError) as e:
        return None, f"{path}: unreadable ({e})"


# ---------------------------------------------------------------- init

def cmd_init(args):
    root = repo_root()
    cfg_path = os.path.join(root, CONFIG_FILE)
    os.makedirs(os.path.join(root, REPORTS_DIR), exist_ok=True)
    if os.path.exists(cfg_path):
        print(f"skip {CONFIG_FILE} (exists)")
    else:
        # No base is stored here on purpose: the diff base for the L1 waiver
        # must come from the trusted caller (CI's --base), never from a file
        # that ships inside the PR under review.
        cfg = {
            "schema": "coverloop-config/v1",
            "test_command": args.test_command or "npx tsc --noEmit",
        }
        with open(cfg_path, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2)
            f.write("\n")
        print(f"+ {CONFIG_FILE}  (test_command: {cfg['test_command']!r} — edit for your stack)")
    gi_path = os.path.join(root, CONFIG_DIR, ".gitignore")
    gi_body = (
        "# Coverloop reports are evidence — commit them with the change.\n"
        "# The negations defeat repo-root ignore rules (e.g. `*.log`) that would\n"
        "# silently swallow the PR-visible transcripts (field report 2026-07-10).\n"
        "!reports/\n"
        "!reports/*.json\n"
        "!reports/*.codex.log\n"
        "!reports/*.glm.log\n"
    )
    if not os.path.exists(gi_path) or "!reports/" not in open(gi_path, encoding="utf-8").read():
        with open(gi_path, "w", encoding="utf-8") as f:
            f.write(gi_body)
        print(f"+ {CONFIG_DIR}/.gitignore  (negations keep evidence commit-able)")
    print(f"+ {REPORTS_DIR}/")
    print("Done. Record evidence with `coverloop attest`, verify with `coverloop gate`.")
    return 0


# ---------------------------------------------------------------- reports

def report_path(root, sha):
    return os.path.join(root, REPORTS_DIR, f"{sha}.json")


def load_report(root, sha):
    """Load the report for this exact SHA. (None, reason) if unusable."""
    path = report_path(root, sha)
    # Reject a report reached through a symlink (or a symlinked reports/ dir):
    # the evidence must live in the repo's committed tree, not off-tree. Mirrors
    # the transcript guard in verify_capture.
    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
    if (os.path.islink(path)
            or os.path.realpath(reports_real) != reports_real
            or (os.path.exists(path) and os.path.dirname(os.path.realpath(path)) != reports_real)):
        return None, f"{path}: report resolves outside the reports dir (symlink) — rejected"
    data, err = load_json(path)
    if err:
        return None, err
    if data.get("schema") != SCHEMA:
        return None, f"{path}: unknown schema {data.get('schema')!r} (want {SCHEMA})"
    if data.get("commit") != sha:
        return None, f"{path}: bound to commit {data.get('commit')!r}, HEAD is {sha}"
    # An invalid risk_tier must fail closed — otherwise a garbage tier is ignored
    # by tier_max() and a pinned --min-tier L0 would gate it as L0 (no evidence).
    if data.get("risk_tier") not in TIERS:
        return None, f"{path}: invalid risk_tier {data.get('risk_tier')!r}"
    # Shape guard (full audit 2026-07-11): a schema-valid report whose
    # tests/codex/glm/human_gate field is not an object would raise an uncaught
    # AttributeError deep in evaluate() (e.g. (tests or {}).get(...)) instead of
    # the documented clean "malformed evidence" FAIL. Reject it here so it takes
    # the fail-closed path.
    for field in ("tests", "codex", "glm", "human_gate"):
        v = data.get(field)
        if v is not None and not isinstance(v, dict):
            return None, f"{path}: field {field!r} must be an object, got {type(v).__name__}"
    # Strict nested-field validation (Sol grade R2): reject a schema-valid report
    # whose sub-fields carry wrong-typed values, so a malformed report takes the
    # clean FAIL path instead of relying on a downstream comparison happening to
    # be falsy. (Note: bool is an int subclass in Python — reject it explicitly so
    # `findings_open: true` can't masquerade as a count.)
    for rk in ("tests", "codex", "glm"):
        e = data.get(rk)
        if e is not None and e.get("status") is not None and e.get("status") not in ("pass", "fail"):
            return None, f"{path}: {rk}.status must be 'pass' or 'fail', got {e.get('status')!r}"
    for rk in ("codex", "glm"):
        e = data.get(rk)
        if e is not None and "findings_open" in e:
            fo = e["findings_open"]
            if isinstance(fo, bool) or not isinstance(fo, int) or fo < 0:
                return None, f"{path}: {rk}.findings_open must be a non-negative integer"
    hg = data.get("human_gate")
    if hg is not None:
        if "approved" in hg and not isinstance(hg["approved"], bool):
            return None, f"{path}: human_gate.approved must be a boolean"
        if hg.get("approver") is not None and not isinstance(hg.get("approver"), str):
            return None, f"{path}: human_gate.approver must be a string"
    return data, None


# How many first-parent ancestors to search for an evidence-only report.
EVIDENCE_WALK_LIMIT = 20


def only_evidence_changed(root, frm, to):
    """True iff the diff frm..to touches ONLY committed report ARTIFACTS
    (<sha>.json / <sha>.<reviewer>.log). A non-artifact file under reports/
    (e.g. reports/backdoor.py) counts as a real code change and returns False."""
    out = git(["diff", "--no-renames", "--name-only", f"{frm}..{to}"], cwd=root)
    if out is None:
        return False  # unresolvable range -> fail closed
    files = [line for line in out.splitlines() if line.strip()]
    return bool(files) and all(is_report_artifact(f) for f in files)


def find_report(root, head):
    """Locate the report that governs HEAD.

    Returns (report, reason, malformed):
      * exact HEAD report when present;
      * else a report bound to a first-parent ancestor, accepted ONLY if the
        diff ancestor..HEAD touches nothing but evidence files (this is what
        makes "attest, commit the report, gate in CI" possible);
      * (None, why, True) when a report file exists but is corrupt, forged,
        or SHA-mismatched — malformed evidence fails EVERY tier;
      * (None, why, False) when no usable report exists.
    """
    path = report_path(root, head)
    if os.path.exists(path):
        report, why = load_report(root, head)
        if report is None:
            return None, why, True
        return report, None, False
    for i in range(1, EVIDENCE_WALK_LIMIT + 1):
        anc = git(["rev-parse", f"{head}~{i}"], cwd=root)
        if not anc:
            break
        if not os.path.exists(report_path(root, anc)):
            continue
        report, why = load_report(root, anc)
        if report is None:
            return None, why, True
        if only_evidence_changed(root, anc, head):
            return report, None, False
        return None, (f"evidence at {anc[:12]} is STALE: non-evidence files "
                      f"changed between it and HEAD — re-run the loop"), False
    return None, "no report found for HEAD or any evidence-only ancestor", False


def new_report(sha, tier):
    return {
        "schema": SCHEMA,
        "commit": sha,
        "risk_tier": tier,
        "created_at": now_utc(),
        "tests": None,
        "codex": None,
        "glm": None,
        "human_gate": None,
    }


_TMP_SEQ = itertools.count()


def _fsync_fd(fd):
    """Best-effort fsync of an already-open fd (used to durably persist a
    directory's rename entry). Never fatal — durability is a bonus, not a
    correctness precondition, and some platforms/filesystems reject dir fsync."""
    try:
        os.fsync(fd)
    except OSError:
        pass


def _fsync_dir(path):
    """Best-effort fsync of a directory by path (fallback publication path)."""
    try:
        d = os.open(path or ".", os.O_RDONLY)
    except OSError:
        return
    try:
        _fsync_fd(d)
    finally:
        os.close(d)


@contextlib.contextmanager
def open_write(root, path):
    """ATOMICALLY write PATH (which MUST live directly inside
    <root>/.coverloop/reports/): the caller writes to a private temp file in the
    same dir; on clean exit the temp is fsync'd and os.replace'd over PATH, so a
    reader (gate) sees either the OLD file or the fully-written NEW one, never a
    torn/partial report (Sol R3: a plain open()+dump is not atomic, so a
    concurrent reader or a killed writer could observe a truncated file). On
    POSIX the containing directory is also fsync'd so the rename survives a crash;
    on platforms without dir-fd support this degrades to a path-based replace
    (atomic on the OS, best-effort directory durability). Still refuses any
    symlink in the reports path and disables newline translation.

    Audit fixes (2026-07-11): (1) evidence WRITES used a plain open() that would
    follow a pre-planted destination symlink and overwrite an arbitrary off-tree
    file; the read paths guarded symlinks but the writers did not. (2) text-mode
    writes translated '\\n'->'\\r\\n' on Windows while output_sha256 is hashed over
    the untranslated string, so verify_capture rejected its own untampered
    evidence there; newline='' keeps on-disk bytes == hashed bytes everywhere.

    Symlink defense mirrors the read-side guard and covers the whole PARENT
    CHAIN, not just the final component (Sol v2.7.3 grade): the file's resolved
    parent must BE the real reports dir (so a symlinked `.coverloop/` or
    `reports/` ancestor can't relocate the write off-tree), and the final
    component must not be a symlink (portable, holds where O_NOFOLLOW is absent).

    Where the platform supports it (POSIX), the actual write additionally goes
    through a PINNED directory fd (open the reports dir O_DIRECTORY|O_NOFOLLOW,
    fstat-verify it IS the real reports dir, then openat the basename relative to
    that fd): once the dir fd is pinned, swapping `reports/` for a symlink AFTER
    the path check can no longer redirect the write — closing the parent-swap
    TOCTOU race (Sol Round-1 review). Windows (no dir_fd/O_DIRECTORY) keeps the
    path-based check + O_NOFOLLOW best-effort."""
    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
    if (os.path.realpath(reports_real) != reports_real          # .coverloop or reports/ is a symlink
            or os.path.islink(path)                             # final component pre-planted as a symlink
            or os.path.dirname(os.path.realpath(path)) != reports_real):  # resolves outside the real reports dir
        fail_usage(f"refusing to write evidence outside the real reports dir (symlinked path): {path}")
    o_nofollow = getattr(os, "O_NOFOLLOW", 0)
    o_dir = getattr(os, "O_DIRECTORY", 0)
    # O_EXCL: the temp name is private (pid + process-monotonic counter), so a
    # collision is anomalous — never clobber. We create it, so it is never a
    # symlink and the write can't be redirected through it.
    wflags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | o_nofollow
    base = os.path.basename(path)
    tmp_base = f".{base}.tmp.{os.getpid()}.{next(_TMP_SEQ)}"
    tmp_full = os.path.join(os.path.dirname(path), tmp_base)
    use_dirfd = bool(o_dir and o_nofollow
                     and os.open in getattr(os, "supports_dir_fd", set())
                     and os.replace in getattr(os, "supports_dir_fd", set()))
    dfd = None
    try:
        if use_dirfd:
            # POSIX: pin the reports dir by fd (no-follow), verify identity, then
            # create + replace WITHIN that pinned fd (immune to a post-check swap).
            dfd = os.open(os.path.join(root, REPORTS_DIR), os.O_RDONLY | o_dir | o_nofollow)
            if not os.path.samestat(os.fstat(dfd), os.stat(reports_real)):
                fail_usage(f"refusing to write evidence: reports dir identity changed: {path}")
            fd = os.open(tmp_base, wflags, 0o644, dir_fd=dfd)
        else:
            fd = os.open(tmp_full, wflags, 0o644)
        f = None
        try:
            f = os.fdopen(fd, "w", encoding="utf-8", newline="")
            yield f                       # caller writes the evidence to the temp
            f.flush()
            os.fsync(f.fileno())          # file data durable before the rename
            f.close(); f = None
            if use_dirfd:                 # atomic publish: reader sees old or new, never partial
                os.replace(tmp_base, base, src_dir_fd=dfd, dst_dir_fd=dfd)
                _fsync_fd(dfd)            # make the rename itself crash-durable (POSIX dir fsync)
            else:
                os.replace(tmp_full, path)
                _fsync_dir(os.path.dirname(path))
        except BaseException:
            # Close the handle BEFORE unlinking — Windows can't unlink an open
            # file (Sol R3 grade), so a leaked-open temp would otherwise survive.
            # The prior report (if any) is untouched: we only ever wrote the temp.
            if f is not None:
                try:
                    f.close()
                except OSError:
                    pass
            try:
                os.unlink(tmp_base, dir_fd=dfd) if use_dirfd else os.unlink(tmp_full)
            except OSError:
                pass
            raise
    finally:
        if dfd is not None:
            os.close(dfd)


def save_report(root, report):
    path = report_path(root, report["commit"])
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open_write(root, path) as f:
        json.dump(report, f, indent=2)
        f.write("\n")
    return path


# ---------------------------------------------------------------- capture

# The exact marker written when a failed run's output is withheld. Checked in
# attach_log AND verify_capture so the placeholder can never be re-attested as
# a review transcript (laundering), wherever a copy of it lives.
WITHHELD_MARKER = "transcript withheld — a failed run is not valid evidence]"
# The FULL placeholder line capture_run writes on a failed run (see below). Match
# the whole line — NOT the substring — so verify_capture rejects a laundered
# failed capture without false-rejecting a genuine review that merely QUOTES the
# marker (e.g. a review of coverloop's own source). (Sol v2.7.3 verify #1)
WITHHELD_RE = re.compile(r"^\[[a-z]+ reviewer command exited -?\d+; "
                         + re.escape(WITHHELD_MARKER) + r"\s*$")


def capture_run(root, sha, name, cmd):
    """Run a reviewer command, save its combined output to
    .coverloop/reports/<sha>.<name>.log, and return provenance (command, exit
    code, output path, sha256, line count, timestamp).

    This turns a bare `--codex pass` claim into evidence backed by the actual
    reviewer transcript, committed alongside the report and hashed so tampering
    with the log invalidates the recorded digest. It does NOT auto-derive the
    verdict — reviewer output is prose, and inferring pass/fail from it
    reliably is not possible — so the caller still states pass/fail, but now
    against a captured, inspectable artifact rather than thin air.
    """
    log_rel = os.path.join(REPORTS_DIR, f"{sha}.{name}.log")
    log_path = os.path.join(root, log_rel)
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    print(f"capturing {name} reviewer: {cmd}")
    try:
        # shell=True: same trust model as the test command — an operator-typed
        # reviewer invocation (e.g. 'codex exec ...'), printed before it runs.
        # text=False: capture raw bytes so non-UTF-8 reviewer output (colored
        # diffs, binary error dumps) can't crash us; decode defensively below.
        proc = subprocess.run(cmd, shell=True, cwd=root,
                              capture_output=True, timeout=1800)
    except (OSError, subprocess.TimeoutExpired) as e:
        fail_usage(f"could not run {name} reviewer command: {e}")
    output = ((proc.stdout or b"") + (proc.stderr or b"")).decode("utf-8", errors="replace")
    if proc.returncode != 0:
        # A failed run's output is untrusted error text (env dumps, stack state
        # that routinely carries tokens). It is also NOT valid evidence (the gate
        # rejects exit!=0), so we WITHHOLD the dump rather than commit a secret-
        # bearing error log to git.
        output = f"[{name} reviewer command exited {proc.returncode}; {WITHHELD_MARKER}\n"
    # Redact secret VALUES before this text is written to a committed file — a
    # privacy tool must never leak keys/tokens/DB creds into git history.
    output = redact_secrets(output)
    with open_write(root, log_path) as f:
        f.write(output)
    return {
        "source": "captured",
        "command": redact_secrets(cmd),  # the invocation string is committed too
        "exit_code": proc.returncode,
        "output_file": log_rel,
        "output_sha256": hashlib.sha256(output.encode("utf-8")).hexdigest(),
        "output_lines": output.count("\n"),
        "ran_at": now_utc(),
    }


ATTACH_MAX_BYTES = 5 * 1024 * 1024  # a review transcript, not a build artifact


def attach_log(root, sha, name, src_path):
    """Attach an EXISTING reviewer transcript as evidence: redact secret
    values, copy it to .coverloop/reports/<sha>.<name>.log, and return
    provenance with the redacted copy's sha256.

    Field reality (the reason this exists): reviews usually run interactively
    first (codex exec / glm-review in the terminal), so `--codex-run` would
    mean paying for the SAME review twice — and in practice evidence stays
    self-attested. An attached transcript is one honesty notch below captured
    (the tool didn't execute the command, so there's no exit-code/execution
    binding) but far above a bare claim: the transcript is committed, readable
    in the PR, and hash-bound to this commit like any captured log.
    """
    if os.path.islink(src_path):
        fail_usage(f"--{name}-log: {src_path} is a symlink — pass the real transcript file")
    if not os.path.isfile(src_path):
        fail_usage(f"--{name}-log: no such file: {src_path}")
    # Refuse sources inside the reports dir: attaching the gate's own artifacts
    # would launder a withheld failed-run log, or replay an OLD commit's log,
    # into fresh "attached" evidence with one command. (Replaying a copy made
    # elsewhere is the documented attester's-word ceiling — but the tool must
    # not accept its own rejection/stale artifacts as new evidence.)
    src_real = os.path.realpath(src_path)
    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
    inside_reports = src_real == reports_real or src_real.startswith(reports_real + os.sep)
    # String compare alone is bypassable on case-insensitive filesystems
    # (".COVERLOOP/REPORTS/x.log" resolves but keeps its casing) — also walk
    # the source's ancestor DIRECTORY IDENTITIES (inode compare) against the
    # reports dir.
    if not inside_reports:
        try:
            rep_stat = os.stat(reports_real)
        except OSError:
            rep_stat = None
        if rep_stat is not None:
            d = os.path.dirname(src_real)
            while True:
                try:
                    if os.path.samestat(os.stat(d), rep_stat):
                        inside_reports = True
                        break
                except OSError:
                    pass
                parent = os.path.dirname(d)
                if parent == d:
                    break
                d = parent
    if inside_reports:
        fail_usage(f"--{name}-log: {src_path} is inside {REPORTS_DIR}/ — attaching the gate's "
                   f"own artifacts would launder or replay existing evidence; pass the "
                   f"original transcript from outside the reports dir")
    size = os.path.getsize(src_path)
    if size > ATTACH_MAX_BYTES:
        fail_usage(f"--{name}-log: {src_path} is {size} bytes (cap {ATTACH_MAX_BYTES}) — "
                   f"attach the reviewer transcript, not a build artifact")
    with open(src_path, "rb") as f:
        text = f.read().decode("utf-8", errors="replace")
    if not text.strip():
        fail_usage(f"--{name}-log: {src_path} is empty — an empty transcript is not evidence")
    if WITHHELD_RE.match(text.strip()):
        fail_usage(f"--{name}-log: {src_path} is a withheld failed-run placeholder, "
                   f"not a review transcript — fix the reviewer command and re-run")
    # Same privacy rule as capture_run: secret VALUES never reach a committed file.
    text = redact_secrets(text)
    # Re-check size AFTER decode+redaction: errors="replace" can expand raw
    # bytes up to 3x (U+FFFD), so a source at the cap could otherwise commit a
    # 15MB artifact.
    if len(text.encode("utf-8")) > ATTACH_MAX_BYTES:
        fail_usage(f"--{name}-log: transcript expands past the {ATTACH_MAX_BYTES}-byte cap "
                   f"after decoding — attach a plain-text review transcript")
    log_rel = os.path.join(REPORTS_DIR, f"{sha}.{name}.log")
    log_path = os.path.join(root, log_rel)
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    with open_write(root, log_path) as f:
        f.write(text)
    return {
        "source": "attached",
        "output_file": log_rel,
        "output_sha256": hashlib.sha256(text.encode("utf-8")).hexdigest(),
        "output_lines": text.count("\n"),
        "attached_at": now_utc(),
    }


# ---------------------------------------------------------------- attest

def cmd_attest(args):
    root = repo_root()
    sha = head_sha(root)
    report, why, malformed = find_report(root, sha)
    if malformed:
        fail_usage(f"existing report is unusable — fix or delete it: {why}")
    if report is not None and report["commit"] != sha:
        # Inherit evidence from an ancestor whose only difference is evidence
        # files (find_report guarantees that), rebound to the current HEAD.
        anc_sha = report["commit"]
        report = dict(report)
        report["commit"] = sha
        # Re-bind any reviewer transcript to the new commit's filename so the
        # gate's commit+reviewer binding still recognizes it. The transcript is
        # trusted ONLY if it verifies AGAINST THE ANCESTOR first (exact
        # <ancestor>.<reviewer>.log name, real in-tree file, hash match,
        # consistent source fields) — otherwise a forged ancestor report could
        # point output_file at any OLD clean artifact and have attest launder
        # it into evidence for the new HEAD.
        for rname in ("codex", "glm"):
            e = report.get(rname)
            if not (e and e.get("source") in ("captured", "attached") and e.get("output_file")):
                continue
            if not verify_capture(root, e, anc_sha, rname):
                # untrusted/unverifiable transcript -> drop to a self-attested
                # claim (the gate will demand a fresh transcript) rather than
                # copy an arbitrary, stale, or off-tree file.
                report[rname] = dict(e, source="self-attested")
                report[rname].pop("output_file", None)
                report[rname].pop("output_sha256", None)
                continue
            src_rel = e["output_file"]
            old_path = os.path.join(root, src_rel)
            new_rel = os.path.join(REPORTS_DIR, f"{sha}.{rname}.log")
            new_path = os.path.join(root, new_rel)
            try:
                if os.path.realpath(old_path) != os.path.realpath(new_path) and os.path.exists(old_path):
                    with open(old_path, "rb") as rf:
                        data = rf.read()
                    # redact on copy (defense in depth) and rebind the hash
                    safe = redact_secrets(data.decode("utf-8", errors="replace"))
                    with open_write(root, new_path) as wf:
                        wf.write(safe)
                    e = dict(e, output_sha256=hashlib.sha256(safe.encode("utf-8")).hexdigest())
                report[rname] = dict(e, output_file=new_rel)
            except OSError:
                pass
    if report is None:
        if not args.tier:
            fail_usage("no report for HEAD yet — pass --tier L0|L1|L2|L3 to create one")
        report = new_report(sha, args.tier)
    elif args.tier:
        # Tier is MONOTONIC: attest may only RAISE it, never silently downgrade
        # an existing report (which would drop its evidence requirements). To
        # lower it, re-attest from scratch (--force) after removing the report.
        cur = report.get("risk_tier")
        raised = tier_max(cur, args.tier)
        if raised != args.tier and not getattr(args, "force", False):
            fail_usage(f"refusing to downgrade risk_tier {cur} -> {args.tier}; a lower tier "
                       f"drops evidence requirements. Re-attest with --force to override.")
        report["risk_tier"] = args.tier if getattr(args, "force", False) else raised
    if report["risk_tier"] not in TIERS:
        fail_usage(f"invalid tier {report['risk_tier']!r}")

    did = []

    if args.tests:
        cfg, err = load_json(os.path.join(root, CONFIG_FILE))
        if err:
            fail_usage(f"cannot run tests: {err} (run `coverloop init` first)")
        cmd = (cfg or {}).get("test_command")
        if not cmd or not str(cmd).strip():
            fail_usage(f"no test_command configured in {CONFIG_FILE}")
        print(f"running tests: {cmd}")
        try:
            # shell=True is deliberate: test_command is the repo owner's own
            # config (same trust model as package.json scripts / Makefiles /
            # loop.conf TEST_CMD) and legitimately needs shell semantics
            # ("npm test && npx tsc --noEmit"). It is printed above before it
            # runs. Never feed this from untrusted input.
            proc = subprocess.run(cmd, shell=True, cwd=root)
            status = "pass" if proc.returncode == 0 else "fail"
        except OSError as e:
            fail_usage(f"could not execute test command: {e}")
        report["tests"] = {"command": cmd, "status": status, "ran_at": now_utc()}
        did.append(f"tests={status}")

    for name, verdict, findings, run_cmd, log_src in (
        ("codex", args.codex, args.codex_findings, args.codex_run, args.codex_log),
        ("glm", args.glm, args.glm_findings, args.glm_run, args.glm_log),
    ):
        if run_cmd and log_src:
            fail_usage(f"--{name}-run and --{name}-log are mutually exclusive — "
                       f"either run the reviewer fresh or attach its existing transcript")
        if (run_cmd or log_src) and not verdict:
            fail_usage(f"--{name}-run/--{name}-log requires --{name} pass|fail — you state the "
                       f"verdict for the transcript (its content is prose, not a status)")
        if verdict:
            entry = {
                "status": verdict,
                "findings_open": findings if findings is not None else 0,
                "recorded_at": now_utc(),
                "source": "self-attested",
            }
            if run_cmd:
                # capture_run sets source="captured" + provenance; keep verdict.
                entry.update(capture_run(root, sha, name, run_cmd))
                entry["status"] = verdict
                entry["findings_open"] = findings if findings is not None else 0
                if entry.get("exit_code") != 0:
                    print(f"WARNING: {name} reviewer command exited {entry['exit_code']} — "
                          f"the capture is an error transcript and the gate will REJECT it. "
                          f"Fix the command and re-run.", file=sys.stderr)
            elif log_src:
                # attach_log sets source="attached" + provenance; keep verdict.
                entry.update(attach_log(root, sha, name, log_src))
                entry["status"] = verdict
                entry["findings_open"] = findings if findings is not None else 0
            report[name] = entry
            did.append(f"{name}={verdict}[{entry['source']}]")

    if args.approve:
        if not args.approver or not args.approver.strip():
            fail_usage("--approve requires --approver <name> (approval must be attributable)")
        report["human_gate"] = {
            "required": True,
            "approved": True,
            "approver": args.approver.strip(),
            "approved_at": now_utc(),
        }
        did.append(f"human_gate=approved({args.approver.strip()})")

    if not did and not args.tier:
        fail_usage("nothing to attest — pass --tests, --codex, --glm, --approve, or --tier")

    path = save_report(root, report)
    rel = os.path.relpath(path, root)
    print(f"recorded [{', '.join(did) or 'tier=' + report['risk_tier']}] -> {rel}")
    print("commit this report with your change — it is the PR-visible evidence.")
    # Evidence git IGNORES can never reach the PR — in the field a repo-root
    # `*.log` rule silently swallowed a captured transcript and CI failed on
    # missing evidence (2026-07-10). check-ignore exits 0 (-> non-None) when
    # a path is ignored.
    evidence_paths = [rel] + [report[r]["output_file"] for r in ("codex", "glm")
                              if report.get(r) and report[r].get("output_file")]
    swallowed = [p for p in evidence_paths if git(["check-ignore", p], cwd=root) is not None]
    if swallowed:
        print(f"ERROR: git IGNORES the evidence just written ({', '.join(swallowed)}) — "
              f"a .gitignore rule (e.g. `*.log`) would keep it out of the PR and the gate "
              f"would fail on missing evidence. Re-run `coverloop init` (writes negation "
              f"rules to .coverloop/.gitignore) and re-attest.", file=sys.stderr)
        return 1
    # attest --tests reflects reality: a failing test run is recorded AND
    # reported via exit code so CI/callers can react immediately.
    if args.tests and report["tests"]["status"] == "fail":
        return 1
    # Same rule for a failed reviewer capture (v2.7.2): the evidence was
    # already saved fail-closed (withheld transcript, gate will reject), but
    # automation reads the EXIT CODE — exiting 0 here let scripts treat a
    # failed review as a successful attestation.
    for rname in ("codex", "glm"):
        e = report.get(rname)
        if e and e.get("source") == "captured" and e.get("exit_code") not in (None, 0):
            return 1
    return 0


# ---------------------------------------------------------------- gate

def changed_files(root, base, sha):
    """Files changed base..sha, or None when the range can't be resolved."""
    if not base:
        return None
    out = git(["diff", "--no-renames", "--name-only", f"{base}..{sha}"], cwd=root)
    if out is None:
        return None
    return [line for line in out.splitlines() if line.strip()]


def docs_only(files):
    """True iff EVERY changed file is documentation (is_doc_file) or a committed
    report artifact. Anything else — including executable code under docs/, a
    basename-collision like src/CHANGELOG, or a non-artifact file under reports/
    — makes it not docs-only, so the L1 test gate is NOT waived."""
    if not files:  # empty diff or unknown -> not provably docs-only
        return False
    for f in files:
        if is_doc_file(f) or is_report_artifact(f):
            continue
        return False
    return True


def check(name, ok, detail):
    return {"check": name, "status": "pass" if ok else "FAIL", "detail": detail}


def source_tag(entry):
    """Human tag for how a reviewer verdict was recorded."""
    src = entry.get("source", "self-attested")
    if src in ("captured", "attached"):
        return f"{src} {entry.get('output_sha256', '')[:8]}"
    return "self-attested"


def verify_capture(root, entry, commit, name):
    """True iff `entry` claims a captured transcript that is genuinely THIS
    commit's / THIS reviewer's committed log and whose sha256 matches.

    Applies to BOTH transcript sources — "captured" (the tool ran the reviewer)
    and "attached" (an existing transcript was attested via --codex-log/--glm-log;
    same binding rules, minus the exit-code check the tool can't know).

    The `source: "captured"` string alone means nothing — a hand-edited report
    could set it. Real transcript evidence must:
      * name the transcript EXACTLY `.coverloop/reports/<commit>.<name>.log`
        (no traversal, and no REPLAY of an old/unrelated log under a different
        commit or reviewer);
      * resolve — after following any symlinks — to a real file INSIDE the
        reports dir (a symlink pointing outside is rejected);
      * hash to the recorded digest (catches tampering).
    """
    src = entry.get("source")
    if src not in ("captured", "attached"):
        return False
    # A CAPTURED reviewer command must have SUCCEEDED. A nonzero exit means it
    # failed (expired auth, missing binary, a hang) and the transcript is an
    # error log, not a review — accepting it would let a failed run pass
    # --require-captured. Attached transcripts carry no exit code (the tool
    # executed nothing); their trust rests on the committed, hash-bound,
    # human-readable log alone.
    if src == "captured":
        # A genuine captured entry carries capture_run's execution fields;
        # requiring them rejects the NAIVE relabel (an attached entry flipped to
        # source:"captured" that forgets to add them). HONEST LIMIT (full audit
        # 2026-07-11): command/exit_code/ran_at are unauthenticated attester
        # JSON and the log bytes+hash are attester-authored, so a committer who
        # adds all three defeats this — no on-disk field can PROVE coverloop
        # executed the reviewer. --require-executed is therefore a best-effort
        # policy filter (rejects honestly-attached evidence), NOT proof of
        # execution; the honest ceiling is documented in docs/GATE.md.
        if not all(k in entry for k in ("command", "exit_code", "ran_at")):
            return False
        if entry.get("exit_code") != 0:
            return False
    # An ATTACHED entry never records execution fields; any leftover
    # exit_code/command/ran_at means a captured (possibly FAILED) entry was
    # hand-reclassified as "attached" to dodge the exit-code check — reject
    # the inconsistency.
    if src == "attached" and any(k in entry for k in ("exit_code", "command", "ran_at")):
        return False
    rel = entry.get("output_file") or ""
    digest = entry.get("output_sha256") or ""
    expected = os.path.join(REPORTS_DIR, f"{commit}.{name}.log")
    if not digest or rel != expected:
        return False
    path = os.path.join(root, rel)
    # The ENTIRE reports path must be real: no symlinked `.coverloop` or
    # `reports/` ancestor (which would relocate the trusted root off-tree) and
    # the log itself must not be a symlink. Only then can the transcript be
    # trusted to live in the repo's committed evidence tree.
    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
    if os.path.realpath(reports_real) != reports_real:
        return False  # `.coverloop` or `.coverloop/reports` is a symlink
    if os.path.islink(path) or os.path.dirname(os.path.realpath(path)) != reports_real:
        return False
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError:
        return False
    # A transcript that IS the withheld failed-run placeholder (whole line) is a
    # laundered rejection artifact, not a review — reject it for BOTH sources
    # even when the hash matches. capture_run writes this line only on a nonzero
    # exit, so a genuine passing capture is never the placeholder; this closes
    # the forge where a FAILED capture's exit_code is hand-edited 1->0 (exit_code
    # is not covered by output_sha256, so no re-hash is needed) plus an attached
    # copy of the placeholder. Matching the WHOLE line (not a substring) means a
    # real review that merely quotes the marker still passes. (full audit +
    # Sol verify 2026-07-11 P1)
    if WITHHELD_RE.match(data.decode("utf-8", errors="replace").strip()):
        return False
    return hashlib.sha256(data).hexdigest() == digest


def reviewer_check(name, entry, mandatory_msg, require_captured, root, commit,
                   require_executed=False):
    """Gate check for a reviewer (codex/glm): pass requires status==pass AND
    zero open findings. A verdict claiming `captured`/`attached` whose
    transcript is missing/tampered/replayed is rejected outright (the label
    must never be a lie); with require_captured, a self-attested verdict also
    fails — captured OR attached both satisfy it (each carries a committed,
    hash-bound transcript; the honest difference is documented in GATE.md)."""
    if not entry:
        return check(name, False, f"{name}: NO RECORD — {mandatory_msg}")
    claims_transcript = entry.get("source") in ("captured", "attached")
    transcript_valid = verify_capture(root, entry, commit, name) if claims_transcript else False
    if claims_transcript and not transcript_valid:
        return check(name, False,
                     f"{name}: claims {entry.get('source')!r} but the transcript is invalid "
                     f"(missing / tampered / wrong commit / failed or inconsistent run) — "
                     f"evidence rejected (re-run attest --{name}-run or --{name}-log)")
    ok = entry.get("status") == "pass" and entry.get("findings_open") == 0
    if ok and require_captured and not transcript_valid:
        return check(name, False,
                     f"{name}: pass but SELF-ATTESTED — --require-transcript needs a "
                     f"transcript (attest --{name}-run \"<cmd>\" or --{name}-log <file>)")
    if ok and require_executed and (entry.get("source") != "captured" or not transcript_valid):
        return check(name, False,
                     f"{name}: --require-executed demands a coverloop-EXECUTED capture "
                     f"(attest --{name}-run \"<cmd>\"); source "
                     f"{entry.get('source', 'self-attested')!r} does not qualify")
    return check(name, ok,
                 f"{name}: {entry.get('status')}, open findings: "
                 f"{entry.get('findings_open')} [{source_tag(entry)}]")


def evaluate(report, tier, files, require_captured=False, root=None, test_command=None,
             require_executed=False):
    """Pure gate logic -> (verdict_pass, [checks]). Fail closed throughout."""
    checks = []

    if tier == "L0":
        checks.append(check("tier", True, "L0: trivial — no evidence required"))
        return True, checks

    tests = report.get("tests") if report else None
    recorded_cmd = str((tests or {}).get("command", "")).strip()
    # The recorded test command must match the project's CURRENT config command,
    # so a hand-forged `{"command":"echo fake","status":"pass"}` (or an old
    # command from before config changed) can't gate green. FAIL CLOSED when the
    # config has no test_command — an empty/None command can never be a match, so
    # a forged pass can't ride on a repo that never configured its tests.
    cfg_cmd = str(test_command or "").strip()
    cmd_matches = bool(cfg_cmd) and recorded_cmd == cfg_cmd
    tests_ok = bool(tests) and tests.get("status") == "pass" and bool(recorded_cmd) and cmd_matches
    if tier == "L1" and docs_only(files):
        checks.append(check("tests", True, "docs-only diff — test gate waived"))
    else:
        if not cfg_cmd:
            detail = "tests: no test_command configured — cannot verify (set one in .coverloop/config.json)"
        elif tests and not cmd_matches:
            detail = (f"tests: recorded command {recorded_cmd!r} != config test_command "
                      f"{cfg_cmd!r} — re-run `coverloop attest --tests`")
        elif tests:
            detail = f"tests: {tests.get('status')} ({tests.get('command')})"
        else:
            detail = "tests: NO RECORD — run `coverloop attest --tests`"
        checks.append(check("tests", tests_ok, detail))

    report_commit = (report or {}).get("commit")
    if tier in ("L2", "L3"):
        checks.append(reviewer_check(
            "codex", report.get("codex") if report else None,
            "independent diff review is mandatory at L2/L3", require_captured, root, report_commit,
            require_executed))

    if tier == "L3":
        checks.append(reviewer_check(
            "glm", report.get("glm") if report else None,
            "red-team/audit is mandatory at L3", require_captured, root, report_commit,
            require_executed))

        hg = report.get("human_gate") if report else None
        hg_ok = bool(hg) and hg.get("approved") is True and bool(str(hg.get("approver", "")).strip())
        detail = (
            f"human gate: approved by {hg.get('approver')!r}" if hg_ok
            else "human gate: NOT APPROVED — L3 requires `coverloop attest --approve --approver <name>`"
        )
        checks.append(check("human_gate", hg_ok, detail))

    verdict = all(c["status"] == "pass" for c in checks)
    return verdict, checks


# git's %G? signature-status codes. Only "G" (good AND from a key of sufficient
# validity — gpg owner-trust, or an ssh signer in allowed_signers) proves an
# AUTHORIZED author. "U" is a good signature whose key validity is UNKNOWN (e.g.
# a key merely imported into the keyring, or an ssh signer NOT in
# allowed_signers) — accepting it would let anyone with any importable key pass,
# so we reject it (Sol R3 P1: `git verify-commit` exit 0 accepts both G and U).
_SIG_STATUS = {
    "U": "good signature but UNKNOWN key validity — grant owner-trust / add the signer to allowed_signers",
    "B": "BAD signature", "E": "signature could not be checked (missing public key)",
    "N": "no signature", "X": "expired signature", "Y": "expired signing key",
    "R": "revoked signing key",
}


def verify_commit_signature(root, sha):
    """(ok, detail) for whether <sha> is signed by a key git fully TRUSTS.

    Provenance (R3): the evidence report is bound to a commit hash, but a hash
    alone doesn't prove WHO authored it. We require `git log %G?` == "G" — a good
    signature from a trusted key (gpg owner-trust, or ssh allowed_signers) — so
    unreviewed code can't be laundered onto an unsigned/forged/untrusted-key
    commit and gated green. Opt-in (--require-signed-commit); never changes the
    default path. errors='replace' so a non-UTF-8 signer name can't raise a
    ValueError past the OSError handler (GLM R3 P2-1). Fail-closed."""
    try:
        out = subprocess.run(["git", "log", "-1", "--format=%G?%n%GS", sha],
                             cwd=root, capture_output=True, text=True,
                             errors="replace", timeout=30)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return False, "git signature check unavailable — cannot confirm commit provenance"
    lines = (out.stdout or "").splitlines()
    status = lines[0].strip() if lines else ""
    signer = lines[1].strip() if len(lines) > 1 else ""
    if out.returncode == 0 and status == "G":
        return True, "HEAD signed by a trusted key" + (f" ({signer})" if signer else "")
    reason = _SIG_STATUS.get(status, "not verifiable")
    return False, (f"HEAD provenance FAIL: {reason} — sign with a trusted key "
                   "or drop --require-signed-commit")


def cmd_gate(args):
    root = repo_root()
    sha = head_sha(root)
    report, why, malformed = find_report(root, sha)

    # The pinned flags (--min-tier, or legacy --tier) are FLOORS: the effective
    # tier is the MAX over EVERY provided floor and the report's self-declared
    # tier, so a pin can only ever RAISE the requirement — never downgrade a
    # dangerous change. Both flags are action="append", so tier_max folds all of
    # them; the old `min_tier or tier` discarded one coexisting floor and
    # argparse last-wins let a repeated lower value win (full audit 2026-07-11).
    min_floors = getattr(args, "min_tier", None) or []
    tier_floors = getattr(args, "tier", None) or []
    report_tier = (report or {}).get("risk_tier")
    tier = tier_max(*min_floors, *tier_floors, report_tier)

    # A corrupt/forged/SHA-mismatched report fails EVERY tier, including L0.
    if malformed:
        _emit(args, sha, tier or "unknown", False,
              [check("report", False, f"malformed evidence: {why}")])
        sys.exit(1)

    if not tier:
        print(f"coverloop gate: FAIL — no risk tier: {why or 'no report'}", file=sys.stderr)
        print("record evidence at HEAD first (`coverloop attest --tier L0|L1|L2|L3 --tests ...`), "
              "or state the required floor: `coverloop gate --min-tier L0|L1|L2|L3`", file=sys.stderr)
        sys.exit(1)
    if tier not in TIERS:
        fail_usage(f"invalid tier {tier!r} (use L0|L1|L2|L3)")

    if report is None and tier != "L0":
        _emit(args, sha, tier, False, [check("report", False, why or "no report for HEAD")])
        sys.exit(1)

    # Non-L0 tiers require a loadable config: the gate must know it is running
    # in an onboarded repo (fail closed on missing/corrupt config).
    cfg, cfg_err = load_json(os.path.join(root, CONFIG_FILE))
    if cfg_err and tier != "L0":
        _emit(args, sha, tier, False,
              [check("config", False, f"{cfg_err} — run `coverloop init` and commit {CONFIG_FILE}")])
        sys.exit(1)

    # OPT-IN: fail closed on a DIRTY non-evidence working tree (full audit
    # 2026-07-11). Evidence binds to HEAD; find_report/only_evidence_changed
    # compare commits only, so uncommitted code edited AFTER a passing attest
    # would gate green while HEAD is unchanged — real drift for the documented
    # local pre-push/pre-deploy use. It is OPT-IN (--require-clean-tree) because
    # a legitimate untracked scratch file would otherwise block the gate; CI
    # (clean checkout) is unaffected either way. Report artifacts are carved out
    # so "attest, then commit the report" still works; git-unavailable fails
    # closed. L0 (no evidence required) is exempt.
    if getattr(args, "require_clean_tree", False) and tier != "L0":
        tracked = git(["diff", "--no-renames", "--name-only", "HEAD"], cwd=root)
        untracked = git(["ls-files", "--others", "--exclude-standard"], cwd=root)
        if tracked is None or untracked is None:
            _emit(args, sha, tier, False,
                  [check("worktree", False, "git status unavailable — cannot confirm a clean tree")])
            sys.exit(1)
        dirty = [p for p in (tracked.splitlines() + untracked.splitlines())
                 if p.strip() and not is_report_artifact(p.strip())]
        if dirty:
            _emit(args, sha, tier, False,
                  [check("worktree", False,
                         f"uncommitted non-evidence changes not covered by the evidence bound to HEAD "
                         f"({', '.join(dirty[:5])}{'…' if len(dirty) > 5 else ''}) — commit and re-attest")])
            sys.exit(1)

    # The docs-only waiver may rely ONLY on a base passed on the command line
    # (CI/operator-controlled — the workflow supplies --base origin/<base_ref>).
    # A base from in-repo config ships INSIDE the PR and is therefore
    # attacker-controllable (set default_base=HEAD~1 and the waiver diff skips
    # your own code change), so config's default_base must NEVER enable a
    # waiver. With no trusted base, `files` is None -> the waiver simply does
    # not apply and tests are required (fail closed).
    files = changed_files(root, args.base, sha) if args.base else None

    # --require-transcript is the honest name (accepts captured OR attached);
    # --require-captured is its deprecated alias; --require-executed implies it
    # and additionally demands a coverloop-EXECUTED capture.
    require_transcript = (args.require_captured or args.require_transcript
                          or args.require_executed)
    verdict, checks = evaluate(report, tier, files,
                               require_captured=require_transcript, root=root,
                               test_command=(cfg or {}).get("test_command"),
                               require_executed=args.require_executed)

    # Provenance (opt-in): also require HEAD to be cryptographically signed, so
    # the tier's evidence can't be replayed onto an unsigned/forged commit. L0
    # (no evidence required) is exempt — a signature gate on a no-op is noise.
    if getattr(args, "require_signed_commit", False) and tier != "L0":
        sig_ok, sig_detail = verify_commit_signature(root, sha)
        checks.append(check("signature", sig_ok, sig_detail))
        verdict = verdict and sig_ok

    _emit(args, sha, tier, verdict, checks)
    sys.exit(0 if verdict else 1)


def _emit(args, sha, tier, verdict, checks):
    # CI annotations go to STDERR so they also work alongside --json
    # (stdout stays pure JSON for tooling; GitHub reads both streams).
    if args.ci:
        for c in checks:
            if c["status"] != "pass":
                print(f"::error title=coverloop gate::{c['check']}: {c['detail']}",
                      file=sys.stderr)
    if args.json:
        print(json.dumps(
            {"schema": "coverloop-gate/v1", "commit": sha, "tier": tier,
             "verdict": "pass" if verdict else "fail", "checks": checks},
            indent=2,
        ))
        return
    print(f"coverloop gate — commit {sha[:12]} — tier {tier}")
    for c in checks:
        mark = "✔" if c["status"] == "pass" else "✘"
        print(f"  {mark} {c['check']:<11} {c['detail']}")
    print(f"VERDICT: {'PASS' if verdict else 'FAIL — required evidence missing or failing'}")


# ---------------------------------------------------------------- main

def main(argv=None):
    p = argparse.ArgumentParser(prog="coverloop", description=__doc__.splitlines()[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    pi = sub.add_parser("init", help="scaffold .coverloop/ in this repo")
    pi.add_argument("--test-command", help="command that must pass (default: npx tsc --noEmit)")
    pi.set_defaults(fn=cmd_init)

    pa = sub.add_parser("attest", help="record evidence for the HEAD commit")
    pa.add_argument("--tier", choices=TIERS, help="risk tier of this change (monotonic — attest can only raise it)")
    pa.add_argument("--force", action="store_true", help="allow lowering an existing report's risk tier (dangerous)")
    pa.add_argument("--tests", action="store_true", help="run the configured test command and record the result")
    pa.add_argument("--codex", choices=["pass", "fail"], help="record the Codex diff-review verdict")
    pa.add_argument("--codex-findings", type=int, help="open Codex findings (default 0)")
    pa.add_argument("--codex-run", metavar="CMD", help="run CMD as the Codex reviewer and "
                    "capture its output (hashed, committed) as evidence backing the verdict")
    pa.add_argument("--codex-log", metavar="FILE", help="attach an EXISTING Codex transcript "
                    "(a review you already ran interactively): redacted, committed, hashed — "
                    "no re-run. Weaker than --codex-run (no execution binding), far stronger "
                    "than a bare self-attested verdict")
    pa.add_argument("--glm", choices=["pass", "fail"], help="record the GLM red-team/audit verdict")
    pa.add_argument("--glm-findings", type=int, help="open GLM findings (default 0)")
    pa.add_argument("--glm-run", metavar="CMD", help="run CMD as the GLM reviewer and "
                    "capture its output (hashed, committed) as evidence backing the verdict")
    pa.add_argument("--glm-log", metavar="FILE", help="attach an EXISTING GLM transcript "
                    "(same rules as --codex-log)")
    pa.add_argument("--approve", action="store_true", help="record the human gate approval (L3)")
    pa.add_argument("--approver", help="who approved (required with --approve)")
    pa.set_defaults(fn=cmd_attest)

    pg = sub.add_parser("gate", help="verify required evidence for the tier; exit non-zero if missing")
    pg.add_argument("--min-tier", choices=TIERS, action="append",
                    help="floor: the effective tier is max(every floor, the report's tier), so a "
                         "pin can only RAISE requirements, never downgrade a dangerous change "
                         "(repeatable; all values raise)")
    pg.add_argument("--tier", choices=TIERS, action="append",
                    help="DEPRECATED alias for --min-tier (also a floor; kept for back-compat)")
    pg.add_argument("--base", help="trusted diff base for the L1 docs-only waiver (e.g. origin/main); "
                                   "without it the waiver never applies and tests are required")
    pg.add_argument("--require-transcript", action="store_true",
                    help="reject self-attested reviewer verdicts at L2/L3 — demand a committed, "
                         "hash-bound transcript: captured (attest --codex-run/--glm-run) or "
                         "attached (--codex-log/--glm-log)")
    pg.add_argument("--require-captured", action="store_true",
                    help="DEPRECATED alias for --require-transcript (kept for CI back-compat)")
    pg.add_argument("--require-executed", action="store_true",
                    help="STRICTER than --require-transcript: prefer a coverloop-EXECUTED capture "
                         "(source 'captured', exit 0) and reject honestly-attached transcripts. "
                         "BEST-EFFORT policy filter, NOT proof of execution — on-disk fields are "
                         "attester-controlled, so a committer who controls the tree can still forge "
                         "a captured-shaped entry (see docs/GATE.md threat model)")
    pg.add_argument("--require-clean-tree", action="store_true",
                    help="for LOCAL pre-push/pre-deploy gating: fail if the working tree has "
                         "uncommitted non-evidence changes (code edited after attest isn't covered "
                         "by evidence bound to HEAD). Off by default (untracked scratch files "
                         "would block it); a clean CI checkout doesn't need it")
    pg.add_argument("--require-signed-commit", action="store_true",
                    help="PROVENANCE: also require HEAD to carry a git-verifiable GPG/SSH "
                         "signature (git verify-commit), so a report can't be replayed onto an "
                         "unsigned/forged commit. Needs a trusted keyring / ssh allowed_signers. "
                         "L0 is exempt")
    pg.add_argument("--ci", action="store_true", help="CI mode: emit GitHub error annotations")
    pg.add_argument("--json", action="store_true", help="machine-readable verdict")
    pg.set_defaults(fn=cmd_gate)

    args = p.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
