#!/usr/bin/env python3
"""coverloop — evidence gate for AI-written changes.

Subcommands:
  init    scaffold .coverloop/ (config + reports dir) in the current repo
  attest  record evidence (test run, reviewer verdicts, human approval)
          into a report bound to the current HEAD commit
  gate    verify the required evidence exists for the given risk tier;
          exit 0 only if every required gate has a passing, HEAD-bound record

Design rules (do not weaken):
  * FAIL CLOSED: missing config (non-L0), missing report (non-L0), stale
    evidence, unreadable JSON, unknown tier -> non-zero exit. A malformed,
    forged, or SHA-mismatched report fails EVERY tier, including L0.
  * The GATE never sends code anywhere and never calls a model — it only
    inspects local files and git metadata. `attest` runs the project's own
    test command and, when given `--codex-run` / `--glm-run`, executes those
    reviewer commands and captures their hashed transcripts; `--codex-log` /
    `--glm-log` instead ATTACH an existing transcript (redacted + hashed, no
    re-run — source "attached", one honesty notch below "captured"); otherwise
    a reviewer verdict is self-attested (a recorded claim). The verdict itself
    is always caller-stated (reviewer output is prose, not a status).
    `gate --require-transcript` makes L2/L3 reject self-attested reviewer
    verdicts and demand a committed transcript (captured or attached);
    `--require-executed` is stricter (executed capture only).
  * Evidence binds to a commit SHA. The gate accepts a report bound to an
    ancestor commit ONLY when the diff from that ancestor to HEAD touches
    nothing but files under .coverloop/reports/ — this makes the
    "attest, then commit the report" flow possible while guaranteeing any
    CODE change after attestation still invalidates the evidence.

Honest threat model: this verifies that evidence EXISTS and is bound to
the commit under review; it cannot stop someone from hand-writing a lying
report. It turns silent drift into an explicit, committed, auditable lie —
and in CI the report travels with the PR, where a reviewer can see it.

Exit codes: 0 = all required gates pass; 1 = gate failure (missing/failed
evidence); 2 = usage or environment error.
"""
import argparse
import contextlib
import datetime
import hashlib
import itertools
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

# The canonical secret filter ships next to this script (install.sh copies all
# of bin/). Import it for transcript/command redaction; fall back to a minimal
# built-in redactor so a missing filter can never cause a total secret leak.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    import glm_secret_filter as _secret
except Exception:  # pragma: no cover - defensive
    _secret = None

_FALLBACK_SECRET_RE = re.compile(
    r"(?<![A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}"
    r"|(?<![A-Za-z0-9])(?:ghp|gho|ghs|github_pat)_[A-Za-z0-9_]{20,}"
    r"|(?<![A-Za-z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}"
    r"|\bbearer\s+[A-Za-z0-9._~+/=-]{16,}"
    r"|-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----",
    re.IGNORECASE | re.DOTALL)


def redact_secrets(text):
    """Strip secret VALUES from text before it is written to a committed file."""
    if _secret is not None:
        return _secret.redact(text)
    return _FALLBACK_SECRET_RE.sub("[REDACTED]", text or "")


SCHEMA = "coverloop-report/v1"
CONFIG_DIR = ".coverloop"
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
REPORTS_DIR = os.path.join(CONFIG_DIR, "reports")
TIERS = ("L0", "L1", "L2", "L3")

# ---------------------------------------------------------------------------
# Deterministic risk classification (the tier FLOOR, derived from the change
# itself).
#
# Why this exists: every gate below keys off `risk_tier`, but that tier was
# self-declared at `init`. A change mislabelled L1 silently skips the L3 gates —
# no alarm, no evidence that anything was skipped. This is the one place the
# whole chain could be defeated by a typo or by optimism. So the tier a human
# (or an AI) declares is now only a FLOOR CANDIDATE: `classify` reads the paths
# that actually changed and emits its own floor, and `gate --min-tier` takes the
# MAX. Classification can therefore only ever RAISE the requirement.
#
# Rules are PATH-based on purpose: paths are cheap, stable, and reviewable, and
# an attacker who renames a migration out of `migrations/` to dodge L3 has to do
# something visible in the diff. Content sniffing was deliberately NOT used —
# it is easy to defeat with formatting and produces false negatives that read as
# safety. Deliberately blunt beats subtly wrong here.
#
# Ordering: first match wins per file, HIGHEST tier over all files wins overall.
# Anything unrecognised is L1, never L0 — an unknown file is not evidence of
# safety.
# Two ways a keyword can end, and the difference is the whole false-positive story.
#
# _kw  — any casing, then a separator, a camelCase hump, or end of name. Used for
#        the DANGEROUS words (auth, credentials, billing, worker...). AuthGuard.tsx
#        and authGuard.tsx both reach L3, and a component that merely sounds like
#        auth being reviewed as auth costs a review nobody regrets.
# _kws — the same, EXCEPT that a PascalCase name does not count as a hump. Used for
#        words that collide with ordinary React component names: ModelViewer.tsx is
#        not a data model, ContextMenu.tsx is not React context, RoutePlanner.tsx is
#        not a router. Those read as L3/L2 under _kw, and a floor that cries danger
#        at a UI component is a floor people learn to route around — which costs far
#        more than the handful of real files it would have caught.
#        `models/`, `model.ts` and `Schema.ts` still match: only the HUMP form is
#        restricted, because that is the only form the collision takes.
def _kw(words):
    return rf"(?:{words})(?=(?-i:[A-Z])|[/._\-\s]|$)"


def _kws(words):
    return rf"(?:(?-i:{words})(?=(?-i:[A-Z]))|(?:{words})(?=[/._\-\s]|$))"


RISK_RULES = (
    # (tier, compiled path pattern, human-readable reason)
    ("L3", r"(^|/)migrations?/|(^|/)(alembic|db)/(versions?|migrate)/"
           r"|(^|/)migrate/[^/]*\.(rb|py|go|ts|js|sql)$", "database migration"),
    ("L3", r"\.sql$", "raw SQL"),
    ("L3", r"(^|/)(auth|authn|authz|authentication|authorization|authorisation"
           r"|rls|rbac|permissions?|policies|policy|acls?|admin)(?=(?-i:[A-Z])|[/._\-\s]|$)",
     "authentication / authorisation / RLS"),
    ("L3", r"(^|/)(billing|payments?|invoices?|invoicing|checkout|charges?|chargebacks?"
           r"|stripe|cardcom|subscriptions?|wallets?|payouts?|refunds?|transfers?|ledgers?)(?=(?-i:[A-Z])|[/._\-\s]|$)",
     "money path"),
    ("L3", r"(^|/)(secrets?|credentials?|keys?)(?=(?-i:[A-Z])|[/._\-\s]|$)|(^|/)\.env",
     "secrets / credentials"),
    ("L3", r"(^|/)\.github/workflows/|(^|/)(Dockerfile|docker-compose|fly\.toml|vercel\.json)"
           r"|(^|/)(\.gitlab-ci\.yml|Jenkinsfile|\.circleci/|azure-pipelines\.yml|buildspec\.yml)"
           r"|(^|/)\.github/actions/|\.(tf|tfvars)$|(^|/)(terraform|pulumi|helm|k8s|kubernetes)/",
     "CI / deploy configuration"),
    ("L3", r"(^|/)(workers?|cron|jobs?|queues?|scheduler)(?=(?-i:[A-Z])|[/._\-\s]|$)",
     "worker / cron / queue"),
    ("L3", r"(^|/)" + _kws("schemas?|models?")
           + r".*\.(ts|tsx|js|jsx|mjs|cjs|py|go|rb|java|kt|swift|rs|php|sql|prisma|graphql|ya?ml|json|cs|ex|exs|scala|clj|hs|dart)$",
     "schema / data model"),
    # L2 — product surface and shared contracts: wide blast radius, no direct
    # money/auth authority.
    # NOTE: these two are scoped to APPLICATION SOURCE extensions on purpose.
    # Unscoped, `hooks/` matched this protocol's own shell hooks and `api/`
    # would match any stray text file — over-classification is not free: a
    # floor that cries L2 at documentation trains people to bypass the gate,
    # and a bypassed gate protects nothing.
    ("L2", r"(^|/)(?:" + _kw("api|handlers?|controllers?|middleware")
           + "|" + _kws("routes?") + r")" + r".*\.(ts|tsx|js|jsx|mjs|cjs|py|go|rb|java|kt|swift|rs|php)$",
     "API surface"),
    ("L2", r"(^|/)(?:" + _kw("hooks?|providers?")
           + "|" + _kws("contexts?|stores?|states?") + r")" + r".*\.(ts|tsx|js|jsx|mjs|cjs|py|go|rb|java|kt|swift|rs|php)$",
     "shared application state"),
    ("L2", r"(^|/)(package\.json|package-lock\.json|pnpm-lock\.yaml|yarn\.lock|requirements.*\.txt|pyproject\.toml)$",
     "dependency manifest"),
    # L0 — provably inert: prose and styling only. Anything else falls through
    # to the L1 default.
    # `.txt` is deliberately absent: config/roles.txt and the like are plain
    # text that configures real behaviour, so an unmatched .txt falls to L1
    # ("silence is not safety") rather than being presumed prose.
    ("L0", r"\.(md|mdx|rst|adoc)$", "documentation"),
    ("L0", r"\.(css|scss|sass|less)$", "stylesheet"),
    ("L0", r"(^|/)(LICENSE|CODEOWNERS|\.gitignore|\.editorconfig)$", "repo metadata"),
)
_RISK_RULES_C = tuple((t, re.compile(p, re.I), why) for t, p, why in RISK_RULES)

# Above this many changed files a change is too broad to be L1 regardless of
# what the individual paths look like — breadth is itself a risk signal.
# Extensions that are inert WHATEVER the file is named. `.txt` is deliberately
# absent: config/permissions.txt and requirements.txt are plain text that
# configures real behaviour, and the blanket shortcut was declaring them L0
# ahead of the rules that call them dangerous. `.txt` falls through to the
# ordinary rules, where the documentation rule still catches notes.txt — but
# only after the L3 rules have had their say.
# .coverloop/reports/ holds the tool's OWN generated evidence artifacts —
# report JSON and reviewer transcripts. They cannot carry application risk;
# their integrity is defended separately (hash binding, forgery checks in
# find_report/verify_capture), not by this classifier. Without this, an
# evidence-only commit classified its own report file as "L1: unrecognized
# source", so a repo's evidence chain kept re-flagging ITSELF as unreviewed.
# Anchored to the REPO ROOT. Unanchored, every occurrence of the substring
# matched, so nested/.coverloop/reports/evil.sql — and even
# x.coverloop/reports/migration.sql, via the unescaped-dot lookalike — were
# exempted from classification entirely: an attacker could park a migration
# under any directory NAMED like the evidence tree and classify it L0.
# ...and only the exact artifact SHAPES the tool itself writes. Anchoring
# alone still exempted .coverloop/reports/evil.sql — anything parked in the
# canonical directory. A file there that is not a report or transcript is
# ordinary (suspicious) code and classifies like any other path.
_INERT_RE = re.compile(r"\.(md|mdx|rst|adoc|css|scss|sass|less)$", re.I)

BREADTH_L2_FILES = 10


# The narrow set: changes a human must personally stop on, because no amount of
# automated review buys back a mistake here.
#
#   1. schema migrations / raw SQL  — can destroy data; there is no undo
#   2. money paths                  — a wrong number moves real funds
#   3. authz / RLS / permissions    — a wrong rule shows one customer another's data
#
# Everything else at L3 (workers, cron, CI config, deploy wiring, concurrency,
# env plumbing) is dangerous enough to earn the FULL automated loop — tests,
# an independent diff gate, a red-team pass, hashed evidence — but it is
# revertible, so stopping a solo founder on every one of them buys less than it
# costs. This list is deliberately short: the moment it grows to cover
# "anything that feels important", the stop stops meaning anything.
# Which L3 REASONS are hard to take back. This is derived from the rule that
# matched, not from a second regex kept in step by hand — the parallel regex
# drifted from RISK_RULES three separate times (camelCase authz, then `acl`,
# then alembic/db-migrate directories), each time silently waiving the human
# stop for exactly the changes `--human-gate-scope irreversible` promises to
# stop. A rule added above is now covered here automatically, or not at all,
# and never half-covered.
IRREVERSIBLE_REASONS = frozenset({
    "database migration",
    "raw SQL",
    "authentication / authorisation / RLS",
    "money path",
    "schema / data model",
})


def is_irreversible(path):
    """True when PATH matches ANY L3 rule whose consequences are hard to undo.

    Checking only the FIRST matching rule made the answer depend on rule ORDER:
    `workers/models/user.py` hit the worker rule (L3, reversible) before the
    schema rule (L3, irreversible), so the human stop was waived for a schema
    change because of where the file happened to live. Tier selection may take
    the first match; irreversibility must ask every rule."""
    return any(rule_tier == "L3" and why in IRREVERSIBLE_REASONS and rx.search(path)
               for rule_tier, rx, why in _RISK_RULES_C)


class _IrreversibleShim:
    """Kept so `IRREVERSIBLE_RE.search(path)` still reads naturally at the two
    call sites and in the tests; the logic lives in is_irreversible()."""

    @staticmethod
    def search(path):
        return is_irreversible(path)


IRREVERSIBLE_RE = _IrreversibleShim()


def _resolve_commit(ref, cwd):
    """Resolve a user-supplied ref to a commit id, or None.

    `--base` reaches `git diff` as a positional, so an option-shaped value was
    read as a FLAG: `--base=--cached` diffed the index, found nothing to classify,
    and the gate passed. `--end-of-options` stops git parsing further flags, and
    demanding a 40-hex answer means nothing but a real commit gets through.
    """
    out = git(["rev-parse", "--verify", "--quiet", "--end-of-options",
               f"{ref}^{{commit}}"], cwd=cwd)
    if not out:
        return None
    out = out.strip()
    return out if re.fullmatch(r"[0-9a-f]{40}", out) else None


def _git_paths(args, cwd):
    """Git path output, parsed losslessly. Returns None if git failed.

    Two ways the old `--name-only` + splitlines() collection lost paths, and both
    are classifier EVASION, not cosmetics:

      * rename detection reported only the DESTINATION, so moving
        src/authGuard.ts to src/guard.ts made an auth change look like an
        unrecognised source file. `--no-renames` reports both sides.
      * git C-quotes any name containing a newline or tab, and splitlines() then
        tore that single path into two meaningless fragments. `-z` emits raw
        names separated by NUL, so there is nothing to quote and nothing to tear.
    """
    # `--no-renames` is a diff option; ls-files rejects it, and appending it
    # blindly made every collection return None — which the caller then, quite
    # correctly, read as "cannot determine the paths" and held at L1. Correct
    # fail-closed behaviour, wrong cause, and it would have masked the evasion
    # fix it was meant to deliver.
    # `show` takes diff options too, and it defaults to rename detection just
    # like `diff` — scoping the flag to `diff` alone let the root-commit fallback
    # lose a rename origin again, one commit after that hole was closed.
    # `ls-files` is the only caller here that rejects it.
    extra = (["--no-renames", "-z"] if args and args[0] in ("diff", "show")
             else ["-z"])
    out = git(args + extra, cwd=cwd)
    if out is None:
        return None
    # Only EMPTY segments are dropped — a filename that is entirely whitespace
    # is a real (and suspicious) file, and discarding it produced an empty,
    # L0 change set.
    return [p for p in out.split("\0") if p]


def _changed_paths_for_gate(root, args):
    """Paths this gate run is judging: the PR range if --base was given (CI),
    else the working tree plus untracked files (local)."""
    base = getattr(args, "base", None)
    if base:
        base = _resolve_commit(base, root)
        if base is None:
            return []
        out = _git_paths(["diff", "--name-only", f"{base}...HEAD"], root)
        if out is None:
            out = _git_paths(["diff", "--name-only", base, "HEAD"], root)
        return out or []
    tracked = _git_paths(["diff", "--name-only", "HEAD"], root) or []
    untracked = _git_paths(["ls-files", "--others", "--exclude-standard"], root) or []
    return list(tracked) + list(untracked)


def _validated_baseline(root, sha, limit=2000):
    """The newest ancestor of SHA whose evidence chain actually VALIDATES.

    Returns (baseline, validated): `validated` is False when the baseline is the
    bare root commit with no accepted evidence — the caller must then classify
    the root's OWN files too, because a two-dot diff from the root excludes the
    files the root itself introduced (a migration in a repo's FIRST commit was
    never classified at all; probed end-to-end). None baseline means git could
    not answer, or the history is SHALLOW — a shallow boundary looks exactly
    like a root commit to rev-list --max-parents=0, and treating it as one
    silently drops everything at or before the boundary; fail closed and let
    the operator fetch full history (CI: fetch-depth: 0, or pass --base).

    A report advances the baseline only if BOTH hold:
      * its tier covers the deterministic floor of the segment it governs, AND
      * it would pass its own VERIFICATION (tests bound to the config command,
        hash-bound reviewer transcripts) — NOT authorization: whether a human
        signed for it is the gate's question about the commit being shipped,
        not a property that makes an ancestor a worse baseline — existence is
        not validity, and a bare tier claim is not evidence: a planted
        no-evidence L3 report on a migration commit advanced the baseline and
        let a later docs commit gate at L0 (probed end-to-end).

    Cost is bounded: at most _BASELINE_WALK_CAP evidence commits are validated
    (newest-first); anything older folds into the pre-baseline segment, which
    only ever ENLARGES what the gate classifies.
    """
    shallow = git(["rev-parse", "--is-shallow-repository"], cwd=root)
    if shallow is None or shallow.strip() == "true":
        return None, False
    out = git(["rev-list", f"--max-count={limit}", sha], cwd=root)
    if not out:
        return None, False
    commits = out.split()
    attested = []
    for c in commits[1:]:
        if os.path.exists(report_path(root, c)):
            rep, _why = load_report(root, c)
            if rep is not None and rep.get("risk_tier") in TIERS:
                attested.append((c, rep))
        if len(attested) >= _BASELINE_WALK_CAP:
            break
    root_out = git(["rev-list", "--max-parents=0", sha], cwd=root)
    if not root_out:
        return None, False
    baseline = root_out.split()[-1]
    validated = False
    cfg, _cfg_err = load_json(os.path.join(root, CONFIG_FILE))
    cfg_cmd = (cfg or {}).get("test_command")
    for c, rep in reversed(attested):
        if c == baseline and validated:
            continue
        seg = _git_paths(["diff", "--name-only", f"{baseline}..{c}"], root)
        if seg is None:
            return None, False
        if not validated:
            # The segment reaching back to the bare root must include the
            # root's own files — a two-dot diff excludes what the root itself
            # introduced, and nothing else ever accounts for those.
            own = _git_paths(["show", "--name-only", "--pretty=format:", baseline], root)
            if own is None:
                return None, False
            seg = list(seg) + own
        tier = rep["risk_tier"]
        floor, _reasons = classify_paths(seg, BREADTH_L2_FILES)
        if tier_max(tier, floor) != tier:
            continue  # under-declares its segment — not a valid baseline
        # VERIFICATION scope, deliberately: this asks "was commit c actually
        # checked?" (tests + reviewers), not "did a human sign for it?". A
        # reviewed-but-unsigned commit is a legitimate risk baseline. Human
        # authorization is enforced by the GATE on the commit being shipped —
        # it is never inherited from an ancestor, and never inferred here.
        ok, _checks = evaluate(rep, tier, None, root=root, test_command=cfg_cmd,
                               scope=EVIDENCE_VERIFICATION)
        if not ok:
            continue  # a tier claim with no evidence behind it is not a baseline
        baseline = c
        validated = True
    return baseline, validated


_BASELINE_WALK_CAP = 100


def _gate_floor_paths(root, args, report, sha):
    """Every path this gate run is judging, and whether that set is TRUSTWORTHY.

    Returns (paths, unknown). `unknown` means git could not answer, and the caller
    must fail closed rather than read the resulting empty list as "nothing risky".

    The first cut of the auto-floor asked only for uncommitted changes, which is
    empty in the ordinary case — you commit, THEN run the gate — so `gate
    --min-tier L0` still passed over a committed migration. The set therefore
    also spans the commits the recorded evidence does not cover: from the report's
    commit to HEAD, or the commit being gated when there is no report at all.
    """
    base = getattr(args, "base", None)
    if base:
        # Resolve to a commit id FIRST. `--base=--cached` was passed through to
        # `git diff` as an OPTION, which diffed the index, found nothing, and
        # gated clean. Anything that does not resolve to a commit is refused
        # before it can reach git as a flag.
        base = _resolve_commit(base, root)
        if base is None:
            return [], True
        out = _git_paths(["diff", "--name-only", f"{base}...HEAD"], root)
        if out is None:
            out = _git_paths(["diff", "--name-only", base, "HEAD"], root)
        if out is None:
            # An unresolvable --base is a caller error, not an all-clear. Reading
            # it as "no files changed" turned a typo into a passing gate.
            return [], True
        return out, False

    tracked = _git_paths(["diff", "--name-only", "HEAD"], root)
    untracked = _git_paths(["ls-files", "--others", "--exclude-standard"], root)
    if tracked is None or untracked is None:
        return [], True
    paths = list(tracked) + list(untracked)

    # ...plus whatever the evidence does not already cover.
    # The commit being gated is ALWAYS classified, including when the evidence
    # sits on it. The old expression returned None in exactly that case — the
    # normal attest path — so a migration could be committed, attested L0 with
    # tests, and sail through: the floor never looked at it. `prior^..sha` also
    # re-covers the evidence commit itself, which is the point: the recorded
    # tier has to match what that commit actually contains.
    # The EARLIEST commit this evidence claims to cover — not the one it was last
    # rebound to (see origin_commit above).
    # The oldest commit some EARLIER evidence already claims to cover.
    # `origin_commit` is the honest source when it exists (set on rebind). A
    # report's plain `commit` field is NOT a substitute: on a first-ever attest
    # it equals sha itself, and treating sha as "prior" collapsed the range to
    # sha^..sha — a single commit — so a migration one commit back (never
    # attested, never rebound) stayed invisible. Absent a real origin, the
    # honest baseline is the newest ANCESTOR that independently carries
    # evidence, walking past sha itself; with none, the root. A migration that
    # nothing has ever reviewed cannot be waved through by attesting the commit
    # after it.
    # origin_commit is kept in reports for provenance, but the baseline is
    # ALWAYS the validated walk: the origin shortcut trusted a rebound report's
    # word for where its coverage began, which is exactly the trust the
    # planted-report attack abused. The walk finds the same origin commit when
    # its report is honest, and walks past it when it is not.
    prior, prior_validated = _validated_baseline(root, sha)
    if prior is None:
        return sorted(set(paths)), True
    if prior == sha:
        # Only reachable for a single-commit repo (sha IS its own root): there
        # is nothing to diff against, so list its own files.
        out = _git_paths(["show", "--name-only", "--pretty=format:", sha], root)
    else:
        # A PLAIN two-dot diff, no caret. `prior` is a commit whose own state
        # was already reviewed — either it carries a real evidence report (and
        # attest now enforces the floor at record time, so that report already
        # reflects tier >= floor(baseline..prior)), or it's the root, which
        # needs no separate review since nothing precedes it. Because of that,
        # `prior..sha` correctly EXCLUDES `prior`'s own introduction: adding
        # `prior`'s files back in (the previous version of this code did, via
        # a `^`) double-counted content that had already been accounted for,
        # and specifically kept re-flagging a repo's OWN coverloop scaffolding
        # every time a later, unrelated commit made that evidence stale for
        # governance purposes but not for floor purposes.
        out = _git_paths(["diff", "--name-only", f"{prior}..{sha}"], root)
        if out is not None and not prior_validated:
            # The baseline is the BARE root: no evidence ever covered the files
            # the root commit itself introduced, and prior..sha excludes them.
            own = _git_paths(["show", "--name-only", "--pretty=format:", prior], root)
            out = None if own is None else out + own
    if out is None:
        # `or []` here once turned a git timeout, a shallow clone, a corrupt
        # object or a bad origin_commit into an EMPTY path set with
        # unknown=False — an all-clear built out of a failure.
        return sorted(set(paths)), True
    paths += out
    return sorted(set(paths)), False


def classify_paths(paths, breadth_threshold=BREADTH_L2_FILES):
    """Derive the deterministic tier FLOOR for a set of changed paths.

    Returns (tier, reasons) where reasons is an ordered, de-duplicated list of
    "<tier>: <why> (<example path>)" strings — the audit trail for the verdict.
    An empty change set is L0 with no reasons; it asserts nothing.
    """
    # RAW git paths — no .strip(). Stripping first meant `<sha>.json ` and
    # ` <sha>.glm.log` (trailing space, leading space, tab) were normalised INTO
    # the exempt artifact shape, so an arbitrary file could take the evidence
    # exemption and skip the L1 floor. git reports the real name; a name with
    # surrounding whitespace is a DIFFERENT, and more suspicious, file.
    paths = [p for p in paths if p]
    if not paths:
        return "L0", []
    tier = "L0"
    reasons, seen = [], set()
    for path in paths:
        matched = None
        # Prose and styling are inert whatever they are NAMED. The name rules run
        # first and match anywhere in the path, so docs/authGuide.md,
        # docs/workerPool.md and docs/credentialsGuide.md were all classified L3 —
        # a floor that demands a red-team review of a markdown file is a floor
        # people learn to route around, which costs more than it ever protects.
        # ...unless the name itself carries meaning. requirements.txt is a
        # dependency manifest that happens to end in .txt, and the blanket inert
        # shortcut demoted it from L2 to L0 — a regression introduced by the fix
        # for documentation false positives.
        if _INERT_RE.search(path) or is_report_artifact(path):
            matched = ("L0", "documentation / styling (inert regardless of name)")
        for rule_tier, rx, why in (() if matched else _RISK_RULES_C):
            if rx.search(path):
                matched = (rule_tier, why)
                break
        # Unrecognised => L1. Silence is not safety.
        if matched is None:
            matched = ("L1", "source change (no specific rule matched)")
        rule_tier, why = matched
        tier = tier_max(tier, rule_tier)
        key = (rule_tier, why)
        if key not in seen:
            seen.add(key)
            reasons.append(f"{rule_tier}: {why} ({path})")
    if len(paths) >= breadth_threshold:
        tier = tier_max(tier, "L2")
        reasons.append(f"L2: breadth — {len(paths)} files changed "
                       f"(>= {breadth_threshold})")
    return tier, reasons

# A committed EVIDENCE ARTIFACT under .coverloop/reports/ — EXACT name shapes
# only: <40-hex commit sha>.json, or <sha>.<reviewer>.log. Anything else under
# reports/ (e.g. .coverloop/reports/backdoor.py) is a NORMAL code file: not
# "evidence-only", not test-waivable. This is what stops code being smuggled in
# under the reports/ prefix.
# `\Z`, not `$`: Python's `$` also matches BEFORE a final newline, so
# "<sha>.json\n" satisfied the artifact shape and took the exemption.
REPORT_ARTIFACT_RE = re.compile(
    r"^" + re.escape(REPORTS_DIR + "/")
    + r"[0-9a-f]{40}(?:\.json|\.(?:codex|glm)\.log)\Z")

# Documentation for the L1 test-gate waiver. Deliberately strict so a code file
# cannot masquerade as docs: an EXACT root-level doc file, or a doc-suffixed
# file UNDER docs/. Never a basename match elsewhere; never a bare .txt/.rst
# outside docs/ (a runtime-loaded config.txt or docs/deploy.sh is NOT a doc).
DOC_SUFFIXES = (".md", ".txt", ".rst")
DOC_ROOT = "docs/"
ROOT_DOC_FILES = ("LICENSE", "CHANGELOG", "CHANGELOG.md", "README.md")


def tier_max(*tiers):
    """Highest tier among the args (None/unknown-safe). TIERS is low->high.
    Used so a pinned --min-tier can only ever RAISE the requirement."""
    best = None
    for t in tiers:
        if t in TIERS and (best is None or TIERS.index(t) > TIERS.index(best)):
            best = t
    return best


def is_report_artifact(f):
    """True iff f is exactly a committed report JSON or reviewer transcript."""
    return bool(REPORT_ARTIFACT_RE.fullmatch(f))


def is_doc_file(f):
    """True iff f is documentation for the L1 waiver (never executable code)."""
    if f in ROOT_DOC_FILES:
        return True
    if f.startswith(DOC_ROOT) and f.endswith(DOC_SUFFIXES):
        return True
    return False


def fail_usage(msg):
    print(f"coverloop: error: {msg}", file=sys.stderr)
    sys.exit(2)


def git(args, cwd=None):
    """Run a git command; return stdout or None on failure."""
    try:
        out = subprocess.run(
            ["git"] + args, cwd=cwd, capture_output=True, text=True, timeout=30,
            # Strict UTF-8 made a non-decodable FILENAME raise, which the gate
            # caught and softened to an L1 floor — an L3 change passing on tests
            # alone because someone's file was latin-1. surrogateescape keeps the
            # bytes intact and round-trippable, so the path is classified rather
            # than lost.
            errors="surrogateescape",
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    # NUL-delimited output is a list of RAW pathnames: a leading or trailing
    # space is part of a filename, not formatting. Stripping it re-created the
    # exemption bypass one layer below classify_paths(), where the tests could
    # not see it — " .coverloop/reports/<sha>.json" became the exact exempt
    # shape again. Only line-oriented output gets the convenience strip.
    if "-z" in args:
        return out.stdout
    return out.stdout.strip()


def repo_root():
    root = git(["rev-parse", "--show-toplevel"])
    if not root:
        fail_usage("not inside a git repository")
    return root


def head_sha(root):
    sha = git(["rev-parse", "HEAD"], cwd=root)
    if not sha:
        fail_usage("cannot resolve HEAD (empty repository?)")
    return sha


def now_utc():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_json(path):
    """Return (data, error). Fail closed on unreadable/invalid JSON."""
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f), None
    except FileNotFoundError:
        return None, f"{path}: not found"
    except (json.JSONDecodeError, OSError) as e:
        return None, f"{path}: unreadable ({e})"


# ---------------------------------------------------------------- init

def cmd_init(args):
    root = repo_root()
    cfg_path = os.path.join(root, CONFIG_FILE)
    os.makedirs(os.path.join(root, REPORTS_DIR), exist_ok=True)
    if os.path.exists(cfg_path):
        print(f"skip {CONFIG_FILE} (exists)")
    else:
        # No base is stored here on purpose: the diff base for the L1 waiver
        # must come from the trusted caller (CI's --base), never from a file
        # that ships inside the PR under review.
        cfg = {
            "schema": "coverloop-config/v1",
            "test_command": args.test_command or "npx tsc --noEmit",
        }
        with open(cfg_path, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2)
            f.write("\n")
        print(f"+ {CONFIG_FILE}  (test_command: {cfg['test_command']!r} — edit for your stack)")
    gi_path = os.path.join(root, CONFIG_DIR, ".gitignore")
    gi_body = (
        "# Coverloop reports are evidence — commit them with the change.\n"
        "# The negations defeat repo-root ignore rules (e.g. `*.log`) that would\n"
        "# silently swallow the PR-visible transcripts (field report 2026-07-10).\n"
        "!reports/\n"
        "!reports/*.json\n"
        "!reports/*.codex.log\n"
        "!reports/*.glm.log\n"
    )
    if not os.path.exists(gi_path) or "!reports/" not in open(gi_path, encoding="utf-8").read():
        with open(gi_path, "w", encoding="utf-8") as f:
            f.write(gi_body)
        print(f"+ {CONFIG_DIR}/.gitignore  (negations keep evidence commit-able)")
    print(f"+ {REPORTS_DIR}/")
    print("Done. Record evidence with `coverloop attest`, verify with `coverloop gate`.")
    return 0


# ---------------------------------------------------------------- reports

def report_path(root, sha):
    return os.path.join(root, REPORTS_DIR, f"{sha}.json")


def load_report(root, sha):
    """Load the report for this exact SHA. (None, reason) if unusable."""
    path = report_path(root, sha)
    # Reject a report reached through a symlink (or a symlinked reports/ dir):
    # the evidence must live in the repo's committed tree, not off-tree. Mirrors
    # the transcript guard in verify_capture.
    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
    if (os.path.islink(path)
            or os.path.realpath(reports_real) != reports_real
            or (os.path.exists(path) and os.path.dirname(os.path.realpath(path)) != reports_real)):
        return None, f"{path}: report resolves outside the reports dir (symlink) — rejected"
    data, err = load_json(path)
    if err:
        return None, err
    if data.get("schema") != SCHEMA:
        return None, f"{path}: unknown schema {data.get('schema')!r} (want {SCHEMA})"
    if data.get("commit") != sha:
        return None, f"{path}: bound to commit {data.get('commit')!r}, HEAD is {sha}"
    # An invalid risk_tier must fail closed — otherwise a garbage tier is ignored
    # by tier_max() and a pinned --min-tier L0 would gate it as L0 (no evidence).
    if data.get("risk_tier") not in TIERS:
        return None, f"{path}: invalid risk_tier {data.get('risk_tier')!r}"
    # Shape guard (full audit 2026-07-11): a schema-valid report whose
    # tests/codex/glm/human_gate field is not an object would raise an uncaught
    # AttributeError deep in evaluate() (e.g. (tests or {}).get(...)) instead of
    # the documented clean "malformed evidence" FAIL. Reject it here so it takes
    # the fail-closed path.
    for field in ("tests", "codex", "glm", "human_gate"):
        v = data.get(field)
        if v is not None and not isinstance(v, dict):
            return None, f"{path}: field {field!r} must be an object, got {type(v).__name__}"
    # Strict nested-field validation (Sol grade R2): reject a schema-valid report
    # whose sub-fields carry wrong-typed values, so a malformed report takes the
    # clean FAIL path instead of relying on a downstream comparison happening to
    # be falsy. (Note: bool is an int subclass in Python — reject it explicitly so
    # `findings_open: true` can't masquerade as a count.)
    for rk in ("tests", "codex", "glm"):
        e = data.get(rk)
        if e is not None and e.get("status") is not None and e.get("status") not in ("pass", "fail"):
            return None, f"{path}: {rk}.status must be 'pass' or 'fail', got {e.get('status')!r}"
    for rk in ("codex", "glm"):
        e = data.get(rk)
        if e is not None and "findings_open" in e:
            fo = e["findings_open"]
            if isinstance(fo, bool) or not isinstance(fo, int) or fo < 0:
                return None, f"{path}: {rk}.findings_open must be a non-negative integer"
    hg = data.get("human_gate")
    if hg is not None:
        if "approved" in hg and not isinstance(hg["approved"], bool):
            return None, f"{path}: human_gate.approved must be a boolean"
        if hg.get("approver") is not None and not isinstance(hg.get("approver"), str):
            return None, f"{path}: human_gate.approver must be a string"
    return data, None


# How many first-parent ancestors to search for an evidence-only report.
EVIDENCE_WALK_LIMIT = 20


def only_evidence_changed(root, frm, to):
    """True iff the diff frm..to touches ONLY committed report ARTIFACTS
    (<sha>.json / <sha>.<reviewer>.log). A non-artifact file under reports/
    (e.g. reports/backdoor.py) counts as a real code change and returns False."""
    # _git_paths, not a line split: a lone " .coverloop/reports/<sha>.json"
    # was stripped into the exact artifact shape, so stale ancestor evidence
    # was accepted as "nothing but evidence changed".
    files = _git_paths(["diff", "--name-only", f"{frm}..{to}"], root)
    if files is None:
        return False  # unresolvable range -> fail closed
    return bool(files) and all(is_report_artifact(f) for f in files)


def find_report(root, head):
    """Locate the report that governs HEAD.

    Returns (report, reason, malformed):
      * exact HEAD report when present;
      * else a report bound to a first-parent ancestor, accepted ONLY if the
        diff ancestor..HEAD touches nothing but evidence files (this is what
        makes "attest, commit the report, gate in CI" possible);
      * (None, why, True) when a report file exists but is corrupt, forged,
        or SHA-mismatched — malformed evidence fails EVERY tier;
      * (None, why, False) when no usable report exists.
    """
    path = report_path(root, head)
    if os.path.exists(path):
        report, why = load_report(root, head)
        if report is None:
            return None, why, True
        return report, None, False
    for i in range(1, EVIDENCE_WALK_LIMIT + 1):
        anc = git(["rev-parse", f"{head}~{i}"], cwd=root)
        if not anc:
            break
        if not os.path.exists(report_path(root, anc)):
            continue
        report, why = load_report(root, anc)
        if report is None:
            return None, why, True
        if only_evidence_changed(root, anc, head):
            return report, None, False
        return None, (f"evidence at {anc[:12]} is STALE: non-evidence files "
                      f"changed between it and HEAD — re-run the loop"), False
    return None, "no report found for HEAD or any evidence-only ancestor", False


def new_report(sha, tier):
    return {
        "schema": SCHEMA,
        "commit": sha,
        "risk_tier": tier,
        "created_at": now_utc(),
        "tests": None,
        "codex": None,
        "glm": None,
        "human_gate": None,
    }


_TMP_SEQ = itertools.count()


def _fsync_fd(fd):
    """Best-effort fsync of an already-open fd (used to durably persist a
    directory's rename entry). Never fatal — durability is a bonus, not a
    correctness precondition, and some platforms/filesystems reject dir fsync."""
    try:
        os.fsync(fd)
    except OSError:
        pass


def _fsync_dir(path):
    """Best-effort fsync of a directory by path (fallback publication path)."""
    try:
        d = os.open(path or ".", os.O_RDONLY)
    except OSError:
        return
    try:
        _fsync_fd(d)
    finally:
        os.close(d)


@contextlib.contextmanager
def open_write(root, path):
    """ATOMICALLY write PATH (which MUST live directly inside
    <root>/.coverloop/reports/): the caller writes to a private temp file in the
    same dir; on clean exit the temp is fsync'd and os.replace'd over PATH, so a
    reader (gate) sees either the OLD file or the fully-written NEW one, never a
    torn/partial report (Sol R3: a plain open()+dump is not atomic, so a
    concurrent reader or a killed writer could observe a truncated file). On
    POSIX the containing directory is also fsync'd so the rename survives a crash;
    on platforms without dir-fd support this degrades to a path-based replace
    (atomic on the OS, best-effort directory durability). Still refuses any
    symlink in the reports path and disables newline translation.

    Audit fixes (2026-07-11): (1) evidence WRITES used a plain open() that would
    follow a pre-planted destination symlink and overwrite an arbitrary off-tree
    file; the read paths guarded symlinks but the writers did not. (2) text-mode
    writes translated '\\n'->'\\r\\n' on Windows while output_sha256 is hashed over
    the untranslated string, so verify_capture rejected its own untampered
    evidence there; newline='' keeps on-disk bytes == hashed bytes everywhere.

    Symlink defense mirrors the read-side guard and covers the whole PARENT
    CHAIN, not just the final component (Sol v2.7.3 grade): the file's resolved
    parent must BE the real reports dir (so a symlinked `.coverloop/` or
    `reports/` ancestor can't relocate the write off-tree), and the final
    component must not be a symlink (portable, holds where O_NOFOLLOW is absent).

    Where the platform supports it (POSIX), the actual write additionally goes
    through a PINNED directory fd (open the reports dir O_DIRECTORY|O_NOFOLLOW,
    fstat-verify it IS the real reports dir, then openat the basename relative to
    that fd): once the dir fd is pinned, swapping `reports/` for a symlink AFTER
    the path check can no longer redirect the write — closing the parent-swap
    TOCTOU race (Sol Round-1 review). Windows (no dir_fd/O_DIRECTORY) keeps the
    path-based check + O_NOFOLLOW best-effort."""
    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
    if (os.path.realpath(reports_real) != reports_real          # .coverloop or reports/ is a symlink
            or os.path.islink(path)                             # final component pre-planted as a symlink
            or os.path.dirname(os.path.realpath(path)) != reports_real):  # resolves outside the real reports dir
        fail_usage(f"refusing to write evidence outside the real reports dir (symlinked path): {path}")
    o_nofollow = getattr(os, "O_NOFOLLOW", 0)
    o_dir = getattr(os, "O_DIRECTORY", 0)
    # O_EXCL: the temp name is private (pid + process-monotonic counter), so a
    # collision is anomalous — never clobber. We create it, so it is never a
    # symlink and the write can't be redirected through it.
    wflags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | o_nofollow
    base = os.path.basename(path)
    tmp_base = f".{base}.tmp.{os.getpid()}.{next(_TMP_SEQ)}"
    tmp_full = os.path.join(os.path.dirname(path), tmp_base)
    use_dirfd = bool(o_dir and o_nofollow
                     and os.open in getattr(os, "supports_dir_fd", set())
                     and os.replace in getattr(os, "supports_dir_fd", set()))
    dfd = None
    try:
        if use_dirfd:
            # POSIX: pin the reports dir by fd (no-follow), verify identity, then
            # create + replace WITHIN that pinned fd (immune to a post-check swap).
            dfd = os.open(os.path.join(root, REPORTS_DIR), os.O_RDONLY | o_dir | o_nofollow)
            if not os.path.samestat(os.fstat(dfd), os.stat(reports_real)):
                fail_usage(f"refusing to write evidence: reports dir identity changed: {path}")
            fd = os.open(tmp_base, wflags, 0o644, dir_fd=dfd)
        else:
            fd = os.open(tmp_full, wflags, 0o644)
        f = None
        try:
            f = os.fdopen(fd, "w", encoding="utf-8", newline="")
            yield f                       # caller writes the evidence to the temp
            f.flush()
            os.fsync(f.fileno())          # file data durable before the rename
            f.close(); f = None
            if use_dirfd:                 # atomic publish: reader sees old or new, never partial
                os.replace(tmp_base, base, src_dir_fd=dfd, dst_dir_fd=dfd)
                _fsync_fd(dfd)            # make the rename itself crash-durable (POSIX dir fsync)
            else:
                os.replace(tmp_full, path)
                _fsync_dir(os.path.dirname(path))
        except BaseException:
            # Close the handle BEFORE unlinking — Windows can't unlink an open
            # file (Sol R3 grade), so a leaked-open temp would otherwise survive.
            # The prior report (if any) is untouched: we only ever wrote the temp.
            if f is not None:
                try:
                    f.close()
                except OSError:
                    pass
            try:
                os.unlink(tmp_base, dir_fd=dfd) if use_dirfd else os.unlink(tmp_full)
            except OSError:
                pass
            raise
    finally:
        if dfd is not None:
            os.close(dfd)


def save_report(root, report):
    path = report_path(root, report["commit"])
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open_write(root, path) as f:
        json.dump(report, f, indent=2)
        f.write("\n")
    return path


# ---------------------------------------------------------------- capture

# The exact marker written when a failed run's output is withheld. Checked in
# attach_log AND verify_capture so the placeholder can never be re-attested as
# a review transcript (laundering), wherever a copy of it lives.
WITHHELD_MARKER = "transcript withheld — a failed run is not valid evidence]"
# The FULL placeholder line capture_run writes on a failed run (see below). Match
# the whole line — NOT the substring — so verify_capture rejects a laundered
# failed capture without false-rejecting a genuine review that merely QUOTES the
# marker (e.g. a review of coverloop's own source). (Sol v2.7.3 verify #1)
WITHHELD_RE = re.compile(r"^\[[a-z]+ reviewer command exited -?\d+; "
                         + re.escape(WITHHELD_MARKER) + r"\s*$")


def capture_run(root, sha, name, cmd):
    """Run a reviewer command, save its combined output to
    .coverloop/reports/<sha>.<name>.log, and return provenance (command, exit
    code, output path, sha256, line count, timestamp).

    This turns a bare `--codex pass` claim into evidence backed by the actual
    reviewer transcript, committed alongside the report and hashed so tampering
    with the log invalidates the recorded digest. It does NOT auto-derive the
    verdict — reviewer output is prose, and inferring pass/fail from it
    reliably is not possible — so the caller still states pass/fail, but now
    against a captured, inspectable artifact rather than thin air.
    """
    log_rel = os.path.join(REPORTS_DIR, f"{sha}.{name}.log")
    log_path = os.path.join(root, log_rel)
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    print(f"capturing {name} reviewer: {cmd}")
    try:
        # shell=True: same trust model as the test command — an operator-typed
        # reviewer invocation (e.g. 'codex exec ...'), printed before it runs.
        # text=False: capture raw bytes so non-UTF-8 reviewer output (colored
        # diffs, binary error dumps) can't crash us; decode defensively below.
        proc = subprocess.run(cmd, shell=True, cwd=root,
                              capture_output=True, timeout=1800)
    except (OSError, subprocess.TimeoutExpired) as e:
        fail_usage(f"could not run {name} reviewer command: {e}")
    output = ((proc.stdout or b"") + (proc.stderr or b"")).decode("utf-8", errors="replace")
    if proc.returncode != 0:
        # A failed run's output is untrusted error text (env dumps, stack state
        # that routinely carries tokens). It is also NOT valid evidence (the gate
        # rejects exit!=0), so we WITHHOLD the dump rather than commit a secret-
        # bearing error log to git.
        output = f"[{name} reviewer command exited {proc.returncode}; {WITHHELD_MARKER}\n"
    # Redact secret VALUES before this text is written to a committed file — a
    # privacy tool must never leak keys/tokens/DB creds into git history.
    output = redact_secrets(output)
    with open_write(root, log_path) as f:
        f.write(output)
    return {
        "source": "captured",
        "command": redact_secrets(cmd),  # the invocation string is committed too
        "exit_code": proc.returncode,
        "output_file": log_rel,
        "output_sha256": hashlib.sha256(output.encode("utf-8")).hexdigest(),
        "output_lines": output.count("\n"),
        "ran_at": now_utc(),
    }


ATTACH_MAX_BYTES = 5 * 1024 * 1024  # a review transcript, not a build artifact


def attach_log(root, sha, name, src_path):
    """Attach an EXISTING reviewer transcript as evidence: redact secret
    values, copy it to .coverloop/reports/<sha>.<name>.log, and return
    provenance with the redacted copy's sha256.

    Field reality (the reason this exists): reviews usually run interactively
    first (codex exec / glm-review in the terminal), so `--codex-run` would
    mean paying for the SAME review twice — and in practice evidence stays
    self-attested. An attached transcript is one honesty notch below captured
    (the tool didn't execute the command, so there's no exit-code/execution
    binding) but far above a bare claim: the transcript is committed, readable
    in the PR, and hash-bound to this commit like any captured log.
    """
    if os.path.islink(src_path):
        fail_usage(f"--{name}-log: {src_path} is a symlink — pass the real transcript file")
    if not os.path.isfile(src_path):
        fail_usage(f"--{name}-log: no such file: {src_path}")
    # Refuse sources inside the reports dir: attaching the gate's own artifacts
    # would launder a withheld failed-run log, or replay an OLD commit's log,
    # into fresh "attached" evidence with one command. (Replaying a copy made
    # elsewhere is the documented attester's-word ceiling — but the tool must
    # not accept its own rejection/stale artifacts as new evidence.)
    src_real = os.path.realpath(src_path)
    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
    inside_reports = src_real == reports_real or src_real.startswith(reports_real + os.sep)
    # String compare alone is bypassable on case-insensitive filesystems
    # (".COVERLOOP/REPORTS/x.log" resolves but keeps its casing) — also walk
    # the source's ancestor DIRECTORY IDENTITIES (inode compare) against the
    # reports dir.
    if not inside_reports:
        try:
            rep_stat = os.stat(reports_real)
        except OSError:
            rep_stat = None
        if rep_stat is not None:
            d = os.path.dirname(src_real)
            while True:
                try:
                    if os.path.samestat(os.stat(d), rep_stat):
                        inside_reports = True
                        break
                except OSError:
                    pass
                parent = os.path.dirname(d)
                if parent == d:
                    break
                d = parent
    if inside_reports:
        fail_usage(f"--{name}-log: {src_path} is inside {REPORTS_DIR}/ — attaching the gate's "
                   f"own artifacts would launder or replay existing evidence; pass the "
                   f"original transcript from outside the reports dir")
    size = os.path.getsize(src_path)
    if size > ATTACH_MAX_BYTES:
        fail_usage(f"--{name}-log: {src_path} is {size} bytes (cap {ATTACH_MAX_BYTES}) — "
                   f"attach the reviewer transcript, not a build artifact")
    with open(src_path, "rb") as f:
        text = f.read().decode("utf-8", errors="replace")
    if not text.strip():
        fail_usage(f"--{name}-log: {src_path} is empty — an empty transcript is not evidence")
    if WITHHELD_RE.match(text.strip()):
        fail_usage(f"--{name}-log: {src_path} is a withheld failed-run placeholder, "
                   f"not a review transcript — fix the reviewer command and re-run")
    # Same privacy rule as capture_run: secret VALUES never reach a committed file.
    text = redact_secrets(text)
    # Re-check size AFTER decode+redaction: errors="replace" can expand raw
    # bytes up to 3x (U+FFFD), so a source at the cap could otherwise commit a
    # 15MB artifact.
    if len(text.encode("utf-8")) > ATTACH_MAX_BYTES:
        fail_usage(f"--{name}-log: transcript expands past the {ATTACH_MAX_BYTES}-byte cap "
                   f"after decoding — attach a plain-text review transcript")
    log_rel = os.path.join(REPORTS_DIR, f"{sha}.{name}.log")
    log_path = os.path.join(root, log_rel)
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    with open_write(root, log_path) as f:
        f.write(text)
    return {
        "source": "attached",
        "output_file": log_rel,
        "output_sha256": hashlib.sha256(text.encode("utf-8")).hexdigest(),
        "output_lines": text.count("\n"),
        "attached_at": now_utc(),
    }


# ---------------------------------------------------------------- attest

@contextlib.contextmanager
def _attest_lock(root):
    """Serialize concurrent `attest` read-modify-write cycles (find_report …
    save_report) so two attests recording DIFFERENT fields of the same commit's
    report can't lost-update each other (R4 / Sol gap #1 — atomic writes stop
    torn files but last-writer-wins still dropped a field). Advisory flock held
    for the whole cycle; auto-released on process exit, so a crashed attest never
    leaves a stale lock. The lock lives in the git dir (machine-local state,
    never committed). No-op where flock is unavailable (native Windows), where
    concurrent attest is not a supported workflow."""
    try:
        import fcntl
    except ImportError:
        # No file locking on this platform (native Windows). Yielding here made
        # the "two attests never lose each other's evidence" guarantee false
        # wherever it could not be kept, silently. Refuse by default, same as a
        # lock that cannot be created.
        if os.environ.get("COVERLOOP_ALLOW_UNLOCKED_ATTEST") != "1":
            sys.stderr.write(
                "coverloop: this platform provides no file locking, so concurrent "
                "`attest` could lose evidence. Refusing. Set "
                "COVERLOOP_ALLOW_UNLOCKED_ATTEST=1 to proceed anyway.\n")
            sys.exit(1)
        yield
        return
    # --git-common-dir (NOT --git-dir): the SHARED git dir, so two linked
    # worktrees of the same repo take the SAME lock (M3 R4 — a per-worktree
    # --git-dir let two worktrees lost-update each other). realpath canonicalizes
    # a relative/`..` submodule path (M3 R4 P3).
    common = git(["rev-parse", "--git-common-dir"], cwd=root)
    candidates = []
    if common:
        candidates.append(os.path.realpath(os.path.join(root, common)))
    candidates.append(os.path.realpath(os.path.join(root, REPORTS_DIR)))  # writable iff attest can write
    fd = None
    for lock_dir in candidates:
        try:
            os.makedirs(lock_dir, exist_ok=True)
            fd = os.open(os.path.join(lock_dir, "coverloop-attest.lock"),
                         os.O_CREAT | os.O_RDWR, 0o644)
            break
        except OSError:
            continue
    if fd is None:
        # Warning loudly was not enough: the body ran anyway, so the "two attests
        # never lose each other's evidence" guarantee was false at exactly the
        # moment it mattered, and a lost update leaves NO trace to notice. The
        # timeout path below already refuses; this path now matches it.
        if os.environ.get("COVERLOOP_ALLOW_UNLOCKED_ATTEST") != "1":
            sys.stderr.write(
                "coverloop: could not create the attest lock; refusing rather than "
                "risking a lost update. Set COVERLOOP_ALLOW_UNLOCKED_ATTEST=1 to "
                "accept that risk.\n")
            sys.exit(1)
        sys.stderr.write("coverloop: WARNING — proceeding UNLOCKED "
                         "(COVERLOOP_ALLOW_UNLOCKED_ATTEST=1); concurrent `attest` "
                         "on this machine may lose updates.\n")
        yield
        return
    try:
        # Bounded wait, then FAIL CLOSED (GPT/Sol R5): poll non-blocking so a
        # stuck holder can't hang every future attest forever (GLM R4 P2-4), but
        # on timeout REFUSE to proceed unlocked — exit non-zero and write nothing
        # — rather than risk a lost update. Proceeding unlocked was the hole that
        # made the "two attests never lose each other's evidence" guarantee false.
        # The window is generous (300s) because the lock currently spans the whole
        # attest, and a reviewer capture (`--codex-run`) can legitimately run for
        # minutes; a genuinely stuck lock still fails within 5 min, not forever.
        # NOTE: flock is a LOCAL guard only — unreliable over NFS/shared FS (GLM
        # R4 P2-3); cross-machine attest is not a supported workflow.
        deadline = time.monotonic() + 300.0
        warned = False
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.monotonic() >= deadline:
                    # fail closed; the `finally` below releases + closes the fd.
                    sys.stderr.write(
                        "coverloop: another `attest` has held the lock for >5min. Refusing to "
                        "proceed UNLOCKED (it could lose evidence) — NOTHING was written. Re-run "
                        "once the other attest finishes, or investigate a stuck process.\n")
                    sys.exit(2)
                if not warned:
                    sys.stderr.write("coverloop: waiting for a concurrent attest to finish…\n")
                    warned = True
                time.sleep(0.1)
        yield
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            pass
        os.close(fd)


def cmd_attest(args):
    root = repo_root()
    with _attest_lock(root):
        return _cmd_attest_locked(args, root)


def _cmd_attest_locked(args, root):
    sha = head_sha(root)
    report, why, malformed = find_report(root, sha)
    if malformed:
        fail_usage(f"existing report is unusable — fix or delete it: {why}")
    if report is not None and report["commit"] != sha:
        # Inherit evidence from an ancestor whose only difference is evidence
        # files (find_report guarantees that), rebound to the current HEAD.
        anc_sha = report["commit"]
        report = dict(report)
        # Remember where this evidence ORIGINALLY bound. Overwriting `commit`
        # alone erased the range: the floor then saw report.commit == HEAD and
        # classified only HEAD^..HEAD, so a dangerous commit A attested as L0,
        # followed by an evidence-only commit B, made A invisible. The floor
        # reads this field, so re-attesting can no longer shrink what it covers.
        report.setdefault("origin_commit", anc_sha)
        report["commit"] = sha
        # Re-bind any reviewer transcript to the new commit's filename so the
        # gate's commit+reviewer binding still recognizes it. The transcript is
        # trusted ONLY if it verifies AGAINST THE ANCESTOR first (exact
        # <ancestor>.<reviewer>.log name, real in-tree file, hash match,
        # consistent source fields) — otherwise a forged ancestor report could
        # point output_file at any OLD clean artifact and have attest launder
        # it into evidence for the new HEAD.
        for rname in ("codex", "glm"):
            e = report.get(rname)
            if not (e and e.get("source") in ("captured", "attached") and e.get("output_file")):
                continue
            if not verify_capture(root, e, anc_sha, rname):
                # untrusted/unverifiable transcript -> drop to a self-attested
                # claim (the gate will demand a fresh transcript) rather than
                # copy an arbitrary, stale, or off-tree file.
                report[rname] = dict(e, source="self-attested")
                report[rname].pop("output_file", None)
                report[rname].pop("output_sha256", None)
                continue
            src_rel = e["output_file"]
            old_path = os.path.join(root, src_rel)
            new_rel = os.path.join(REPORTS_DIR, f"{sha}.{rname}.log")
            new_path = os.path.join(root, new_rel)
            try:
                if os.path.realpath(old_path) != os.path.realpath(new_path) and os.path.exists(old_path):
                    with open(old_path, "rb") as rf:
                        data = rf.read()
                    # redact on copy (defense in depth) and rebind the hash
                    safe = redact_secrets(data.decode("utf-8", errors="replace"))
                    with open_write(root, new_path) as wf:
                        wf.write(safe)
                    e = dict(e, output_sha256=hashlib.sha256(safe.encode("utf-8")).hexdigest())
                report[rname] = dict(e, output_file=new_rel)
            except OSError:
                pass
    # ------------------------------------------------------------------ tier
    # The tier is DERIVED, not declared. Across nine repos, hand-declared tiers
    # were wrong in both directions — 35% too high on validated baselines, and,
    # far worse, 47% of Alex Switchboard reports declared L2 on segments whose
    # floor was L3. So: with no --tier, the deterministic floor IS the tier, and
    # it is computed with the SAME function and the SAME baseline semantics the
    # gate uses (_gate_floor_paths), so attest and gate can never disagree.
    #
    # Two things the floor cannot see are still allowed, and only upward:
    #   --raise-tier L2|L3 --reason "..."   semantic elevation with a durable,
    #                                       committed reason (a milestone gate
    #                                       covering fourteen migrations; a
    #                                       config file that steers auth). The
    #                                       reason is recorded in the report.
    #   --tier (legacy)                     kept for compatibility; treated as a
    #                                       floor pin. Above the derived floor it
    #                                       needs --reason like --raise-tier.
    # Nothing lowers the floor. --force only bypasses the "git cannot answer"
    # refusal and is recorded, never hidden.
    try:
        floor_paths, floor_unknown = _gate_floor_paths(root, args, report, sha)
    except Exception:
        floor_paths, floor_unknown = [], True
    if floor_unknown and not getattr(args, "force", False):
        # Skipping the check when git could not answer was a fail-open: break
        # `git diff` and attest happily recorded L0 over a migration (probed
        # directly). If the floor cannot be computed, nothing can vouch for any
        # tier — refuse before writing. --force still works and is not hidden:
        # gate computes its own floor and fails closed on unknown too.
        fail_usage("cannot determine the changed paths for the floor check "
                   "(is git responding?). Refusing to record an unvalidated tier; "
                   "pass --force to record anyway — the gate will still compute "
                   "its own floor independently.")
    auto_floor, auto_reasons = ("L0", [])
    if not floor_unknown and floor_paths:
        auto_floor, auto_reasons = classify_paths(floor_paths, BREADTH_L2_FILES)

    raise_to = getattr(args, "raise_tier", None)
    legacy = getattr(args, "tier", None)
    reason = (getattr(args, "reason", None) or "").strip()
    requested = tier_max(raise_to, legacy)  # the highest thing the caller asked for
    if raise_to and legacy and raise_to != legacy:
        fail_usage("--raise-tier and --tier disagree; pass one (prefer --raise-tier --reason)")
    if reason and not requested:
        fail_usage("--reason only accompanies --raise-tier (or the legacy --tier)")

    existing = report.get("risk_tier") if report is not None else None
    derived = tier_max(auto_floor, existing)   # never below what is already recorded
    if requested and tier_max(requested, derived) != requested and not getattr(args, "force", False):
        # Asked for LESS than the derived tier. Two distinct reasons, named
        # separately because the fix differs: the recorded report already
        # carries a higher tier (a DOWNGRADE — re-attest from scratch with
        # --force if that is truly intended), or the changed paths themselves
        # floor higher (the under-declaration the fleet data showed, L2 on an
        # L3 segment — nothing lowers that).
        flag = 'raise-tier' if raise_to else 'tier'
        if existing and tier_max(existing, requested) != requested and tier_max(existing, auto_floor) == existing:
            fail_usage(
                f"refusing to downgrade risk_tier {existing} -> {requested}; a lower tier drops "
                f"evidence requirements. Re-attest with --force to override.")
        fail_usage(
            f"--{flag} {requested} is below the deterministic floor {derived} for the changes "
            f"since the last verified evidence ({'; '.join(auto_reasons[:4])}). The floor "
            f"cannot be lowered. Omit the flag to record the derived tier {derived}.")
    if requested and tier_max(requested, derived) == requested and requested != derived:
        # Elevation above the floor: allowed, upward only, and recorded with a
        # reason that survives in the committed report. The NEW interface
        # (--raise-tier) insists on --reason: an elevation nobody can explain is
        # indistinguishable from a habit, and habits are what made one repo
        # declare L3 on 100% of its changes. The LEGACY flag (--tier) is kept
        # working for every existing script and CI job: above the floor it is
        # accepted, but the report says plainly that no reason was given, and
        # stderr points at the better flag. Compatibility never means silence.
        if raise_to and not reason:
            fail_usage(
                f"elevating {derived} -> {requested} above the deterministic floor requires "
                f"--reason \"<why the classifier cannot see this risk>\" (recorded in the "
                f"report). Omit the flag to record the derived tier {derived}.")
        if not reason:
            reason = "legacy --tier pin — no reason given"
            print(f"note: --tier {requested} elevates above the derived floor {derived} without a "
                  f"reason; recorded as such. Prefer `--raise-tier {requested} --reason \"...\"`.",
                  file=sys.stderr)
        final_tier = requested
        elevation = {"from": derived, "to": requested, "reason": reason, "at": now_utc()}
        tier_source = "elevated"
    else:
        final_tier = derived if not getattr(args, "force", False) or not requested else requested
        elevation = None
        tier_source = "derived" if not (requested and getattr(args, "force", False)) else "forced"

    if report is None:
        report = new_report(sha, final_tier)
    else:
        if tier_max(existing, final_tier) != final_tier and not getattr(args, "force", False):
            fail_usage(f"refusing to downgrade risk_tier {existing} -> {final_tier}; a lower tier "
                       f"drops evidence requirements. Re-attest with --force to override.")
        report["risk_tier"] = final_tier
    report["tier_source"] = tier_source
    report["floor"] = {"tier": auto_floor, "reasons": auto_reasons[:8]}
    if elevation:
        report["elevation"] = elevation
    elif "elevation" in report and tier_source == "derived":
        report.pop("elevation", None)
    if report["risk_tier"] not in TIERS:
        fail_usage(f"invalid tier {report['risk_tier']!r}")

    did = []

    if args.tests:
        cfg, err = load_json(os.path.join(root, CONFIG_FILE))
        if err:
            fail_usage(f"cannot run tests: {err} (run `coverloop init` first)")
        cmd = (cfg or {}).get("test_command")
        if not cmd or not str(cmd).strip():
            fail_usage(f"no test_command configured in {CONFIG_FILE}")
        print(f"running tests: {cmd}")
        try:
            # shell=True is deliberate: test_command is the repo owner's own
            # config (same trust model as package.json scripts / Makefiles /
            # loop.conf TEST_CMD) and legitimately needs shell semantics
            # ("npm test && npx tsc --noEmit"). It is printed above before it
            # runs. Never feed this from untrusted input.
            proc = subprocess.run(cmd, shell=True, cwd=root)
            status = "pass" if proc.returncode == 0 else "fail"
        except OSError as e:
            fail_usage(f"could not execute test command: {e}")
        report["tests"] = {"command": cmd, "status": status, "ran_at": now_utc()}
        did.append(f"tests={status}")

    for name, verdict, findings, run_cmd, log_src in (
        ("codex", args.codex, args.codex_findings, args.codex_run, args.codex_log),
        ("glm", args.glm, args.glm_findings, args.glm_run, args.glm_log),
    ):
        if run_cmd and log_src:
            fail_usage(f"--{name}-run and --{name}-log are mutually exclusive — "
                       f"either run the reviewer fresh or attach its existing transcript")
        if (run_cmd or log_src) and not verdict:
            fail_usage(f"--{name}-run/--{name}-log requires --{name} pass|fail — you state the "
                       f"verdict for the transcript (its content is prose, not a status)")
        if verdict:
            entry = {
                "status": verdict,
                "findings_open": findings if findings is not None else 0,
                "recorded_at": now_utc(),
                "source": "self-attested",
            }
            if run_cmd:
                # capture_run sets source="captured" + provenance; keep verdict.
                entry.update(capture_run(root, sha, name, run_cmd))
                entry["status"] = verdict
                entry["findings_open"] = findings if findings is not None else 0
                if entry.get("exit_code") != 0:
                    print(f"WARNING: {name} reviewer command exited {entry['exit_code']} — "
                          f"the capture is an error transcript and the gate will REJECT it. "
                          f"Fix the command and re-run.", file=sys.stderr)
            elif log_src:
                # attach_log sets source="attached" + provenance; keep verdict.
                entry.update(attach_log(root, sha, name, log_src))
                entry["status"] = verdict
                entry["findings_open"] = findings if findings is not None else 0
            report[name] = entry
            did.append(f"{name}={verdict}[{entry['source']}]")

    if args.approve:
        if not args.approver or not args.approver.strip():
            fail_usage("--approve requires --approver <name> (approval must be attributable)")
        report["human_gate"] = {
            "required": True,
            "approved": True,
            "approver": args.approver.strip(),
            "approved_at": now_utc(),
        }
        did.append(f"human_gate=approved({args.approver.strip()})")

    if not did and not args.tier and not getattr(args, "raise_tier", None):
        did.append(f"tier={report['risk_tier']}[{report.get('tier_source', 'derived')}]")

    path = save_report(root, report)
    rel = os.path.relpath(path, root)
    # `check` drives attest with a provisional "fail" verdict per reviewer and
    # resolves the real one from the transcript afterwards; printing the
    # provisional line there would read as a failure that then "became" a pass.
    if not getattr(args, "quiet", False):
        print(f"recorded [{', '.join(did) or 'tier=' + report['risk_tier']}] -> {rel}")
        print("commit this report with your change — it is the PR-visible evidence.")
    # Evidence git IGNORES can never reach the PR — in the field a repo-root
    # `*.log` rule silently swallowed a captured transcript and CI failed on
    # missing evidence (2026-07-10). check-ignore exits 0 (-> non-None) when
    # a path is ignored.
    evidence_paths = [rel] + [report[r]["output_file"] for r in ("codex", "glm")
                              if report.get(r) and report[r].get("output_file")]
    swallowed = [p for p in evidence_paths if git(["check-ignore", p], cwd=root) is not None]
    if swallowed:
        print(f"ERROR: git IGNORES the evidence just written ({', '.join(swallowed)}) — "
              f"a .gitignore rule (e.g. `*.log`) would keep it out of the PR and the gate "
              f"would fail on missing evidence. Re-run `coverloop init` (writes negation "
              f"rules to .coverloop/.gitignore) and re-attest.", file=sys.stderr)
        return 1
    # attest --tests reflects reality: a failing test run is recorded AND
    # reported via exit code so CI/callers can react immediately.
    if args.tests and report["tests"]["status"] == "fail":
        return 1
    # Same rule for a failed reviewer capture (v2.7.2): the evidence was
    # already saved fail-closed (withheld transcript, gate will reject), but
    # automation reads the EXIT CODE — exiting 0 here let scripts treat a
    # failed review as a successful attestation.
    for rname in ("codex", "glm"):
        e = report.get(rname)
        if e and e.get("source") == "captured" and e.get("exit_code") not in (None, 0):
            return 1
    return 0


# ---------------------------------------------------------------- gate

def changed_files(root, base, sha):
    """Files changed base..sha, or None when the range can't be resolved."""
    if not base:
        return None
    # Same collector as everywhere else — a stripped pathname here granted an
    # incorrect docs-only waiver.
    return _git_paths(["diff", "--name-only", f"{base}..{sha}"], root)


def docs_only(files):
    """True iff EVERY changed file is documentation (is_doc_file) or a committed
    report artifact. Anything else — including executable code under docs/, a
    basename-collision like src/CHANGELOG, or a non-artifact file under reports/
    — makes it not docs-only, so the L1 test gate is NOT waived."""
    if not files:  # empty diff or unknown -> not provably docs-only
        return False
    for f in files:
        if is_doc_file(f) or is_report_artifact(f):
            continue
        return False
    return True


def check(name, ok, detail):
    return {"check": name, "status": "pass" if ok else "FAIL", "detail": detail}


def source_tag(entry):
    """Human tag for how a reviewer verdict was recorded."""
    src = entry.get("source", "self-attested")
    if src in ("captured", "attached"):
        return f"{src} {entry.get('output_sha256', '')[:8]}"
    return "self-attested"


def verify_capture(root, entry, commit, name):
    """True iff `entry` claims a captured transcript that is genuinely THIS
    commit's / THIS reviewer's committed log and whose sha256 matches.

    Applies to BOTH transcript sources — "captured" (the tool ran the reviewer)
    and "attached" (an existing transcript was attested via --codex-log/--glm-log;
    same binding rules, minus the exit-code check the tool can't know).

    The `source: "captured"` string alone means nothing — a hand-edited report
    could set it. Real transcript evidence must:
      * name the transcript EXACTLY `.coverloop/reports/<commit>.<name>.log`
        (no traversal, and no REPLAY of an old/unrelated log under a different
        commit or reviewer);
      * resolve — after following any symlinks — to a real file INSIDE the
        reports dir (a symlink pointing outside is rejected);
      * hash to the recorded digest (catches tampering).
    """
    src = entry.get("source")
    if src not in ("captured", "attached"):
        return False
    # A CAPTURED reviewer command must have SUCCEEDED. A nonzero exit means it
    # failed (expired auth, missing binary, a hang) and the transcript is an
    # error log, not a review — accepting it would let a failed run pass
    # --require-captured. Attached transcripts carry no exit code (the tool
    # executed nothing); their trust rests on the committed, hash-bound,
    # human-readable log alone.
    if src == "captured":
        # A genuine captured entry carries capture_run's execution fields;
        # requiring them rejects the NAIVE relabel (an attached entry flipped to
        # source:"captured" that forgets to add them). HONEST LIMIT (full audit
        # 2026-07-11): command/exit_code/ran_at are unauthenticated attester
        # JSON and the log bytes+hash are attester-authored, so a committer who
        # adds all three defeats this — no on-disk field can PROVE coverloop
        # executed the reviewer. --require-executed is therefore a best-effort
        # policy filter (rejects honestly-attached evidence), NOT proof of
        # execution; the honest ceiling is documented in docs/GATE.md.
        if not all(k in entry for k in ("command", "exit_code", "ran_at")):
            return False
        if entry.get("exit_code") != 0:
            return False
    # An ATTACHED entry never records execution fields; any leftover
    # exit_code/command/ran_at means a captured (possibly FAILED) entry was
    # hand-reclassified as "attached" to dodge the exit-code check — reject
    # the inconsistency.
    if src == "attached" and any(k in entry for k in ("exit_code", "command", "ran_at")):
        return False
    rel = entry.get("output_file") or ""
    digest = entry.get("output_sha256") or ""
    expected = os.path.join(REPORTS_DIR, f"{commit}.{name}.log")
    if not digest or rel != expected:
        return False
    path = os.path.join(root, rel)
    # The ENTIRE reports path must be real: no symlinked `.coverloop` or
    # `reports/` ancestor (which would relocate the trusted root off-tree) and
    # the log itself must not be a symlink. Only then can the transcript be
    # trusted to live in the repo's committed evidence tree.
    reports_real = os.path.join(os.path.realpath(root), REPORTS_DIR)
    if os.path.realpath(reports_real) != reports_real:
        return False  # `.coverloop` or `.coverloop/reports` is a symlink
    if os.path.islink(path) or os.path.dirname(os.path.realpath(path)) != reports_real:
        return False
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError:
        return False
    # A transcript that IS the withheld failed-run placeholder (whole line) is a
    # laundered rejection artifact, not a review — reject it for BOTH sources
    # even when the hash matches. capture_run writes this line only on a nonzero
    # exit, so a genuine passing capture is never the placeholder; this closes
    # the forge where a FAILED capture's exit_code is hand-edited 1->0 (exit_code
    # is not covered by output_sha256, so no re-hash is needed) plus an attached
    # copy of the placeholder. Matching the WHOLE line (not a substring) means a
    # real review that merely quotes the marker still passes. (full audit +
    # Sol verify 2026-07-11 P1)
    if WITHHELD_RE.match(data.decode("utf-8", errors="replace").strip()):
        return False
    return hashlib.sha256(data).hexdigest() == digest


def reviewer_check(name, entry, mandatory_msg, require_captured, root, commit,
                   require_executed=False):
    """Gate check for a reviewer (codex/glm): pass requires status==pass AND
    zero open findings. A verdict claiming `captured`/`attached` whose
    transcript is missing/tampered/replayed is rejected outright (the label
    must never be a lie); with require_captured, a self-attested verdict also
    fails — captured OR attached both satisfy it (each carries a committed,
    hash-bound transcript; the honest difference is documented in GATE.md)."""
    if not entry:
        return check(name, False, f"{name}: NO RECORD — {mandatory_msg}")
    claims_transcript = entry.get("source") in ("captured", "attached")
    transcript_valid = verify_capture(root, entry, commit, name) if claims_transcript else False
    if claims_transcript and not transcript_valid:
        return check(name, False,
                     f"{name}: claims {entry.get('source')!r} but the transcript is invalid "
                     f"(missing / tampered / wrong commit / failed or inconsistent run) — "
                     f"evidence rejected (re-run attest --{name}-run or --{name}-log)")
    ok = entry.get("status") == "pass" and entry.get("findings_open") == 0
    if ok and require_captured and not transcript_valid:
        return check(name, False,
                     f"{name}: pass but SELF-ATTESTED — --require-transcript needs a "
                     f"transcript (attest --{name}-run \"<cmd>\" or --{name}-log <file>)")
    if ok and require_executed and (entry.get("source") != "captured" or not transcript_valid):
        return check(name, False,
                     f"{name}: --require-executed demands a coverloop-EXECUTED capture "
                     f"(attest --{name}-run \"<cmd>\"); source "
                     f"{entry.get('source', 'self-attested')!r} does not qualify")
    return check(name, ok,
                 f"{name}: {entry.get('status')}, open findings: "
                 f"{entry.get('findings_open')} [{source_tag(entry)}]")


# Two DIFFERENT questions the gate answers, kept apart on purpose:
#
#   VERIFICATION  — "was this change actually checked?" tests bound to the config
#                   command, an independent diff review, a red-team at L3, every
#                   transcript hash-bound to the SHA. Machine-checkable evidence.
#   AUTHORIZATION — "did a human take responsibility for it?" the named approval
#                   the gate policy demands at L3.
#
# They are not interchangeable. The baseline walk asks only the FIRST question:
# a commit whose evidence VERIFIES is a sound place to start counting risk from,
# whether or not anyone signed for it — 238 fully-reviewed L3 commits across the
# fleet were never signed, and treating them as unreviewed collapsed every
# baseline to the root and inflated every floor to L3. The gate asks BOTH, and
# authorization is never inferred from verification: reviewers passing does not
# mean a human said yes.
EVIDENCE_VERIFICATION = "verification"      # tests + reviewers only
EVIDENCE_AUTHORIZATION = "authorization"    # + the human gate, where policy requires it


def evaluate(report, tier, files, require_captured=False, root=None, test_command=None,
             require_executed=False, human_gate_required=True,
             scope=EVIDENCE_AUTHORIZATION):
    """Pure gate logic -> (verdict_pass, [checks]). Fail closed throughout.

    `scope` selects which question is being asked (see EVIDENCE_* above).
    EVIDENCE_VERIFICATION deliberately omits the human gate; it is for deciding
    whether a past commit counts as a reviewed baseline, never for clearing a
    merge. EVIDENCE_AUTHORIZATION is the full gate.
    """
    checks = []

    if tier == "L0":
        checks.append(check("tier", True, "L0: trivial — no evidence required"))
        return True, checks

    tests = report.get("tests") if report else None
    recorded_cmd = str((tests or {}).get("command", "")).strip()
    # The recorded test command must match the project's CURRENT config command,
    # so a hand-forged `{"command":"echo fake","status":"pass"}` (or an old
    # command from before config changed) can't gate green. FAIL CLOSED when the
    # config has no test_command — an empty/None command can never be a match, so
    # a forged pass can't ride on a repo that never configured its tests.
    cfg_cmd = str(test_command or "").strip()
    cmd_matches = bool(cfg_cmd) and recorded_cmd == cfg_cmd
    tests_ok = bool(tests) and tests.get("status") == "pass" and bool(recorded_cmd) and cmd_matches
    if tier == "L1" and docs_only(files):
        checks.append(check("tests", True, "docs-only diff — test gate waived"))
    else:
        if not cfg_cmd:
            detail = "tests: no test_command configured — cannot verify (set one in .coverloop/config.json)"
        elif tests and not cmd_matches:
            detail = (f"tests: recorded command {recorded_cmd!r} != config test_command "
                      f"{cfg_cmd!r} — re-run `coverloop attest --tests`")
        elif tests:
            detail = f"tests: {tests.get('status')} ({tests.get('command')})"
        else:
            detail = "tests: NO RECORD — run `coverloop attest --tests`"
        checks.append(check("tests", tests_ok, detail))

    report_commit = (report or {}).get("commit")
    if tier in ("L2", "L3"):
        checks.append(reviewer_check(
            "codex", report.get("codex") if report else None,
            "independent diff review is mandatory at L2/L3", require_captured, root, report_commit,
            require_executed))

    if tier == "L3":
        checks.append(reviewer_check(
            "glm", report.get("glm") if report else None,
            "red-team/audit is mandatory at L3", require_captured, root, report_commit,
            require_executed))

        # WHO gets stopped, and why it is a choice.
        #
        # By default every L3 change waits for a named human. Measured on a real
        # billing/auth/worker platform that is ~47% of commits — and a gate that
        # fires on half your work is a gate you learn to rubber-stamp, which is
        # the same failure this tool warns about for over-classification, one
        # notch up. `--human-gate-scope irreversible` narrows the STOP (not the
        # review: tests, diff gate and red-team still run on every L3) to the
        # changes you cannot take back — schema migrations, money paths, and
        # authz/RLS policy. On that same repo it took the human stops from 47%
        # to 25% of commits.
        #
        # It is OPT-IN. Silently relaxing an existing user's gate on upgrade
        # would be exactly the kind of unannounced weakening this project exists
        # to make impossible.
        if scope == EVIDENCE_VERIFICATION:
            # Asked only whether the change was VERIFIED. Say so explicitly in
            # the checks rather than silently passing: the record must show this
            # evaluation never claimed anyone authorized anything.
            checks.append(check("human_gate", True,
                                "human gate: not evaluated (verification-only scope — "
                                "reviewed evidence, not authorization)"))
            verdict = all(c["status"] == "pass" for c in checks)
            return verdict, checks
        needs_human = human_gate_required
        why_exempt = ("" if needs_human else
                      " — scope=irreversible and no migration/money/authz path in "
                      "this change; the full automated L3 evidence still applies")

        hg = report.get("human_gate") if report else None
        hg_ok = bool(hg) and hg.get("approved") is True and bool(str(hg.get("approver", "")).strip())
        if not needs_human:
            checks.append(check("human_gate", True, "human gate: not required" + why_exempt))
        else:
            detail = (
                f"human gate: approved by {hg.get('approver')!r}" if hg_ok
                else "human gate: NOT APPROVED — L3 requires `coverloop attest --approve --approver <name>`"
            )
            checks.append(check("human_gate", hg_ok, detail))

    verdict = all(c["status"] == "pass" for c in checks)
    return verdict, checks


# git's %G? signature-status codes. Only "G" (good AND from a key of sufficient
# validity — gpg owner-trust, or an ssh signer in allowed_signers) proves an
# AUTHORIZED author. "U" is a good signature whose key validity is UNKNOWN (e.g.
# a key merely imported into the keyring, or an ssh signer NOT in
# allowed_signers) — accepting it would let anyone with any importable key pass,
# so we reject it (Sol R3 P1: `git verify-commit` exit 0 accepts both G and U).
_SIG_STATUS = {
    "U": "good signature but UNKNOWN key validity — grant owner-trust / add the signer to allowed_signers",
    "B": "BAD signature", "E": "signature could not be checked (missing public key)",
    "N": "no signature", "X": "expired signature", "Y": "expired signing key",
    "R": "revoked signing key",
}


def _project_signers_file(root, ref, tmpdir):
    """Materialize .coverloop/allowed_signers AS COMMITTED at <ref> into a temp
    file, IGNORING the working tree — a dirty/untracked policy file must never
    self-authorize (Sol+M3+GLM R4 P1), and reading the committed blob also closes
    the check-then-read TOCTOU/symlink window (no working-tree path is handed to
    git). Returns the temp path, or None if that tree has no such file.

    <ref> is HEAD by default (the bootstrapping caveat: a commit can introduce
    its OWN signer file, so a change to the policy is itself gated evidence —
    review it like any code change). Pass a PROTECTED ref (`--signers-ref
    origin/main`) that a PR can't rewrite to remove even the bootstrap gap (R5)."""
    # Resolve FIRST: `git show` takes options positionally, so an option-shaped
    # --signers-ref (e.g. --format=...) was interpreted as formatting and could
    # materialise attacker-chosen commit text AS THE ALLOWED-SIGNERS POLICY.
    # Same class as the --base injection; the same fix applies.
    resolved = _resolve_commit(ref, root)
    if resolved is None:
        return None
    content = git(["show", "--end-of-options", f"{resolved}:.coverloop/allowed_signers"],
                  cwd=root)
    if content is None:
        return None
    p = os.path.join(tmpdir, "allowed_signers")
    with open(p, "w", encoding="utf-8") as fh:
        fh.write(content + "\n")
    return p


def _is_ssh_signed(root, sha):
    """True iff <sha>'s signature is an SSH signature (vs GPG). The project
    signer policy is an ssh allowed_signers file, which git only consults for SSH
    signatures — a GPG-signed commit would be validated against the ambient GPG
    keyring and bypass the policy entirely (GLM R4 P2-2).

    We inspect ONLY the `gpgsig` header, NOT the whole object: a commit's MESSAGE
    is attacker-controlled, so a GPG-signed commit whose message merely contains
    the text 'BEGIN SSH SIGNATURE' must not be mistaken for ssh-signed (Sol R4 —
    a spoof of the substring check). Commit headers end at the first blank line;
    the signature is the `gpgsig` header (its base64 continues on space-indented
    lines), so we read only up to that blank line and only the gpgsig header."""
    obj = git(["cat-file", "commit", sha], cwd=root)
    if not obj:
        return False
    header = obj.partition("\n\n")[0]  # headers only — drop the message
    for line in header.split("\n"):
        if line.startswith("gpgsig "):
            return "SSH SIGNATURE" in line  # 'gpgsig -----BEGIN SSH SIGNATURE-----'
    return False


def verify_commit_signature(root, sha, signers_file=None):
    """(ok, detail) for whether <sha> is signed by a key git fully TRUSTS.

    Provenance (R3): the evidence report is bound to a commit hash, but a hash
    alone doesn't prove WHO authored it. We require `git log %G?` == "G" — a good
    signature from a trusted key (gpg owner-trust, or ssh allowed_signers) — so
    unreviewed code can't be laundered onto an unsigned/forged/untrusted-key
    commit and gated green. Opt-in (--require-signed-commit); never changes the
    default path. errors='replace' so a non-UTF-8 signer name can't raise a
    ValueError past the OSError handler (GLM R3 P2-1). Fail-closed.

    signers_file (R4 / Sol gap #2): when given, verify against a REPO-COMMITTED
    ssh allowed_signers policy (via -c gpg.ssh.allowedSignersFile) instead of
    each machine's ambient git trust — so a project defines WHO may sign,
    uniformly across machines and CI. Commit the file so it's authoritative in a
    clean checkout (same trust model as the rest of .coverloop)."""
    cfg = []
    if signers_file:
        sf = signers_file if os.path.isabs(signers_file) else os.path.join(root, signers_file)
        cfg = ["-c", "gpg.ssh.allowedSignersFile=" + sf]
    try:
        out = subprocess.run(["git"] + cfg + ["log", "-1", "--format=%G?%n%GS", sha],
                             cwd=root, capture_output=True, text=True,
                             errors="replace", timeout=30)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return False, "git signature check unavailable — cannot confirm commit provenance"
    lines = (out.stdout or "").splitlines()
    status = lines[0].strip() if lines else ""
    signer = lines[1].strip() if len(lines) > 1 else ""
    if out.returncode == 0 and status == "G":
        return True, "HEAD signed by a trusted key" + (f" ({signer})" if signer else "")
    reason = _SIG_STATUS.get(status, "not verifiable")
    return False, (f"HEAD provenance FAIL: {reason} — sign with a trusted key "
                   "or drop --require-signed-commit")


def _which(name):
    """Absolute path of an executable, or None. Uses a login-shell PATH lookup
    as a fallback because a tool installed under ~/.npm-global/bin is invisible
    to a non-login shell — a real trap this project hit repeatedly."""
    p = shutil.which(name)
    if p:
        return p
    home_bins = [os.path.expanduser(x) for x in
                 ("~/.npm-global/bin", "~/.local/bin", "~/bin")]
    for d in home_bins:
        cand = os.path.join(d, name)
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return None


def cmd_doctor(args):
    """Explain what is installed, what is missing, and what each choice costs.

    A setup command's job is not to say "not configured" — it is to say exactly
    which command fixes it. This project's own field audit found that when the
    strong path is annoying enough, people quietly stop using it, and a gate
    nobody runs protects nobody. So every ✗ below carries its fix.
    """
    ok = "✓"
    bad = "✗"
    warn = "!"
    rows, problems = [], []

    def line(sym, label, detail):
        rows.append(f"  {sym} {label:<24} {detail}")

    # --- the things nothing works without -------------------------------
    py = f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}"
    line(ok, "python3", py)
    g = _which("git")
    line(ok if g else bad, "git", g or "MISSING — install git")
    if not g:
        problems.append("install git")

    claude = _which("claude")
    line(ok if claude else warn, "claude code",
         claude or "not on PATH (fine if you drive coverloop yourself)")

    # --- the one credential the review loop actually needs ---------------
    key_env = os.environ.get("OPENROUTER_API_KEY", "").strip()
    key_file = os.path.expanduser("~/.config/openrouter/api_key")
    plugin_key = os.environ.get("CLAUDE_PLUGIN_OPTION_OPENROUTER_API_KEY", "").strip()
    have_file = False
    if os.path.isfile(key_file):
        try:
            with open(key_file, encoding="utf-8") as _fh:
                have_file = bool(_fh.read().strip())
        except OSError:
            have_file = False
    if plugin_key:
        line(ok, "openrouter key", "provided by the plugin (stored in your keychain)")
    elif key_env:
        line(ok, "openrouter key", "from $OPENROUTER_API_KEY")
    elif have_file:
        mode = oct(os.stat(key_file).st_mode & 0o777)[2:]
        # A world-readable key on a shared box is a real leak, not a nit.
        note = key_file + ("" if mode == "600" else
                           f"   [!] mode {mode} — run: chmod 600 {key_file}")
        line(ok if mode == "600" else warn, "openrouter key", note)
    else:
        line(bad, "openrouter key", "MISSING")
        problems.append(
            "get a key at https://openrouter.ai/keys, then:\n"
            "      mkdir -p ~/.config/openrouter && printf '%s' 'sk-or-...' "
            "> ~/.config/openrouter/api_key && chmod 600 ~/.config/openrouter/api_key")

    # --- the reviewers ---------------------------------------------------
    here = os.path.dirname(os.path.abspath(__file__))
    for tool, why in (("glm-review", "red-team + audit (full ZDR)"),):
        p = os.path.join(here, tool)
        line(ok if os.path.exists(p) else bad, tool,
             why if os.path.exists(p) else "MISSING from this install")

    # --- the gate: two routes, different privacy, user's call ------------
    codex = _which("codex")
    rows.append("")
    rows.append("  Independent diff gate (a different lineage from the builder):")
    if codex:
        rows.append(f"    {ok} Codex CLI               {codex}")
        rows.append("         Verify sign-in with a REAL call — `codex login status`")
        rows.append("         reports success on a revoked token:")
        rows.append("           codex exec --skip-git-repo-check hi < /dev/null")
    else:
        rows.append(f"    {bad} Codex CLI               not installed")
        rows.append("         npm i -g @openai/codex && codex login")
        rows.append("         Needed for L2+ gates. It keeps the diff inside your own")
        rows.append("         OpenAI account; no OpenAI model on OpenRouter offers")
        rows.append("         strict zero-data-retention, so there is no shortcut here.")
        problems.append("npm i -g @openai/codex && codex login   (the L2+ diff gate)")

    # --- this repo -------------------------------------------------------
    rows.append("")
    # Ask git directly: repo_root() prints its own error and exits, which would
    # spill a stray "not inside a git repository" line above this report.
    r = git(["rev-parse", "--show-toplevel"])
    if r:
        has = os.path.isdir(os.path.join(r, REPORTS_DIR))
        line(ok if has else warn, "this repo",
             "initialised" if has else "not initialised yet — run: coverloop init")
        if not has:
            problems.append("coverloop init   (once per repo)")
    else:
        line(warn, "this repo", "not a git repository — cd into your project first")

    print("coverloop doctor\n")
    print("\n".join(rows))
    if problems:
        print("\nTo finish setup:")
        for i, p in enumerate(problems, 1):
            print(f"  {i}. {p}")
        sys.exit(1)
    print("\nAll set. Next:  coverloop classify   (what risk is your current change?)")


def cmd_classify(args):
    """Print the deterministic tier floor for the current change.

    Designed to be piped straight into the gate, so the floor cannot be
    forgotten:  coverloop gate --min-tier "$(coverloop classify --quiet)"
    """
    if getattr(args, "paths", None):
        # Explicit paths are a PURE classification — no repo needed. Requiring
        # one made `coverloop classify <path>` unusable outside a checkout,
        # which is exactly where someone first tries it (found in the field on
        # the VPS the day this shipped).
        paths = list(args.paths)
        source = "explicit paths"
    else:
        # ONE collector, shared with the gate. This block used to carry its own
        # copy of the same git calls — a third one — and the copies drifted: the
        # gate learned to parse NUL-separated names while `classify` kept
        # splitting lines, so the very same repo reported different paths
        # depending on which command you ran. Duplicated collection logic is how
        # a fix lands in one place and quietly misses the other.
        root = repo_root()
        base = getattr(args, "base", None)
        if base and _resolve_commit(base, root) is None:
            # An EMPTY diff is a legitimate answer ("nothing changed since that
            # ref"); only an unresolvable ref is an error. Conflating the two
            # made `classify --base HEAD` report the repo as unreadable.
            print(f"coverloop classify: cannot resolve --base {base!r} — is this "
                  f"a git repo, and does that ref exist?", file=sys.stderr)
            sys.exit(2)
        paths = _changed_paths_for_gate(root, args)
        source = (f"diff {base}...HEAD" if base
                  else "working tree vs HEAD (incl. untracked)")

    tier, reasons = classify_paths(paths)

    human = "required"
    if tier != "L3":
        human = "not required (below L3)"
    elif not any(IRREVERSIBLE_RE.search(p) for p in paths):
        human = "not required under --human-gate-scope irreversible"

    if getattr(args, "human_gate", False):
        print("required" if human == "required" else "not-required")
        return
    if getattr(args, "quiet", False):
        print(tier)
        return

    print(f"coverloop classify: {tier}  ({len(paths)} file(s), {source})")
    for r in reasons:
        print(f"  - {r}")
    if not reasons:
        print("  - no files changed; this asserts nothing")
    print(f"\nHuman stop: {human}")
    print("\nThis is a FLOOR, not a verdict: the gate takes the MAX of this, any "
          "other --min-tier, and the report's own tier. It can only raise.")
    print(f'Wire it:  coverloop gate --min-tier "$(coverloop classify --quiet)"')


def cmd_gate(args):
    root = repo_root()
    sha = head_sha(root)
    report, why, malformed = find_report(root, sha)

    # The pinned flags (--min-tier, or legacy --tier) are FLOORS: the effective
    # tier is the MAX over EVERY provided floor and the report's self-declared
    # tier, so a pin can only ever RAISE the requirement — never downgrade a
    # dangerous change. Both flags are action="append", so tier_max folds all of
    # them; the old `min_tier or tier` discarded one coexisting floor and
    # argparse last-wins let a repeated lower value win (full audit 2026-07-11).
    min_floors = getattr(args, "min_tier", None) or []
    tier_floors = getattr(args, "tier", None) or []
    report_tier = (report or {}).get("risk_tier")

    # The DETERMINISTIC floor, computed here rather than trusted from the caller.
    # Until v2.10.1 `classify` was a separate command you had to remember to wire
    # (`gate --min-tier "$(classify --quiet)"`), which meant the headline promise —
    # the tier is not the author's to declare — held only for repos that opted in.
    # An L0 report, or plain `gate --min-tier L0`, passed over a migration. An
    # independent review of this repo's own release found it, correctly, as the
    # exact fail-open v2.10 claimed to close. The floor now runs unconditionally:
    # there is no flag to switch it off, because a switch is the hole.
    auto_floor, auto_reasons = None, []
    auto_paths, unknown = [], True
    try:
        auto_paths, unknown = _gate_floor_paths(root, args, report, sha)
        if unknown and getattr(args, "base", None):
            # Substituting an L1 floor let a valid L1 report gate successfully
            # over an unresolvable base — the caller believes they reviewed a
            # range that was never read. A base git cannot resolve is a caller
            # error; say so and stop.
            print(f"coverloop gate: cannot resolve --base {args.base!r} — nothing "
                  f"was classified. Fix the ref (in CI, fetch the base branch "
                  f"first).", file=sys.stderr)
            sys.exit(2)
        if unknown:
            # Softening to L1 let a valid L1 report with green tests pass while
            # the gate had, by its own admission, failed to read what changed —
            # a git timeout could hide an L3 path. If the floor cannot be
            # computed, the gate has nothing to stand on.
            print("coverloop gate: could not determine the changed paths, so no "
                  "risk floor could be derived. Refusing rather than guessing "
                  "(is this a git repo, and is git responding?).", file=sys.stderr)
            sys.exit(1)
        elif auto_paths:
            auto_floor, auto_reasons = classify_paths(auto_paths, BREADTH_L2_FILES)
    except SystemExit:
        raise
    except Exception as exc:
        print(f"coverloop gate: classification failed ({exc}); refusing. A change "
              f"the gate cannot read is not a change it can clear.", file=sys.stderr)
        sys.exit(1)

    tier = tier_max(*min_floors, *tier_floors, report_tier, auto_floor)

    # A corrupt/forged/SHA-mismatched report fails EVERY tier, including L0.
    if malformed:
        _emit(args, sha, tier or "unknown", False,
              [check("report", False, f"malformed evidence: {why}")])
        sys.exit(1)

    if not tier:
        print(f"coverloop gate: FAIL — no risk tier: {why or 'no report'}", file=sys.stderr)
        print("record evidence at HEAD first (`coverloop attest --tier L0|L1|L2|L3 --tests ...`), "
              "or state the required floor: `coverloop gate --min-tier L0|L1|L2|L3`", file=sys.stderr)
        sys.exit(1)
    if tier not in TIERS:
        fail_usage(f"invalid tier {tier!r} (use L0|L1|L2|L3)")

    if auto_floor and tier_max(report_tier, *min_floors, *tier_floors) != tier:
        print(f"coverloop gate: risk floor raised to {auto_floor} by the changed paths "
              f"(not the author's declaration):", file=sys.stderr)
        for r in auto_reasons[:6]:
            print(f"  - {r}", file=sys.stderr)

    if report is None and tier != "L0":
        _emit(args, sha, tier, False, [check("report", False, why or "no report for HEAD")])
        sys.exit(1)

    # Non-L0 tiers require a loadable config: the gate must know it is running
    # in an onboarded repo (fail closed on missing/corrupt config).
    cfg, cfg_err = load_json(os.path.join(root, CONFIG_FILE))
    if cfg_err and tier != "L0":
        _emit(args, sha, tier, False,
              [check("config", False, f"{cfg_err} — run `coverloop init` and commit {CONFIG_FILE}")])
        sys.exit(1)

    # OPT-IN: fail closed on a DIRTY non-evidence working tree (full audit
    # 2026-07-11). Evidence binds to HEAD; find_report/only_evidence_changed
    # compare commits only, so uncommitted code edited AFTER a passing attest
    # would gate green while HEAD is unchanged — real drift for the documented
    # local pre-push/pre-deploy use. It is OPT-IN (--require-clean-tree) because
    # a legitimate untracked scratch file would otherwise block the gate; CI
    # (clean checkout) is unaffected either way. Report artifacts are carved out
    # so "attest, then commit the report" still works; git-unavailable fails
    # closed. L0 (no evidence required) is exempt.
    if getattr(args, "require_clean_tree", False) and tier != "L0":
        tracked = _git_paths(["diff", "--name-only", "HEAD"], root)
        untracked = _git_paths(["ls-files", "--others", "--exclude-standard"], root)
        if tracked is None or untracked is None:
            _emit(args, sha, tier, False,
                  [check("worktree", False, "git status unavailable — cannot confirm a clean tree")])
            sys.exit(1)
        # No per-path strip: it turned a whitespace-padded name into the exempt
        # artifact shape and hid a dirty tree.
        dirty = [p for p in (list(tracked) + list(untracked))
                 if not is_report_artifact(p)]
        if dirty:
            _emit(args, sha, tier, False,
                  [check("worktree", False,
                         f"uncommitted non-evidence changes not covered by the evidence bound to HEAD "
                         f"({', '.join(dirty[:5])}{'…' if len(dirty) > 5 else ''}) — commit and re-attest")])
            sys.exit(1)

    # The docs-only waiver may rely ONLY on a base passed on the command line
    # (CI/operator-controlled — the workflow supplies --base origin/<base_ref>).
    # A base from in-repo config ships INSIDE the PR and is therefore
    # attacker-controllable (set default_base=HEAD~1 and the waiver diff skips
    # your own code change), so config's default_base must NEVER enable a
    # waiver. With no trusted base, `files` is None -> the waiver simply does
    # not apply and tests are required (fail closed).
    files = changed_files(root, args.base, sha) if args.base else None

    # --require-transcript is the honest name (accepts captured OR attached);
    # --require-captured is its deprecated alias; --require-executed implies it
    # and additionally demands a coverloop-EXECUTED capture.
    require_transcript = (args.require_captured or args.require_transcript
                          or args.require_executed)
    human_required = True
    if tier == "L3" and getattr(args, "human_gate_scope", "all") == "irreversible":
        # The SAME path set the floor was derived from — including the committed
        # range. This used to call the worktree-only collector, so after an
        # attestation the only "changed" path was the untracked report itself;
        # that matches nothing irreversible, and a committed authz change was
        # waved through without the exemption ever looking at it.
        _changed = auto_paths if not unknown else []
        # No visible change set (a bare HEAD check) is NOT evidence of safety:
        # fall back to demanding the human.
        human_required = (not _changed) or any(IRREVERSIBLE_RE.search(p) for p in _changed)

    verdict, checks = evaluate(report, tier, files,
                               human_gate_required=human_required,
                               require_captured=require_transcript, root=root,
                               test_command=(cfg or {}).get("test_command"),
                               require_executed=args.require_executed)

    # Provenance (opt-in): also require HEAD to be cryptographically signed, so
    # the tier's evidence can't be replayed onto an unsigned/forged commit. L0
    # (no evidence required) is exempt — a signature gate on a no-op is noise.
    if getattr(args, "require_signed_commit", False) and tier != "L0":
        signers = getattr(args, "signers", None)
        signers_ref = getattr(args, "signers_ref", None)
        if signers and signers_ref:
            fail_usage("--signers (a file path) and --signers-ref (a git ref) are mutually exclusive")
        if signers is not None and not signers.strip():
            fail_usage("--signers path is empty")  # don't silently fall through (GLM R4 P2-5)
        _sig_tmp = None
        project_policy = bool(signers)
        policy_src = "file" if signers else None
        if not signers:
            # Resolve the signer policy from a COMMITTED tree, NOT the working
            # tree (a dirty/untracked file must not self-authorize — R4 P1). With
            # --signers-ref, read it from a PROTECTED ref (e.g. origin/main) a PR
            # can't rewrite — closing the self-authorization gap where a commit
            # introduces its own signer key (R5). Default is HEAD (bootstrapping).
            policy_ref = signers_ref or sha
            _sig_tmp = tempfile.mkdtemp(prefix="coverloop-signers-")
            signers = _project_signers_file(root, policy_ref, _sig_tmp)
            if signers_ref and signers is None:
                fail_usage(f"--signers-ref {signers_ref!r} has no committed "
                           f".coverloop/allowed_signers (fetch it, e.g. `git fetch origin`)")
            project_policy = signers is not None
            policy_src = ("protected ref %s" % signers_ref) if (signers and signers_ref) else "HEAD"
        try:
            if project_policy and not _is_ssh_signed(root, sha):
                # the policy is an ssh allowed_signers file; a GPG signature would
                # be validated against the ambient keyring and bypass it (GLM P2-2)
                sig_ok = False
                sig_detail = ("HEAD provenance FAIL: a project signer policy is in effect but HEAD "
                              "is not SSH-signed (the policy governs ssh signatures only)")
            else:
                sig_ok, sig_detail = verify_commit_signature(root, sha, signers_file=signers)
                if project_policy:
                    sig_detail += " [project signer policy @ %s]" % policy_src
        finally:
            if _sig_tmp:
                shutil.rmtree(_sig_tmp, ignore_errors=True)
        checks.append(check("signature", sig_ok, sig_detail))
        verdict = verdict and sig_ok

    _emit(args, sha, tier, verdict, checks)
    sys.exit(0 if verdict else 1)


# The words real reviewers actually end on. Sampled from the fleet's captured
# transcripts: Codex ends "VERDICT: PASS", GLM's red-team scale is
# "Verdict: PASS / PASS WITH RISKS / REQUEST CHANGES / BLOCK", and some runs
# emit lowercase "verdict: fail" or a GitHub-style "APPROVE". A parser that
# only knew uppercase "VERDICT: PASS" scored every one of those a fail —
# fail-closed, but useless: it would have made `check` unusable with the very
# reviewers this repo ships. Unknown wording still fails.
_VERDICT_LINE = re.compile(r"\bverdicts?\s*[:\-]\s*([A-Za-z][A-Za-z \t/_-]{0,40})", re.I)
_VERDICT_FAIL = ("fail", "block", "reject", "request change", "changes request",
                 "issues", "needs work", "no-go", "no go")
_VERDICT_PASS = ("pass", "ship", "approve", "approved", "lgtm")


def _verdict_class(phrase):
    hits = [w for w in _VERDICT_FAIL + _VERDICT_PASS if phrase.startswith(w)]
    if not hits:
        return None
    return "fail" if max(hits, key=len) in _VERDICT_FAIL else "pass"


def transcript_verdict(text, window=4000):
    """Read a reviewer's own verdict out of the tail of its transcript.

    Fail-closed in both directions: any recognised failing verdict in the
    window loses, an unrecognised or absent verdict loses, and only an
    unambiguous passing verdict wins. "PASS WITH RISKS" is a pass — it is the
    reviewer's own scale for "no blocker" — while "REQUEST CHANGES" is not. A
    line that lists the whole scale ("Verdict: PASS / REQUEST CHANGES / BLOCK")
    is a rubric echoed from the prompt, not a verdict, and is skipped rather
    than read as whichever outcome it happens to name first.
    """
    tail = (text or "")[-window:]
    seen_pass = False
    for m in _VERDICT_LINE.finditer(tail):
        phrase = " ".join(m.group(1).lower().replace("/", " ").split())
        if (any(w in phrase for w in _VERDICT_FAIL)
                and any(w in phrase for w in _VERDICT_PASS)):
            continue                      # a rubric names both outcomes
        cls = _verdict_class(phrase)
        if cls == "fail":
            return "fail"
        if cls == "pass":
            seen_pass = True
    return "pass" if seen_pass else "fail"


def _stop(reason):
    """The single STOP line. stdout is flushed first so the reason is the last
    thing on the terminal even though it goes to stderr."""
    sys.stdout.flush()
    print(f"STOP: {reason}", file=sys.stderr)
    sys.exit(1)


def cmd_check(args):
    """The one-command boundary: derive the floor, run the tests, run the
    reviewers the tier requires, record it all bound to HEAD, then gate.

    Prints ONE line on success ("SAFE TO MERGE") and ONE concrete reason on
    failure ("STOP: ..."). Everything underneath is the existing primitives —
    classify, attest, gate — unchanged and still available for debugging; this
    only removes the eight-step ceremony the builder used to orchestrate by hand.

    Fail-closed at every step: the first thing that cannot be verified stops the
    run and is named. Reviewer roles come from .coverloop/config.json
    ("reviewers": {"primary": <name>, "secondary": <name>}, default
    codex/glm) so the builder lineage can change without a code change; the
    report keys stay "codex"/"glm" for compatibility with every existing report.
    """
    root = repo_root()
    sha = head_sha(root)
    cfg, cfg_err = load_json(os.path.join(root, CONFIG_FILE))
    if cfg_err:
        print(f"STOP: {cfg_err} — run `coverloop init` and commit {CONFIG_FILE}", file=sys.stderr)
        sys.exit(1)
    cfg = cfg or {}
    reviewers = cfg.get("reviewers") or {}
    primary = reviewers.get("primary", "codex")
    secondary = reviewers.get("secondary", "glm")
    if primary not in ("codex", "glm") or secondary not in ("codex", "glm") or primary == secondary:
        print("STOP: .coverloop/config.json reviewers must name two distinct roles from "
              "{codex, glm} (report keys are fixed for compatibility)", file=sys.stderr)
        sys.exit(1)

    # A dirty tree means evidence bound to HEAD would not describe the code that
    # ships. Refuse up front — the single most common process failure in the
    # fleet's gate logs was exactly this, discovered only after the reviewers ran.
    tracked = _git_paths(["diff", "--name-only", "HEAD"], root)
    untracked = _git_paths(["ls-files", "--others", "--exclude-standard"], root)
    if tracked is None or untracked is None:
        print("STOP: git could not report the working tree state", file=sys.stderr)
        sys.exit(1)
    dirty = [p for p in list(tracked) + list(untracked) if not is_report_artifact(p)]
    if dirty:
        print(f"STOP: uncommitted changes not covered by evidence "
              f"({', '.join(dirty[:4])}{'…' if len(dirty) > 4 else ''}) — commit first",
              file=sys.stderr)
        sys.exit(1)

    # 1. derive the tier with the gate's own semantics (attest does this too; we
    #    compute it here so the STOP reasons can name it before anything runs).
    report, why, malformed = find_report(root, sha)
    if malformed:
        print(f"STOP: existing evidence is malformed — {why}", file=sys.stderr)
        sys.exit(1)
    try:
        paths, unknown = _gate_floor_paths(root, args, report, sha)
    except Exception as exc:
        print(f"STOP: could not classify the change ({exc})", file=sys.stderr)
        sys.exit(1)
    if unknown:
        print("STOP: could not determine the changed paths (shallow clone or git failure) — "
              "fetch full history or pass --base", file=sys.stderr)
        sys.exit(1)
    floor, reasons = classify_paths(paths, BREADTH_L2_FILES) if paths else ("L0", [])
    tier = tier_max(floor, (report or {}).get("risk_tier"))
    raise_to = getattr(args, "raise_tier", None)
    reason = (getattr(args, "reason", None) or "").strip()
    if raise_to:
        if tier_max(raise_to, tier) != raise_to:
            print(f"STOP: --raise-tier {raise_to} is below the derived floor {tier}; the floor "
                  f"cannot be lowered", file=sys.stderr)
            sys.exit(1)
        if raise_to != tier and not reason:
            print(f"STOP: elevating {tier} -> {raise_to} requires --reason", file=sys.stderr)
            sys.exit(1)
        tier = raise_to

    # 2. attest: tests + whichever reviewers this tier needs. Reviewer commands
    #    come from config ("reviewer_commands": {"codex": "...", "glm": "..."});
    #    with none configured, check STOPs and names the missing role rather
    #    than silently downgrading to a self-attested verdict.
    a = argparse.Namespace(
        tier=None, raise_tier=raise_to if raise_to and raise_to != floor else None,
        reason=reason or None, force=False, tests=True,
        codex=None, codex_findings=None, codex_run=None, codex_log=None,
        glm=None, glm_findings=None, glm_run=None, glm_log=None,
        approve=False, approver=None, base=getattr(args, "base", None), quiet=True)
    cmds = cfg.get("reviewer_commands") or {}
    need = []
    if tier in ("L2", "L3"):
        need.append(primary)
    if tier == "L3":
        need.append(secondary)
    for role in need:
        cmd = cmds.get(role)
        if not cmd:
            print(f"STOP: tier {tier} requires an independent {role} review but "
                  f".coverloop/config.json has no reviewer_commands.{role}", file=sys.stderr)
            sys.exit(1)
        setattr(a, f"{role}_run", cmd)
        # The verdict is read back from the transcript AFTER the run (below);
        # attest requires a stated verdict, so we provisionally state "fail" and
        # only upgrade it when the transcript ends in a pass marker. Fail-closed.
        setattr(a, role, "fail")
    print(f"coverloop check — {sha[:12]} — derived tier {tier}"
          + (f" (elevated from {floor}: {reason})" if raise_to and raise_to != floor else ""))
    for r in reasons[:4]:
        print(f"  - {r}")
    with _attest_lock(root):
        rc = _cmd_attest_locked(a, root)
    report, why, malformed = find_report(root, sha)
    if report is None:
        print(f"STOP: attest did not produce a report — {why}", file=sys.stderr)
        sys.exit(1)
    if (report.get("tests") or {}).get("status") != "pass" and tier != "L0":
        _stop(f"tests failed ({(report.get('tests') or {}).get('command')})")
    # 3. read each reviewer's verdict from its captured transcript. Only an
    #    unambiguous pass marker counts; anything else stays "fail".
    for role in need:
        e = report.get(role) or {}
        log_rel = e.get("output_file")
        verdict = "fail"
        if log_rel and e.get("exit_code") == 0:
            try:
                txt = open(os.path.join(root, log_rel), encoding="utf-8", errors="replace").read()
                verdict = transcript_verdict(txt)
            except OSError:
                verdict = "fail"
        if verdict != "pass":
            report[role]["status"] = "fail"
            save_report(root, report)
            _stop(f"{role} review did not pass — see {log_rel or 'no transcript'}")
        report[role]["status"] = "pass"
        report[role]["findings_open"] = 0
    save_report(root, report)

    # 4. gate — the real one, unchanged. Its checks are the final word.
    g = argparse.Namespace(
        min_tier=[tier], tier=[], base=getattr(args, "base", None),
        require_transcript=True, require_captured=False, require_executed=False,
        require_clean_tree=True, require_signed_commit=False, signers=None,
        signers_ref=None, ci=getattr(args, "ci", False), json=False,
        human_gate_scope=getattr(args, "human_gate_scope", "all"))
    files = changed_files(root, g.base, sha) if g.base else None
    human_required = True
    if tier == "L3" and g.human_gate_scope == "irreversible":
        human_required = (not paths) or any(IRREVERSIBLE_RE.search(p) for p in paths)
    verdict, checks = evaluate(report, tier, files, human_gate_required=human_required,
                               require_captured=True, root=root,
                               test_command=cfg.get("test_command"))
    failing = [c for c in checks if c["status"] != "pass"]
    if getattr(args, "json", False):
        print(json.dumps({"schema": "coverloop-check/v1", "commit": sha, "tier": tier,
                          "verdict": "pass" if verdict else "fail", "checks": checks}, indent=2))
    elif verdict:
        for c in checks:
            print(f"  ✓ {c['check']:<11} {c['detail']}")
        print(f"  ✓ evidence bound to {sha[:12]}")
        print("SAFE TO MERGE")
    else:
        for c in checks:
            print(f"  {'✓' if c['status'] == 'pass' else '✘'} {c['check']:<11} {c['detail']}")
        first = failing[0]
        if first["check"] == "human_gate":
            _stop(f"{tier} requires a named human approval — "
                  f"`coverloop attest --approve --approver <name>` then re-run check")
        _stop(first["detail"])
    print("commit the evidence in .coverloop/reports/ with this change.")
    sys.exit(0)


def _emit(args, sha, tier, verdict, checks):
    # CI annotations go to STDERR so they also work alongside --json
    # (stdout stays pure JSON for tooling; GitHub reads both streams).
    if args.ci:
        for c in checks:
            if c["status"] != "pass":
                print(f"::error title=coverloop gate::{c['check']}: {c['detail']}",
                      file=sys.stderr)
    if args.json:
        print(json.dumps(
            {"schema": "coverloop-gate/v1", "commit": sha, "tier": tier,
             "verdict": "pass" if verdict else "fail", "checks": checks},
            indent=2,
        ))
        return
    print(f"coverloop gate — commit {sha[:12]} — tier {tier}")
    for c in checks:
        mark = "✔" if c["status"] == "pass" else "✘"
        print(f"  {mark} {c['check']:<11} {c['detail']}")
    print(f"VERDICT: {'PASS' if verdict else 'FAIL — required evidence missing or failing'}")


# ---------------------------------------------------------------- main

def main(argv=None):
    # Windows defaults stdout/stderr to cp1252, which can't encode the gate's
    # ✔/✘/…/— glyphs — the gate would crash with UnicodeEncodeError on every
    # verdict print. Force UTF-8 (best-effort; a no-op on POSIX where it already
    # is) so output is portable across platforms.
    for _s in (sys.stdout, sys.stderr):
        try:
            _s.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError):
            pass
    p = argparse.ArgumentParser(prog="coverloop", description=__doc__.splitlines()[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    pi = sub.add_parser("init", help="scaffold .coverloop/ in this repo")
    pi.add_argument("--test-command", help="command that must pass (default: npx tsc --noEmit)")
    pi.set_defaults(fn=cmd_init)

    pd = sub.add_parser("doctor",
                        help="check the install and say exactly what to fix")
    pd.set_defaults(fn=cmd_doctor)

    pc = sub.add_parser("classify",
                        help="derive the deterministic tier FLOOR from the changed paths")
    pc.add_argument("--base", metavar="REF",
                    help="classify REF...HEAD instead of the working tree (e.g. origin/main)")
    pc.add_argument("--human-gate", action="store_true",
                    help="print required|not-required instead of the tier — whether a NAMED "
                         "human approval is needed under --human-gate-scope irreversible")
    pc.add_argument("--quiet", "-q", action="store_true",
                    help="print only the tier, for piping into gate --min-tier")
    pc.add_argument("paths", nargs="*",
                    help="classify these paths instead of reading git")
    pc.set_defaults(fn=cmd_classify)

    pa = sub.add_parser("attest", help="record evidence for the HEAD commit")
    pa.add_argument("--tier", choices=TIERS,
                    help="LEGACY floor pin. The tier is now DERIVED from the changed paths with the "
                         "gate's own floor semantics; omit this. Kept for compatibility: below the "
                         "floor it is refused, above it it needs --reason (see --raise-tier)")
    pa.add_argument("--raise-tier", choices=TIERS, dest="raise_tier",
                    help="elevate ABOVE the derived floor for a risk the path classifier cannot see "
                         "(a milestone gate covering many migrations; a config file that steers "
                         "auth). Upward only; requires --reason; both are recorded in the report")
    pa.add_argument("--reason", help="why the classifier under-reads this change (recorded with --raise-tier)")
    pa.add_argument("--force", action="store_true", help="allow lowering an existing report's risk tier (dangerous)")
    pa.add_argument("--tests", action="store_true", help="run the configured test command and record the result")
    pa.add_argument("--codex", choices=["pass", "fail"], help="record the Codex diff-review verdict")
    pa.add_argument("--codex-findings", type=int, help="open Codex findings (default 0)")
    pa.add_argument("--codex-run", metavar="CMD", help="run CMD as the Codex reviewer and "
                    "capture its output (hashed, committed) as evidence backing the verdict")
    pa.add_argument("--codex-log", metavar="FILE", help="attach an EXISTING Codex transcript "
                    "(a review you already ran interactively): redacted, committed, hashed — "
                    "no re-run. Weaker than --codex-run (no execution binding), far stronger "
                    "than a bare self-attested verdict")
    pa.add_argument("--glm", choices=["pass", "fail"], help="record the GLM red-team/audit verdict")
    pa.add_argument("--glm-findings", type=int, help="open GLM findings (default 0)")
    pa.add_argument("--glm-run", metavar="CMD", help="run CMD as the GLM reviewer and "
                    "capture its output (hashed, committed) as evidence backing the verdict")
    pa.add_argument("--glm-log", metavar="FILE", help="attach an EXISTING GLM transcript "
                    "(same rules as --codex-log)")
    pa.add_argument("--approve", action="store_true", help="record the human gate approval (L3)")
    pa.add_argument("--approver", help="who approved (required with --approve)")
    pa.set_defaults(fn=cmd_attest)

    pg = sub.add_parser("gate", help="verify required evidence for the tier; exit non-zero if missing")
    pg.add_argument("--min-tier", choices=TIERS, action="append",
                    help="floor: the effective tier is max(every floor, the report's tier), so a "
                         "pin can only RAISE requirements, never downgrade a dangerous change "
                         "(repeatable; all values raise)")
    pg.add_argument("--tier", choices=TIERS, action="append",
                    help="DEPRECATED alias for --min-tier (also a floor; kept for back-compat)")
    pg.add_argument("--base", help="trusted diff base for the L1 docs-only waiver (e.g. origin/main); "
                                   "without it the waiver never applies and tests are required")
    pg.add_argument("--require-transcript", action="store_true",
                    help="reject self-attested reviewer verdicts at L2/L3 — demand a committed, "
                         "hash-bound transcript: captured (attest --codex-run/--glm-run) or "
                         "attached (--codex-log/--glm-log)")
    pg.add_argument("--require-captured", action="store_true",
                    help="DEPRECATED alias for --require-transcript (kept for CI back-compat)")
    pg.add_argument("--require-executed", action="store_true",
                    help="STRICTER than --require-transcript: prefer a coverloop-EXECUTED capture "
                         "(source 'captured', exit 0) and reject honestly-attached transcripts. "
                         "BEST-EFFORT policy filter, NOT proof of execution — on-disk fields are "
                         "attester-controlled, so a committer who controls the tree can still forge "
                         "a captured-shaped entry (see docs/GATE.md threat model)")
    pg.add_argument("--require-clean-tree", action="store_true",
                    help="for LOCAL pre-push/pre-deploy gating: fail if the working tree has "
                         "uncommitted non-evidence changes (code edited after attest isn't covered "
                         "by evidence bound to HEAD). Off by default (untracked scratch files "
                         "would block it); a clean CI checkout doesn't need it")
    pg.add_argument("--require-signed-commit", action="store_true",
                    help="PROVENANCE: also require HEAD to carry a git-verifiable GPG/SSH "
                         "signature from a TRUSTED key (git status %%G? == 'G'), so a report "
                         "can't be replayed onto an unsigned/forged/untrusted commit. L0 is exempt")
    pg.add_argument("--signers", metavar="FILE",
                    help="verify --require-signed-commit against this ssh allowed_signers FILE "
                         "(an operator-provided path) instead of the machine's ambient git trust. "
                         "With no --signers, auto-detects the repo-committed .coverloop/allowed_signers "
                         "— read from the COMMITTED blob at HEAD, not the working tree. SSH sigs only")
    pg.add_argument("--signers-ref", metavar="REF",
                    help="read the .coverloop/allowed_signers policy from a TRUSTED git ref "
                         "(e.g. origin/main) instead of HEAD — so a PR can't add its own key to the "
                         "policy and self-authorize. Needs the ref fetched. Mutually exclusive with --signers")
    pg.add_argument("--ci", action="store_true", help="CI mode: emit GitHub error annotations")
    pg.add_argument("--json", action="store_true", help="machine-readable verdict")
    pg.add_argument("--human-gate-scope", choices=["all", "irreversible"], default="all",
                    help="which L3 changes need a NAMED human approval. all (default) = every "
                         "L3 change. irreversible = only migrations/SQL, money paths and "
                         "authz/RLS; the full automated L3 review still runs on everything else")
    pg.set_defaults(fn=cmd_gate)

    pk = sub.add_parser("check", help="the one-command boundary: derive tier, run tests + required "
                                       "reviewers, record evidence bound to HEAD, gate. Prints "
                                       "SAFE TO MERGE or one STOP reason")
    pk.add_argument("--raise-tier", choices=TIERS, dest="raise_tier",
                    help="elevate above the derived floor (upward only; requires --reason)")
    pk.add_argument("--reason", help="why the classifier under-reads this change")
    pk.add_argument("--base", help="diff base (CI: origin/<base_ref>)")
    pk.add_argument("--human-gate-scope", choices=["all", "irreversible"], default="all",
                    help="same meaning as for gate; default all")
    pk.add_argument("--ci", action="store_true", help="emit GitHub error annotations")
    pk.add_argument("--json", action="store_true", help="machine-readable result")
    pk.set_defaults(fn=cmd_check)

    args = p.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
