#!/bin/sh
# A diff packet carries the change plus the files it touches, and thinking through it takes minutes:
# measured 2-6 min on 130-155 KB packets, past the helper's default 120 s and 120000 chars.
DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
GLM_TIMEOUT=600 GLM_MAX_CHARS=200000 GLM_MAX_COMPLETION_TOKENS=24000 \
exec "$DIR/glm-review" --mode diff "$@"
