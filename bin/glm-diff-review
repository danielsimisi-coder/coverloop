#!/bin/sh
# Thinking through a diff packet takes minutes (measured 1-6 min), past the helper's default 120 s,
# and the output budget must fit the CHECKED lines and findings. The 120000-char packet cap stays.
DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
GLM_TIMEOUT=600 GLM_MAX_COMPLETION_TOKENS=24000 \
exec "$DIR/glm-review" --mode diff "$@"
