#!/usr/bin/env bash
# sol-review — the independent DIFF GATE, on a different lineage, through the
# same OpenRouter key as the other reviewers.
#
# WHY THIS EXISTS
# The gate reviewer used to require the Codex CLI: a second install, a second
# account, and a browser OAuth round-trip. That is two credentials for one
# protocol, and setup friction is not free — this project's own field audit
# found that when the strong path is annoying enough, people quietly stop using
# it, and a bypassed gate protects nothing.
#
# GPT-5.6 Sol is reachable on OpenRouter and PASSES the same fail-closed privacy
# gate as GLM (verified: provider.data_collection=deny is accepted, served by
# OpenAI). So the gate role now needs ZERO extra setup beyond the one key the
# loop already needs.
#
# WHY A PACKET CALL IS THE RIGHT SHAPE FOR A GATE (not a downgrade)
# The Codex CLI is agentic: it can read the repo and run commands. That is
# valuable for BUILDING and DEBUGGING. For JUDGING it is the wrong shape — the
# off-policy rule says the reviewer must see the change as a COLD ARTIFACT in a
# fresh context, and a packet call is exactly that. It cannot wander into the
# builder's reasoning, and it cannot quietly re-derive the author's intent.
#
# Codex CLI remains a supported UPGRADE for anyone who has it: `coverloop doctor`
# detects it and prefers it, which also spends their existing subscription
# instead of per-token cost.
#
# Everything else — secret filter, redact-before-egress, ZDR routing, egress log,
# daily spend cap — is inherited unchanged from the hardened engine. This wrapper
# deliberately adds no new network path of its own.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

: "${SOL_MODEL:=openai/gpt-5.6-sol}"
# Effort per the protocol's Sol routing: a gate is high (L2) / xhigh (L3).
# Sol defaults LOW on its own — a lazy judge — so this is set explicitly.
: "${SOL_REASONING_EFFORT:=high}"

GLM_MODEL="$SOL_MODEL" \
GLM_REASONING_EFFORT="$SOL_REASONING_EFFORT" \
REVIEWER_NAME="GPT-5.6 Sol" \
exec python3 "$HERE/glm-review" "$@"
