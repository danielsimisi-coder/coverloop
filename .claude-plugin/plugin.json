{
  "name": "coverloop",
  "version": "2.12.4",
  "description": "Never let the model that wrote the code be the one that approves it. Risk-tiered gates, independent cross-lineage review, and evidence bound to the commit.",
  "author": {
    "name": "Daniel Siman Tov",
    "url": "https://github.com/danielsimisi-coder/coverloop"
  },
  "homepage": "https://github.com/danielsimisi-coder/coverloop",
  "license": "MIT",
  "keywords": [
    "code-review",
    "safety",
    "gate",
    "risk",
    "evidence",
    "multi-model"
  ],
  "userConfig": {
    "openrouter_api_key": {
      "type": "string",
      "title": "OpenRouter API key",
      "description": "Optional for advisory plan review through the existing glm-* helpers (currently Kimi K3). Buyer-funded OpenRouter account; Codex diff review uses its own account. Never paste keys into chat or a repository.",
      "sensitive": true
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-contract.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-risky-git.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/loop-stop-check.sh\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/capture-failure.sh\""
          }
        ]
      }
    ]
  }
}
